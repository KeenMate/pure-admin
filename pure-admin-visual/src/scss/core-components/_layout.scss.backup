/* ========================================
   Layout Components
   Navbar, Sidebar, Main Content, Container, Footer, and Responsive Design
   ======================================== */

// Navbar - Fixed at top, full width by default
.pa-navbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: $header-height;
  background-color: $header-bg;
  border-bottom: $border-width-base solid $header-border-color;
  z-index: $z-index-header; // 2000
  display: flex;
  align-items: center;
  justify-content: center; // Center for constrained mode
}

// Constrained navbar - limit navbar width to match container
// Body class is just a marker, no width styles on body itself
body.pa-container-sm .pa-navbar {
  max-width: $layout-container-sm;
  left: 0;
  right: 0;
  margin-left: auto;
  margin-right: auto;
}

body.pa-container-md .pa-navbar {
  max-width: $layout-container-md;
  left: 0;
  right: 0;
  margin-left: auto;
  margin-right: auto;
}

body.pa-container-lg .pa-navbar {
  max-width: $layout-container-lg;
  left: 0;
  right: 0;
  margin-left: auto;
  margin-right: auto;
}

body.pa-container-xl .pa-navbar {
  max-width: $layout-container-xl;
  left: 0;
  right: 0;
  margin-left: auto;
  margin-right: auto;
}

body.pa-container-2xl .pa-navbar {
  max-width: $layout-container-2xl;
  left: 0;
  right: 0;
  margin-left: auto;
  margin-right: auto;
}

// Navbar inner content
.pa-navbar__inner {
  width: 100%;
  padding: 0 $spacing-base;
  display: flex;
  align-items: center;
  gap: $spacing-base;

}

// Navbar elements (using pa-header__ prefix for backward compatibility with existing partials)
.pa-header {
  &__burger {
    flex-shrink: 0;
    margin-left: $burger-menu-margin-left;
  }

  &__brand {
    flex-shrink: 0;
    padding-left: $header-brand-padding-left;

    h1 {
      margin: 0;
      font-size: $font-size-lg;
      font-weight: $font-weight-semibold;
      color: $text-primary;
      white-space: nowrap;
    }
  }

  &__nav {
    flex-shrink: 0;

    // Only style the direct child ul (main navigation)
    > ul {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      gap: $spacing-md;

      > li {
        position: relative; // For dropdown positioning

        > a {
          text-decoration: none;
          color: $text-secondary;
          font-weight: $font-weight-medium;
          padding: $spacing-xs $spacing-sm;
          border-radius: $border-radius;
          transition: all $transition-fast $easing-snappy;
          font-size: $font-size-sm;
          display: block;

          &:hover {
            color: $accent-color;
            background-color: $accent-hover;
          }
        }
      }
    }

    &--left {
      margin-right: auto;
    }

    &--right {
      margin-left: auto;
    }
  }

  // Dropdown navigation items
  &__nav-item {
    &--has-dropdown {
      position: static; // Position dropdown relative to header, not this item

      &:hover > .pa-header__dropdown {
        display: block !important; // Override the !important hide
      }
    }
  }

  &__nav-link {
    display: flex;
    align-items: center;
    gap: $spacing-xs;
  }

  // Dropdown menus
  &__dropdown {
    display: none !important; // Force hide by default
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 12rem;
    background-color: $card-bg;
    border: $border-width-base solid $border-color;
    border-radius: $border-radius;
    box-shadow: $shadow-lg;
    z-index: 1100;
    padding: $spacing-xs 0;
    margin-top: 0;
    list-style: none;
    flex-direction: column; // Override any flex from parent

    li {
      display: block;
      position: relative;

      // Create invisible bridge for nested dropdowns (horizontal)
      &.pa-header__nav-item--has-dropdown::after {
        content: '';
        position: absolute;
        top: 0;
        left: 100%;
        width: 4px; // Small invisible bridge
        height: 100%;
        z-index: 1099;
      }

      // Show nested dropdown on hover
      &:hover > .pa-header__dropdown {
        display: block !important;
      }

      a {
        display: block;
        padding: $spacing-sm $spacing-base;
        color: $text-primary;
        border-radius: 0;
        white-space: nowrap;
        text-decoration: none;
        font-weight: $font-weight-medium;
        font-size: $font-size-sm;

        &:hover {
          background-color: $accent-light;
          color: $accent-color;
        }
      }
    }

    // Level 2 dropdown (nested)
    &--level2 {
      top: 0;
      left: 100%;
      margin-top: 0;
      margin-left: 0; // Remove gap to prevent dropdown from disappearing
    }
  }

  &__title {
    flex: 1;
    min-width: 0;  // Enable ellipsis
    text-align: center;

    h2 {
      margin: 0;
      font-size: $font-size-lg;
      font-weight: $font-weight-semibold;
      color: $text-primary;
      whitespace: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
  }

  &__profile-btn {
    flex-shrink: 0;
  }
}

// Burger menu button
.burger-menu {
  display: flex;
  flex-direction: column;
  justify-content: space-around;
  width: $burger-width;
  height: $burger-height;
  background: transparent;
  border: none;
  cursor: pointer;
  padding: 0;

  span {
    width: 100%;
    height: $burger-bar-height;
    background-color: $text-primary;
    border-radius: $border-radius;
    transition: all $transition-normal $easing-snappy;
    transform-origin: center;
  }

  &.active {
    span:nth-child(1) {
      transform: rotate(45deg) translate($burger-transform-offset, $burger-transform-offset);
    }

    span:nth-child(2) {
      opacity: 0;
    }

    span:nth-child(3) {
      transform: rotate(-45deg) translate($burger-transform-offset, -$burger-transform-offset);
    }
  }

  &:hover span {
    background-color: $accent-color;
  }
}

// Theme switcher styling
.theme-switcher {
  display: flex;
  align-items: center;
  gap: $spacing-sm;

  label {
    color: $text-secondary;
    font-size: $font-size-sm;
  }

  select {
    padding: $spacing-xs $spacing-sm;
    border: $border-width-base solid $border-color;
    border-radius: $border-radius;
    background-color: $header-bg;
    color: $text-primary;
    font-size: $font-size-sm;

    &:focus {
      outline: none;
      border-color: $accent-color;
    }
  }
}

// Main Container - Flexbox wrapper for sidebar + content
.pa-main-container {
  display: flex;
}

// Sidebar - Flex child, no absolute positioning
.pa-sidebar {
  width: $sidebar-width;
  max-width: $sidebar-max-width;
  flex-shrink: 0;
  background-color: $sidebar-bg;
  border-right: $border-width-base solid $border-color;
  z-index: $z-index-sidebar; // 1000 - below header
  opacity: 1;

  // Only transition after page load to prevent slide animation on initial render
  body.loaded & {
    transition: width $transition-normal $easing-snappy, opacity $transition-normal $easing-snappy;
  }

  &__nav {
    padding: $spacing-base 0;

    ul {
      list-style: none;
      margin: 0;
      padding: 0;
    }
  }

  &__item {
    // Base styles for all sidebar items (regular links and submenu toggles)
  }

  &__link {
    display: flex;
    align-items: center;
    gap: $sidebar-item-gap;
    padding: $sidebar-padding;
    color: $text-secondary;
    text-decoration: none;
    font-weight: $font-weight-medium;
    border-right: $border-width-thick solid transparent; // Reserve space to prevent shift on active

    body.loaded & {
      transition: all $transition-fast $easing-snappy;
    }

    &:hover {
      color: $text-primary;
      background-color: $accent-light;
    }

    &--active {
      color: $accent-color;
      background-color: $accent-hover;
      border-right-color: $accent-color; // Only change color, not width
    }
  }

  &__toggle {
    // For submenu toggle buttons (non-link items)
    display: flex;
    align-items: center;
    gap: $sidebar-item-gap;
    padding: $sidebar-padding;
    color: $text-secondary;
    background: none;
    border: none;
    width: 100%;
    text-align: left;
    font-weight: $font-weight-medium;
    cursor: pointer;

    body.loaded & {
      transition: all $transition-fast $easing-snappy;
    }

    &:hover {
      color: $text-primary;
      background-color: $accent-light;
    }

    &--active {
      color: $accent-color;
      background-color: $accent-hover;
    }
  }

  // Icon and label styles
  &__icon {
    width: $sidebar-icon-size;
    min-width: $sidebar-icon-size;
    height: $sidebar-icon-size;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    font-size: $font-size-base;
    text-align: center;
  }

  &__label {
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;

    body.loaded & {
      transition: opacity $transition-normal $easing-snappy, width $transition-normal $easing-snappy;
    }
  }

  // Submenu styles - Level 2
  &__submenu {
    list-style: none;
    margin: 0;
    padding: 0;
    max-height: 0;
    overflow: hidden;
    background-color: $sidebar-submenu-bg;

    body.loaded & {
      transition: max-height $transition-normal $easing-snappy;
    }

    &--open {
      max-height: $submenu-max-height; // Generous height for animation
    }
  }

  // Level 2 submenu links
  &__submenu > &__item > &__link {
    padding-left: $sidebar-submenu-indent;
    font-size: $font-size-md;
    border-right: $border-width-medium solid transparent; // Reserve space to prevent shift on active

    &:hover {
      background-color: $sidebar-submenu-hover-bg;
    }

    &--active {
      background-color: $sidebar-submenu-active-bg;
      border-right-color: $accent-color; // Only change color, not width
    }
  }

  // Level 2 submenu toggles (for third level)
  &__submenu > &__item > &__toggle {
    padding-left: $sidebar-submenu-indent;
    font-size: $font-size-md;
  }

  // Level 3 submenu links
  &__submenu &__submenu > &__item > &__link {
    padding-left: calc($sidebar-submenu-indent * $sidebar-submenu-indent-multiplier);
    font-size: $font-size-sm;
    border-right: $border-width-base solid transparent; // Reserve space to prevent shift on active

    &--active {
      border-right-color: $accent-color; // Only change color, not width
    }
  }

  // Chevron icon for toggle buttons
  &__chevron {
    margin-left: auto;
    font-size: $font-size-xs;

    body.loaded & {
      transition: transform $transition-fast $easing-snappy;
    }

    .pa-sidebar__item--open & {
      transform: rotate(90deg);
    }
  }

  // Custom scrollbar styling for sidebar
  &::-webkit-scrollbar {
    width: $scrollbar-width;
  }

  &::-webkit-scrollbar-track {
    background: $sidebar-bg;
    border-radius: $border-radius;
  }

  &::-webkit-scrollbar-thumb {
    background: $border-color;
    border-radius: $border-radius;
    border: $border-width-base solid $sidebar-bg;

    &:hover {
      background: $accent-color;
      border-color: $accent-hover;
    }

    &:active {
      background: $accent-hover;
    }
  }

  // Firefox scrollbar
  scrollbar-width: auto;
  scrollbar-color: $border-color $sidebar-bg;

  // Sticky mode: Scrollable sidebar
  body.sidebar-sticky & {
    overflow-y: auto;
  }
}

// Content Wrapper - Flex child that wraps content + footer
.pa-content-wrapper {
  flex: 1;
  display: flex;
  flex-direction: column;
}

// Sticky mode: Scrollable content wrapper
body.sidebar-sticky .pa-content-wrapper {
  overflow-y: auto;
}

// Sidebar hidden state
.sidebar-hidden {
  .pa-sidebar {
    width: 0;
    opacity: 0;
    overflow: hidden;
    border-right: none;
  }

  // Icon-collapse mode: show narrow icon-only bar when hidden
  .pa-sidebar--icon-collapse {
    width: $sidebar-collapsed-width;
    opacity: 1; // Override parent opacity: 0 to make icons visible
    overflow: visible !important; // Allow flyout to show outside sidebar
    z-index: 1050; // Higher than content area (950) for flyouts
    border-right: $border-width-base solid $border-color; // Restore border

    // Enable positioning for flyouts
    .pa-sidebar__item {
      position: relative;
    }

    // Hide text labels
    .pa-sidebar__label {
      opacity: 0;
      width: 0;
      overflow: hidden;
    }

    // Hide chevron indicators
    .pa-sidebar__chevron {
      display: none;
    }

    // Hide submenus when collapsed (but allow hover override)
    .pa-sidebar__submenu {
      display: none;
    }

    // Center icons in collapsed bar
    .pa-sidebar__icon {
      width: 100%;
      justify-content: center;
    }

    // Adjust link/toggle padding for icon-only
    .pa-sidebar__link,
    .pa-sidebar__toggle {
      padding: $spacing-sm 0;
      justify-content: center;
      gap: 0; // Remove gap to center icons properly
      position: relative; // For flyout positioning
    }

    // Flyout label on hover
    .pa-sidebar__link:hover,
    .pa-sidebar__toggle:hover {
      overflow: visible;
      z-index: 1000; // Elevate parent above content area

      .pa-sidebar__label {
        opacity: 1;
        width: auto;
        overflow: visible; // Remove overflow hidden
        position: absolute;
        left: 100%;
        top: 0;
        bottom: 0;
        padding: $spacing-sm $spacing-base;
        background-color: $sidebar-bg;
        border: $border-width-base solid $border-color;
        border-left: none;
        border-radius: 0 $border-radius $border-radius 0;
        box-shadow: $shadow-md;
        white-space: nowrap;
        z-index: 10; // Relative to parent
        display: flex;
        align-items: center;
      }
    }

    // Show submenu flyout on hover (for items with submenus)
    .pa-sidebar__item:hover > .pa-sidebar__submenu,
    .pa-sidebar__submenu:hover {
      display: block !important;
      max-height: none !important;
      overflow: visible !important;
      position: absolute;
      left: 100%;
      top: 0;
      min-width: 12rem;
      margin: 0;
      padding: 0;
      list-style: none;
      background-color: $sidebar-submenu-bg;
      border: $border-width-base solid $border-color;
      border-left: none;
      border-radius: 0 $border-radius $border-radius 0;
      box-shadow: $shadow-md;
      z-index: 1001; // Higher than parent

      // Reset submenu styling for flyout
      .pa-sidebar__item {
        position: relative; // For nested flyouts
      }

      .pa-sidebar__link,
      .pa-sidebar__toggle {
        padding: $spacing-sm $spacing-base;
        justify-content: flex-start;
        gap: $sidebar-item-gap;
        font-size: $font-size-sm;
        width: 100%;

        &:hover {
          background-color: $sidebar-submenu-hover-bg;
        }

        &--active {
          background-color: $sidebar-submenu-active-bg;
        }
      }

      .pa-sidebar__icon {
        width: $sidebar-icon-size;
        min-width: $sidebar-icon-size;
        justify-content: center;
      }

      .pa-sidebar__label {
        position: static;
        opacity: 1;
        width: auto;
        padding: 0;
        background: none;
        border: none;
        box-shadow: none;
      }

      .pa-sidebar__chevron {
        display: inline;
        margin-left: auto;
        transform: none !important; // Always point right in flyout menus (never rotate down)
      }

      // Nested submenu flyout (level 3)
      .pa-sidebar__submenu {
        display: none;
      }

      .pa-sidebar__item:hover > .pa-sidebar__submenu,
      .pa-sidebar__submenu .pa-sidebar__submenu:hover {
        display: block !important;
        max-height: none !important;
        overflow: visible !important;
        position: absolute;
        left: 100%;
        top: 0;
        min-width: 12rem;
        margin: 0;
        padding: 0;
        list-style: none;
        background-color: $sidebar-submenu-bg;
        border: $border-width-base solid $border-color;
        border-left: none;
        border-radius: 0 $border-radius $border-radius 0;
        box-shadow: $shadow-md;
        z-index: 1002; // Higher than parent submenu

        .pa-sidebar__link,
        .pa-sidebar__toggle {
          font-size: $font-size-xs;
        }

        .pa-sidebar__chevron {
          transform: none !important; // Always point right in nested flyout menus
        }
      }
    }
  }
}

// Sidebar expanded state (when not hidden) - ensure icon-collapse mode shows full width
body:not(.sidebar-hidden) {
  .pa-sidebar--icon-collapse {
    width: $sidebar-width;

    // Show labels when expanded
    .pa-sidebar__label {
      opacity: 1;
      width: auto;
    }

    // Show chevron when expanded
    .pa-sidebar__chevron {
      display: inline;
    }

    // Restore normal padding for level 1 items only
    .pa-sidebar__link,
    .pa-sidebar__toggle {
      padding: $sidebar-padding;
      justify-content: flex-start;
      gap: $sidebar-item-gap; // Restore gap when expanded
    }

    // Allow submenus to show when expanded
    .pa-sidebar__submenu {
      display: block !important;
    }

    // Restore submenu indentation for level 2
    .pa-sidebar__submenu > .pa-sidebar__item > .pa-sidebar__link,
    .pa-sidebar__submenu > .pa-sidebar__item > .pa-sidebar__toggle {
      padding-left: $sidebar-submenu-indent;
    }

    // Restore submenu indentation for level 3
    .pa-sidebar__submenu .pa-sidebar__submenu > .pa-sidebar__item > .pa-sidebar__link,
    .pa-sidebar__submenu .pa-sidebar__submenu > .pa-sidebar__item > .pa-sidebar__toggle {
      padding-left: calc($sidebar-submenu-indent * $sidebar-submenu-indent-multiplier);
    }

    // Reset icon width and alignment
    .pa-sidebar__icon {
      width: $sidebar-icon-size;
      justify-content: flex-start; // Align left with padding, not center
    }
  }
}

// Main Content - Flex child
.pa-content {
  flex: 1; // Take remaining space
  position: relative;
  // No z-index - allows tooltips to escape to higher z-index layers

  &__inner {
    padding: $spacing-base;
  }

  h2 {
    margin: 0 0 $spacing-base 0;
    font-size: $font-size-2xl;
    font-weight: $font-weight-semibold;
    color: $text-primary;
  }
}

// Container wrapper - centers entire layout (main container below fixed header)
.pa-layout-container {
  max-width: 100%;
  margin: $header-height auto 0; // Top margin for fixed header
  position: relative;
  background-color: $primary-bg;
  // No overflow - tooltips need to extend beyond container bounds

  // PureCSS breakpoints: sm=568px, md=768px, lg=1024px, xl=1280px
  &--sm {
    max-width: $layout-container-sm; // ~768px
    box-shadow: $shadow-2xl;
    border-left: $border-width-base solid $border-color;
    border-right: $border-width-base solid $border-color;
    // Don't use overflow-x: hidden - breaks position: sticky
  }

  &--md {
    max-width: $layout-container-md; // ~1024px
    box-shadow: $shadow-2xl;
    border-left: $border-width-base solid $border-color;
    border-right: $border-width-base solid $border-color;
    // Don't use overflow-x: hidden - breaks position: sticky
  }

  &--lg {
    max-width: $layout-container-lg; // ~1280px
    box-shadow: $shadow-2xl;
    border-left: $border-width-base solid $border-color;
    border-right: $border-width-base solid $border-color;
    // Don't use overflow-x: hidden - breaks position: sticky
  }

  &--xl {
    max-width: $layout-container-xl; // ~1600px
    box-shadow: $shadow-xl;
    border-left: $border-width-base solid $border-color;
    border-right: $border-width-base solid $border-color;
    // Don't use overflow-x: hidden - breaks position: sticky
  }

  &--2xl {
    max-width: $layout-container-2xl; // ~1920px
    box-shadow: $shadow-xl;
    border-left: $border-width-base solid $border-color;
    border-right: $border-width-base solid $border-color;
    // Don't use overflow-x: hidden - breaks position: sticky
  }

  &--fluid {
    max-width: none;
  }
}

// Sticky mode: Fixed height minus header
body.sidebar-sticky .pa-layout-container {
  height: calc(100vh - #{$header-height});
  margin-top: $header-height; // Ensure margin even in sticky mode
}

// Scroll mode: Minimum height
body:not(.sidebar-sticky) .pa-layout-container {
  min-height: calc(100vh - #{$header-height});
}

// Footer - Inside content wrapper, spans full width naturally
.pa-footer {
  height: $footer-height;
  background-color: $footer-bg;
  border-top: $border-width-base solid $footer-border-color;
  display: flex;
  align-items: center;
  padding: 0 $spacing-base;
  margin-top: auto; // Push to bottom of flex container

  &__content {
    p {
      margin: 0;
      color: $text-secondary;
      font-size: $font-size-sm;
    }
  }
}

// Demo content styles
.content-section {
  background: $card-bg;
  border: $border-width-base solid $border-color;
  border-radius: $border-radius-lg;
  padding: $spacing-base;
  margin-bottom: $spacing-base;
}

.sample-data {
  display: grid;
  gap: $spacing-sm;
  margin: $spacing-sm 0;

  .data-item {
    padding: $spacing-sm;
    background-color: $primary-bg;
    border: $border-width-base solid $border-color;
    border-radius: $border-radius;
    font-weight: $font-weight-medium;
  }
}

.long-content {
  .content-block {
    padding: $spacing-base;
    margin: $spacing-sm 0;
    background: $card-bg;
    border: $border-width-base solid $border-color;
    border-radius: $border-radius;
    text-align: center;
    font-size: $font-size-lg;
    font-weight: $font-weight-medium;
  }
}

// Responsive Design - Mobile and Tablet
@media (max-width: $mobile-breakpoint) {
  // Mobile: Auto-hide sidebar, content takes full width
  body:not(.sidebar-visible) {
    .pa-sidebar {
      width: 0;
      opacity: 0;
      overflow: hidden;
      border-right: none;
    }

    // Override icon-collapse mode on mobile - sidebar should be fully hidden
    .pa-sidebar--icon-collapse {
      width: 0 !important;
    }
  }

  // Mobile: Fullscreen sidebar overlay when visible
  .sidebar-visible {
    // Use fixed positioning for mobile overlay
    .pa-main-container {
      position: relative;
    }

    .pa-sidebar {
      position: fixed;
      top: $header-height;
      left: 0;
      bottom: 0;
      width: $mobile-sidebar-width;
      z-index: 1050;
      background-color: $sidebar-bg;
      opacity: 1;
      overflow-y: auto;
    }

    // Override icon-collapse mode on mobile - show full width overlay
    .pa-sidebar--icon-collapse {
      width: $mobile-sidebar-width !important;
      overflow-y: auto !important;

      .pa-sidebar__label {
        opacity: 1 !important;
        width: auto !important;
        overflow: visible !important;
        position: static !important;
      }
    }

    // Add backdrop overlay
    &::before {
      content: "";
      position: fixed;
      top: $header-height;
      left: 0;
      right: 0;
      bottom: 0;
      background-color: $mobile-backdrop-bg;
      z-index: 1040;
    }
  }

  // Adjust header for mobile
  .pa-header {
    gap: $spacing-sm;

    &__nav {
      display: none; // Hide navigation links on mobile
    }

    &__title h2 {
      font-size: $font-size-sm;
    }
  }

  // Hide theme switcher label on mobile
  .theme-switcher {
    label {
      display: none;
    }
  }
}

@media (max-width: $tablet-breakpoint) and (min-width: $tablet-breakpoint-min) {
  // Tablet: Reduce sidebar width
  .pa-sidebar {
    width: $sidebar-width-tablet;

    &__nav ul li a {
      padding: $spacing-sm $spacing-md;
      font-size: $font-size-sm;
    }
  }
}
