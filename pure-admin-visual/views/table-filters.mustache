<!-- Search with More Filters Button -->
<div class="pa-card">
    <div class="pa-card__header">
        <h3>Expandable Filters</h3>
        <p>Search with expandable advanced filters</p>
    </div>
</div>

<div class="pa-card" id="filter-card">
    <div class="pa-card__body">
        <div style="display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap;">
            <!-- Search by rule -->
            <div class="pa-input-group" style="flex: 1; min-width: 200px;">
                <span class="pa-input-group__prepend">🔍</span>
                <input type="text" class="pa-input" placeholder="Search by rule">
            </div>

            <!-- Filter by data source -->
            <div class="pa-input-group" style="flex: 1; min-width: 200px;">
                <span class="pa-input-group__prepend">🌐</span>
                <input type="text" class="pa-input" placeholder="Filter by data source">
            </div>

            <!-- Filter by Organization tree -->
            <div class="pa-input-group" style="flex: 1; min-width: 200px;">
                <span class="pa-input-group__prepend">🌐</span>
                <input type="text" class="pa-input" placeholder="Filter by Organization tree">
            </div>

            <!-- Action buttons -->
            <button class="pa-btn pa-btn--secondary pa-btn--icon-only" title="Clear all filters">×</button>
            <button class="pa-btn pa-btn--primary pa-btn--icon-only" title="Refresh">🔄</button>
            <button id="toggle-filters-btn" class="pa-btn pa-btn--primary pa-btn--icon-only" title="More filters" onclick="toggleFilters()">▼</button>
        </div>

        <!-- Advanced Filters (Hidden by default) -->
        <div id="advanced-filters" style="display: none; margin-top: 1rem; padding-top: 1rem; border-top: 1px solid #e0e0e0;">
            <div class="pure-g">
                <div class="pure-u-1 pure-u-md-1-3">
                    <div class="pa-form-group">
                        <label>Category</label>
                        <div class="pa-input-wrapper">
                            <select class="pa-select">
                                <option>All Categories</option>
                                <option>Electronics</option>
                                <option>Clothing</option>
                                <option>Books</option>
                            </select>
                            <button class="pa-input-wrapper__clear" type="button">×</button>
                        </div>
                    </div>
                </div>
                <div class="pure-u-1 pure-u-md-1-3">
                    <div class="pa-form-group">
                        <label>Price Range</label>
                        <div class="pa-input-wrapper">
                            <select class="pa-select">
                                <option>Any Price</option>
                                <option>Under $50</option>
                                <option>$50 - $100</option>
                                <option>$100 - $500</option>
                                <option>Over $500</option>
                            </select>
                            <button class="pa-input-wrapper__clear" type="button">×</button>
                        </div>
                    </div>
                </div>
                <div class="pure-u-1 pure-u-md-1-3">
                    <div class="pa-form-group">
                        <label>Status</label>
                        <div class="pa-input-wrapper">
                            <select class="pa-select">
                                <option>All Statuses</option>
                                <option>In Stock</option>
                                <option>Out of Stock</option>
                                <option>Pre-order</option>
                            </select>
                            <button class="pa-input-wrapper__clear" type="button">×</button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="pure-g">
                <div class="pure-u-1 pure-u-md-1-2">
                    <div class="pa-form-group">
                        <label>Date Range</label>
                        <div class="pure-g">
                            <div class="pure-u-1 pure-u-md-1-2">
                                <div class="pa-input-wrapper">
                                    <input type="date" class="pa-input">
                                    <button class="pa-input-wrapper__clear" type="button">×</button>
                                </div>
                            </div>
                            <div class="pure-u-1 pure-u-md-1-2">
                                <div class="pa-input-wrapper">
                                    <input type="date" class="pa-input">
                                    <button class="pa-input-wrapper__clear" type="button">×</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="pure-u-1 pure-u-md-1-2">
                    <div class="pa-form-group">
                        <label>Supplier</label>
                        <div class="pa-input-wrapper">
                            <select class="pa-select">
                                <option>All Suppliers</option>
                                <option>Supplier A</option>
                                <option>Supplier B</option>
                                <option>Supplier C</option>
                            </select>
                            <button class="pa-input-wrapper__clear" type="button">×</button>
                        </div>
                    </div>
                </div>
            </div>

            <div style="text-align: right; margin-top: 0.5rem;">
                <button class="pa-btn pa-btn--secondary">Clear Filters</button>
                <button class="pa-btn pa-btn--primary">Apply Filters</button>
            </div>
        </div>
    </div>
</div>

