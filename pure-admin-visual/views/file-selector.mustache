<div class="pa-card">
  <div class="pa-card__header">
    <h2>File Selector Component</h2>
  </div>
  <div class="pa-card__body">
    <p>Custom file input styling, drag & drop areas, image previews, file lists, and upload progress indicators.</p>
    <p><strong>Features:</strong> Custom styled inputs, drag-and-drop support, file validation, image thumbnails, progress bars, and detailed file information display.</p>
  </div>
</div>

<!-- Basic File Input - Single -->
<div class="pa-card">
  <div class="pa-card__header">
    <h3>Basic File Input - Single File</h3>
  </div>
  <div class="pa-card__body">
    <p>Custom-styled file input replacing the default browser input. Click the button to select a file.</p>

    <div class="pa-row">
      <div class="pa-col-100 pa-col-md-50">
        <div class="pa-form-group">
          <label>Upload Document</label>
          <div class="pa-file-input">
            <input type="file" id="file-single" class="pa-file-input__native" accept=".pdf,.doc,.docx">
            <button type="button" class="pa-btn pa-btn--secondary pa-file-input__button">
              <span class="pa-btn__icon">📁</span>
              Choose File
            </button>
            <span class="pa-file-input__filename">No file chosen</span>
          </div>
          <small class="pa-form-text">Accepts PDF and Word documents</small>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Basic File Input - Multiple -->
<div class="pa-card">
  <div class="pa-card__header">
    <h3>Basic File Input - Multiple Files</h3>
  </div>
  <div class="pa-card__body">
    <p>Select multiple files at once. The selected count will be displayed.</p>

    <div class="pa-row">
      <div class="pa-col-100 pa-col-md-50">
        <div class="pa-form-group">
          <label>Upload Images</label>
          <div class="pa-file-input">
            <input type="file" id="file-multiple" class="pa-file-input__native" accept="image/*" multiple>
            <button type="button" class="pa-btn pa-btn--secondary pa-file-input__button">
              <span class="pa-btn__icon">🖼️</span>
              Choose Files
            </button>
            <span class="pa-file-input__filename">No files chosen</span>
          </div>
          <small class="pa-form-text">Select multiple images</small>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Drag & Drop Area - Single -->
<div class="pa-card">
  <div class="pa-card__header">
    <h3>Drag & Drop Area - Single File</h3>
  </div>
  <div class="pa-card__body">
    <p>Drag and drop a file onto the area, or click to select. Visual feedback during drag operations.</p>

    <div class="pa-row">
      <div class="pa-col-100 pa-col-md-50">
        <div class="pa-form-group">
          <label>Upload Profile Picture</label>
          <div class="pa-file-dropzone" id="dropzone-single">
            <input type="file" class="pa-file-dropzone__input" accept="image/*">
            <div class="pa-file-dropzone__content">
              <div class="pa-file-dropzone__icon">📤</div>
              <div class="pa-file-dropzone__text">
                <strong>Drop file here</strong> or click to browse
              </div>
              <div class="pa-file-dropzone__hint">PNG, JPG up to 5MB</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Drag & Drop Area - Multiple -->
<div class="pa-card">
  <div class="pa-card__header">
    <h3>Drag & Drop Area - Multiple Files</h3>
  </div>
  <div class="pa-card__body">
    <p>Drag and drop multiple files onto the area. Files will be listed below the dropzone.</p>

    <div class="pa-row">
      <div class="pa-col-100 pa-col-md-50">
        <div class="pa-form-group">
          <label>Upload Documents</label>
          <div class="pa-file-dropzone" id="dropzone-multiple">
            <input type="file" class="pa-file-dropzone__input" accept=".pdf,.doc,.docx,.txt" multiple>
            <div class="pa-file-dropzone__content">
              <div class="pa-file-dropzone__icon">📎</div>
              <div class="pa-file-dropzone__text">
                <strong>Drop files here</strong> or click to browse
              </div>
              <div class="pa-file-dropzone__hint">PDF, DOC, DOCX, TXT files</div>
            </div>
          </div>
          <div id="dropzone-multiple-list" class="pa-file-list"></div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Image Preview -->
<div class="pa-card">
  <div class="pa-card__header">
    <h3>Image Preview with Thumbnails</h3>
  </div>
  <div class="pa-card__body">
    <p>Select images and see thumbnail previews before uploading. Each preview has a remove button.</p>

    <div class="pa-row">
      <div class="pa-col-100">
        <div class="pa-form-group">
          <label>Select Images</label>
          <div class="pa-file-dropzone" id="dropzone-preview">
            <input type="file" class="pa-file-dropzone__input" accept="image/*" multiple>
            <div class="pa-file-dropzone__content">
              <div class="pa-file-dropzone__icon">🖼️</div>
              <div class="pa-file-dropzone__text">
                <strong>Drop images here</strong> or click to browse
              </div>
              <div class="pa-file-dropzone__hint">PNG, JPG, GIF, WEBP</div>
            </div>
          </div>
          <div id="preview-container" class="pa-file-preview-grid"></div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- File List with Details -->
<div class="pa-card">
  <div class="pa-card__header">
    <h3>File List with Details</h3>
  </div>
  <div class="pa-card__body">
    <p>Detailed file list showing filename, size, type, and upload status with remove buttons.</p>

    <div class="pa-row">
      <div class="pa-col-100">
        <div class="pa-form-group">
          <label>Upload Files</label>
          <div class="pa-file-dropzone" id="dropzone-detailed">
            <input type="file" class="pa-file-dropzone__input" multiple>
            <div class="pa-file-dropzone__content">
              <div class="pa-file-dropzone__icon">📁</div>
              <div class="pa-file-dropzone__text">
                <strong>Drop files here</strong> or click to browse
              </div>
              <div class="pa-file-dropzone__hint">Any file type</div>
            </div>
          </div>
          <div id="detailed-file-list" class="pa-file-list pa-file-list--detailed"></div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- File Validation -->
<div class="pa-card">
  <div class="pa-card__header">
    <h3>File Validation (Size & Type)</h3>
  </div>
  <div class="pa-card__body">
    <p>Validate file size and type before accepting. Shows error messages for invalid files.</p>

    <div class="pa-row">
      <div class="pa-col-100 pa-col-md-50">
        <div class="pa-form-group">
          <label>Upload Image (Max 2MB)</label>
          <div class="pa-file-dropzone" id="dropzone-validated">
            <input type="file" class="pa-file-dropzone__input" accept="image/png,image/jpeg" data-max-size="2097152">
            <div class="pa-file-dropzone__content">
              <div class="pa-file-dropzone__icon">🖼️</div>
              <div class="pa-file-dropzone__text">
                <strong>Drop image here</strong> or click to browse
              </div>
              <div class="pa-file-dropzone__hint">PNG or JPEG only, max 2MB</div>
            </div>
          </div>
          <div id="validation-error" class="pa-alert pa-alert--danger" style="display: none; margin-top: 0.5rem;"></div>
          <div id="validation-success" class="pa-alert pa-alert--success" style="display: none; margin-top: 0.5rem;"></div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Upload Progress -->
<div class="pa-card">
  <div class="pa-card__header">
    <h3>Upload Progress Indicators</h3>
  </div>
  <div class="pa-card__body">
    <p>Simulated upload progress with progress bars. Click "Upload Files" after selecting to see progress.</p>

    <div class="pa-row">
      <div class="pa-col-100">
        <div class="pa-form-group">
          <label>Select Files to Upload</label>
          <div class="pa-file-dropzone" id="dropzone-progress">
            <input type="file" class="pa-file-dropzone__input" multiple>
            <div class="pa-file-dropzone__content">
              <div class="pa-file-dropzone__icon">☁️</div>
              <div class="pa-file-dropzone__text">
                <strong>Drop files here</strong> or click to browse
              </div>
              <div class="pa-file-dropzone__hint">Select files then click Upload</div>
            </div>
          </div>
          <div id="progress-file-list" class="pa-file-list pa-file-list--detailed"></div>
          <button type="button" id="upload-btn" class="pa-btn pa-btn--primary" style="margin-top: 1rem; display: none;">
            <span class="pa-btn__icon">⬆️</span>
            Upload Files
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Compact Mode: Files Inside Dropzone -->
<div class="pa-card">
  <div class="pa-card__header">
    <h3>Compact Mode - Files Inside Dropzone</h3>
  </div>
  <div class="pa-card__body">
    <p>Professional, space-efficient layout with files displayed in a grid inside the dropzone. Add <code>data-files-inside="true"</code> to enable compact mode.</p>

    <div class="pa-row">
      <!-- Compact: Multiple Files with Icons -->
      <div class="pa-col-100 pa-col-md-50" style="padding-right: 0.5rem;">
        <div class="pa-form-group">
          <label>Documents (Compact)</label>
          <div class="pa-file-dropzone" id="dropzone-compact" data-files-inside="true">
            <input type="file" class="pa-file-dropzone__input" accept=".pdf,.doc,.docx,.txt" multiple>
            <div class="pa-file-dropzone__content">
              <div class="pa-file-dropzone__icon">📎</div>
              <div class="pa-file-dropzone__text">
                <strong>Drop files here</strong> or click to browse
              </div>
              <div class="pa-file-dropzone__hint">PDF, DOC, DOCX, TXT files</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Compact: Images with Thumbnails -->
      <div class="pa-col-100 pa-col-md-50" style="padding-left: 0.5rem;">
        <div class="pa-form-group">
          <label>Images (Compact)</label>
          <div class="pa-file-dropzone" id="dropzone-compact-images" data-files-inside="true">
            <input type="file" class="pa-file-dropzone__input" accept="image/*" multiple>
            <div class="pa-file-dropzone__content">
              <div class="pa-file-dropzone__icon">🖼️</div>
              <div class="pa-file-dropzone__text">
                <strong>Drop images here</strong> or click to browse
              </div>
              <div class="pa-file-dropzone__hint">PNG, JPG, GIF, WEBP</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Ultra-Compact Mode: Summary + Modal with Drag Overlay -->
<div class="pa-card">
  <div class="pa-card__header">
    <h3>Ultra-Compact Mode - Form Integration</h3>
  </div>
  <div class="pa-card__body">
    <p>Minimalist file picker perfect for compact forms. Single-line summary that blends naturally with form fields. Drag files anywhere on the form to see the overlay expand!</p>

    <div class="pa-row">
      <div class="pa-col-100 pa-col-md-50">
        <form id="compact-form" style="padding: 1rem; border: 1px solid #ddd; border-radius: 0.25rem; background: #f9f9f9;">
          <div class="pa-form-group">
            <label>Name</label>
            <input type="text" class="pa-input" placeholder="Enter your name">
          </div>

          <div class="pa-form-group">
            <label>Email</label>
            <input type="email" class="pa-input" placeholder="Enter your email">
          </div>

          <div class="pa-form-group">
            <label>Attachments</label>
            <div class="pa-file-dropzone" id="dropzone-ultracompact"
                 data-files-compact="modal"
                 data-overlay-target="compact-form">
              <input type="file" class="pa-file-dropzone__input" multiple>
              <div class="pa-file-dropzone__content">
                <span style="font-size: 1rem; color: #666;">Click or drag files</span>
              </div>
            </div>
            <small class="pa-form-text">Drag files anywhere on this form to see the overlay!</small>
          </div>

          <button type="button" id="upload-ultracompact-btn" class="pa-btn pa-btn--primary" style="display: none; margin-right: 0.5rem;">
            <span class="pa-btn__icon">⬆️</span>
            Upload Files
          </button>
          <button type="submit" class="pa-btn pa-btn--secondary">Submit</button>
        </form>
      </div>

      <div class="pa-col-100 pa-col-md-50" style="padding-left: 1rem;">
        <div class="pa-alert pa-alert--info">
          <strong>Features:</strong>
          <ul style="margin: 0.5rem 0 0 0; padding-left: 1.5rem;">
            <li><strong>Single-line display:</strong> "📎 3 files (2.5MB) • Click to view details"</li>
            <li><strong>Drag overlay:</strong> Drag files anywhere on form to expand dropzone</li>
            <li><strong>Click file count</strong> to open positioned popover with file table</li>
            <li><strong>Floating UI:</strong> Smart positioning with auto-flip and arrow</li>
            <li><strong>Progress tracking:</strong> Currently uploading file shown inline</li>
            <li><strong>Blends with forms:</strong> No border, minimal styling</li>
          </ul>
        </div>

        <div class="pa-alert pa-alert--success" style="margin-top: 1rem;">
          <strong>Configuration:</strong>
          <pre style="margin: 0.5rem 0 0 0; font-size: 0.7rem;"><code>data-files-compact="modal"
data-overlay-target="compact-form"</code></pre>
        </div>
      </div>
    </div>
  </div>
</div>

