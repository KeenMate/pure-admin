<h2>Simple Timeline</h2>
<p class="pa-text pa-text--secondary mb-6">Left-aligned timeline with dot markers - perfect for logs and simple event lists</p>

<!-- Variant 1: Simple Timeline with Color Coding -->
<div class="pa-card">
    <div class="pa-card__header">
        <h3>Color-Coded Events</h3>
        <p class="pa-card__meta">Use color modifiers to categorize different event types</p>
    </div>
    <div class="pa-card__body">
        <ul class="pa-timeline pa-timeline--simple">
            <li class="pa-timeline__item pa-timeline__item--primary">
                <div class="pa-timeline__time">09:00 AM</div>
                <div class="pa-timeline__content">System startup initialized</div>
            </li>
            <li class="pa-timeline__item pa-timeline__item--success">
                <div class="pa-timeline__time">09:05 AM</div>
                <div class="pa-timeline__content">Database connection established successfully</div>
            </li>
            <li class="pa-timeline__item pa-timeline__item--info">
                <div class="pa-timeline__time">09:30 AM</div>
                <div class="pa-timeline__content">Loading user preferences and settings</div>
            </li>
            <li class="pa-timeline__item pa-timeline__item--warning">
                <div class="pa-timeline__time">01:00 PM</div>
                <div class="pa-timeline__content">High memory usage detected - 85% utilized</div>
            </li>
            <li class="pa-timeline__item pa-timeline__item--success">
                <div class="pa-timeline__time">01:30 PM</div>
                <div class="pa-timeline__content">Cache cleared successfully - memory optimized</div>
            </li>
            <li class="pa-timeline__item pa-timeline__item--primary">
                <div class="pa-timeline__time">03:30 PM</div>
                <div class="pa-timeline__content">Backup process started automatically</div>
            </li>
            <li class="pa-timeline__item pa-timeline__item--success">
                <div class="pa-timeline__time">04:30 PM</div>
                <div class="pa-timeline__content">Backup completed - 2.4GB archived</div>
            </li>
            <li class="pa-timeline__item pa-timeline__item--danger">
                <div class="pa-timeline__time">07:00 PM</div>
                <div class="pa-timeline__content">Critical error: Failed to connect to external API</div>
            </li>
            <li class="pa-timeline__item pa-timeline__item--warning">
                <div class="pa-timeline__time">07:30 PM</div>
                <div class="pa-timeline__content">Retrying connection with exponential backoff</div>
            </li>
            <li class="pa-timeline__item pa-timeline__item--success">
                <div class="pa-timeline__time">08:00 PM</div>
                <div class="pa-timeline__content">Connection restored - all systems operational</div>
            </li>
        </ul>
    </div>
</div>

