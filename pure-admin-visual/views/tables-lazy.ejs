            <h2>Tables - Lazy Load (Virtual Scrolling)</h2>
            <p>Virtual scrolling for handling large datasets efficiently. Only visible rows are rendered in the DOM, allowing smooth performance with thousands of items.</p>

            <!-- Virtual Scrolling Table -->
            <div class="pa-card">
                <div class="pa-card__header">
                    <h3>Virtual Scrolling Demo</h3>
                </div>
                <div class="pa-card__body">
                    <p>This table simulates 10,000 rows but only renders the visible ones. Scroll to see the performance.</p>

                    <!-- Table Info -->
                    <div style="margin-bottom: 1rem; padding: 0.5rem; background: var(--primary-bg); border-radius: var(--border-radius); font-size: 0.875rem;">
                        <strong>Stats:</strong>
                        <span id="total-rows">Total: 10,000 rows</span> |
                        <span id="visible-rows">Visible: 0 rows</span> |
                        <span id="scroll-position">Scroll: 0%</span>
                    </div>

                    <!-- Virtual Table Container -->
                    <div class="pa-virtual-table" id="virtualTable">
                        <div class="pa-virtual-table__header">
                            <div class="pa-virtual-table__header-cell">ID</div>
                            <div class="pa-virtual-table__header-cell">Name</div>
                            <div class="pa-virtual-table__header-cell">Email</div>
                            <div class="pa-virtual-table__header-cell">Department</div>
                            <div class="pa-virtual-table__header-cell">Salary</div>
                            <div class="pa-virtual-table__header-cell">Status</div>
                        </div>
                        <div class="pa-virtual-table__body" id="virtualTableBody">
                            <div class="pa-virtual-table__spacer-top" id="spacerTop"></div>
                            <div class="pa-virtual-table__rows" id="visibleRows"></div>
                            <div class="pa-virtual-table__spacer-bottom" id="spacerBottom"></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Simple Infinite Scroll Table -->
            <div class="pa-card">
                <div class="pa-card__header">
                    <h3>Infinite Scroll Demo</h3>
                </div>
                <div class="pa-card__body">
                    <p>Traditional infinite scroll - loads more data when you reach the bottom.</p>

                    <div class="pa-table-container" style="max-height: 400px; overflow-y: auto;" id="infiniteTable">
                        <table class="pa-table">
                            <thead>
                                <tr>
                                    <th>Order</th>
                                    <th>Customer</th>
                                    <th>Product</th>
                                    <th>Amount</th>
                                    <th>Date</th>
                                </tr>
                            </thead>
                            <tbody id="infiniteTableBody">
                                <!-- Rows will be loaded here -->
                            </tbody>
                        </table>
                        <div class="pa-load-more pa-load-more--center" id="infiniteLoader" style="margin: 1rem 0;">
                            <button class="pa-load-more__button pa-load-more__button--loading" style="display: none;" id="infiniteLoadingBtn">
                                <div class="pa-load-more__spinner"></div>
                                <span class="pa-load-more__text">Loading more...</span>
