            </div>

            <!-- Usage Guide -->
            <div class="pa-card">
                <div class="pa-card__header">
                    <h3>Implementation Guide</h3>
                </div>
                <div class="pa-card__body">
                    <h4>Virtual Scrolling</h4>
                    <ul>
                        <li><strong>Use for:</strong> Large datasets (1000+ rows) where you need instant scrolling</li>
                        <li><strong>Benefits:</strong> Constant performance regardless of dataset size</li>
                        <li><strong>Considerations:</strong> More complex implementation, fixed row heights required</li>
                    </ul>

                    <h4>Infinite Scroll</h4>
                    <ul>
                        <li><strong>Use for:</strong> Medium datasets where progressive loading makes sense</li>
                        <li><strong>Benefits:</strong> Simple implementation, good user experience</li>
                        <li><strong>Considerations:</strong> Performance degrades as more rows are loaded</li>
                    </ul>

                    <h4>Key Differences</h4>
                    <div class="pa-table-container">
                        <table class="pa-table pa-table--2x">
                            <thead>
                                <tr>
                                    <th>Feature</th>
                                    <th>Virtual Scrolling</th>
                                    <th>Infinite Scroll</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>DOM Elements</td>
                                    <td>~20-50 rows always</td>
                                    <td>Grows with loaded data</td>
                                </tr>
                                <tr>
                                    <td>Performance</td>
                                    <td>Constant</td>
                                    <td>Degrades over time</td>
                                </tr>
                                <tr>
                                    <td>Memory Usage</td>
                                    <td>Low</td>
                                    <td>Increases with data</td>
                                </tr>
                                <tr>
                                    <td>Implementation</td>
                                    <td>Complex</td>
                                    <td>Simple</td>
                                </tr>
                                <tr>
                                    <td>Best for</td>
                                    <td>10,000+ rows</td>
                                    <td>100-5,000 rows</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>


            <script>
            // Simple Virtual Scrolling Implementation (more stable)
            class VirtualTable {
                constructor(container, data) {
                    this.container = container;
                    this.data = data;
                    this.rowHeight = 32;
                    this.containerHeight = 400;
                    this.visibleCount = Math.ceil(this.containerHeight / this.rowHeight) + 2;
                    this.totalHeight = this.data.length * this.rowHeight;

                    this.spacerTop = container.querySelector('#spacerTop');
                    this.spacerBottom = container.querySelector('#spacerBottom');
                    this.rowsContainer = container.querySelector('#visibleRows');

                    // Set total height immediately
                    this.spacerBottom.style.height = `${this.totalHeight}px`;

                    // Use throttled scroll with simple timeout
                    let scrollTimeout;
                    this.container.addEventListener('scroll', () => {
                        clearTimeout(scrollTimeout);
                        scrollTimeout = setTimeout(() => this.handleScroll(), 16); // ~60fps
                    }, { passive: true });

                    this.handleScroll();
                }

                handleScroll() {
                    const scrollTop = this.container.scrollTop;
                    const startIndex = Math.floor(scrollTop / this.rowHeight);
                    const endIndex = Math.min(startIndex + this.visibleCount, this.data.length);

                    // Update spacers
                    this.spacerTop.style.height = `${startIndex * this.rowHeight}px`;
                    this.spacerBottom.style.height = `${(this.data.length - endIndex) * this.rowHeight}px`;

                    // Render visible rows
                    this.rowsContainer.innerHTML = '';
                    for (let i = startIndex; i < endIndex; i++) {
                        if (this.data[i]) {
                            this.rowsContainer.appendChild(this.createRow(this.data[i], i));
                        }
                    }

                    this.updateStats(startIndex, endIndex, scrollTop);
                }

                updateStats(startIndex, endIndex, scrollTop) {
                    const maxScroll = this.totalHeight - this.containerHeight;
                    const scrollPercent = maxScroll > 0 ? Math.round((scrollTop / maxScroll) * 100) : 0;
                    document.getElementById('visible-rows').textContent = `Visible: ${endIndex - startIndex} rows`;
                    document.getElementById('scroll-position').textContent = `Scroll: ${scrollPercent}%`;
                }

                createRow(item, index) {
                    const row = document.createElement('div');
                    row.className = 'pa-virtual-table__row';
                    row.innerHTML = `
                        <div class="pa-virtual-table__cell">${item.id}</div>
                        <div class="pa-virtual-table__cell">${item.name}</div>
                        <div class="pa-virtual-table__cell">${item.email}</div>
                        <div class="pa-virtual-table__cell">${item.department}</div>
                        <div class="pa-virtual-table__cell">$${item.salary.toLocaleString()}</div>
                        <div class="pa-virtual-table__cell"><span class="pa-badge pa-badge--${item.status === 'Active' ? 'success' : 'warning'}">${item.status}</span></div>
                    `;
                    return row;
                }
            }

            // Infinite Scroll Implementation
            class InfiniteScrollTable {
                constructor(container, tableBody, loader) {
                    this.container = container;
                    this.tableBody = tableBody;
                    this.loader = loader;
                    this.loadingBtn = loader.querySelector('#infiniteLoadingBtn');
                    this.currentPage = 0;
                    this.pageSize = 20;
                    this.isLoading = false;
                    this.hasMore = true;

                    this.container.addEventListener('scroll', this.onScroll.bind(this));
                    this.loadMore();
                }

                onScroll() {
                    if (this.isLoading || !this.hasMore) return;

                    const { scrollTop, scrollHeight, clientHeight } = this.container;
                    if (scrollTop + clientHeight >= scrollHeight - 50) {
                        this.loadMore();
                    }
                }

                async loadMore() {
                    if (this.isLoading || !this.hasMore) return;

                    this.isLoading = true;
                    this.loadingBtn.style.display = 'flex';

                    // Simulate API delay
                    await new Promise(resolve => setTimeout(resolve, 800));

                    const startIndex = this.currentPage * this.pageSize;
                    const endIndex = startIndex + this.pageSize;

                    for (let i = startIndex; i < endIndex && i < 500; i++) { // Limit to 500 total
                        const row = this.createRow({
                            id: `ORD-${(i + 1).toString().padStart(4, '0')}`,
                            customer: `Customer ${i + 1}`,
                            product: ['MacBook Pro', 'iPhone 15', 'iPad Air', 'Apple Watch', 'AirPods'][i % 5],
                            amount: (Math.random() * 2000 + 100).toFixed(2),
                            date: new Date(Date.now() - Math.random() * 90 * 24 * 60 * 60 * 1000).toLocaleDateString()
                        });
                        this.tableBody.appendChild(row);
                    }

                    this.currentPage++;
                    this.hasMore = endIndex < 500;
                    this.isLoading = false;
                    this.loadingBtn.style.display = 'none';
                }

                createRow(item) {
                    const row = document.createElement('tr');
                    row.innerHTML = `
                        <td>${item.id}</td>
                        <td>${item.customer}</td>
                        <td>${item.product}</td>
                        <td>$${item.amount}</td>
                        <td>${item.date}</td>
                    `;
                    return row;
                }
            }

            // Generate sample data for virtual table
            function generateData(count) {
                const departments = ['Engineering', 'Sales', 'Marketing', 'Support', 'HR', 'Finance'];
                const firstNames = ['John', 'Jane', 'Mike', 'Sarah', 'David', 'Lisa', 'Chris', 'Emma', 'Alex', 'Maria'];
                const lastNames = ['Smith', 'Johnson', 'Brown', 'Davis', 'Wilson', 'Miller', 'Moore', 'Taylor', 'Anderson', 'Thomas'];

                return Array.from({ length: count }, (_, i) => ({
                    id: i + 1,
                    name: `${firstNames[i % firstNames.length]} ${lastNames[i % lastNames.length]}`,
                    email: `user${i + 1}@company.com`,
                    department: departments[i % departments.length],
                    salary: Math.floor(Math.random() * 80000) + 40000,
                    status: Math.random() > 0.8 ? 'Inactive' : 'Active'
                }));
            }

            // Initialize when page loads
            document.addEventListener('DOMContentLoaded', function() {
                // Virtual scrolling table
                const virtualTableData = generateData(10000);
                const virtualTableContainer = document.getElementById('virtualTable');
                new VirtualTable(virtualTableContainer, virtualTableData);

                // Infinite scroll table
                const infiniteContainer = document.getElementById('infiniteTable');
                const infiniteTableBody = document.getElementById('infiniteTableBody');
                const infiniteLoader = document.getElementById('infiniteLoader');
                new InfiniteScrollTable(infiniteContainer, infiniteTableBody, infiniteLoader);
            });
            </script>