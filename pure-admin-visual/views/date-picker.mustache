<script>
// Future dates only demo
(function() {
  const futureOnly = document.getElementById('future-only');
  if (futureOnly) {
    const today = new Date();
    today.setHours(0, 0, 0, 0);
    const todayStr = today.toISOString().split('T')[0];
    futureOnly.setAttribute('min-date', todayStr);
  }
})();

// Custom rendering demo (holidays & events)
(function() {
  const customRender = document.getElementById('custom-rendering');
  if (customRender) {
    customRender.getDateMetadataCallback = (date) => {
      const day = date.getDate();
      const month = date.getMonth();

      // Add some example holidays and events
      if (month === 0 && day === 1) {
        return { badge: 'primary', tooltip: 'New Year\'s Day', label: 'Holiday' };
      }
      if (month === 1 && day === 14) {
        return { badge: 'danger', tooltip: 'Valentine\'s Day', label: 'Holiday' };
      }
      if (month === 6 && day === 4) {
        return { badge: 'primary', tooltip: 'Independence Day', label: 'Holiday' };
      }
      if (month === 11 && day === 25) {
        return { badge: 'success', tooltip: 'Christmas Day', label: 'Holiday' };
      }

      // Example: Team meeting every Monday
      if (date.getDay() === 1) {
        return { badge: 'warning', tooltip: 'Team Meeting at 10 AM', label: 'Meeting' };
      }

      return null;
    };
  }
})();

// Programmatic control functions
function setThisWeek() {
  const picker = document.getElementById('programmatic-demo');
  if (picker) {
    const today = new Date();
    const firstDay = new Date(today);
    firstDay.setDate(today.getDate() - today.getDay() + 1); // Monday
    const lastDay = new Date(firstDay);
    lastDay.setDate(firstDay.getDate() + 6); // Sunday

    // Note: Setting values programmatically requires accessing internal methods
    // This is a placeholder - actual implementation depends on web component API
    console.log('Set week:', firstDay, lastDay);
  }
}

function setThisMonth() {
  const picker = document.getElementById('programmatic-demo');
  if (picker) {
    const today = new Date();
    const firstDay = new Date(today.getFullYear(), today.getMonth(), 1);
    const lastDay = new Date(today.getFullYear(), today.getMonth() + 1, 0);

    console.log('Set month:', firstDay, lastDay);
  }
}

function getSelection() {
  const picker = document.getElementById('programmatic-demo');
  const output = document.getElementById('selection-output');
  if (picker && output) {
    const value = picker.value || 'No selection';
    output.innerHTML = `<strong>Current Selection:</strong><br>${value}`;
  }
}

function clearSelection() {
  const picker = document.getElementById('programmatic-demo');
  if (picker) {
    picker.value = '';
  }
}

// Events demo
(function() {
  const eventsDemo = document.getElementById('events-demo');
  const eventLog = document.getElementById('event-log-date');

  if (eventsDemo && eventLog) {
    eventsDemo.addEventListener('date-select', (e) => {
      const timestamp = new Date().toLocaleTimeString();
      const detail = e.detail || {};
      const logEntry = document.createElement('div');
      logEntry.style.marginBottom = '0.25rem';

      if (detail.date) {
        logEntry.textContent = `[${timestamp}] Selected: ${detail.date}`;
      } else if (detail.dateRange) {
        logEntry.textContent = `[${timestamp}] Range: ${detail.dateRange.start} to ${detail.dateRange.end}`;
      } else {
        logEntry.textContent = `[${timestamp}] Selection changed`;
      }

      eventLog.insertBefore(logEntry, eventLog.firstChild);

      // Keep only last 10 entries
      while (eventLog.children.length > 10) {
        eventLog.removeChild(eventLog.lastChild);
      }
    });
  }
})();
</script>
