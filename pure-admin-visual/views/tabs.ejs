                </div>
                <div class="pa-card__body">
                    <div class="pa-tabs pa-tabs--pills pa-tabs--scrollable" data-tabs-scroll>
                        <button class="pa-tabs__scroll-btn pa-tabs__scroll-btn--left" onclick="scrollTabs(this, 'left')">
                            <i class="fa-solid fa-chevron-left"></i>
                        </button>
                        <div class="pa-tabs__scroll-container">
                            <button class="pa-tabs__item pa-tabs__item--active" onclick="switchTab(this, 'scroll-pills-1')">Dashboard Overview</button>
                            <button class="pa-tabs__item" onclick="switchTab(this, 'scroll-pills-2')">Organizations Tree</button>
                            <button class="pa-tabs__item" onclick="switchTab(this, 'scroll-pills-3')">User Management System</button>
                            <button class="pa-tabs__item" onclick="switchTab(this, 'scroll-pills-4')">Reports & Analytics</button>
                            <button class="pa-tabs__item" onclick="switchTab(this, 'scroll-pills-5')">Settings & Configuration</button>
                            <button class="pa-tabs__item" onclick="switchTab(this, 'scroll-pills-6')">Security & Permissions</button>
                            <button class="pa-tabs__item" onclick="switchTab(this, 'scroll-pills-7')">Audit Logs</button>
                        </div>
                        <button class="pa-tabs__scroll-btn pa-tabs__scroll-btn--right" onclick="scrollTabs(this, 'right')">
                            <i class="fa-solid fa-chevron-right"></i>
                        </button>
                    </div>
                    <div class="pa-tabs__content">
                        <div class="pa-tabs__panel pa-tabs__panel--active" id="scroll-pills-1">
                            <p>Dashboard Overview - arrows appear when tabs overflow the container.</p>
                        </div>
                        <div class="pa-tabs__panel" id="scroll-pills-2">
                            <p>Organizations Tree content.</p>
                        </div>
                        <div class="pa-tabs__panel" id="scroll-pills-3">
                            <p>User Management content.</p>
                        </div>
                        <div class="pa-tabs__panel" id="scroll-pills-4">
                            <p>Reports content.</p>
                        </div>
                        <div class="pa-tabs__panel" id="scroll-pills-5">
                            <p>Settings content.</p>
                        </div>
                        <div class="pa-tabs__panel" id="scroll-pills-6">
                            <p>Security content.</p>
                        </div>
