<div class="pa-card">
    <div class="pa-card__header">
        <h3>Interactive Composite Badges</h3>
        <p>Examples with click handlers and dynamic behavior</p>
    </div>
    <div class="pa-card__body">
        <div class="component-showcase">
            <div class="pa-composite-badge pa-composite-badge--info" id="demo-badge-1">
                <span class="pa-composite-badge__icon">📋</span>
                <span class="pa-composite-badge__label" onclick="handleLabelClick('Task #1234')">Task #1234</span>
                <button class="pa-composite-badge__button" onclick="handleRemove('demo-badge-1')">×</button>
            </div>

            <div class="pa-composite-badge pa-composite-badge--success" id="demo-badge-2">
                <span class="pa-composite-badge__icon">👤</span>
                <span class="pa-composite-badge__label" onclick="handleLabelClick('John Doe')">John Doe</span>
                <button class="pa-composite-badge__button" onclick="handleEdit('demo-badge-2')">✎</button>
            </div>

            <div class="pa-composite-badge pa-composite-badge--warning" id="demo-badge-3">
                <span class="pa-composite-badge__icon">🏷️</span>
                <span class="pa-composite-badge__label" onclick="handleLabelClick('v2.1.0')">v2.1.0</span>
                <button class="pa-composite-badge__button" onclick="handleDownload('v2.1.0')">↓</button>
            </div>
        </div>

        <div class="pa-alert pa-alert--primary mt-4">
            <small><strong>Demo Actions:</strong> Click labels to view details, click buttons for actions. Check browser console for event logs.</small>
        </div>
    </div>
</div>

<script>
// Demo JavaScript for composite badge interactions
function handleLabelClick(label) {
    console.log('Label clicked:', label);
    alert(`Viewing details for: ${label}`);
}

function handleRemove(badgeId) {
    console.log('Remove clicked for:', badgeId);
    if (confirm('Remove this item?')) {
        document.getElementById(badgeId).style.opacity = '0.5';
        document.getElementById(badgeId).style.pointerEvents = 'none';
    }
}

function handleEdit(badgeId) {
    console.log('Edit clicked for:', badgeId);
    alert('Opening edit dialog...');
}

function handleDownload(version) {
    console.log('Download clicked for:', version);
    alert(`Downloading ${version}...`);
}
</script>