                        <div class="pa-stat__label">Orders</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="pure-u-1 pure-u-md-1-2 pure-u-lg-1-4">
        <div class="pa-card pa-card--stat">
            <div class="pa-card__body">
                <div class="pa-stat">
                    <div class="pa-stat__icon pa-stat__icon--info">📈</div>
                    <div class="pa-stat__content">
                        <div class="pa-stat__number">+12%</div>
                        <div class="pa-stat__label">Growth</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>