<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{#pageTitle}}{{pageTitle}}{{/pageTitle}}{{^pageTitle}}Dashboard{{/pageTitle}} - Pure Admin Visual</title>
    <!-- Critical CSS: Loader (inline to prevent FOUC) -->
    <style>
        .page-loader {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: var(--page-loader-bg, rgba(26, 26, 26, 0.95));
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 99999;
            transition: opacity 0.15s ease, visibility 0.15s ease;
        }
        .page-loader.loaded {
            opacity: 0;
            visibility: hidden;
        }
        .page-loader__spinner {
            width: 50px;
            height: 50px;
            border: 4px solid var(--page-loader-spinner-border, #333);
            border-top-color: var(--page-loader-spinner-accent, #0066cc);
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
        }
        @keyframes spin {
            to { transform: rotate(360deg); }
        }
    </style>
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <!-- Preload critical fonts for Audi theme (latin subset) -->
    {{#isAudiTheme}}
    <link rel="preload" href="/fonts/google/wEOhEADFm8hSaQTFG18FErVhsC9x-tarUfbtrQ.woff2" as="font" type="font/woff2" crossorigin>
    {{/isAudiTheme}}
    <!-- SCSS VARIABLE THEME: Dynamic theme loading -->
    <link rel="stylesheet" href="/dist/css/themes/{{currentTheme}}.css">
    <!-- Floating UI for tooltips and popovers -->
    <script src="https://cdn.jsdelivr.net/npm/@floating-ui/core@1.7.3"></script>
    <script src="https://cdn.jsdelivr.net/npm/@floating-ui/dom@1.7.4"></script>
    <!-- D3.js for charts -->
    <script src="https://d3js.org/d3.v7.min.js"></script>
    <!-- Command Palette -->
    <script src="/dist/js/command-palette.js"></script>
    <!-- Analytics -->
    <script defer data-domain="pure-admin.keenmate.dev" src="https://stats.keenmate.services/js/plausible.js"></script>
</head>
<body>
    <!-- Page Loader: Shows while fonts/CSS load -->
    <div class="page-loader" id="pageLoader">
        <div class="page-loader__spinner"></div>
    </div>

    <!-- Hide loader when fonts are ready -->
    <script>
        (function() {
            const loader = document.getElementById('pageLoader');

            // Hide loader AFTER fonts are fully loaded
            if (document.fonts && document.fonts.ready) {
                Promise.race([
                    document.fonts.ready,
                    new Promise(resolve => setTimeout(resolve, 1000)) // 1s timeout fallback
                ]).then(() => {
                    requestAnimationFrame(() => {
                        loader.classList.add('loaded');
                        // Remove from DOM after transition
                        setTimeout(() => loader.remove(), 80);
                    });
                });
            } else {
                // Fallback for browsers without Font Loading API
                window.addEventListener('load', () => {
                    loader.classList.add('loaded');
                    setTimeout(() => loader.remove(), 80);
                });
            }
        })();
    </script>

    <!-- Prevent FOUC: Apply saved settings immediately before rendering -->
    <script>
        (function() {
            // Apply sidebar behavior immediately
            const sidebarBehavior = localStorage.getItem('sidebar-behavior') || 'hide';
            const sidebarHidden = localStorage.getItem('sidebar-hidden') === 'true';
            const isMobile = window.innerWidth <= 768;

            // Apply sidebar-hidden state (works for both 'hide' and 'icon-collapse' behaviors)
            if (!isMobile && sidebarHidden) {
                document.body.classList.add('sidebar-hidden');
            }

            // Apply compact mode immediately
            const isCompactMode = localStorage.getItem('compact-mode') === 'true';
            if (isCompactMode) {
                document.body.classList.add('compact-mode');
            }

            // Apply font size immediately to prevent size jump
            const savedFontSize = localStorage.getItem('font-size') || 'default';
            if (savedFontSize !== 'default') {
                document.documentElement.classList.add(`font-size-${savedFontSize}`);
            }

            // Apply sidebar mode to body immediately
            const sidebarMode = '{{sidebarMode}}';
            if (sidebarMode === 'sticky') {
                document.body.classList.add('pa-layout--sticky');
            }

            // Apply container width to body immediately
            const containerWidth = '{{containerWidth}}';
            if (containerWidth && containerWidth !== 'fluid') {
                document.body.classList.add(`pa-container-${containerWidth}`);
            }
        })();
    </script>

    <!-- Set burger menu state immediately to prevent FOUC -->
    <script>
        (function() {
            const sidebarHidden = localStorage.getItem('sidebar-hidden') === 'true';
            const isMobile = window.innerWidth <= 768;

            if (!isMobile && sidebarHidden) {
                const burgerMenu = document.querySelector('.burger-menu');
                if (burgerMenu) {
                    burgerMenu.classList.add('active');
                }
            }
        })();
    </script>

    <!-- Navbar (outside layout container) -->
    {{{partials.navbar}}}

    <!-- Layout Container (below navbar) -->
    <div class="pa-layout" id="layoutContainer">
        <!-- Layout Inner: Sidebar + Content -->
        <div class="pa-layout__inner">
            {{{partials.sidebar}}}

            <!-- Restore submenu states immediately to prevent FOUC -->
            <script>
                (function() {
                    document.querySelectorAll('.pa-sidebar__toggle').forEach(button => {
                        const label = button.querySelector('.pa-sidebar__label');
                        if (!label) return;

                        const submenuId = label.textContent.toLowerCase().replace(/\s+/g, '-');
                        const savedState = localStorage.getItem(`submenu-${submenuId}`);

                        if (savedState === 'open') {
                            const parentItem = button.closest('.pa-sidebar__item');
                            const submenu = parentItem.querySelector('.pa-sidebar__submenu');
                            if (submenu) {
                                parentItem.classList.add('pa-sidebar__item--open');
                                submenu.classList.add('pa-sidebar__submenu--open');
                            }
                        }
                    });
                })();
            </script>

            <!-- Layout Content: Main + Footer -->
            <div class="pa-layout__content">
                <!-- Main Content -->
                <main class="pa-layout__main">
                    <div class="pa-layout__main__inner">
                        {{{body}}}
                    </div>
                </main>

                <!-- Footer -->
                <footer class="pa-layout__footer">
                    <div class="pa-layout__footer__content">
                        <p>&copy; 2024 Pure Admin Visual Framework</p>
                    </div>
                </footer>
            </div>
        </div>
    </div><!-- /.pa-layout -->

    <!-- Command Palette -->
    <div class="pa-command-palette" id="commandPalette">
        <div class="pa-command-palette__backdrop" id="commandPaletteBackdrop"></div>
        <div class="pa-command-palette__container">
            <div class="pa-command-palette__search">
                <input
                    type="text"
                    class="pa-command-palette__input"
                    id="commandPaletteInput"
                    placeholder="Search products, orders, users... (try /p, /o, /u)"
                    autocomplete="off"
                    spellcheck="false"
                >
                <div class="pa-command-palette__context" id="commandPaletteContext"></div>
            </div>
            <div class="pa-command-palette__results" id="commandPaletteResults">
                <div class="pa-command-palette__empty">Type to search or use /p for products, /o for orders, /u for users, /i for invoices</div>
            </div>
            <div class="pa-command-palette__footer">
                <div class="pa-command-palette__hint">
                    <span class="pa-command-palette__key">↑↓</span>
                    <span>Navigate</span>
                </div>
                <div class="pa-command-palette__hint">
                    <span class="pa-command-palette__key">←→</span>
                    <span>Pages</span>
                </div>
                <div class="pa-command-palette__hint">
                    <span class="pa-command-palette__key">↵</span>
                    <span>Select</span>
                </div>
                <div class="pa-command-palette__hint">
                    <span class="pa-command-palette__key">Esc</span>
                    <span>Close</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Floating Settings Panel -->
    <div class="pa-settings-panel" id="settingsPanel">
        <button class="pa-settings-panel__toggle" id="settingsToggle" title="Settings">
            ⚙
        </button>

        <div class="pa-settings-panel__content">
            <h3 class="pa-settings-panel__title">Settings</h3>

            <!-- Theme Selector -->
            <div class="pa-settings-panel__section">
                <label class="pa-settings-panel__label">Theme</label>
                <select class="pa-settings-panel__select" id="themeSelector">
                    <option value="audi">Audi</option>
                    <option value="audi-light">Audi Light</option>
                    <option value="corporate">Corporate</option>
                    <option value="express">Express</option>
                    <option value="dark">Dark</option>
                    <option value="dark-blue">Dark Blue</option>
                    <option value="dark-green">Dark Green</option>
                    <option value="dark-red">Dark Red</option>
                    <option value="minimal">Minimal</option>
                </select>
            </div>

            <!-- Layout Width -->
            <div class="pa-settings-panel__section">
                <label class="pa-settings-panel__label">Layout Width</label>
                <select class="pa-settings-panel__select" id="containerWidthSelector">
                    <option value="fluid">Fluid (Full Width)</option>
                    <option value="sm">Small (768px)</option>
                    <option value="md">Medium (1024px)</option>
                    <option value="lg">Large (1280px)</option>
                    <option value="xl">Extra Large (1600px)</option>
                    <option value="2xl">2X Large (1920px)</option>
                </select>
            </div>

            <!-- Sidebar Mode -->
            <div class="pa-settings-panel__section">
                <label class="pa-settings-panel__label">Sidebar Mode</label>
                <select class="pa-settings-panel__select" id="sidebarModeSelector">
                    <option value="">Scrolls with Content</option>
                    <option value="sticky">Fixed Position</option>
                </select>
            </div>

            <!-- Sidebar Behavior -->
            <div class="pa-settings-panel__section">
                <label class="pa-settings-panel__label">Sidebar Behavior</label>
                <select class="pa-settings-panel__select" id="sidebarBehaviorSelector">
                    <option value="hide">Hide Completely</option>
                    <option value="icon-collapse">Show Icons Only</option>
                </select>
            </div>

            <!-- Sidebar Position -->
            <div class="pa-settings-panel__section">
                <label class="pa-settings-panel__label">Sidebar</label>
                <div class="pa-settings-panel__checkbox-group">
                    <label class="pa-settings-panel__checkbox">
                        <input type="checkbox" id="sidebarCollapsed">
                        <span>Collapsed</span>
                    </label>
                </div>
            </div>

            <!-- Compact Mode -->
            <div class="pa-settings-panel__section">
                <label class="pa-settings-panel__label">Display</label>
                <div class="pa-settings-panel__checkbox-group">
                    <label class="pa-settings-panel__checkbox">
                        <input type="checkbox" id="compactMode">
                        <span>Compact Mode</span>
                    </label>
                </div>
            </div>

            <!-- Font Size -->
            <div class="pa-settings-panel__section">
                <label class="pa-settings-panel__label">Font Size</label>
                <select class="pa-settings-panel__select" id="fontSizeSelector">
                    <option value="small">Small (14px)</option>
                    <option value="default">Default (16px)</option>
                    <option value="large">Large (18px)</option>
                    <option value="xlarge">Extra Large (20px)</option>
                </select>
            </div>

            <!-- Font Family -->
            <div class="pa-settings-panel__section">
                <label class="pa-settings-panel__label">Font Family</label>
                <select class="pa-settings-panel__select" id="fontFamilySelector">
                    <option value="default">Theme Default</option>
                    <option value="serif">Serif</option>
                    <option value="mono">Monospace</option>
                    <option value="delivery">Delivery</option>
                    <option value="cuprum">Cuprum</option>
                    <option value="fira-sans-condensed">Fira Sans Condensed</option>
                    <option value="manrope">Manrope</option>
                    <option value="martel">Martel</option>
                    <option value="maven-pro">Maven Pro</option>
                    <option value="monda">Monda</option>
                    <option value="play">Play</option>
                    <option value="signika">Signika</option>
                    <option value="yanone-kaffeesatz">Yanone Kaffeesatz</option>
                </select>
            </div>

            <!-- Reset Button -->
            <div class="pa-settings-panel__section">
                <button class="pa-btn pa-btn--secondary pa-btn--block" id="resetSettings">
                    Reset to Defaults
                </button>
            </div>
        </div>
    </div>

    <!-- User Profile Panel -->
    <div class="pa-profile-panel" id="profilePanel">
        <div class="pa-profile-panel__overlay" onclick="closeProfilePanel()"></div>
        <div class="pa-profile-panel__content">
            <div class="pa-profile-panel__header">
                <div class="pa-profile-panel__avatar">
                    <span class="pa-profile-panel__avatar-icon">👤</span>
                </div>
                <div class="pa-profile-panel__info">
                    <h3 class="pa-profile-panel__name">John Doe</h3>
                    <p class="pa-profile-panel__email">john.doe@company.com</p>
                    <span class="pa-profile-panel__role">Administrator</span>
                </div>
                <button class="pa-profile-panel__close" onclick="closeProfilePanel()" aria-label="Close Profile">
                    ✕
                </button>
            </div>

            <div class="pa-profile-panel__body">
                <nav class="pa-profile-panel__nav">
                    <ul>
                        <li><a href="#" class="pa-profile-panel__nav-item">
                            <span class="pa-profile-panel__nav-icon">👤</span>
                            Profile Settings
                        </a></li>
                        <li><a href="#" class="pa-profile-panel__nav-item">
                            <span class="pa-profile-panel__nav-icon">🔒</span>
                            Security
                        </a></li>
                        <li><a href="#" class="pa-profile-panel__nav-item">
                            <span class="pa-profile-panel__nav-icon">🔔</span>
                            Notifications
                        </a></li>
                        <li><a href="#" class="pa-profile-panel__nav-item">
                            <span class="pa-profile-panel__nav-icon">⚙️</span>
                            Preferences
                        </a></li>
                        <li><a href="#" class="pa-profile-panel__nav-item">
                            <span class="pa-profile-panel__nav-icon">❓</span>
                            Help & Support
                        </a></li>
                    </ul>
                </nav>

                <div class="pa-profile-panel__actions">
                    <button class="pa-btn pa-btn--secondary pa-btn--block">
                        Switch Account
                    </button>
                    <button class="pa-btn pa-btn--danger pa-btn--block">
                        Sign Out
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Toast Containers (Global - one for each position) -->
    <div id="toast-container-top-right" class="pa-toast-container pa-toast-container--top-right"></div>
    <div id="toast-container-top-center" class="pa-toast-container pa-toast-container--top-center"></div>
    <div id="toast-container-top-left" class="pa-toast-container pa-toast-container--top-left"></div>
    <div id="toast-container-bottom-right" class="pa-toast-container pa-toast-container--bottom-right"></div>
    <div id="toast-container-bottom-center" class="pa-toast-container pa-toast-container--bottom-center"></div>
    <div id="toast-container-bottom-left" class="pa-toast-container pa-toast-container--bottom-left"></div>

    <script>
        function switchTheme(theme) {
            // Redirect to current page with theme parameter
            const url = new URL(window.location);
            url.searchParams.set('theme', theme);
            window.location.href = url.toString();
        }

        function switchSidebarMode(mode) {
            // Redirect to current page with sidebar mode parameter
            const url = new URL(window.location);
            url.searchParams.set('sidebarMode', mode);
            window.location.href = url.toString();
        }

        function toggleSidebar() {
            const body = document.body;
            const burgerMenu = document.querySelector('.burger-menu');
            const sidebar = document.querySelector('.pa-layout__sidebar');
            const isMobile = window.innerWidth <= 768;
            const sidebarBehavior = localStorage.getItem('sidebar-behavior') || 'hide';

            if (isMobile) {
                // Mobile: Toggle sidebar visibility but don't persist state
                body.classList.toggle('sidebar-visible');
                burgerMenu.classList.toggle('active');
            } else {
                // Desktop: Check sidebar behavior mode
                if (sidebarBehavior === 'icon-collapse') {
                    // Icon-collapse mode: toggle between icon bar and full width
                    const isExpanded = !body.classList.contains('sidebar-hidden');

                    if (isExpanded) {
                        // Currently expanded, collapse to icons
                        body.classList.add('sidebar-hidden');
                        burgerMenu.classList.remove('active');
                    } else {
                        // Currently showing icons, expand to full width
                        body.classList.remove('sidebar-hidden');
                        burgerMenu.classList.add('active');
                    }
                    localStorage.setItem('sidebar-hidden', body.classList.contains('sidebar-hidden'));
                } else {
                    // Normal hide mode: toggle visibility completely
                    const isHidden = body.classList.contains('sidebar-hidden');

                    if (isHidden) {
                        // Currently hidden, show it
                        body.classList.remove('sidebar-hidden');
                        burgerMenu.classList.add('active');
                    } else {
                        // Currently visible, hide it
                        body.classList.add('sidebar-hidden');
                        burgerMenu.classList.remove('active');
                    }
                    localStorage.setItem('sidebar-hidden', body.classList.contains('sidebar-hidden'));
                }
            }
        }

        function checkMobileLayout() {
            const body = document.body;
            const isMobile = window.innerWidth <= 768;

            if (isMobile) {
                // Mobile: Always start with sidebar hidden (not visible)
                body.classList.remove('sidebar-hidden');
                body.classList.remove('sidebar-visible');
                document.querySelector('.burger-menu').classList.remove('active');
            } else {
                // Desktop: Use saved state (works for both 'hide' and 'icon-collapse' behaviors)
                body.classList.remove('sidebar-visible');
                const sidebarHidden = localStorage.getItem('sidebar-hidden') === 'true';
                const burgerMenu = document.querySelector('.burger-menu');

                if (sidebarHidden) {
                    // Collapsed/Hidden state
                    body.classList.add('sidebar-hidden');
                    if (burgerMenu) burgerMenu.classList.remove('active'); // Show hamburger
                } else {
                    // Expanded/Visible state
                    body.classList.remove('sidebar-hidden');
                    if (burgerMenu) burgerMenu.classList.add('active'); // Show X
                }
            }
        }

        function closeMobileSidebar(event) {
            const body = document.body;
            if (body.classList.contains('sidebar-visible') && event.target === body) {
                body.classList.remove('sidebar-visible');
                document.querySelector('.burger-menu').classList.remove('active');
                // No need to save mobile sidebar state - always starts hidden on page load
            }
        }

        document.addEventListener('DOMContentLoaded', function() {
            // Set data-theme attribute for any remaining [data-theme] selectors
            const currentTheme = '{{currentTheme}}';
            document.body.setAttribute('data-theme', currentTheme);

            // Add loaded class after a short delay to prevent FOUC transitions
            setTimeout(() => {
                document.body.classList.add('loaded');
            }, 50);

            checkMobileLayout();
            window.addEventListener('resize', checkMobileLayout);
            document.body.addEventListener('click', closeMobileSidebar);

            // Settings Panel Functionality
            const settingsPanel = document.getElementById('settingsPanel');
            const settingsToggle = document.getElementById('settingsToggle');
            const themeSelector = document.getElementById('themeSelector');
            const fontSizeSelector = document.getElementById('fontSizeSelector');
            const fontFamilySelector = document.getElementById('fontFamilySelector');
            const sidebarCollapsed = document.getElementById('sidebarCollapsed');
            const sidebarBehaviorSelector = document.getElementById('sidebarBehaviorSelector');
            const sidebarModeSelector = document.getElementById('sidebarModeSelector');
            const compactMode = document.getElementById('compactMode');
            const containerWidthSelector = document.getElementById('containerWidthSelector');
            const resetSettings = document.getElementById('resetSettings');
            const body = document.body;

            // Load saved settings
            const loadSettings = () => {
                // Theme - use server-provided currentTheme
                const currentTheme = '{{currentTheme}}';
                themeSelector.value = currentTheme;
                body.setAttribute('data-theme', currentTheme);

                // Font size
                const savedFontSize = localStorage.getItem('font-size') || 'default';
                fontSizeSelector.value = savedFontSize;
                document.documentElement.classList.remove('font-size-small', 'font-size-default', 'font-size-large', 'font-size-xlarge');
                if (savedFontSize !== 'default') {
                    document.documentElement.classList.add(`font-size-${savedFontSize}`);
                }

                // Font family
                const savedFontFamily = localStorage.getItem('font-family') || 'default';
                fontFamilySelector.value = savedFontFamily;
                body.classList.remove('font-family-serif', 'font-family-mono');
                if (savedFontFamily !== 'default') {
                    body.classList.add(`font-family-${savedFontFamily}`);
                }

                // Sidebar collapsed
                const isSidebarCollapsed = localStorage.getItem('sidebar-hidden') === 'true';
                sidebarCollapsed.checked = isSidebarCollapsed;

                // Sidebar behavior
                const sidebarBehavior = localStorage.getItem('sidebar-behavior') || 'hide';
                sidebarBehaviorSelector.value = sidebarBehavior;
                const sidebar = document.querySelector('.pa-layout__sidebar');
                const burgerMenu = document.querySelector('.burger-menu');
                if (sidebar) {
                    sidebar.classList.remove('pa-layout__sidebar--icon-collapse');
                    if (sidebarBehavior === 'icon-collapse') {
                        sidebar.classList.add('pa-layout__sidebar--icon-collapse');
                        // In icon-collapse mode, check if expanded or collapsed
                        const isExpanded = !body.classList.contains('sidebar-hidden');
                        if (burgerMenu) {
                            if (isExpanded) {
                                burgerMenu.classList.add('active'); // Expanded, show X
                            } else {
                                burgerMenu.classList.remove('active'); // Collapsed to icons, show hamburger
                            }
                        }
                    } else {
                        // In hide mode, burger active = sidebar visible
                        if (burgerMenu) {
                            if (body.classList.contains('sidebar-hidden')) {
                                burgerMenu.classList.remove('active'); // Hidden, show hamburger
                            } else {
                                burgerMenu.classList.add('active'); // Visible, show X
                            }
                        }
                    }
                }

                // Compact mode
                const isCompactMode = localStorage.getItem('compact-mode') === 'true';
                compactMode.checked = isCompactMode;
                if (isCompactMode) {
                    body.classList.add('compact-mode');
                }

                // Container width - use server-provided containerWidth
                const currentContainerWidth = '{{containerWidth}}';
                containerWidthSelector.value = currentContainerWidth;

                // Sidebar mode - use server-provided sidebarMode
                const currentSidebarMode = '{{sidebarMode}}';
                sidebarModeSelector.value = currentSidebarMode;
            };

            // Toggle panel
            settingsToggle.addEventListener('click', () => {
                settingsPanel.classList.toggle('pa-settings-panel--open');
            });

            // Close panel when clicking outside
            document.addEventListener('click', (e) => {
                if (!settingsPanel.contains(e.target) && settingsPanel.classList.contains('pa-settings-panel--open')) {
                    settingsPanel.classList.remove('pa-settings-panel--open');
                }
            });

            // Theme change
            themeSelector.addEventListener('change', (e) => {
                const theme = e.target.value;
                switchTheme(theme);
            });

            // Font size change
            fontSizeSelector.addEventListener('change', (e) => {
                const size = e.target.value;
                document.documentElement.classList.remove('font-size-small', 'font-size-default', 'font-size-large', 'font-size-xlarge');
                if (size !== 'default') {
                    document.documentElement.classList.add(`font-size-${size}`);
                }
                localStorage.setItem('font-size', size);
            });

            // Font family change
            fontFamilySelector.addEventListener('change', (e) => {
                const family = e.target.value;
                body.classList.remove('font-family-serif', 'font-family-mono');
                if (family !== 'default') {
                    body.classList.add(`font-family-${family}`);
                }
                localStorage.setItem('font-family', family);
            });

            // Sidebar toggle
            sidebarCollapsed.addEventListener('change', (e) => {
                toggleSidebar();
            });

            // Compact mode toggle
            compactMode.addEventListener('change', (e) => {
                if (e.target.checked) {
                    body.classList.add('compact-mode');
                    localStorage.setItem('compact-mode', 'true');
                } else {
                    body.classList.remove('compact-mode');
                    localStorage.setItem('compact-mode', 'false');
                }
            });

            // Container width change - reload page with query param to set cookie
            containerWidthSelector.addEventListener('change', (e) => {
                const width = e.target.value;
                const url = new URL(window.location);
                url.searchParams.set('containerWidth', width);
                window.location.href = url.toString();
            });

            // Sidebar mode change
            sidebarModeSelector.addEventListener('change', (e) => {
                const mode = e.target.value;
                switchSidebarMode(mode);
            });

            // Sidebar behavior change
            sidebarBehaviorSelector.addEventListener('change', (e) => {
                const behavior = e.target.value;
                const sidebar = document.querySelector('.pa-layout__sidebar');
                const burgerMenu = document.querySelector('.burger-menu');

                if (sidebar) {
                    sidebar.classList.remove('pa-layout__sidebar--icon-collapse');
                    document.body.classList.remove('sidebar-hidden');

                    if (behavior === 'icon-collapse') {
                        // Show icon-only sidebar in collapsed state
                        sidebar.classList.add('pa-layout__sidebar--icon-collapse');
                        // Start in collapsed state (icon bar showing)
                        if (burgerMenu) burgerMenu.classList.remove('active'); // Not expanded, show hamburger
                        localStorage.setItem('sidebar-hidden', 'false'); // Not fully hidden, just in icon mode
                    } else if (behavior === 'hide') {
                        // Hide sidebar completely
                        document.body.classList.add('sidebar-hidden');
                        if (burgerMenu) burgerMenu.classList.remove('active'); // Hidden, show hamburger to open
                        localStorage.setItem('sidebar-hidden', 'true');
                    } else {
                        // Default behavior - show full sidebar
                        if (burgerMenu) burgerMenu.classList.add('active'); // Visible, show X to close
                        localStorage.setItem('sidebar-hidden', 'false');
                    }

                    localStorage.setItem('sidebar-behavior', behavior);
                }
            });

            // Reset settings
            resetSettings.addEventListener('click', () => {
                // Clear localStorage settings
                localStorage.removeItem('font-size');
                localStorage.removeItem('font-family');
                localStorage.removeItem('sidebar-hidden');
                localStorage.removeItem('sidebar-behavior');
                localStorage.removeItem('compact-mode');

                // Reset theme, container width, and sidebar mode to defaults
                const url = new URL(window.location);
                url.searchParams.set('theme', 'audi');
                url.searchParams.set('containerWidth', 'fluid');
                url.searchParams.set('sidebarMode', '');
                window.location.href = url.toString();
            });

            // Load settings on init
            loadSettings();
        });

        // Profile Panel Functions
        function toggleProfilePanel() {
            const profilePanel = document.getElementById('profilePanel');
            profilePanel.classList.toggle('pa-profile-panel--open');
        }

        function closeProfilePanel() {
            const profilePanel = document.getElementById('profilePanel');
            profilePanel.classList.remove('pa-profile-panel--open');
        }

        // Close profile panel when clicking outside
        document.addEventListener('click', (e) => {
            const profilePanel = document.getElementById('profilePanel');
            const profileBtn = document.querySelector('.pa-header__profile-btn');

            if (!profilePanel.contains(e.target) && !profileBtn.contains(e.target) &&
                profilePanel.classList.contains('pa-profile-panel--open')) {
                closeProfilePanel();
            }
        });

        // Sidebar Submenu Functions - No accordion behavior for multilevel support
        function toggleSubmenu(button) {
            const parentItem = button.closest('.pa-sidebar__item');
            const submenu = parentItem.querySelector('.pa-sidebar__submenu');

            if (!submenu) return;

            const isOpen = parentItem.classList.contains('pa-sidebar__item--open');

            // Simply toggle current submenu without closing others
            if (isOpen) {
                parentItem.classList.remove('pa-sidebar__item--open');
                submenu.classList.remove('pa-sidebar__submenu--open');
            } else {
                parentItem.classList.add('pa-sidebar__item--open');
                submenu.classList.add('pa-sidebar__submenu--open');
            }

            // Save state to localStorage
            const submenuId = button.querySelector('.pa-sidebar__label').textContent.toLowerCase().replace(/\s+/g, '-');
            localStorage.setItem(`submenu-${submenuId}`, !isOpen ? 'open' : 'closed');
        }

        // Clear all submenu states (for debugging)
        function clearAllSubmenuStates() {
            // Clear localStorage
            Object.keys(localStorage).forEach(key => {
                if (key.startsWith('submenu-')) {
                    localStorage.removeItem(key);
                }
            });

            // Close all open submenus
            document.querySelectorAll('.pa-sidebar__item--open').forEach(item => {
                item.classList.remove('pa-sidebar__item--open');
            });
            document.querySelectorAll('.pa-sidebar__submenu--open').forEach(submenu => {
                submenu.classList.remove('pa-sidebar__submenu--open');
            });

            console.log('All submenu states cleared');
        }

        // Note: Submenu state restoration is now handled by inline script right after sidebar HTML
        // to prevent FOUC. No need to restore states again on DOMContentLoaded.

        // Popover Functions
        document.addEventListener('DOMContentLoaded', function() {
            // Toggle popover
            document.querySelectorAll('.pa-popover__trigger').forEach(trigger => {
                trigger.addEventListener('click', function(e) {
                    e.stopPropagation();
                    const popover = this.closest('.pa-popover');
                    const isOpen = popover.classList.contains('pa-popover--open');

                    // Close all other popovers
                    document.querySelectorAll('.pa-popover--open').forEach(p => {
                        if (p !== popover) {
                            p.classList.remove('pa-popover--open');
                        }
                    });

                    // Toggle current popover
                    popover.classList.toggle('pa-popover--open');
                });
            });

            // Close popover with close button
            document.querySelectorAll('.pa-popover__close').forEach(closeBtn => {
                closeBtn.addEventListener('click', function(e) {
                    e.stopPropagation();
                    const popover = this.closest('.pa-popover');
                    popover.classList.remove('pa-popover--open');
                });
            });

            // Close popovers when clicking outside
            document.addEventListener('click', function(e) {
                if (!e.target.closest('.pa-popover')) {
                    document.querySelectorAll('.pa-popover--open').forEach(popover => {
                        popover.classList.remove('pa-popover--open');
                    });
                }
            });

            // Prevent closing when clicking inside popover content
            document.querySelectorAll('.pa-popover__content').forEach(content => {
                content.addEventListener('click', function(e) {
                    e.stopPropagation();
                });
            });

            // Smart positioning for popovers - collision detection
            function adjustPopoverPosition(popover) {
                const content = popover.querySelector('.pa-popover__content');
                if (!content) return;

                // Remove previous adjustments
                popover.classList.remove('pa-popover--shift-left', 'pa-popover--shift-right',
                    'pa-popover--auto-flip-top', 'pa-popover--auto-flip-bottom',
                    'pa-popover--auto-flip-left', 'pa-popover--auto-flip-right');

                // Get original position classes
                const isBottom = popover.classList.contains('pa-popover--bottom');
                const isLeft = popover.classList.contains('pa-popover--left');
                const isRight = popover.classList.contains('pa-popover--right');
                const isTop = !isBottom && !isLeft && !isRight; // Default is top

                // Wait for next frame to ensure content is visible for measurement
                requestAnimationFrame(() => {
                    const rect = content.getBoundingClientRect();
                    const triggerRect = popover.getBoundingClientRect();
                    const viewport = {
                        width: window.innerWidth,
                        height: window.innerHeight
                    };
                    const margin = 10; // Safety margin from viewport edges

                    // Check vertical overflow for top/bottom positions
                    if (isTop || isBottom) {
                        // Check horizontal overflow
                        if (rect.left < margin) {
                            popover.classList.add('pa-popover--shift-right');
                        } else if (rect.right > viewport.width - margin) {
                            popover.classList.add('pa-popover--shift-left');
                        }

                        // Check vertical flip
                        if (isTop && rect.top < margin) {
                            popover.classList.add('pa-popover--auto-flip-bottom');
                        } else if (isBottom && rect.bottom > viewport.height - margin) {
                            popover.classList.add('pa-popover--auto-flip-top');
                        }
                    }

                    // Check horizontal overflow for left/right positions
                    if (isLeft || isRight) {
                        // Check if needs flip
                        if (isLeft && rect.left < margin) {
                            popover.classList.add('pa-popover--auto-flip-right');
                        } else if (isRight && rect.right > viewport.width - margin) {
                            popover.classList.add('pa-popover--auto-flip-left');
                        }
                    }
                });
            }

            // Apply smart positioning when popover opens
            const originalPopoverToggle = document.querySelectorAll('.pa-popover__trigger');
            originalPopoverToggle.forEach(trigger => {
                trigger.addEventListener('click', function() {
                    const popover = this.closest('.pa-popover');
                    if (popover.classList.contains('pa-popover--open')) {
                        adjustPopoverPosition(popover);
                    }
                });
            });

            // Floating UI Tooltip System
            (function() {
                let tooltipEl = null;
                let currentReference = null;
                let cleanupFn = null;

                // Create tooltip element
                function createTooltip() {
                    if (tooltipEl) return;

                    tooltipEl = document.createElement('div');
                    tooltipEl.className = 'pa-tooltip-floating';
                    tooltipEl.style.position = 'absolute';
                    tooltipEl.style.top = '0';
                    tooltipEl.style.left = '0';
                    tooltipEl.style.visibility = 'hidden';
                    tooltipEl.style.zIndex = '9000';
                    document.body.appendChild(tooltipEl);
                }

                // Show tooltip
                async function showTooltip(element) {
                    if (!tooltipEl) createTooltip();
                    if (currentReference === element) return;

                    // Get tooltip text from data-tooltip attribute
                    const text = element.dataset.tooltip || element.getAttribute('aria-label') || '';
                    if (!text) return;

                    // Determine placement from classes
                    let placement = 'top';
                    if (element.classList.contains('pa-tooltip--bottom')) placement = 'bottom';
                    else if (element.classList.contains('pa-tooltip--left')) placement = 'left';
                    else if (element.classList.contains('pa-tooltip--right')) placement = 'right';

                    // Copy variant classes to floating tooltip
                    tooltipEl.className = 'pa-tooltip-floating';
                    if (element.classList.contains('pa-tooltip--primary')) tooltipEl.classList.add('pa-tooltip--primary');
                    if (element.classList.contains('pa-tooltip--success')) tooltipEl.classList.add('pa-tooltip--success');
                    if (element.classList.contains('pa-tooltip--warning')) tooltipEl.classList.add('pa-tooltip--warning');
                    if (element.classList.contains('pa-tooltip--danger')) tooltipEl.classList.add('pa-tooltip--danger');
                    if (element.classList.contains('pa-tooltip--multiline')) tooltipEl.classList.add('pa-tooltip--multiline');

                    // Set content and make visible
                    tooltipEl.textContent = text;
                    tooltipEl.style.visibility = 'visible';
                    currentReference = element;

                    // Use Floating UI to position tooltip
                    const { computePosition, flip, shift, offset } = window.FloatingUIDOM;

                    const { x, y } = await computePosition(element, tooltipEl, {
                        placement: placement,
                        middleware: [
                            offset(8),
                            flip(),
                            shift({ padding: 5 })
                        ]
                    });

                    Object.assign(tooltipEl.style, {
                        left: `${x}px`,
                        top: `${y}px`
                    });
                }

                // Hide tooltip
                function hideTooltip() {
                    if (!tooltipEl) return;
                    tooltipEl.style.visibility = 'hidden';
                    currentReference = null;
                }

                // Initialize tooltips
                function initTooltips() {
                    createTooltip();

                    document.querySelectorAll('[class*="pa-tooltip"]').forEach(element => {
                        // Skip if already initialized
                        if (element.dataset.tooltipInit) return;
                        element.dataset.tooltipInit = 'true';

                        // Store tooltip text in data attribute if it's in aria-label
                        if (!element.dataset.tooltip && element.getAttribute('aria-label')) {
                            element.dataset.tooltip = element.getAttribute('aria-label');
                        }

                        element.addEventListener('mouseenter', () => showTooltip(element));
                        element.addEventListener('mouseleave', hideTooltip);
                        element.addEventListener('focus', () => showTooltip(element));
                        element.addEventListener('blur', hideTooltip);
                    });
                }

                // Initialize on DOM ready
                initTooltips();

                // Re-initialize after dynamic content loads
                window.addEventListener('content-loaded', initTooltips);
            })();

            // Recalculate positions on window resize
            let resizeTimer;
            window.addEventListener('resize', function() {
                clearTimeout(resizeTimer);
                resizeTimer = setTimeout(() => {
                    // Recalculate for any visible tooltips (on hover) or open popovers
                    document.querySelectorAll('.pa-popover--open').forEach(adjustPopoverPosition);
                }, 250);
            });

        });
    </script>
</body>
</html>