<!-- Popconfirm Component Examples -->

<div class="pa-card">
    <div class="pa-card__header">
        <h3>Popconfirm Component</h3>
        <p>Small confirmation dialogs anchored to trigger buttons - perfect for delete confirmations and quick decisions</p>
    </div>
    <div class="pa-card__body">
        <div class="pure-g">
            <div class="pure-u-1 pure-u-md-1-2">
                <h4>Basic Popconfirms</h4>
                <div class="min-h-12x">
                    <div class="pa-btn-group">
                        <button
                            class="pa-btn pa-btn--danger"
                            onclick="togglePopconfirm(event, 'popconfirm-delete')"
                        >
                            Delete Item
                        </button>

                        <button
                            class="pa-btn pa-btn--warning"
                            onclick="togglePopconfirm(event, 'popconfirm-warning')"
                        >
                            Archive Item
                        </button>

                        <button
                            class="pa-btn pa-btn--secondary"
                            onclick="togglePopconfirm(event, 'popconfirm-info')"
                        >
                            Reset Settings
                        </button>
                    </div>
                </div>
            </div>

            <div class="pure-u-1 pure-u-md-1-2">
                <h4>Compact Variant</h4>
                <div class="min-h-12x">
                    <div class="pa-btn-group">
                        <button
                            class="pa-btn pa-btn--xs pa-btn--danger"
                            onclick="togglePopconfirm(event, 'popconfirm-compact')"
                        >
                            🗑️
                        </button>

                        <button
                            class="pa-btn pa-btn--xs pa-btn--outline-danger"
                            onclick="togglePopconfirm(event, 'popconfirm-compact-2')"
                        >
                            Remove
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

