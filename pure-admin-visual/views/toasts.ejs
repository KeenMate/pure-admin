            <p>Temporary notification messages that auto-dismiss with smooth animations.</p>

            <!-- Toast Container Position Demo -->
            <div class="pa-card">
                <div class="pa-card__header">
                    <h3>Toast Positions</h3>
                </div>
                <div class="pa-card__body">
                    <div class="pure-g">
                        <div class="pure-u-1 pure-u-md-1-3">
                            <button class="pa-btn pa-btn--primary pa-btn--block" onclick="showToast('top-right', 'success')">
                                Top Right
                            </button>
                        </div>
                        <div class="pure-u-1 pure-u-md-1-3">
                            <button class="pa-btn pa-btn--primary pa-btn--block" onclick="showToast('top-center', 'info')">
                                Top Center
                            </button>
                        </div>
                        <div class="pure-u-1 pure-u-md-1-3">
                            <button class="pa-btn pa-btn--primary pa-btn--block" onclick="showToast('top-left', 'warning')">
                                Top Left
                            </button>
                        </div>
                    </div>
                    <div class="pure-g" style="margin-top: 1rem;">
                        <div class="pure-u-1 pure-u-md-1-3">
                            <button class="pa-btn pa-btn--secondary pa-btn--block" onclick="showToast('bottom-right', 'danger')">
                                Bottom Right
                            </button>
                        </div>
                        <div class="pure-u-1 pure-u-md-1-3">
                            <button class="pa-btn pa-btn--secondary pa-btn--block" onclick="showToast('bottom-center', 'primary')">
                                Bottom Center
                            </button>
                        </div>
                        <div class="pure-u-1 pure-u-md-1-3">
                            <button class="pa-btn pa-btn--secondary pa-btn--block" onclick="showToast('bottom-left', 'success')">
                                Bottom Left
