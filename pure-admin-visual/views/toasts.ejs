                </div>
                <div class="pa-card__body">
                    <button class="pa-btn pa-btn--primary" onclick="showMultipleToasts()">
                        Show 3 Toasts
                    </button>
                    <p style="margin-top: 1rem; color: var(--text-secondary);">
                        Toasts automatically stack vertically in the container
                    </p>
