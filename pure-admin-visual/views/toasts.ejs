            </div>

            <!-- Toast Variants -->
            <div class="pa-card">
                <div class="pa-card__header">
                    <h3>Toast Variants</h3>
                </div>
                <div class="pa-card__body">
                    <div class="pure-g">
                        <div class="pure-u-1 pure-u-md-1-2 pure-u-lg-1-5">
                            <button class="pa-btn pa-btn--primary pa-btn--block" onclick="showToastVariant('primary')">
                                Primary
                            </button>
                        </div>
                        <div class="pure-u-1 pure-u-md-1-2 pure-u-lg-1-5">
                            <button class="pa-btn pa-btn--success pa-btn--block" onclick="showToastVariant('success')">
                                Success
