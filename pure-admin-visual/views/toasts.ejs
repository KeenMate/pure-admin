            </div>

<script>
// Toast configuration
const toastIcons = {
    primary: 'ℹ️',
    success: '✓',
    danger: '✕',
    warning: '⚠',
    info: 'ℹ'
};

const toastTitles = {
    primary: 'Primary',
    success: 'Success',
    danger: 'Error',
    warning: 'Warning',
    info: 'Information'
};

const toastMessages = {
    primary: 'This is a primary toast notification.',
    success: 'Your action was completed successfully.',
    danger: 'An error occurred. Please try again.',
    warning: 'Please review this warning message.',
    info: 'Here is some useful information for you.'
};

// Create and show a toast
function createToast(position, variant, title, message, duration = 5000, showProgress = false, persistent = false) {
    const container = document.getElementById(`toast-container-${position}`);
    const toastId = `toast-${Date.now()}-${Math.random()}`;

    const toast = document.createElement('div');
    toast.className = `pa-toast pa-toast--${variant}`;
    toast.id = toastId;

    toast.innerHTML = `
        <div class="pa-toast__icon">${toastIcons[variant] || 'ℹ'}</div>
        <div class="pa-toast__content">
            <div class="pa-toast__title">${title}</div>
            <div class="pa-toast__message">${message}</div>
        </div>
        <button class="pa-toast__close" onclick="dismissToast('${toastId}')" aria-label="Close">
            ✕
        </button>
        ${showProgress && !persistent ? '<div class="pa-toast__progress" style="width: 100%;"></div>' : ''}
    `;

    container.appendChild(toast);

    // Trigger animation
    setTimeout(() => {
        toast.classList.add('pa-toast--show');
    }, 10);

    // Progress bar animation
    if (showProgress && !persistent) {
        const progress = toast.querySelector('.pa-toast__progress');
        if (progress) {
            progress.style.transition = `width ${duration}ms linear`;
            setTimeout(() => {
                progress.style.width = '0%';
            }, 50);
        }
    }

    // Auto-dismiss (only if not persistent)
    if (!persistent) {
        setTimeout(() => {
            dismissToast(toastId);
        }, duration);
    }
}

// Dismiss a toast
function dismissToast(toastId) {
    const toast = document.getElementById(toastId);
    if (!toast) return;

    toast.classList.remove('pa-toast--show');
    toast.classList.add('pa-toast--hide');

    setTimeout(() => {
        toast.remove();
    }, 300);
}

// Demo functions
function showToast(position, variant) {
    createToast(
        position,
        variant,
        toastTitles[variant],
        toastMessages[variant]
    );
}

function showToastVariant(variant) {
    createToast(
        'top-right',
        variant,
        toastTitles[variant],
        toastMessages[variant]
    );
}

function showProgressToast() {
    createToast(
        'top-right',
        'primary',
        'Processing',
        'Your request is being processed...',
        5000,
        true
    );
}

function showActionToast(message, variant) {
    createToast(
        'top-right',
        variant,
        toastTitles[variant],
        message
    );
}

function showMultipleToasts() {
    createToast('top-right', 'success', 'First Toast', 'This is the first notification');
    setTimeout(() => {
        createToast('top-right', 'warning', 'Second Toast', 'This is the second notification');
    }, 300);
    setTimeout(() => {
        createToast('top-right', 'info', 'Third Toast', 'This is the third notification');
    }, 600);
}

function showPersistentToast(variant) {
    const persistentMessages = {
        warning: 'This is an important warning that requires your attention. Click the close button to dismiss.',
        danger: 'Critical error detected! This message will remain until you acknowledge it.',
        info: 'Important information that you should read carefully before dismissing.'
    };

    createToast(
        'top-right',
        variant,
        toastTitles[variant],
        persistentMessages[variant] || toastMessages[variant],
        0,
        false,
        true  // persistent = true
    );
}
</script>
