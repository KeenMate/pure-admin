<script>
// Card interactions
function toggleCard(button) {
    const card = button.closest('.pa-card');
    const body = card.querySelector('.pa-card__body');

    if (body.style.display === 'none') {
        body.style.display = 'block';
        button.textContent = '−';
    } else {
        body.style.display = 'none';
        button.textContent = '+';
    }
}

function showTab(button, tabId) {
    const card = button.closest('.pa-card');
    const allTabs = card.querySelectorAll('.pa-card__tab');
    const allContents = card.querySelectorAll('.pa-card__tab-content');

    // Remove active class from all tabs and contents
    allTabs.forEach(tab => tab.classList.remove('pa-card__tab--active'));
    allContents.forEach(content => content.classList.remove('pa-card__tab-content--active'));

    // Add active class to clicked tab and corresponding content
    button.classList.add('pa-card__tab--active');
    document.getElementById(tabId).classList.add('pa-card__tab-content--active');
}
</script>