{
  "name": "pure-admin-visual",
  "version": "1.0.0",
  "description": "Lightweight data-focused admin framework based on PureCSS",
  "main": "index.html",
  "scripts": {
    "build-css": "sass --silence-deprecation=import src/scss/main.scss dist/css/main.css",
    "build-themes": "sass --silence-deprecation=import src/scss/themes:dist/css/themes",
    "build-all": "npm run build-css && npm run build-themes",
    "watch-css": "sass --silence-deprecation=import --watch src/scss/main.scss:dist/css/main.css",
    "watch-themes": "sass --silence-deprecation=import --watch src/scss/themes:dist/css/themes",
    "watch-all": "concurrently \"npm run watch-css\" \"npm run watch-themes\"",
    "dev": "npm run watch-all",
    "dev-server": "concurrently \"npm run watch-all\" \"live-server --port=8000 --wait=500\"",
    "serve": "live-server --port=8000"
  },
  "keywords": [
    "admin",
    "framework",
    "purecss",
    "sass",
    "lightweight"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2",
    "live-server": "^1.2.2",
    "sass": "^1.69.0"
  },
  "dependencies": {
    "cookie-parser": "^1.4.6",
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "express-ejs-layouts": "^2.5.1",
    "mustache-express": "^1.3.2",
    "purecss": "^3.0.0"
  }
}
