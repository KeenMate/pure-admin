{
  "name": "pure-admin-kit",
  "version": "1.0.0",
  "type": "module",
  "description": "A modern Svelte component library for building admin dashboards with PureCSS",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "svelte": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./styles": "./src/app.css"
  },
  "files": [
    "dist",
    "src/app.css",
    "README.md"
  ],
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && npm run package",
    "package": "svelte-kit sync && svelte-package",
    "preview": "vite preview",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "svelte",
    "components",
    "admin",
    "dashboard",
    "purecss",
    "ui-library"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@sveltejs/adapter-auto": "^6.1.0",
    "@sveltejs/kit": "^2.39.1",
    "@sveltejs/package": "^2.3.7",
    "@sveltejs/vite-plugin-svelte": "^6.2.0",
    "svelte": "^5.38.10",
    "vite": "^7.1.5"
  },
  "dependencies": {
    "purecss": "^3.0.0"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  }
}
