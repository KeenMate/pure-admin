<div class="ex4-log" id="ex4-log" aria-live="polite"></div>

<div class="pa-callout pa-callout--warning mt-4">
    <strong>Right tool check.</strong> Two techniques, two jobs. The fit
    <em>engine</em> (example 1) shrinks a 1-D <strong>row</strong> of items —
    <code>steps</code> to keep something reachable, <code>hide</code> for
    supplementary bits. A <strong>container query</strong> (example 2) is for a
    2-D <strong>layout swap</strong> — chart ↔ KPI, sidebar ↔ drawer, and
    (example 3) several swaps stacked into one query: panels → tabs → icons plus
    header trimming, all keyed off the card's own width. And when the hidden
    branch is <strong>expensive</strong> (a chart, a date-picker, a shadow-DOM
    widget), reach past CSS for the <strong>Container Breakpoint engine</strong>
    (example 4): same width thresholds, but it emits an event so JS can
    <em>build the widget only when its mode is on screen and tear it down
    otherwise</em> — the piece a Svelte/LiveView wrapper turns into real
    mount/unmount. None of these is a form-reflow engine: for fields wrapping to
    new lines, use the grid / flex-wrap.
</div>

<script>
    (function () {
        function fitInit(id) {
            var el = document.getElementById(id);
            if (el && window.pureAdmin && pureAdmin.components && pureAdmin.components.fit) {
                pureAdmin.components.fit.init(el);
            }
        }
        fitInit('ex1-toolbar');   // examples 2 & 3 are pure CSS container queries — no JS engine

        // Example 3 tab switching (only visible in the tabbed / narrow form; the
        // wide 3-panel grid ignores it since every panel shows). Scoped to the
        // clicked card so multiple product cards wouldn't cross-talk.
        window.prodTab = function (btn) {
            var card = btn.closest('.prod');
            if (!card) return;
            var panel = btn.getAttribute('data-panel');
            card.querySelectorAll('.prod__tabs .pa-tabs__item').forEach(function (t) {
                t.classList.toggle('pa-tabs__item--active', t === btn);
            });
            card.querySelectorAll('.prod__panel').forEach(function (p) {
                p.classList.toggle('prod__panel--active', p.getAttribute('data-panel') === panel);
            });
        };

        // Slider → stage width. Example 1's fit row (width:100% of the stage) is
        // re-settled by the engine's ResizeObserver; example 2's card is the
        // container-query container, so its own width drives the chart ↔ KPI swap.
        window.fitSetWidth = function (stageId, w) {
            var stage = document.getElementById(stageId);
            if (stage) stage.style.maxWidth = w + 'px';
            var out = document.getElementById(stageId + '-w');
            if (out) out.textContent = w + 'px';
        };

        // Example 2's Chart.js sparkline. Created while the card is wide (chart
        // visible) so it renders at a real size; Chart.js's own ResizeObserver
        // re-fits it when the container query shows it again after a narrow spell.
        if (window.Chart) {
            var accent = (getComputedStyle(document.documentElement)
                .getPropertyValue('--pc-accent') || '#3b82f6').trim();
            // Both cards (slider-driven and window-driven) get the same sparkline.
            ['ex2-chart', 'ex2b-chart'].forEach(function (id) {
                var canvas = document.getElementById(id);
                if (!canvas) return;
                new Chart(canvas, {
                    type: 'line',
                    data: {
                        labels: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'],
                        datasets: [{
                            data: [612, 640, 606, 701, 760, 803, 847],
                            borderColor: accent,
                            backgroundColor: 'rgba(59, 130, 246, 0.12)',
                            fill: true, tension: 0.4, pointRadius: 0, borderWidth: 2
                        }]
                    },
                    options: {
                        responsive: true, maintainAspectRatio: false,
                        plugins: { legend: { display: false }, tooltip: { enabled: false } },
                        scales: { x: { display: false }, y: { display: false } }
                    }
                });
            });
        }
    })();
</script>

<script>
    // Example 4 — the engine-driven twin of example 3. container-breakpoint.js
    // auto-wires the card (data-pa-breakpoints), toggles .d-none on the
    // data-pa-show pieces, reflects [data-mode], and fires 'pa:breakpoint'. We use
    // that event to BUILD the hero revenue chart only in 'grid' mode and DESTROY
    // it otherwise — the "mount on demand" a Svelte {#if} would automate — and to
    // switch tabs. prodxTab handles clicks in the tabbed (narrow) modes.
    (function () {
        var card = document.getElementById('ex4');
        if (!card) return;
        var logEl = document.getElementById('ex4-log');
        var chart = null, builds = 0;

        function log(msg) {
            if (!logEl) return;
            var line = document.createElement('div');
            line.textContent = msg;
            logEl.insertBefore(line, logEl.firstChild);
        }

        function buildChart() {
            var canvas = document.getElementById('ex4-chart');
            if (!canvas || !window.Chart) return null;
            var accent = (getComputedStyle(document.documentElement)
                .getPropertyValue('--pc-accent') || '#3b82f6').trim();
            return new Chart(canvas, {
                type: 'line',
                data: {
                    labels: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'],
                    datasets: [{
                        data: [612, 640, 606, 701, 760, 803, 847],
                        borderColor: accent, backgroundColor: 'rgba(59, 130, 246, 0.12)',
                        fill: true, tension: 0.4, pointRadius: 0, borderWidth: 2
                    }]
                },
                options: {
                    responsive: true, maintainAspectRatio: false,
                    plugins: { legend: { display: false }, tooltip: { enabled: false } },
                    scales: { x: { display: false }, y: { display: false } }
                }
            });
        }

        // Tab switching for the tabbed (narrow) modes — scoped to this card.
        window.prodxTab = function (btn) {
            var panel = btn.getAttribute('data-panel');
            card.querySelectorAll('.prodx__tabs .pa-tabs__item').forEach(function (t) {
                t.classList.toggle('pa-tabs__item--active', t === btn);
            });
            card.querySelectorAll('.prodx__panel').forEach(function (p) {
                p.classList.toggle('prodx__panel--active', p.getAttribute('data-panel') === panel);
            });
        };

        log('waiting — the revenue Chart.js instance is NOT built until the card reaches grid mode (~640px)');
        card.addEventListener('pa:breakpoint', function (e) {
            var w = Math.round(e.detail.width);
            log('mode → ' + e.detail.mode + ' (card ' + w + 'px)');
            if (e.detail.mode === 'grid') {
                if (!chart) {
                    chart = buildChart();
                    if (chart) { builds++; log('  ▶ built revenue chart instance #' + builds); }
                }
            } else if (chart) {
                chart.destroy();
                chart = null;
                log('  ✕ destroyed chart (not grid mode)');
            }
        });
    })();
</script>
