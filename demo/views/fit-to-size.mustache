<style>
    /* The "stage" is the resizable frame whose width the slider controls; the fit
       row inside it is width:100%, so narrowing the stage narrows the row and the
       Fit engine's ResizeObserver re-settles it. Capped at 100% so it never
       exceeds the viewport — on a phone it's already at the narrow end. */
    .fit-stage {
        max-width: 100%;
        margin-block: 0.75rem;
        border: 1px dashed var(--pc-border-color);
        border-radius: 8px;
        transition: max-width 0.08s ease;
    }

    .fit-slider-row {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-top: 1rem;
        font-size: var(--pc-font-size-sm, 1.4rem);
        color: var(--pc-text-color-2);
    }
    .fit-slider-row input[type="range"] { flex: 1; min-width: 0; }
    .fit-slider-row output { font-variant-numeric: tabular-nums; min-width: 4.5ch; text-align: end; }

    /* Fit row (example 1): a plain flex row. Children don't shrink (flex:0 0 auto)
       + never wrap — so the engine folds them instead of the browser squishing. */
    .fit-toolbar {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        width: 100%;
    }
    .fit-toolbar > * { flex: 0 0 auto; white-space: nowrap; }
    /* Keep each step's icon + label on ONE line, so the engine folds the button
       rather than the button wrapping its own content when cramped. */
    .fit-toolbar [data-pa-fit-step] {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        white-space: nowrap;
    }

    /* Example 2 uses a CSS CONTAINER QUERY (not the fit engine): the card is the
       query container and its own width swaps the chart for compact KPIs. These
       are the only non-component styles here — every visible piece is a real pa-*. */
    /* NB: pure-admin's root font-size is 10px, so 1rem = 10px — 45rem = 450px. */
    .fit-cq { container-type: inline-size; }
    .fit-cq__chart { width: 20rem; height: 10rem; }
    .fit-cq__chart { display: none; }              /* narrow default → show the KPIs */
    .fit-cq__kpi { display: flex; flex-direction: column; align-items: flex-start; gap: 0.6rem; }
    @container (min-width: 45rem) {
        .fit-cq__chart { display: block; }         /* wide (≥450px) → show the chart */
        .fit-cq__kpi { display: none; }
    }

    /* Example 3 uses ONE CSS container query that restyles the card on
       SEVERAL axes at three widths — panels grid → tabs → icon-tabs, plus a
       header that sheds supplier / packaging / trend. Demo-only layout classes
       are prefixed .prod; every visible piece (pa-badge, pa-stat, pa-tabs,
       pa-dot-leaders) is a real component. Root font 10px → 1rem = 10px. */
    .prod { container-type: inline-size; }

    .prod__header {
        display: flex; justify-content: space-between; align-items: flex-start; gap: 1.5rem;
    }
    .prod__title { margin: 0.4rem 0 0.3rem; }
    .prod__meta { color: var(--pc-text-color-2); font-size: var(--pc-font-size-sm, 1.4rem); }
    .prod__price { flex: 0 0 auto; text-align: end; }
    .prod__price-num { font-size: 2rem; font-weight: 700; font-variant-numeric: tabular-nums; }
    .prod__price-trend { margin-top: 0.4rem; }

    /* Header detail + trend badge start hidden; they appear as the card widens. */
    .prod__meta-pkg, .prod__meta-sup, .prod__price-trend { display: none; }

    /* DEFAULT (narrowest): tabbed, one panel at a time, tabs are ICON-ONLY. */
    .prod__tabs { margin-top: 1.2rem; }
    /* Re-assert the tab item's flex row + gap. The buttons carry .pa-tooltip
       (for the icon-only width), and .pa-tooltip's display:inline-block would
       otherwise clobber .pa-tabs__item's own display:flex — collapsing the gap
       so the icon touches the label. This two-class selector wins. */
    .prod__tabs .pa-tabs__item { display: flex; align-items: center; justify-content: center; gap: 0.5rem; }
    .prod__tabs .pa-tabs__item span { display: none; }   /* icon-only until there's room */
    .prod__panels { margin-top: 1.2rem; }
    .prod__panel { display: none; }
    .prod__panel--active { display: block; }
    .prod__panel-title { display: none; }                 /* the tab label already names it */

    /* MEDIUM (≥34rem / 340px): tab TEXT appears; header regains packaging + trend. */
    @container (min-width: 34rem) {
        .prod__tabs .pa-tabs__item span { display: inline; }
        .prod__meta-pkg { display: inline; }
        .prod__price-trend { display: inline-flex; }
    }

    /* WIDE (≥64rem / 640px): drop the tabs, lay the three panels side-by-side,
       reveal the per-panel titles and the supplier line. */
    @container (min-width: 64rem) {
        .prod__tabs { display: none; }
        .prod__panels { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.6rem; }
        .prod__panel { display: block; }
        .prod__panel + .prod__panel {
            padding-inline-start: 1.6rem;
            border-inline-start: 1px solid var(--pc-border-color);
        }
        .prod__panel-title { display: block; }
        .prod__meta-sup { display: inline; }
    }

    /* Example 4 — the SAME multi-level product card as example 3, but driven by
       the Container Breakpoint engine instead of a CSS @container. NOTE: .prodx
       does NOT set container-type, so no @container fires here — the swaps are
       driven by the engine: data-pa-show toggles the shared .d-none (a class you
       can watch in devtools), and [data-mode="grid"] does the one real 2-D layout
       change. Swappable pieces are VISIBLE by default; the engine hides the
       out-of-mode ones. Structural rules below mirror example 3's .prod. */
    .prodx__header { display: flex; justify-content: space-between; align-items: flex-start; gap: 1.5rem; }
    .prodx__title { margin: 0.4rem 0 0.3rem; }
    .prodx__meta { color: var(--pc-text-color-2); font-size: var(--pc-font-size-sm, 1.4rem); }
    .prodx__price { flex: 0 0 auto; text-align: end; }
    .prodx__price-num { font-size: 2rem; font-weight: 700; font-variant-numeric: tabular-nums; }
    .prodx__chart { height: 8rem; margin-top: 1.2rem; }
    .prodx__tabs { margin-top: 1.2rem; }
    /* flex-gap fix: .pa-tooltip's display:inline-block would clobber the tab item's
       flex, colliding the icon and label (see example 3). */
    .prodx__tabs .pa-tabs__item { display: flex; align-items: center; justify-content: center; gap: 0.5rem; }
    .prodx__panels { margin-top: 1.2rem; }
    /* tabs / icons modes: one panel at a time (standard tab pattern) */
    .prodx__panel { display: none; }
    .prodx__panel--active { display: block; }
    /* grid mode: the one genuine 2-D layout change — three panels side-by-side */
    .prodx[data-mode="grid"] .prodx__panels { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.6rem; }
    .prodx[data-mode="grid"] .prodx__panel { display: block; }
    .prodx[data-mode="grid"] .prodx__panel + .prodx__panel { padding-inline-start: 1.6rem; border-inline-start: 1px solid var(--pc-border-color); }
    .ex4-log {
        margin-top: 0.8rem; max-height: 9rem; overflow: auto;
        font-size: var(--pc-font-size-xs, 1.2rem);
        font-family: var(--pc-font-family-mono, ui-monospace, monospace);
        color: var(--pc-text-color-2);
    }
    .ex4-log > div { padding: 0.15rem 0; border-bottom: 1px dashed var(--pc-border-color); }
</style>

<p>
    The Fit engine (<code>fit.js</code>) shrinks a horizontal row to fit its
    container — degrading the least-important slots first, lowest priority first,
    and restoring them as space returns. It powers the navbar, but it's not
    navbar-only: call <code>pureAdmin.components.fit.init(el)</code> on any flex
    row (a toolbar, a filter bar, a card's action cluster).
</p>

<div class="pa-callout pa-callout--info mb-4">
    <strong>The vocabulary.</strong>
    <code>data-pa-fit="hide|steps|sidebar"</code> makes an element a slot;
    <code>data-pa-fit-priority</code> orders them (lower goes first);
    <code>data-pa-fit-auto</code> on a container folds in <em>every</em> child
    without tagging each; <code>data-pa-fit-ignore</code> pins one out entirely;
    and <code>pureAdmin.config.fit.defaultPriority</code> (or a container's
    <code>data-pa-fit-default-priority</code>) sets the fallback rank.
    <strong>Drag the sliders</strong> — or just open this page on a narrow phone —
    to watch each row fold.
</div>

<!-- ============================================================
     EXAMPLE 1 — Card toolbar: shrink, don't lose (steps + ignore)
     ============================================================ -->
<h3 class="mt-4 mb-2">1 · Card toolbar — shrink, don't lose</h3>
<p>
    A <code>steps</code> slot degrades <strong>full label → icon-only → gone</strong>
    instead of vanishing outright, so an action stays reachable as an icon before
    it's dropped. Here <strong>Save</strong> is pinned full
    (<code>data-pa-fit-ignore</code>); <strong>Duplicate</strong> and
    <strong>Export</strong> shrink to icons (higher priority survives longer);
    <strong>Delete</strong> is un-tagged, so it inherits the toolbar's
    <code>data-pa-fit-default-priority="20"</code> and drops first.
</p>

<div class="fit-slider-row">
    <span>Container width</span>
    <input type="range" min="200" max="720" value="360"
           oninput="fitSetWidth('stage1', this.value)" aria-label="Example 1 width">
    <output id="stage1-w">360px</output>
</div>

<div class="fit-stage" id="stage1" style="max-width: 360px">
    <div class="pa-card" style="margin: 0">
        <div class="pa-card__header">
            <div class="pa-card__title"><span class="pa-card__title-text">Sales Overview</span></div>
        </div>
        <div class="pa-card__body">
            <div id="ex1-toolbar" class="fit-toolbar" data-pa-fit-auto data-pa-fit-default-priority="20">
                <button class="pa-btn pa-btn--primary" data-pa-fit-ignore>
                    <span class="pa-btn__icon">💾</span> Save
                </button>
                <button class="pa-btn" data-pa-fit="steps" data-pa-fit-priority="40">
                    <span data-pa-fit-step="0"><span class="pa-btn__icon">⧉</span> Duplicate</span>
                    <span data-pa-fit-step="1" class="pa-fit-hidden"><span class="pa-btn__icon">⧉</span></span>
                </button>
                <button class="pa-btn" data-pa-fit="steps" data-pa-fit-priority="30">
                    <span data-pa-fit-step="0"><span class="pa-btn__icon">⬇️</span> Export</span>
                    <span data-pa-fit-step="1" class="pa-fit-hidden"><span class="pa-btn__icon">⬇️</span></span>
                </button>
                <button class="pa-btn">
                    <span class="pa-btn__icon">🗑️</span> Delete
                </button>
            </div>
            <p class="mt-3 mb-0" style="color: var(--pc-text-color-2); font-size: var(--pc-font-size-sm, 1.4rem)">
                Drag left: Delete drops → Export shrinks to its icon, then drops →
                Duplicate shrinks → only Save remains, always full.
            </p>
        </div>
    </div>
</div>

