<style>
    /* The "stage" is the resizable frame whose width the slider controls; the fit
       row inside it is width:100%, so narrowing the stage narrows the row and the
       Fit engine's ResizeObserver re-settles it. Capped at 100% so it never
       exceeds the viewport — on a phone it's already at the narrow end. */
    .fit-stage {
        max-width: 100%;
        margin-block: 0.75rem;
        border: 1px dashed var(--pc-border-color);
        border-radius: 8px;
        transition: max-width 0.08s ease;
    }

    .fit-slider-row {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-top: 1rem;
        font-size: var(--pc-font-size-sm, 1.4rem);
        color: var(--pc-text-color-2);
    }
    .fit-slider-row input[type="range"] { flex: 1; min-width: 0; }
    .fit-slider-row output { font-variant-numeric: tabular-nums; min-width: 4.5ch; text-align: end; }

    /* Fit row (example 1): a plain flex row. Children don't shrink (flex:0 0 auto)
       + never wrap — so the engine folds them instead of the browser squishing. */
    .fit-toolbar {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        width: 100%;
    }
    .fit-toolbar > * { flex: 0 0 auto; white-space: nowrap; }
    /* Keep each step's icon + label on ONE line, so the engine folds the button
       rather than the button wrapping its own content when cramped. */
    .fit-toolbar [data-pa-fit-step] {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        white-space: nowrap;
    }

    /* Example 2 uses a CSS CONTAINER QUERY (not the fit engine): the card is the
       query container and its own width swaps the chart for compact KPIs. These
       are the only non-component styles here — every visible piece is a real pa-*. */
    /* NB: pure-admin's root font-size is 10px, so 1rem = 10px — 45rem = 450px. */
    .fit-cq { container-type: inline-size; }
    .fit-cq__chart { width: 20rem; height: 10rem; }
    .fit-cq__chart { display: none; }              /* narrow default → show the KPIs */
    .fit-cq__kpi { display: flex; flex-direction: column; align-items: flex-start; gap: 0.6rem; }
    @container (min-width: 45rem) {
        .fit-cq__chart { display: block; }         /* wide (≥450px) → show the chart */
        .fit-cq__kpi { display: none; }
    }
</style>

<p>
    The Fit engine (<code>fit.js</code>) shrinks a horizontal row to fit its
    container — degrading the least-important slots first, lowest priority first,
    and restoring them as space returns. It powers the navbar, but it's not
    navbar-only: call <code>pureAdmin.components.fit.init(el)</code> on any flex
    row (a toolbar, a filter bar, a card's action cluster).
</p>

<div class="pa-callout pa-callout--info mb-4">
    <strong>The vocabulary.</strong>
    <code>data-pa-fit="hide|steps|sidebar"</code> makes an element a slot;
    <code>data-pa-fit-priority</code> orders them (lower goes first);
    <code>data-pa-fit-auto</code> on a container folds in <em>every</em> child
    without tagging each; <code>data-pa-fit-ignore</code> pins one out entirely;
    and <code>pureAdmin.config.fit.defaultPriority</code> (or a container's
    <code>data-pa-fit-default-priority</code>) sets the fallback rank.
    <strong>Drag the sliders</strong> — or just open this page on a narrow phone —
    to watch each row fold.
</div>

<!-- ============================================================
     EXAMPLE 1 — Card toolbar: shrink, don't lose (steps + ignore)
     ============================================================ -->
<h3 class="mt-4 mb-2">1 · Card toolbar — shrink, don't lose</h3>
<p>
    A <code>steps</code> slot degrades <strong>full label → icon-only → gone</strong>
    instead of vanishing outright, so an action stays reachable as an icon before
    it's dropped. Here <strong>Save</strong> is pinned full
    (<code>data-pa-fit-ignore</code>); <strong>Duplicate</strong> and
    <strong>Export</strong> shrink to icons (higher priority survives longer);
    <strong>Delete</strong> is un-tagged, so it inherits the toolbar's
    <code>data-pa-fit-default-priority="20"</code> and drops first.
</p>

<div class="fit-slider-row">
    <span>Container width</span>
    <input type="range" min="200" max="720" value="360"
           oninput="fitSetWidth('stage1', this.value)" aria-label="Example 1 width">
    <output id="stage1-w">360px</output>
</div>

<div class="fit-stage" id="stage1" style="max-width: 360px">
    <div class="pa-card" style="margin: 0">
        <div class="pa-card__header">
            <div class="pa-card__title"><span class="pa-card__title-text">Sales Overview</span></div>
        </div>
        <div class="pa-card__body">
            <div id="ex1-toolbar" class="fit-toolbar" data-pa-fit-auto data-pa-fit-default-priority="20">
                <button class="pa-btn pa-btn--primary" data-pa-fit-ignore>
                    <span class="pa-btn__icon">💾</span> Save
                </button>
                <button class="pa-btn" data-pa-fit="steps" data-pa-fit-priority="40">
                    <span data-pa-fit-step="0"><span class="pa-btn__icon">⧉</span> Duplicate</span>
                    <span data-pa-fit-step="1" class="pa-fit-hidden"><span class="pa-btn__icon">⧉</span></span>
                </button>
                <button class="pa-btn" data-pa-fit="steps" data-pa-fit-priority="30">
                    <span data-pa-fit-step="0"><span class="pa-btn__icon">⬇️</span> Export</span>
                    <span data-pa-fit-step="1" class="pa-fit-hidden"><span class="pa-btn__icon">⬇️</span></span>
                </button>
                <button class="pa-btn">
                    <span class="pa-btn__icon">🗑️</span> Delete
                </button>
            </div>
            <p class="mt-3 mb-0" style="color: var(--pc-text-color-2); font-size: var(--pc-font-size-sm, 1.4rem)">
                Drag left: Delete drops → Export shrinks to its icon, then drops →
                Duplicate shrinks → only Save remains, always full.
            </p>
        </div>
    </div>
</div>

<!-- ============================================================
     EXAMPLE 2 — Product card: chart ↔ KPI via a CSS container query
     ============================================================ -->
<h3 class="mt-5 mb-2">2 · Product card — chart ↔ KPI</h3>
<p>
    A different job needs a different tool. Swapping a rich <strong>chart</strong>
    for compact <strong>KPI numbers</strong> is a 2-D layout change, not a 1-D row
    fold — so this one is a pure CSS <strong>container query</strong> on the card,
    no JS engine. Left half stays product info (category, title, code); the right
    half shows the Chart.js sparkline while there's room and swaps to a
    <code>pa-stat</code> KPI once the card narrows past <code>45rem</code> (450px). Every
    visible piece — <code>pa-card</code>, <code>pa-badge</code>, <code>pa-stat</code>,
    the chart — is a real component.
</p>

<div class="fit-slider-row">
    <span>Container width</span>
    <input type="range" min="260" max="720" value="640"
           oninput="fitSetWidth('stage2', this.value)" aria-label="Example 2 width">
    <output id="stage2-w">640px</output>
</div>

<div class="fit-stage" id="stage2" style="max-width: 640px; border: 0">
    <div class="pa-card fit-cq" style="margin: 0">
        <div class="pa-card__body d-flex" style="align-items: center; gap: 1.5rem">
            <div class="flex-1" style="min-width: 0">
                <span class="pa-badge pa-badge--color-3">Beverages</span>
                <h4 class="mt-2 mb-1">Arabica Cold Brew</h4>
                <div style="color: var(--pc-text-color-2); font-size: var(--pc-font-size-sm, 1.4rem)">
                    <code>SKU-4471</code> · 1 L bottle
                </div>
            </div>
            <div style="flex: 0 0 auto">
                <div class="fit-cq__chart"><canvas id="ex2-chart"></canvas></div>
                <div class="fit-cq__kpi">
                    <div class="pa-stat">
                        <div class="pa-stat__icon pa-stat__icon--success">📈</div>
                        <div class="pa-stat__content">
                            <div class="pa-stat__number">$847K</div>
                            <div class="pa-stat__label">Revenue</div>
                        </div>
                    </div>
                    <span class="pa-badge pa-badge--success">▲ 12.5%</span>
                </div>
            </div>
        </div>
    </div>
</div>
<p class="mt-2" style="color: var(--pc-text-color-2); font-size: var(--pc-font-size-sm, 1.4rem)">
    Drag left (or view on a phone): past <code>45rem</code> the chart gives way to
    the KPI stat — same data, denser. Drag right to bring the chart back.
</p>

<div class="pa-callout pa-callout--warning mt-4">
    <strong>Right tool check.</strong> Two techniques, two jobs. The fit
    <em>engine</em> (example 1) shrinks a 1-D <strong>row</strong> of items —
    <code>steps</code> to keep something reachable, <code>hide</code> for
    supplementary bits. A <strong>container query</strong> (example 2) is for a
    2-D <strong>layout swap</strong> — chart ↔ KPI, sidebar ↔ drawer. Neither is a
    form-reflow engine: for fields wrapping to new lines, use the grid / flex-wrap.
</div>

<script>
    (function () {
        function fitInit(id) {
            var el = document.getElementById(id);
            if (el && window.pureAdmin && pureAdmin.components && pureAdmin.components.fit) {
                pureAdmin.components.fit.init(el);
            }
        }
        fitInit('ex1-toolbar');   // example 2 is a pure CSS container query — no JS engine

        // Slider → stage width. Example 1's fit row (width:100% of the stage) is
        // re-settled by the engine's ResizeObserver; example 2's card is the
        // container-query container, so its own width drives the chart ↔ KPI swap.
        window.fitSetWidth = function (stageId, w) {
            var stage = document.getElementById(stageId);
            if (stage) stage.style.maxWidth = w + 'px';
            var out = document.getElementById(stageId + '-w');
            if (out) out.textContent = w + 'px';
        };

        // Example 2's Chart.js sparkline. Created while the card is wide (chart
        // visible) so it renders at a real size; Chart.js's own ResizeObserver
        // re-fits it when the container query shows it again after a narrow spell.
        if (window.Chart) {
            var canvas = document.getElementById('ex2-chart');
            if (canvas) {
                var accent = (getComputedStyle(document.documentElement)
                    .getPropertyValue('--pc-accent') || '#3b82f6').trim();
                new Chart(canvas, {
                    type: 'line',
                    data: {
                        labels: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'],
                        datasets: [{
                            data: [612, 640, 606, 701, 760, 803, 847],
                            borderColor: accent,
                            backgroundColor: 'rgba(59, 130, 246, 0.12)',
                            fill: true, tension: 0.4, pointRadius: 0, borderWidth: 2
                        }]
                    },
                    options: {
                        responsive: true, maintainAspectRatio: false,
                        plugins: { legend: { display: false }, tooltip: { enabled: false } },
                        scales: { x: { display: false }, y: { display: false } }
                    }
                });
            }
        }
    })();
</script>
