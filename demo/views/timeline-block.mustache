<!-- Variant 3: Timeline Block - Virtual Scroll -->
<div class="pa-card">
    <div class="pa-card__header">
        <div class="pa-card__title">
            <h3 class="pa-card__title-text">Timeline Block - Virtual Scroll</h3>
        </div>
        <p class="pa-card__meta">Automatically loads more entries as you scroll down</p>
    </div>
    <div class="pa-card__body">
        <div class="pa-timeline__scroll-container" id="timeline-block-scroll-container">
            <div class="pa-timeline pa-timeline--alternating" id="timeline-block-virtual-scroll">
                <div class="pa-timeline__item">
                    <div class="pa-timeline__date">Week 1</div>
                    <div class="pa-timeline__icon">📝</div>
                    <div class="pa-timeline__content">
                        <h3>Requirements Gathering</h3>
                        <p>Met with stakeholders to understand project requirements and constraints.</p>
                    </div>
                </div>
                <div class="pa-timeline__item">
                    <div class="pa-timeline__date">Week 2</div>
                    <div class="pa-timeline__icon">🎨</div>
                    <div class="pa-timeline__content">
                        <h3>Design Phase</h3>
                        <p>Created wireframes and mockups for all major application screens.</p>
                    </div>
                </div>
                <div class="pa-timeline__item">
                    <div class="pa-timeline__date">Week 3</div>
                    <div class="pa-timeline__icon">⚡</div>
                    <div class="pa-timeline__content">
                        <h3>Prototype Development</h3>
                        <p>Built interactive prototype to validate design decisions.</p>
                    </div>
                </div>
            </div>
            <div class="pa-timeline__loader" id="timeline-block-scroll-loader">
                <div class="pa-loader pa-loader--sm" id="timeline-block-scroll-spinner" style="display: none;">
                    <div class="pa-spinner"></div>
                </div>
                <div class="pa-timeline__loader-text" id="timeline-block-scroll-text" style="display: none;">Loading more entries...</div>
            </div>
        </div>
    </div>
</div>

<script>
// Load More Timeline Block
let loadMoreBlockPage = 1;
const loadMoreBlockData = [
    [
        { date: 'Feb 14', icon: '💝', title: 'Valentine Release', content: 'Launched special themed UI update for Valentine\'s Day.' },
        { date: 'Mar 1', icon: '🌱', title: 'Spring Refresh', content: 'Major UI refresh with new color palette and design system.' },
        { date: 'Mar 15', icon: '🚀', title: 'Performance Boost', content: 'Reduced page load time by 40% through optimization efforts.' }
    ],
    [
        { date: 'Apr 1', icon: '🎭', title: 'April Update', content: 'Added new customization options and theme variants.' },
        { date: 'Apr 22', icon: '🌍', title: 'Earth Day', content: 'Implemented green hosting and carbon-neutral deployment.' },
        { date: 'May 1', icon: '🎯', title: 'Milestone Reached', content: 'Achieved 10,000 active users and celebrated with the team.' }
    ],
    [
        { date: 'Jun 1', icon: '☀️', title: 'Summer Features', content: 'Released beach-themed components and seasonal updates.' },
        { date: 'End', icon: '✨', title: 'No More Entries', content: 'You have reached the end of the timeline.' }
    ]
];

function loadMoreBlockItems() {
    if (loadMoreBlockPage >= loadMoreBlockData.length) {
        alert('No more entries to load!');
        return;
    }

    const timeline = document.getElementById('timeline-block-load-more');
    const items = loadMoreBlockData[loadMoreBlockPage];

    items.forEach(item => {
        const div = document.createElement('div');
        div.className = 'pa-timeline__item';
        div.innerHTML = `
            <div class="pa-timeline__date">${item.date}</div>
            <div class="pa-timeline__icon">${item.icon}</div>
            <div class="pa-timeline__content">
                <h3>${item.title}</h3>
                <p>${item.content}</p>
            </div>
        `;
        timeline.appendChild(div);
    });

    loadMoreBlockPage++;
}

// Virtual Scroll Timeline Block
let virtualScrollBlockPage = 1;
let isLoadingVirtualScrollBlock = false;

const virtualScrollBlockData = [
    [
        { date: 'Week 4', icon: '🔍', title: 'User Testing', content: 'Conducted usability tests with focus groups.' },
        { date: 'Week 5', icon: '📊', title: 'Analytics Setup', content: 'Implemented comprehensive analytics and tracking.' },
        { date: 'Week 6', icon: '🛠️', title: 'Bug Fixes', content: 'Resolved critical issues found during testing phase.' }
    ],
    [
        { date: 'Week 7', icon: '🎓', title: 'Training', content: 'Conducted team training on new features and systems.' },
        { date: 'Week 8', icon: '📱', title: 'Mobile Optimization', content: 'Optimized responsive design for mobile devices.' },
        { date: 'Week 9', icon: '🔒', title: 'Security Audit', content: 'Completed security review and penetration testing.' }
    ],
    [
        { date: 'Week 10', icon: '🚢', title: 'Deployment', content: 'Successfully deployed to production environment.' },
        { date: 'Week 11', icon: '📈', title: 'Monitoring', content: 'Set up monitoring and alerting systems.' },
        { date: 'Week 12', icon: '🎊', title: 'Project Complete', content: 'Celebrated successful project completion!' }
    ]
];

const scrollBlockContainer = document.getElementById('timeline-block-scroll-container');
const virtualScrollBlockTimeline = document.getElementById('timeline-block-virtual-scroll');
const scrollBlockLoader = document.getElementById('timeline-block-scroll-loader');
const scrollBlockLoaderSpinner = document.getElementById('timeline-block-scroll-spinner');
const scrollBlockLoaderText = document.getElementById('timeline-block-scroll-text');

// Use Intersection Observer API for better performance
const observerBlockOptions = {
    root: scrollBlockContainer,
    rootMargin: '50px',
    threshold: 0.1
};

const loadMoreBlockObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
        if (entry.isIntersecting && !isLoadingVirtualScrollBlock && virtualScrollBlockPage < virtualScrollBlockData.length) {
            loadVirtualScrollBlockItems();
        }
    });
}, observerBlockOptions);

loadMoreBlockObserver.observe(scrollBlockLoader);

function loadVirtualScrollBlockItems() {
    if (virtualScrollBlockPage >= virtualScrollBlockData.length || isLoadingVirtualScrollBlock) {
        return;
    }

    isLoadingVirtualScrollBlock = true;
    scrollBlockLoaderSpinner.style.display = 'block';
    scrollBlockLoaderText.style.display = 'block';

    setTimeout(() => {
        const items = virtualScrollBlockData[virtualScrollBlockPage];

        items.forEach(item => {
            const div = document.createElement('div');
            div.className = 'pa-timeline__item';
            div.innerHTML = `
                <div class="pa-timeline__date">${item.date}</div>
                <div class="pa-timeline__icon">${item.icon}</div>
                <div class="pa-timeline__content">
                    <h3>${item.title}</h3>
                    <p>${item.content}</p>
                </div>
            `;
            virtualScrollBlockTimeline.appendChild(div);
        });

        virtualScrollBlockPage++;
        scrollBlockLoaderSpinner.style.display = 'none';
        scrollBlockLoaderText.style.display = 'none';
        isLoadingVirtualScrollBlock = false;

        if (virtualScrollBlockPage >= virtualScrollBlockData.length) {
            loadMoreBlockObserver.disconnect();
            scrollBlockLoader.style.display = 'none';
        }
    }, 800);
}
</script>

