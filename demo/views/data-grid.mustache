<div class="pa-card">
  <div class="pa-card__header">
    <h2>Web Grid Component</h2>
  </div>
  <div class="pa-card__body">
    <p>
      Advanced data grid web component from <code>@keenmate/web-grid</code> with sorting, filtering,
      pagination, inline editing, and keyboard navigation. Built as a framework-agnostic web component.
    </p>
    <p>
      <strong>Key Features:</strong> Multi-column sorting, per-column filtering, inline editing with 7 editor types,
      spreadsheet-like keyboard navigation, row toolbar, context menu, and dark mode support.
    </p>
  </div>
</div>

<!-- Basic Example -->
<div class="pa-card">
  <div class="pa-card__header">
    <h3>Basic Grid</h3>
  </div>
  <div class="pa-card__body">
    <web-grid id="basic-grid" striped hoverable></web-grid>
    <small class="pa-form-text">Simple grid with striped rows and hover effect</small>
  </div>
</div>

<!-- Sortable Grid -->
<div class="pa-card">
  <div class="pa-card__header">
    <h3>Sorting</h3>
  </div>
  <div class="pa-card__body">
    <div class="pa-row">
      <div class="pa-col-100 pa-col-md-50">
        <h4>Single Column Sort</h4>
        <web-grid id="single-sort-grid" striped hoverable></web-grid>
        <small class="pa-form-text">Click column headers to sort</small>
      </div>
      <div class="pa-col-100 pa-col-md-50">
        <h4>Multi-Column Sort</h4>
        <web-grid id="multi-sort-grid" striped hoverable></web-grid>
        <small class="pa-form-text">Hold Ctrl/Cmd and click to sort by multiple columns</small>
      </div>
    </div>
  </div>
</div>

<!-- Filterable Grid -->
<div class="pa-card">
  <div class="pa-card__header">
    <h3>Filtering</h3>
  </div>
  <div class="pa-card__body">
    <web-grid id="filterable-grid" striped hoverable></web-grid>
    <small class="pa-form-text">Type in the filter row to filter data</small>
  </div>
</div>

<!-- Paginated Grid -->
<div class="pa-card">
  <div class="pa-card__header">
    <h3>Pagination</h3>
  </div>
  <div class="pa-card__body">
    <web-grid id="paginated-grid" striped hoverable></web-grid>
    <small class="pa-form-text">Navigate through pages using the pagination controls</small>
  </div>
</div>

<!-- Editable Grid -->
<div class="pa-card">
  <div class="pa-card__header">
    <h3>Inline Editing</h3>
  </div>
  <div class="pa-card__body">
    <web-grid id="editable-grid" striped hoverable></web-grid>
    <small class="pa-form-text">Double-click cells to edit. Supports text, number, select, checkbox, and date editors.</small>
  </div>
</div>

<!-- Row Toolbar Grid -->
<div class="pa-card">
  <div class="pa-card__header">
    <h3>Row Toolbar</h3>
  </div>
  <div class="pa-card__body">
    <web-grid id="toolbar-grid" striped hoverable></web-grid>
    <small class="pa-form-text">Hover over rows to see the action toolbar</small>
  </div>
</div>

<!-- Context Menu Grid -->
<div class="pa-card">
  <div class="pa-card__header">
    <h3>Context Menu</h3>
  </div>
  <div class="pa-card__body">
    <web-grid id="context-menu-grid" striped hoverable></web-grid>
    <small class="pa-form-text">Right-click on rows to open the context menu</small>
  </div>
</div>

<!-- Full Featured Grid -->
<div class="pa-card">
  <div class="pa-card__header">
    <h3>Full Featured Example</h3>
  </div>
  <div class="pa-card__body">
    <web-grid id="full-grid" striped hoverable></web-grid>
    <small class="pa-form-text">Combines sorting, filtering, pagination, editing, toolbar, and context menu</small>
  </div>
</div>

<!-- Documentation -->
<div class="pa-card">
  <div class="pa-card__header">
    <h3>Resources</h3>
  </div>
  <div class="pa-card__body">
    <ul>
      <li><strong>npm Package:</strong> <code>@keenmate/web-grid</code></li>
      <li><strong>Repository:</strong> <a href="https://github.com/keenmate/web-grid" target="_blank">github.com/keenmate/web-grid</a></li>
      <li><strong>CSS Variables:</strong> Uses <code>--wg-*</code> prefix (component) and <code>--base-*</code> prefix (theme integration)</li>
      <li><strong>Theming:</strong> Pure Admin provides <code>--base-*</code> variables via <code>src/scss/_base-css-variables.scss</code></li>
    </ul>
  </div>
</div>

<script type="module">
// Sample data
const employees = [
  { id: 1, name: 'Alice Johnson', department: 'Engineering', salary: 95000, hired: '2020-03-15', active: true },
  { id: 2, name: 'Bob Smith', department: 'Marketing', salary: 72000, hired: '2019-07-22', active: true },
  { id: 3, name: 'Carol Williams', department: 'Engineering', salary: 105000, hired: '2018-01-10', active: true },
  { id: 4, name: 'David Brown', department: 'Sales', salary: 68000, hired: '2021-11-05', active: false },
  { id: 5, name: 'Eva Martinez', department: 'HR', salary: 62000, hired: '2022-02-28', active: true },
  { id: 6, name: 'Frank Garcia', department: 'Engineering', salary: 88000, hired: '2020-09-14', active: true },
  { id: 7, name: 'Grace Lee', department: 'Marketing', salary: 75000, hired: '2019-04-03', active: true },
  { id: 8, name: 'Henry Wilson', department: 'Sales', salary: 82000, hired: '2017-08-19', active: true },
  { id: 9, name: 'Ivy Chen', department: 'Engineering', salary: 110000, hired: '2016-12-01', active: true },
  { id: 10, name: 'Jack Taylor', department: 'HR', salary: 58000, hired: '2023-01-15', active: true },
  { id: 11, name: 'Karen Davis', department: 'Sales', salary: 71000, hired: '2021-06-20', active: false },
  { id: 12, name: 'Leo Anderson', department: 'Marketing', salary: 79000, hired: '2020-04-08', active: true }
];

const basicColumns = [
  { field: 'id', title: 'ID', width: '60px' },
  { field: 'name', title: 'Name' },
  { field: 'department', title: 'Department' },
  { field: 'salary', title: 'Salary', formatCallback: (v) => '$' + v.toLocaleString() },
  { field: 'active', title: 'Active', formatCallback: (v) => v ? 'Yes' : 'No' }
];

// Basic Grid
const basicGrid = document.getElementById('basic-grid');
basicGrid.items = employees.slice(0, 5);
basicGrid.columns = basicColumns;

// Single Sort Grid
const singleSortGrid = document.getElementById('single-sort-grid');
singleSortGrid.items = [...employees];
singleSortGrid.columns = basicColumns;
singleSortGrid.sortMode = 'single';

// Multi Sort Grid
const multiSortGrid = document.getElementById('multi-sort-grid');
multiSortGrid.items = [...employees];
multiSortGrid.columns = basicColumns;
multiSortGrid.sortMode = 'multi';

// Filterable Grid
const filterableGrid = document.getElementById('filterable-grid');
filterableGrid.items = [...employees];
filterableGrid.columns = basicColumns.map(col => ({ ...col, filterable: true }));
filterableGrid.filterable = true;
filterableGrid.sortMode = 'single';

// Paginated Grid
const paginatedGrid = document.getElementById('paginated-grid');
paginatedGrid.items = [...employees];
paginatedGrid.columns = basicColumns;
paginatedGrid.pageable = true;
paginatedGrid.pageSize = 5;
paginatedGrid.sortMode = 'single';

// Editable Grid
const editableGrid = document.getElementById('editable-grid');
editableGrid.items = employees.slice(0, 5).map(e => ({ ...e }));
editableGrid.columns = [
  { field: 'id', title: 'ID', width: '60px', editable: false },
  { field: 'name', title: 'Name', editable: true, editor: 'text' },
  { field: 'department', title: 'Department', editable: true, editor: 'select', editorOptions: {
    options: [
      { value: 'Engineering', label: 'Engineering' },
      { value: 'Marketing', label: 'Marketing' },
      { value: 'Sales', label: 'Sales' },
      { value: 'HR', label: 'HR' }
    ]
  }},
  { field: 'salary', title: 'Salary', editable: true, editor: 'number', formatCallback: (v) => '$' + v.toLocaleString() },
  { field: 'hired', title: 'Hired', editable: true, editor: 'date' },
  { field: 'active', title: 'Active', editable: true, editor: 'checkbox' }
];
editableGrid.editable = true;
editableGrid.editTrigger = 'dblclick';
editableGrid.addEventListener('rowchange', (e) => {
  console.log('Row changed:', e.detail);
});

// Row Toolbar Grid
const toolbarGrid = document.getElementById('toolbar-grid');
toolbarGrid.items = employees.slice(0, 5).map(e => ({ ...e }));
toolbarGrid.columns = basicColumns;
toolbarGrid.showRowToolbar = true;
toolbarGrid.rowToolbar = [
  'add',
  'duplicate',
  'delete',
  {
    id: 'view',
    icon: '👁️',
    title: 'View Details',
    onclick: ({ row }) => alert(`Viewing: ${row.name}`)
  }
];
toolbarGrid.addEventListener('rowaction', (e) => {
  console.log('Row action:', e.detail);
});

// Context Menu Grid
const contextMenuGrid = document.getElementById('context-menu-grid');
contextMenuGrid.items = employees.slice(0, 5).map(e => ({ ...e }));
contextMenuGrid.columns = basicColumns;
contextMenuGrid.contextMenu = [
  { id: 'view', label: 'View Details', icon: '👁️', onclick: ({ row }) => alert(`Viewing: ${row.name}`) },
  { id: 'edit', label: 'Edit', icon: '✏️', onclick: ({ row }) => alert(`Editing: ${row.name}`) },
  { id: 'delete', label: 'Delete', icon: '🗑️', danger: true, onclick: ({ row }) => alert(`Deleting: ${row.name}`) }
];

// Full Featured Grid
const fullGrid = document.getElementById('full-grid');
fullGrid.items = [...employees];
fullGrid.columns = [
  { field: 'id', title: 'ID', width: '60px', filterable: true },
  { field: 'name', title: 'Name', filterable: true, editable: true, editor: 'text' },
  { field: 'department', title: 'Department', filterable: true, editable: true, editor: 'select', editorOptions: {
    options: [
      { value: 'Engineering', label: 'Engineering' },
      { value: 'Marketing', label: 'Marketing' },
      { value: 'Sales', label: 'Sales' },
      { value: 'HR', label: 'HR' }
    ]
  }},
  { field: 'salary', title: 'Salary', filterable: true, editable: true, editor: 'number', formatCallback: (v) => '$' + v.toLocaleString() },
  { field: 'hired', title: 'Hired', filterable: true, editable: true, editor: 'date' },
  { field: 'active', title: 'Active', editable: true, editor: 'checkbox', formatCallback: (v) => v ? 'Yes' : 'No' }
];
fullGrid.sortMode = 'multi';
fullGrid.filterable = true;
fullGrid.pageable = true;
fullGrid.pageSize = 5;
fullGrid.editable = true;
fullGrid.editTrigger = 'dblclick';
fullGrid.showRowToolbar = true;
fullGrid.rowToolbar = ['add', 'duplicate', 'delete'];
fullGrid.contextMenu = [
  { id: 'view', label: 'View Details', icon: '👁️', onclick: ({ row }) => alert(`Viewing: ${row.name}`) },
  { id: 'edit', label: 'Edit Row', icon: '✏️', onclick: ({ row }) => alert(`Editing: ${row.name}`) },
  { id: 'delete', label: 'Delete', icon: '🗑️', danger: true, onclick: ({ row }) => confirm(`Delete ${row.name}?`) }
];
</script>
