            <!-- Usage Examples -->
            <div class="pa-card">
                <div class="pa-card__header">
                    <h3>Usage Guide</h3>
                </div>
                <div class="pa-card__body">
                    <h4>Ripple Effect</h4>
                    <p>Add <code>pa-btn--ripple</code> class and <code>data-ripple</code> attribute to any button for click animation feedback.</p>

                    <h4>Loading States</h4>
                    <p>Use <code>pa-btn--loading</code> class to show spinner. JavaScript can toggle this class during async operations.</p>

                    <h4>Best Practices</h4>
                    <ul>
                        <li><strong>Fast Sites:</strong> Always show loading feedback, even for quick operations (200-500ms minimum)</li>
                        <li><strong>User Confidence:</strong> Ripple effects confirm button clicks were registered</li>
                        <li><strong>Prevent Double-clicks:</strong> Disable buttons during loading to prevent duplicate submissions</li>
                        <li><strong>Accessibility:</strong> Loading states are announced to screen readers</li>
                    </ul>
                </div>
            </div>

            <script>
            // Ripple Effect Implementation
            document.addEventListener('DOMContentLoaded', function() {
                function addRippleEffect(button) {
                    button.addEventListener('click', function(e) {
                        // Add ripple active class
                        this.classList.add('pa-btn--ripple-active');

                        // Remove the class after animation completes
                        setTimeout(() => {
                            this.classList.remove('pa-btn--ripple-active');
                        }, 600);
                    });
                }

                function addLoadingDemo(button) {
                    button.addEventListener('click', function() {
                        if (this.classList.contains('pa-btn--loading')) return;

                        // Add spinner and toggle loading class — CSS handles text hiding via font-size: 0
                        const spinner = document.createElement('span');
                        spinner.className = 'pa-btn__spinner';
                        this.appendChild(spinner);
                        this.classList.add('pa-btn--loading');
                        this.disabled = true;

                        // Simulate async operation (1-3 seconds)
                        const loadingTime = Math.random() * 2000 + 1000;

                        setTimeout(() => {
                            this.classList.remove('pa-btn--loading');
                            spinner.remove();
                            this.disabled = false;
                        }, loadingTime);
                    });
                }

                // Initialize ripple effects
                document.querySelectorAll('[data-ripple]').forEach(addRippleEffect);

                // Initialize loading demos
                document.querySelectorAll('[data-loading-demo]').forEach(addLoadingDemo);
            });
            </script>

            <!-- Popconfirm support for split button demo -->
            <script>
            let currentPopconfirm = null;
            let currentTrigger = null;

            function togglePopconfirm(event, popconfirmId) {
                event.stopPropagation();
                event.preventDefault();
                const trigger = event.currentTarget;
                const popconfirm = document.getElementById(popconfirmId);

                if (currentPopconfirm && currentPopconfirm !== popconfirm) {
                    currentPopconfirm.classList.remove('is-open');
                }

                if (popconfirm.classList.contains('is-open')) {
                    popconfirm.classList.remove('is-open');
                    currentPopconfirm = null;
                    currentTrigger = null;
                } else {
                    positionPopconfirm(trigger, popconfirm);
                    popconfirm.classList.add('is-open');
                    currentPopconfirm = popconfirm;
                    currentTrigger = trigger;
                }
            }

            function closePopconfirm(popconfirmId, event) {
                if (event) event.stopPropagation();
                const popconfirm = document.getElementById(popconfirmId);
                popconfirm.classList.remove('is-open');
                if (currentPopconfirm === popconfirm) {
                    currentPopconfirm = null;
                    currentTrigger = null;
                }
            }

            let memberCounter = 3;
            const memberNames = ['Dave Grohl', 'Eve Torres', 'Frank Zappa', 'Grace Slick', 'Hank Williams', 'Iggy Pop', 'Janis Joplin', 'Kurt Cobain'];

            function addMember() {
                memberCounter++;
                const name = memberNames[(memberCounter - 4) % memberNames.length];
                const pcId = `pc-member-${memberCounter}`;

                // Create menu row
                const row = document.createElement('div');
                row.className = 'pa-btn-split__item-row';
                row.innerHTML = `
                    <button class="pa-btn-split__item">
                        <span class="pa-btn-split__item-icon"><i class="fas fa-user"></i></span>
                        ${name}
                    </button>
                    <button class="pa-btn pa-btn--danger pa-btn--xs pa-btn--icon-only"
                        onclick="togglePopconfirm(event, '${pcId}')">
                        <i class="fas fa-trash-can"></i>
                    </button>`;

                // Create popconfirm
                const pc = document.createElement('div');
                pc.id = pcId;
                pc.className = 'pa-popconfirm pa-popconfirm--bottom pa-popconfirm--compact';
                pc.innerHTML = `
                    <div class="pa-popconfirm__arrow"></div>
                    <div class="pa-popconfirm__content">
                        <div class="pa-popconfirm__message pa-popconfirm__icon pa-popconfirm__icon--danger">
                            <p>Remove ${name}?</p>
                        </div>
                        <div class="pa-popconfirm__actions">
                            <button class="pa-btn pa-btn--secondary" onclick="closePopconfirm('${pcId}', event)">Cancel</button>
                            <button class="pa-btn pa-btn--danger" onclick="confirmRemoveMember(this, '${pcId}')">Remove</button>
                        </div>
                    </div>`;

                // Add row to the menu
                const menu = document.getElementById('members-split').querySelector('.pa-btn-split__menu-inner');
                menu.appendChild(row);

                // Add popconfirm to body
                document.body.appendChild(pc);
            }

            function confirmRemoveMember(btn, popconfirmId) {
                closePopconfirm(popconfirmId);
                // Find the delete button inside the split menu that triggers this popconfirm
                const triggerBtn = document.querySelector(`.pa-btn-split__menu [onclick*="togglePopconfirm"][onclick*="${popconfirmId}"]`);
                if (triggerBtn) triggerBtn.closest('.pa-btn-split__item-row').remove();
                // Remove the popconfirm element
                const pc = document.getElementById(popconfirmId);
                if (pc) pc.remove();
            }

            async function positionPopconfirm(trigger, popconfirm) {
                // Popconfirm classes use logical sides (start/end); Floating UI
                // speaks physical (left/right), so translate both ways.
                const isRtl = document.documentElement.dir === 'rtl';
                const toPhysical = { top: 'top', bottom: 'bottom', start: isRtl ? 'right' : 'left', end: isRtl ? 'left' : 'right' };
                const toLogical  = { top: 'top', bottom: 'bottom', left: isRtl ? 'end' : 'start', right: isRtl ? 'start' : 'end' };

                const classMatch = popconfirm.className.match(/pa-popconfirm--(top|bottom|start|end)/);
                const logical = classMatch ? classMatch[1] : 'bottom';
                const placement = toPhysical[logical];
                const { computePosition, flip, shift, offset } = window.FloatingUIDOM;

                const { x, y, placement: finalPlacement } = await computePosition(trigger, popconfirm, {
                    placement,
                    middleware: [offset(8), flip(), shift({ padding: 10 })]
                });

                const finalLogical = toLogical[finalPlacement.split('-')[0]] || 'bottom';
                popconfirm.className = popconfirm.className
                    .replace(/pa-popconfirm--(top|bottom|start|end)/g, '').trim()
                    + ' pa-popconfirm--' + finalLogical;
                Object.assign(popconfirm.style, { left: `${x}px`, top: `${y}px` });
            }

            document.addEventListener('click', (e) => {
                if (currentPopconfirm && !currentPopconfirm.contains(e.target) &&
                    e.target !== currentTrigger && !currentTrigger?.contains(e.target)) {
                    currentPopconfirm.classList.remove('is-open');
                    currentPopconfirm = null;
                    currentTrigger = null;
                }
            });
            </script>

