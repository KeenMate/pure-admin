    </div>
</div>

<script type="module">
customElements.whenDefined('web-grid').then(() => {
    const grid = document.getElementById('detail-grid')
    const panel = document.getElementById('gridDetailPanel')
    const title = document.getElementById('gridDetailTitle')
    const body = document.getElementById('gridDetailBody')
    const closeBtn = document.getElementById('gridDetailClose')

    if (!grid || !panel) return

    // Column subset (read-only)
    const columns = [
        { field: 'id', title: 'ID', width: '70px', horizontalAlign: 'center' },
        { field: 'name', title: 'Name', width: '140px' },
        { field: 'department', title: 'Department', width: '120px' },
        { field: 'salary', title: 'Salary', width: '100px', horizontalAlign: 'right', formatCallback: v => v != null ? `$${v.toLocaleString()}` : '' },
        { field: 'status', title: 'Status', width: '100px' },
        { field: 'location', title: 'Location', width: '120px' }
    ]

    // Inline sample data (self-contained — no dependency on data-grid page)
    const gridData = [
        { id: 1847, name: 'Alice Johnson', email: 'alice@example.com', department: 'Engineering', salary: 85000, startDate: '2020-03-15', status: 'Active', location: 'New York' },
        { id: 1848, name: 'Bob Smith', email: 'bob@example.com', department: 'Marketing', salary: 72000, startDate: '2019-07-22', status: 'Active', location: 'Chicago' },
        { id: 1849, name: 'Carol Williams', email: 'carol@example.com', department: 'Sales', salary: 91000, startDate: '2021-01-10', status: 'Inactive', location: 'Boston' },
        { id: 1850, name: 'David Brown', email: 'david@example.com', department: 'Engineering', salary: 95000, startDate: '2018-11-05', status: 'Active', location: 'Seattle' },
        { id: 1851, name: 'Eva Martinez', email: 'eva@example.com', department: 'Design', salary: 78000, startDate: '2022-04-18', status: 'Active', location: 'Austin' },
        { id: 1852, name: 'Frank Davis', email: 'frank@example.com', department: 'HR', salary: 68000, startDate: '2020-09-30', status: 'Active', location: 'Denver' },
        { id: 1853, name: 'Grace Lee', email: 'grace@example.com', department: 'Engineering', salary: 102000, startDate: '2017-06-12', status: 'Active', location: 'San Francisco' },
        { id: 1854, name: 'Henry Wilson', email: 'henry@example.com', department: 'Support', salary: 62000, startDate: '2023-02-01', status: 'Active', location: 'Miami' },
        { id: 1855, name: 'Iris Taylor', email: 'iris@example.com', department: 'Marketing', salary: 76000, startDate: '2021-08-20', status: 'Inactive', location: 'Portland' },
        { id: 1856, name: 'Jack Anderson', email: 'jack@example.com', department: 'Sales', salary: 88000, startDate: '2019-12-03', status: 'Active', location: 'Dallas' }
    ]

    // Configure grid
    grid.columns = columns
    grid.items = [...gridData]
    grid.isHoverable = true
    grid.isRowNumbersVisible = true

    // Track loading timer
    let loadTimer = null

    function openPanel(row) {
        panel.classList.add('pa-detail-view__panel--open')

        // Show spinner
        title.textContent = 'Loading\u2026'
        body.innerHTML =
            '<div class="pa-loader-center" style="padding: 4rem 0;">' +
                '<div class="pa-spinner"></div>' +
            '</div>'

        if (loadTimer) clearTimeout(loadTimer)

        loadTimer = setTimeout(() => {
            title.textContent = row.name
            body.innerHTML = renderGridDetails(row)
            loadTimer = null
        }, 600)
    }

    function closePanel() {
        if (loadTimer) {
            clearTimeout(loadTimer)
            loadTimer = null
        }
        panel.classList.remove('pa-detail-view__panel--open')
    }

    function renderGridDetails(row) {
        const statusClass = row.status === 'Active' ? 'pa-badge--success' : 'pa-badge--secondary'
        const initial = row.name ? row.name.charAt(0) : '?'
        const salary = row.salary != null ? `$${row.salary.toLocaleString()}` : '\u2014'
        const startDate = row.startDate || '\u2014'

        return `
            <div style="display: flex; align-items: center; gap: 1.2rem; margin-bottom: 1.6rem;">
                <div style="width: 5.6rem; height: 5.6rem; border-radius: 50%; background: var(--pa-accent-light); display: flex; align-items: center; justify-content: center; font-size: 2.4rem; color: var(--pa-accent); flex-shrink: 0;">
                    ${initial}
                </div>
                <div>
                    <div style="font-weight: 600; font-size: 1.6rem; color: var(--pa-text-color-1);">${row.name}</div>
                    <div style="color: var(--pa-text-color-2); font-size: 1.3rem;">${row.email || ''}</div>
                </div>
            </div>

            <table class="pa-table pa-table--sm pa-table--borderless" style="margin-bottom: 0;">
                <tbody>
                    <tr>
                        <td style="width: 40%; color: var(--pa-text-color-2); font-weight: 500;">ID</td>
                        <td>${row.id}</td>
                    </tr>
                    <tr>
                        <td style="color: var(--pa-text-color-2); font-weight: 500;">Department</td>
                        <td>${row.department}</td>
                    </tr>
                    <tr>
                        <td style="color: var(--pa-text-color-2); font-weight: 500;">Salary</td>
                        <td>${salary}</td>
                    </tr>
                    <tr>
                        <td style="color: var(--pa-text-color-2); font-weight: 500;">Start Date</td>
                        <td>${startDate}</td>
                    </tr>
                    <tr>
                        <td style="color: var(--pa-text-color-2); font-weight: 500;">Location</td>
                        <td>${row.location}</td>
                    </tr>
                    <tr>
                        <td style="color: var(--pa-text-color-2); font-weight: 500;">Status</td>
                        <td><span class="pa-badge ${statusClass}">${row.status}</span></td>
                    </tr>
                </tbody>
            </table>
        `
    }

    // Wire up row focus event — fires with { rowIndex, row, previousRowIndex }
    grid.onrowfocus = ({ row }) => {
        openPanel(row)
    }

    // Close button
    closeBtn.addEventListener('click', () => {
        closePanel()
    })

    // Escape key (scoped — only if this panel is open)
    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && panel.classList.contains('pa-detail-view__panel--open')) {
            closePanel()
        }
    })
})
</script>


