                            </button>
                            <button class="pa-btn pa-btn--icon pa-btn--outline-secondary pa-btn--xs" title="Bookmark">
                                <i class="fas fa-bookmark"></i>
                            </button>
                            <button class="pa-btn pa-btn--icon pa-btn--outline-danger pa-btn--xs" title="Delete">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>
                        <button class="pa-detail-panel__close" id="gridDetailClose" aria-label="Close panel">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                    <div class="pa-detail-panel__body" id="gridDetailBody">
