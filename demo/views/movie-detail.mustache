<div style="margin-bottom: 1.6rem;">
    <a href="/showcases/movies" class="pa-btn pa-btn--secondary pa-btn--sm">
        <i class="fas fa-arrow-left"></i> Back to Movies
    </a>
    <span id="movieTitle" style="font-size: 2rem; font-weight: 600; margin-inline-start: 1.2rem;"></span>
</div>

<!-- Row 1: Basic Info + Technical Details -->
<div class="pa-row">
    <div class="pa-col-md-50">
        <div class="pa-card">
            <div class="pa-card__header">
                <h3>Basic Information</h3>
            </div>
            <div class="pa-card__body" id="movieBasicInfo">
                <!-- Rendered by JS -->
            </div>
        </div>
    </div>
    <div class="pa-col-md-50">
        <div class="pa-card">
            <div class="pa-card__header">
                <h3>Technical Details</h3>
            </div>
            <div class="pa-card__body" id="movieTechnicalInfo">
                <!-- Rendered by JS -->
            </div>
        </div>
    </div>
</div>

<!-- Row 2: Cast with inline detail panel -->
<div class="pa-card">
    <div class="pa-card__header">
        <h3>Cast</h3>
    </div>
    <div class="pa-card__body p-0">
        <div class="pa-detail-view">
            <!-- Left: Actors Table -->
            <div class="pa-detail-view__main">
                <table class="pa-table pa-table--hover" id="movieCastTable">
                    <thead>
                        <tr>
                            <th>Actor</th>
                            <th>Role</th>
                            <th>Nationality</th>
                        </tr>
                    </thead>
                    <tbody id="movieActorsBody">
                        <!-- Rendered by JS -->
                    </tbody>
                </table>
            </div>

            <!-- Right: Actor Detail Panel -->
            <div class="pa-detail-view__panel" id="actorDetailPanel">
                <div class="pa-detail-panel__content">
                    <div class="pa-detail-panel-resize"></div>
                    <div class="pa-detail-panel__header">
                        <h4 class="pa-detail-panel__title" id="actorPanelTitle">Select an actor</h4>
                        <button class="pa-detail-panel__close" onclick="closeActorPanel()" aria-label="Close panel">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                    <div class="pa-detail-panel__body" id="actorPanelBody">
                        <p class="text-secondary">Click an actor row to view details here.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="/src/js/movies.js"></script>
<script src="/src/js/movie-detail.js"></script>
