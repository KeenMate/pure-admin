<!-- Fixed Navbar -->
<nav class="pc-navbar">
    <div class="pc-navbar__inner">
        <!-- Hamburger — a FIXED anchor (no data-pc-fit), so it lives OUTSIDE the
             degradable start/center/end zones as __inner's first child. Omitted
             in the sidebar-less "simple" layout (nothing to toggle). -->
        {{^simpleLayout}}
        <button class="pc-navbar__burger burger-menu" onclick="toggleSidebar()" aria-label="Toggle sidebar">
            <span></span>
            <span></span>
            <span></span>
        </button>
        {{/simpleLayout}}

        <!-- Start Section: Brand, Start Nav -->
        <div class="pc-navbar__start">
            <!-- Brand. The wordmark is a fit "steps" slot (Pure Admin → PA) and
                 the version tag a fit "hide" slot, so as the header narrows the
                 version drops first (priority 10), then the wordmark shrinks to
                 a monogram (priority 30). See fit.js. -->
            <div class="pc-app-header">
                <h1><span class="pc-app-header__name" data-pc-fit="steps" data-pc-fit-priority="30"><span data-pc-fit-step="0">Pure Admin</span><span data-pc-fit-step="1" class="pc-fit-hidden">PA</span></span>{{#coreVersion}}<span class="pc-app-header__version" data-pc-fit="hide" data-pc-fit-priority="10">v{{coreVersion}}</span>{{/coreVersion}}</h1>
            </div>

            <!-- Left Navigation Links. data-pc-fit-nav="sidebar" moves the
                 lowest-priority items into the sidebar (as standard
                 .pc-sidebar__* items under a "Menu" section heading) as the
                 header narrows, restoring them as it widens — the one Fit engine
                 (fit.js) now owns nav collapse too. The active item is
                 auto-pinned; Dashboard is also explicitly pinned via
                 data-pc-fit-nav-priority. Omitted in the simple layout — it
                 folds into a sidebar that isn't there. -->
            {{^simpleLayout}}
            <nav class="pc-navmenu" data-pc-fit-nav="sidebar" data-pc-fit-nav-label="Menu">
                <ul>
                    <li class="pc-navmenu__item{{#isDashboard}} pc-navmenu__item--active{{/isDashboard}}" data-pc-fit-nav-priority="10" data-pc-nav-icon="📊"><a href="/">Dashboard</a></li>
                    <li class="pc-navmenu__item pc-navmenu__item--has-dropdown{{#isComponents}} pc-navmenu__item--active{{/isComponents}}" data-pc-nav-icon="🧩">
                        <a href="/components/overview" class="pc-navmenu__link">Components</a>
                        <ul class="pc-navmenu__dropdown">
                            <li><a href="/components/buttons">Buttons</a></li>
                            <li><a href="/components/cards">Cards</a></li>
                            <li><a href="/components/tabs">Tabs</a></li>
                            <li class="pc-navmenu__item pc-navmenu__item--has-dropdown">
                                <a href="#" class="pc-navmenu__link">More ›</a>
                                <ul class="pc-navmenu__dropdown pc-navmenu__dropdown--level2">
                                    <li><a href="/components/badges">Badges</a></li>
                                    <li><a href="/components/modals">Modals</a></li>
                                    <li><a href="/components/loaders">Loaders</a></li>
                                    <li><a href="/components/toasts">Toasts</a></li>
                                </ul>
                            </li>
                        </ul>
                    </li>
                    <li class="pc-navmenu__item pc-navmenu__item--has-dropdown{{#isForms}} pc-navmenu__item--active{{/isForms}}" data-pc-nav-icon="📝">
                        <a href="/forms" class="pc-navmenu__link">Forms</a>
                        <ul class="pc-navmenu__dropdown">
                            <li><a href="/forms">Form Elements</a></li>
                            <li><a href="/components/inputs">Inputs</a></li>
                            <li><a href="/components/validations">Validations</a></li>
                            <li class="pc-navmenu__item pc-navmenu__item--has-dropdown">
                                <a href="#" class="pc-navmenu__link">Selectors ›</a>
                                <ul class="pc-navmenu__dropdown pc-navmenu__dropdown--level2">
                                    <li><a href="/components/multiselect">Multiselect</a></li>
                                    <li><a href="/components/date-picker">Date Picker</a></li>
                                    <li><a href="/components/checkbox-lists">Checkbox Lists</a></li>
                                    <li><a href="/components/file-selector">File Upload</a></li>
                                </ul>
                            </li>
                        </ul>
                    </li>
                    <li class="pc-navmenu__item pc-navmenu__item--has-dropdown" data-pc-nav-icon="📋">
                        <a href="/tables/standard" class="pc-navmenu__link">Data</a>
                        <ul class="pc-navmenu__dropdown">
                            <li><a href="/tables/standard">Tables</a></li>
                            <li><a href="/components/data-grid">Data Grid</a></li>
                            <li><a href="/components/lists">Lists</a></li>
                            <li class="pc-navmenu__item pc-navmenu__item--has-dropdown">
                                <a href="#" class="pc-navmenu__link">Visualize ›</a>
                                <ul class="pc-navmenu__dropdown pc-navmenu__dropdown--level2">
                                    <li><a href="/components/data-display">Data Display</a></li>
                                    <li><a href="/components/data-visualization">Data Visualization</a></li>
                                    <li><a href="/kpi/bento">KPI · Bento</a></li>
                                    <li><a href="/kpi/sparkline-list">KPI · Sparklines</a></li>
                                </ul>
                            </li>
                        </ul>
                    </li>
                    <!-- data-pc-fit-nav="hide": rather than fold into the
                         sidebar when space runs out, this item just hides. Fitting
                         here because its children (Theme Variables, Colors,
                         Helpers) already live in the main sidebar, so nothing is
                         lost when it disappears on narrow screens. -->
                    <li class="pc-navmenu__item pc-navmenu__item--has-dropdown" data-pc-nav-icon="🎨" data-pc-fit-nav="hide">
                        <a href="/design/theme-variables" class="pc-navmenu__link">Design</a>
                        <ul class="pc-navmenu__dropdown">
                            <li><a href="/design/theme-variables">Theme Variables</a></li>
                            <li><a href="/design/colors">Colors</a></li>
                            <li><a href="/design/helpers">Helpers</a></li>
                            <li><a href="/design/layouts">Layouts</a></li>
                        </ul>
                    </li>
                </ul>
            </nav>
            {{/simpleLayout}}
        </div>

        <!-- Center Section: Page Title (flexible) -->
        <!-- Search position "A" (inline navbar search) swaps the title for a live
             search box; toggled by the settings panel via #navbarTitle / #navbarSearchInline. -->
        <div class="pc-navbar__center">
            <div class="pc-page-header" id="navbarTitle" data-pc-fit="hide" data-pc-fit-priority="20">
                <h2>{{#pageTitle}}{{pageTitle}}{{/pageTitle}}{{^pageTitle}}Dashboard{{/pageTitle}}</h2>
            </div>

            <!-- A) Inline navbar search: a live search box with its own results
                 dropdown (independent of the Ctrl+K palette). Hidden until selected. -->
            <div class="pc-navbar-search pc-navbar-search--field" id="navbarSearchInline" hidden>
                <span class="pc-navbar-search__icon" aria-hidden="true">🔍</span>
                <input type="text" class="pc-navbar-search__field" id="navbarSearchInput"
                       placeholder="Search products, orders, users…" autocomplete="off" aria-label="Search">
                <div class="pa-search-autocomplete" id="navbarSearchResults" hidden></div>
            </div>
        </div>

        <!-- End Section: End Nav, Notifications, Profile.
             data-pc-fit-auto arms the zone: every child joins the fit set, so the
             search folds by its own priority (25) while the End nav, bell and
             profile are held put with data-pc-fit-ignore (must stay reachable). -->
        <div class="pc-navbar__end" data-pc-fit-auto>
            <!-- B) Compact search box before the bell: opens the Ctrl+K palette
                 (which becomes a fullscreen sheet on phones). Hidden until selected. -->
            <button type="button" class="pc-navbar-search" id="navbarSearchTrigger" hidden
                    data-pc-fit="hide" data-pc-fit-priority="25"
                    onclick="window.pureAdmin && pureAdmin.commandPalette && pureAdmin.commandPalette.open()"
                    aria-label="Search (Ctrl+K)">
                <span class="pc-navbar-search__icon" aria-hidden="true">🔍</span>
                <span class="pc-navbar-search__placeholder">Search…</span>
                <span class="pc-navbar-search__shortcut"><kbd>Ctrl</kbd><kbd>K</kbd></span>
            </button>

            <!-- D) Type-and-go search box: a real input in a <form>; Enter submits
                 (native GET) and navigates to /search?q=… — no dropdown, no palette.
                 This is pure HTML/CSS: an app wires its own action/route. Hidden
                 until selected. -->
            <form class="pc-navbar-search pc-navbar-search--input" id="navbarSearchGo" hidden
                  data-pc-fit="hide" data-pc-fit-priority="25"
                  action="/search" method="get" role="search">
                <span class="pc-navbar-search__icon" aria-hidden="true">🔍</span>
                <input type="search" name="q" class="pc-navbar-search__field"
                       placeholder="Search…" autocomplete="off" aria-label="Search">
            </form>

            <!-- End Navigation Links -->
            <nav class="pc-navmenu" data-pc-fit-ignore>
                <ul>
                    <li><a href="/components/alerts">Alerts</a></li>
                    <li><a href="/tables/standard">Tables</a></li>
                </ul>
            </nav>

            <!-- Notification Bell -->
            <div class="pa-notifications" data-pc-fit-ignore>
                <button class="pa-notifications__btn" onclick="toggleNotifications()" aria-label="Notifications">
                    <span class="pa-notifications__icon">🔔</span>
                    <span class="pa-notifications__badge">3</span>
                </button>

                <div class="pa-notifications__panel" id="notificationsPanel">
                    <div class="pa-notifications__header">
                        <h3>Notifications</h3>
                        <button class="pa-notifications__mark-read" onclick="markAllRead()">Mark all as read</button>
                    </div>
                    <ul class="pa-notifications__list">
                        <li class="pa-notifications__item pa-notifications__item--unread">
                            <div class="pa-notifications__icon-wrapper pa-notifications__icon-wrapper--primary">
                                📝
                            </div>
                            <div class="pa-notifications__content">
                                <h4>New task assigned</h4>
                                <p>Review the Q4 report by end of week</p>
                                <span class="pa-notifications__time">2 minutes ago</span>
                            </div>
                        </li>
                        <li class="pa-notifications__item pa-notifications__item--unread">
                            <div class="pa-notifications__icon-wrapper pa-notifications__icon-wrapper--success">
                                ✓
                            </div>
                            <div class="pa-notifications__content">
                                <h4>Build completed</h4>
                                <p>Production deployment finished successfully</p>
                                <span class="pa-notifications__time">15 minutes ago</span>
                            </div>
                        </li>
                        <li class="pa-notifications__item pa-notifications__item--unread">
                            <div class="pa-notifications__icon-wrapper pa-notifications__icon-wrapper--warning">
                                ⚠️
                            </div>
                            <div class="pa-notifications__content">
                                <h4>Server maintenance</h4>
                                <p>Scheduled downtime tonight at 11 PM</p>
                                <span class="pa-notifications__time">1 hour ago</span>
                            </div>
                        </li>
                        <li class="pa-notifications__item">
                            <div class="pa-notifications__icon-wrapper pa-notifications__icon-wrapper--secondary">
                                💬
                            </div>
                            <div class="pa-notifications__content">
                                <h4>New comment</h4>
                                <p>Sarah replied to your comment on Issue #432</p>
                                <span class="pa-notifications__time">3 hours ago</span>
                            </div>
                        </li>
                    </ul>
                    <div class="pa-notifications__footer">
                        <a href="/components/notifications">View all notifications</a>
                    </div>
                </div>
            </div>

            <!-- Profile Button -->
            <button class="pc-navbar__profile-btn" data-pc-fit-ignore onclick="toggleProfilePanel()" aria-label="User Profile">
                <span class="pa-btn__icon">👤</span>
                <span class="pc-navbar__profile-name">John Doe</span>
            </button>
        </div>
    </div>
</nav>
