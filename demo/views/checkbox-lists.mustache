<!-- Interactive Demo -->
<div class="pa-card">
    <div class="pa-card__header">
        <h3>Interactive Demo</h3>
        <p>Select-all functionality and row selection</p>
    </div>
    <div class="pa-card__body pa-card__body--no-padding">
        <table class="pa-table pa-table--striped" id="interactive-table">
            <thead>
                <tr>
                    <th class="pa-table__checkbox-col">
                        <span class="pa-checkbox"><input type="checkbox" id="select-all-demo"><span class="pa-checkbox__box"></span></span>
                    </th>
                    <th>Product</th>
                    <th>SKU</th>
                    <th>Price</th>
                    <th>Stock</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td class="pa-table__checkbox-col">
                        <span class="pa-checkbox"><input type="checkbox" class="row-checkbox-demo"><span class="pa-checkbox__box"></span></span>
                    </td>
                    <td>Laptop Pro 15"</td>
                    <td>LPT-001</td>
                    <td>$1,299</td>
                    <td><span class="pa-badge pa-badge--success">In Stock</span></td>
                </tr>
                <tr>
                    <td class="pa-table__checkbox-col">
                        <span class="pa-checkbox"><input type="checkbox" class="row-checkbox-demo"><span class="pa-checkbox__box"></span></span>
                    </td>
                    <td>Wireless Mouse</td>
                    <td>MSE-042</td>
                    <td>$29</td>
                    <td><span class="pa-badge pa-badge--success">In Stock</span></td>
                </tr>
                <tr>
                    <td class="pa-table__checkbox-col">
                        <span class="pa-checkbox"><input type="checkbox" class="row-checkbox-demo"><span class="pa-checkbox__box"></span></span>
                    </td>
                    <td>USB-C Hub</td>
                    <td>HUB-123</td>
                    <td>$49</td>
                    <td><span class="pa-badge pa-badge--warning">Low Stock</span></td>
                </tr>
                <tr>
                    <td class="pa-table__checkbox-col">
                        <span class="pa-checkbox"><input type="checkbox" class="row-checkbox-demo"><span class="pa-checkbox__box"></span></span>
                    </td>
                    <td>Monitor 27"</td>
                    <td>MON-789</td>
                    <td>$399</td>
                    <td><span class="pa-badge pa-badge--danger">Out of Stock</span></td>
                </tr>
                <tr>
                    <td class="pa-table__checkbox-col">
                        <span class="pa-checkbox"><input type="checkbox" class="row-checkbox-demo"><span class="pa-checkbox__box"></span></span>
                    </td>
                    <td>Keyboard Mechanical</td>
                    <td>KBD-555</td>
                    <td>$89</td>
                    <td><span class="pa-badge pa-badge--success">In Stock</span></td>
                </tr>
            </tbody>
        </table>
    </div>
    <div class="pa-card__footer">
        <div id="selection-info" style="font-size: 0.875rem; color: var(--base-text-color-3);">
            0 items selected
        </div>
    </div>
</div>

<script>
// Select-all functionality
document.getElementById('select-all-demo').addEventListener('change', function() {
    const checkboxes = document.querySelectorAll('.row-checkbox-demo');
    const isChecked = this.checked;

    checkboxes.forEach(checkbox => {
        checkbox.checked = isChecked;
        const row = checkbox.closest('tr');
        if (isChecked) {
            row.classList.add('pa-table__row--selected');
        } else {
            row.classList.remove('pa-table__row--selected');
        }
    });

    updateSelectionInfo();
});

// Individual checkbox handling
document.querySelectorAll('.row-checkbox-demo').forEach(checkbox => {
    checkbox.addEventListener('change', function() {
        const row = this.closest('tr');
        if (this.checked) {
            row.classList.add('pa-table__row--selected');
        } else {
            row.classList.remove('pa-table__row--selected');
        }

        // Update select-all checkbox state
        const allCheckboxes = document.querySelectorAll('.row-checkbox-demo');
        const checkedCheckboxes = document.querySelectorAll('.row-checkbox-demo:checked');
        document.getElementById('select-all-demo').checked = allCheckboxes.length === checkedCheckboxes.length;

        updateSelectionInfo();
    });
});

function updateSelectionInfo() {
    const checkedCount = document.querySelectorAll('.row-checkbox-demo:checked').length;
    document.getElementById('selection-info').textContent = `${checkedCount} item${checkedCount !== 1 ? 's' : ''} selected`;
}
</script>
