        <p>Select-all functionality and row selection</p>
    </div>
    <div class="pa-table-card__body pa-table-card__body--scrollable">
        <table class="pa-table pa-table--striped" id="interactive-table">
            <thead>
                <tr>
                    <th class="pa-table__checkbox-col">
                        <label class="pa-checkbox"><input type="checkbox" id="select-all-demo"><span class="pa-checkbox__box"></span></label>
                    </th>
                    <th>Product</th>
                    <th>SKU</th>
                    <th>Price</th>
                    <th>Stock</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td class="pa-table__checkbox-col">
                        <label class="pa-checkbox"><input type="checkbox" class="row-checkbox-demo"><span class="pa-checkbox__box"></span></label>
                    </td>
