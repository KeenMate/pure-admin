                    <td>HUB-123</td>
                    <td>$49</td>
                    <td><span class="pa-badge pa-badge--warning">Low Stock</span></td>
                </tr>
                <tr>
                    <td class="pa-table__checkbox-col">
                        <label class="pa-checkbox"><input type="checkbox" class="row-checkbox-demo"><span class="pa-checkbox__box"></span></label>
                    </td>
                    <td>Monitor 27"</td>
                    <td>MON-789</td>
                    <td>$399</td>
                    <td><span class="pa-badge pa-badge--danger">Out of Stock</span></td>
                </tr>
