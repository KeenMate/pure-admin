<!-- ============================================================
     pa-stat — fit & priority LAB  (prototype, not framework code)
     Prototypes: (1) container-query priority disclosure,
                 (2) JS fit-to-box for the primary number,
                 (3) why pure cqi can't guarantee the fit.
     All styles/scripts are scoped with the `sfl-` prefix so nothing
     leaks into the framework. Port the winning bits into
     core-components/_statistics.scss once the behaviour is agreed.
     ============================================================ -->

<style>
  /* ---------- THE TILE (the bit we're prototyping) ---------- */
  .sfl-tile{
    container-type:size;            /* width AND height @container queries */
    container-name:sfltile;
    display:flex; flex-direction:column;
    padding:1.4rem 1.6rem;
    border-radius:1rem;
    color:#fff;
    box-shadow:0 4px 10px rgba(0,0,0,.18);
    overflow:hidden;                /* required for resize handle + clipping */
  }
  .sfl-tile--primary  { background:var(--pc-accent); }
  .sfl-tile--success  { background:var(--pc-success-bg); }
  .sfl-tile--info     { background:var(--pc-info-bg); }
  .sfl-tile--secondary{ background:var(--pc-text-color-2); }
  .sfl-tile--danger   { background:var(--pc-danger-bg); }

  /* slot = space the number may fill. flex:1 → grows when the label hides.
     The ResizeObserver watches THIS element. */
  .sfl-slot{
    flex:1 1 auto; min-height:0;
    display:flex; align-items:center; justify-content:flex-start;
  }
  /* number + symbol move as one unit; JS sets font-size on .sfl-group,
     children use em so the symbol tracks the number. */
  .sfl-group{
    white-space:nowrap; line-height:1;
    display:inline-flex; align-items:baseline; gap:.12em;
    font-weight:800;
  }
  .sfl-group .sfl-num{ font-size:1em; }
  .sfl-group .sfl-sym{ font-size:.5em; font-weight:700; opacity:.85; }

  .sfl-label{
    margin-top:.8rem;
    font-size:1.2rem; font-weight:600; text-transform:uppercase; letter-spacing:.05em;
    opacity:.85; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;
  }
  .sfl-change{
    margin-top:.4rem; font-size:1.3rem; font-weight:700; white-space:nowrap;
    overflow:hidden; text-overflow:ellipsis;
  }
  .sfl-change--up::before{ content:"▲ "; }
  .sfl-context{
    margin-top:.4rem; font-size:1.1rem; font-weight:500; opacity:.7; white-space:nowrap;
    overflow:hidden; text-overflow:ellipsis;
  }

  /* ---------- PRIORITY DISCLOSURE (pure CSS, container queries) ----------
     Reveal-based ladder. Everything below P0 is hidden by default and
     REVEALED as the container earns enough width AND height. Drop order
     (shrinking) is the reverse: context → trend → label → symbol → number.
     Gated on BOTH dimensions so a wide-but-short banner doesn't show the
     tall-only tiers. Tune the rem thresholds live. */
  .sfl-tile .sfl-sym,
  .sfl-tile .sfl-label,
  .sfl-tile .sfl-change,
  .sfl-tile .sfl-context{ display:none; }       /* P0 number only by default */

  @container sfltile (min-width: 8rem) and (min-height: 4.5rem){
    .sfl-tile .sfl-sym{ display:inline; }        /* + P1 symbol */
  }
  @container sfltile (min-width: 13rem) and (min-height: 6.5rem){
    .sfl-tile .sfl-label{ display:block; }        /* + P2 label */
  }
  @container sfltile (min-width: 18rem) and (min-height: 9.5rem){
    .sfl-tile .sfl-change{ display:block; }       /* + P3 trend */
  }
  @container sfltile (min-width: 24rem) and (min-height: 13rem){
    .sfl-tile .sfl-context{ display:block; }      /* + P4 context */
  }

  /* ---------- lab chrome ---------- */
  .sfl-playground{ display:flex; gap:2.4rem; flex-wrap:wrap; align-items:flex-start; }
  .sfl-resizable{ resize:both; overflow:hidden; min-width:4.8rem; min-height:4rem; width:40rem; height:22rem; }
  .sfl-tiers{ margin-top:.4rem; font-size:1.2rem; }
  .sfl-tiers .on{ color:var(--pc-success-bg); font-weight:700; }
  .sfl-tiers .off{ color:var(--pc-text-color-2); text-decoration:line-through; opacity:.6; }
  .sfl-dims{ font-family:ui-monospace,Menlo,Consolas,monospace; color:var(--pc-text-color-2); margin-top:.8rem; }
  .sfl-controls{ margin-top:1rem; display:flex; gap:.8rem; flex-wrap:wrap; }

  .sfl-matrix{ display:flex; gap:1.6rem; flex-wrap:wrap; align-items:flex-start; }
  .sfl-matrix figure{ margin:0; }
  .sfl-matrix figcaption{ font-family:ui-monospace,monospace; font-size:1.2rem; color:var(--pc-text-color-2); margin-top:.6rem; text-align:center; }
  .sfl-lg{ width:30rem; height:14rem; } .sfl-md{ width:20rem; height:9.6rem; }
  .sfl-sm{ width:13rem; height:7rem; }  .sfl-xs{ width:7.8rem; height:4.8rem; } .sfl-banner{ width:52rem; height:8rem; }

  /* cqi comparison (pure CSS, no JS) */
  .sfl-cqi{
    container-type:inline-size;
    display:flex; align-items:center; justify-content:flex-start;
    padding:1.4rem 1.6rem; border-radius:1rem; color:#fff; background:var(--pc-text-color-2); overflow:hidden;
    width:16rem; height:9rem;
  }
  .sfl-cqi .sfl-num{ font-size:clamp(2rem, 42cqi, 20rem); font-weight:800; line-height:1; white-space:nowrap; }
</style>

<p class="mb-4">
  Prototyping <strong>priority disclosure + fit-to-box</strong> for <code>pa-stat--square</code> before touching the framework.
  Primary number = <code>P0</code> (always shown, maxed, never overflows) → symbol <code>P1</code> → label <code>P2</code>.
  All styles/scripts here are <code>sfl-</code> scoped and throwaway.
</p>

