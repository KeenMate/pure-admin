<!-- 4 · WHY PURE CQI CAN'T DO IT -->
<div class="pa-card mb-4">
  <div class="pa-card__header"><div class="pa-card__title"><h3 class="pa-card__title pa-card__title-text">4 · Why pure <code>cqi</code> can't do it</h3></div></div>
  <div class="pa-card__body">
    <p class="text-muted mb-3">Both boxes are <code>160×90</code> with a pure-CSS <code>clamp(2rem, 42cqi, 20rem)</code> font.
       Short content is fine; longer content <strong>overflows</strong> — the font size knows the box width but not the character count.</p>
    <div class="sfl-matrix">
      <figure><div class="sfl-cqi"><span class="sfl-num">92</span></div><figcaption>cqi · "92" ✓</figcaption></figure>
      <figure><div class="sfl-cqi"><span class="sfl-num">847K</span></div><figcaption>cqi · "847K" ~</figcaption></figure>
      <figure><div class="sfl-cqi"><span class="sfl-num">12.4M</span></div><figcaption>cqi · "12.4M" ✗ spills</figcaption></figure>
    </div>
  </div>
</div>

<script>
  (function(){
    /* fit-to-box: size the .sfl-group so it fills .sfl-slot, never overflows */
    var SAFETY = 0.92, BASE = 200;

    function fit(slot){
      var group = slot.querySelector('.sfl-group');
      if(!group) return;
      group.style.fontSize = BASE + 'px';
      var gw = group.offsetWidth, gh = group.offsetHeight;
      var sw = slot.clientWidth, sh = slot.clientHeight;
      if(!gw || !gh || !sw || !sh) return;
      var scale = Math.min(sw / gw, sh / gh) * SAFETY;
      group.style.fontSize = (BASE * scale) + 'px';
    }

    // Re-fit on any slot size change. Hiding the label (container query) grows
    // the slot → fires here → number re-maxes. The same tile-resize event also
    // hides the symbol, so the measure already reflects the dropped symbol.
    var ro = new ResizeObserver(function(entries){
      entries.forEach(function(e){ fit(e.target); });
    });
    document.querySelectorAll('.sfl-slot').forEach(function(s){ ro.observe(s); });

    /* playground: live dims + visible-tier readout */
    var play = document.getElementById('sflPlay');
    var dims = document.getElementById('sflPlayDims');
    var tiers = document.getElementById('sflPlayTiers');
    if(play && dims){
      // priority order, highest-priority first (number always on)
      var TIERS = [
        { label:'P0 number',  sel:'.sfl-num' },
        { label:'P1 symbol',  sel:'.sfl-sym' },
        { label:'P2 label',   sel:'.sfl-label' },
        { label:'P3 trend',   sel:'.sfl-change' },
        { label:'P4 context', sel:'.sfl-context' }
      ];
      function renderTiers(){
        if(!tiers) return;
        tiers.innerHTML = TIERS.map(function(t){
          var el = play.querySelector(t.sel);
          var on = el && getComputedStyle(el).display !== 'none';
          return '<span class="' + (on ? 'on' : 'off') + '">' + t.label + '</span>';
        }).join('  ·  ');
      }
      new ResizeObserver(function(){
        var r = play.getBoundingClientRect();
        dims.textContent = Math.round(r.width) + ' × ' + Math.round(r.height) + ' px';
        renderTiers();
      }).observe(play);

      /* playground: content switcher */
      var slotEl = play.querySelector('.sfl-slot');
      var groupEl = play.querySelector('.sfl-group');
      var numEl = play.querySelector('.sfl-num');
      var symEl = play.querySelector('.sfl-sym');
      play.parentElement.querySelectorAll('.sfl-controls button').forEach(function(btn){
        btn.addEventListener('click', function(){
          numEl.textContent = btn.dataset.num;
          var sym = btn.dataset.sym || '';
          symEl.textContent = sym;
          symEl.style.display = sym ? '' : 'none';
          if(btn.dataset.pre) groupEl.prepend(symEl); else groupEl.append(symEl);
          fit(slotEl);
          renderTiers();
        });
      });
    }
  })();
</script>
