<p>"Bento layout" KPI indicator. <strong>Asymmetric tile sizes, sparkline as a low-opacity background</strong> on each tile, big numerals layered over the chart in the lower-left corner. Hero (Monthly Revenue) spans two rows on the left; two stacked tiles on the right (top); three equal tiles below — magazine-style mixed sizes rather than a uniform grid. Card-level container query collapses the whole bento to a single-column stack when the host card narrows below 700px so the same markup works in narrow page-grid cells.</p>

<style>
/* === Card chrome === */
.kpi-bento {
  container-type: inline-size;
}
.kpi-bento__header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 1.6rem;
  flex-wrap: wrap;
}
.kpi-bento__live {
  display: inline-flex;
  align-items: center;
  gap: 0.6rem;
  font-family: var(--base-font-family-mono);
  font-size: 1.2rem;
  font-weight: 600;
  letter-spacing: 0.06em;
  color: var(--pa-text-secondary);
}
.kpi-bento__livedot {
  width: 0.8rem;
  height: 0.8rem;
  border-radius: 50%;
  background: var(--pa-positive);
  box-shadow: 0 0 6px var(--pa-positive);
  animation: kpiPulse 1.6s ease-in-out infinite;
}
@keyframes kpiPulse { 50% { opacity: 0.35; } }

.kpi-bento__body { padding: 1.6rem; }

/* === Bento grid ===
   6 columns × 3 rows. Hero takes the left half of the top two rows;
   two stacked tiles fill the right half of those rows; three equal tiles
   form the bottom row. Tile placement is by source order via :nth-child
   so the markup just lists six tiles in reading order without per-tile
   placement classes. Tile heights are fixed (each row is 12rem) so the
   asymmetric proportions read consistently across themes/cards. */
.kpi-bento__grid {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  grid-template-rows: 12rem 12rem 12rem;
  grid-template-areas:
    "hero hero hero a    a    a"
    "hero hero hero b    b    b"
    "c    c    d    d    e    e";
  gap: 1rem;
}
.kpi-bento__grid > :nth-child(1) { grid-area: hero; }
.kpi-bento__grid > :nth-child(2) { grid-area: a; }
.kpi-bento__grid > :nth-child(3) { grid-area: b; }
.kpi-bento__grid > :nth-child(4) { grid-area: c; }
.kpi-bento__grid > :nth-child(5) { grid-area: d; }
.kpi-bento__grid > :nth-child(6) { grid-area: e; }

/* Narrow card → stack everything. The hero modifier still bumps the
   value font-size at the top of the stack so the headline metric still
   feels like the headline metric. */
@container (max-width: 700px) {
  .kpi-bento__grid {
    grid-template-columns: 1fr;
    grid-template-rows: auto;
    grid-template-areas: none;
    gap: 0.8rem;
  }
  .kpi-bento__grid > :nth-child(n) { grid-area: auto; }
  .kpi-bento-tile { min-height: 10rem; }
  .kpi-bento-tile--hero { min-height: 14rem; }
}

/* === Tile === */
.kpi-bento-tile {
  /* Per-tile inline-size container — value font-size scales with this
     tile's width via cqi, so a narrow bento cell keeps the number from
     blowing past the right edge while a wide cell lets the value breathe.
     Without this, cqi would resolve against .kpi-bento (the outer card)
     and the hero tile + the smaller tiles would scale together rather
     than each to their own width. */
  container-type: inline-size;
  position: relative;
  overflow: hidden;
  padding: 1.3rem 1.5rem;
  border: 1px solid var(--pa-border-color);
  background: var(--pa-card-bg);
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  grid-template-rows: auto 1fr auto;
  grid-template-areas:
    "label delta"
    ".     .    "
    "value value";
  gap: 0.4rem 1rem;
  /* Sparkline + delta sentiment colour cascades via currentColor.
     Override per-tile with the modifiers below. */
  --kpi-tile-color: var(--pa-positive);
}
.kpi-bento-tile--positive    { --kpi-tile-color: var(--pa-positive); }
.kpi-bento-tile--negative    { --kpi-tile-color: var(--pa-negative); }
.kpi-bento-tile--neutral     { --kpi-tile-color: var(--pa-neutral); }
.kpi-bento-tile--up-strong   { --kpi-tile-color: var(--pa-very-positive); }
.kpi-bento-tile--down-strong { --kpi-tile-color: var(--pa-very-negative); }

/* Top row: label + delta side-by-side, both sit above the chart.
   Both get z-index: 1 so they're not covered by the chart that fills
   the lower portion of the tile from behind. */
.kpi-bento-tile__label {
  grid-area: label;
  font-family: var(--base-font-family-mono);
  font-size: 1.3rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: color-mix(in srgb, var(--pa-text-color-1) 60%, transparent);
  z-index: 1;
  line-height: 1.2;
}
.kpi-bento-tile__delta {
  grid-area: delta;
  font-family: var(--base-font-family-mono);
  font-size: 1.3rem;
  font-weight: 700;
  color: var(--kpi-tile-color);
  z-index: 1;
  align-self: start;
  line-height: 1.2;
}

/* Value: lives in the bottom row of the grid, layered over the chart.
   z-index: 1 + position: relative is what wins it the stacking layer
   over the absolutely-positioned chart underneath. */
.kpi-bento-tile__value {
  grid-area: value;
  align-self: end;
  position: relative;
  z-index: 1;
  font-family: var(--base-font-family-mono);
  display: inline-flex;
  align-items: baseline;
  line-height: 1;
  white-space: nowrap;
}
.kpi-bento-tile__num {
  font-size: clamp(2rem, 14cqi, 3.2rem);
  font-weight: 700;
  letter-spacing: -0.02em;
  color: var(--pa-text-color-1);
}
.kpi-bento-tile__unit {
  font-size: clamp(1.2rem, 7cqi, 1.6rem);
  font-weight: 500;
  color: color-mix(in srgb, var(--pa-text-color-1) 50%, transparent);
  margin: 0 0.3rem;
}

/* Hero tile: bigger value, slightly larger padding so the headline
   number has more room to breathe when the layout is wide. */
.kpi-bento-tile--hero {
  padding: 1.6rem 1.8rem;
}
.kpi-bento-tile--hero .kpi-bento-tile__num {
  font-size: clamp(3.6rem, 22cqi, 7rem);
}
.kpi-bento-tile--hero .kpi-bento-tile__unit {
  font-size: clamp(1.6rem, 9cqi, 2.6rem);
}
.kpi-bento-tile--hero .kpi-bento-tile__label,
.kpi-bento-tile--hero .kpi-bento-tile__delta {
  font-size: 1.4rem;
}

/* === Sparkline background ===
   Absolutely positioned, fills the bottom 60-70% of the tile. The value
   sits over it (z-index: 1 above) and the line/area read through behind
   the digits. Same currentColor cascade as elsewhere — the polyline gets
   the stroke, the polygon under it gets a low-alpha fill of the same
   colour for the soft area. */
/* Chart container reserves the bottom band of the tile and pins its
   inner SVG wrapper to the bottom edge. We can't let the SVG fill the
   full container height (`height: 65%` of the tile) because the SVG
   uses `preserveAspectRatio="none"` — taller tiles would stretch the
   line's Y-amplitude proportionally to tile height, so the line shape
   looks different on the hero (tall) vs. non-hero (short) tiles even
   though they share the same viewBox data. Same fix as kpi-hero-
   supporting's chart: outer container can grow with the tile, but the
   SVG itself sits in a fixed-height inner span so its vertical
   proportions stay constant. Empty space appears above the SVG when
   the tile is tall, instead of compressing/stretching the line. */
.kpi-bento-tile__chart {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 65%;
  pointer-events: none;
  color: var(--kpi-tile-color);
  z-index: 0;
  display: flex;
  align-items: flex-end;
}
.kpi-bento-tile--hero .kpi-bento-tile__chart {
  height: 70%;
}
/* Fixed-height SVG wrapper. Width still flexes with the tile; only the
   *Y* dimension is constrained, which is what the preserveAspectRatio
   bug is about. Height comes from the framework's
   `--pa-chart-trendline-height` token so all KPI showcases share the
   same line proportions. Override the var locally if a particular
   bento layout wants a hero-sized line. */
.kpi-bento-tile__chart-svg {
  position: relative;
  display: block;
  width: 100%;
  height: var(--pa-chart-trendline-height);
}
.kpi-bento-tile__chart svg {
  display: block;
  width: 100%;
  height: 100%;
  overflow: visible;
}
/* Both the line stroke and the area fill are dialled down so the headline
   number stays the focal point — the chart is supporting context, not a
   competing element. The polygon (area fill) gets the steeper drop because
   it sits directly behind the digits across the full width of the tile;
   the polyline still needs to read as a defined line shape so it keeps a
   higher opacity. */
.kpi-bento-tile__chart polyline {
  fill: none;
  stroke: currentColor;
  stroke-opacity: 0.55;
  stroke-width: var(--pa-chart-trendline-stroke);
  stroke-linecap: round;
  stroke-linejoin: round;
}
.kpi-bento-tile__chart polygon {
  fill: currentColor;
  fill-opacity: 0.10;
  stroke: none;
}

/* === Footer caption === */
.kpi-bento__footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 1rem;
  font-family: var(--base-font-family-mono);
  font-size: 1.2rem;
  color: var(--pa-text-secondary);
}
.kpi-bento__footer strong {
  color: var(--pa-text-color-1);
  font-weight: 700;
}

/* === Hover detail popover (cursor-anchored, same recipe as elsewhere) === */
.kpi-bento-detail {
  position: fixed;
  top: 0;
  left: 0;
  visibility: hidden;
  pointer-events: none;
  z-index: 9000;
  min-width: 24rem;
  max-width: 30rem;
  background: var(--pa-detail-bg);
  color: var(--pa-detail-text);
  padding: 1.1rem 1.4rem;
  font-family: var(--base-font-family-mono);
  font-size: 1.2rem;
  line-height: 1.5;
  border-radius: 0.4rem;
  box-shadow: var(--pa-detail-shadow);
}
.kpi-bento-detail[data-show] { visibility: visible; }
.kpi-bento-detail-title {
  text-transform: uppercase;
  letter-spacing: 0.08em;
  font-size: 1.05rem;
  font-weight: 700;
  color: var(--pa-detail-title);
  margin-bottom: 0.6rem;
}
.kpi-bento-detail dl {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 0.35rem 1.6rem;
  margin: 0;
}
.kpi-bento-detail dt { margin: 0; color: var(--pa-detail-row-label); font-weight: 400; }
.kpi-bento-detail dd { margin: 0; text-align: end; font-weight: 600; font-variant-numeric: tabular-nums; }
.kpi-bento-detail .pos { color: var(--pa-positive); }
.kpi-bento-detail .neg { color: var(--pa-negative); }
.kpi-bento-detail .warn { color: var(--pa-warning); }
</style>

