<!-- PROGRAMMATIC API -->
<div class="pa-card">
  <div class="pa-card__header">
    <div class="pa-card__title">
        <h3 class="pa-card__title-text">Programmatic API &amp; Events</h3>
    </div>
  </div>
  <div class="pa-card__body">
    <div class="pa-row">
      <div class="pa-col-100 pa-col-md-50">
        <div class="pa-form-group">
          <label>Live event log</label>
          <web-dropzone id="api-demo" display-mode="detailed" accept="*/*"></web-dropzone>
          <div style="margin-top: 0.75rem;">
            <button type="button" class="pa-btn pa-btn--sm pa-btn--secondary" id="api-clear">clear()</button>
            <button type="button" class="pa-btn pa-btn--sm pa-btn--secondary" id="api-getfiles">getFiles()</button>
          </div>
        </div>
      </div>
      <div class="pa-col-100 pa-col-md-50">
        <div class="pa-form-group">
          <label>Events</label>
          <pre id="api-log" class="text-xs" style="height: 16rem; overflow-y: auto; padding: 0.75rem; background: var(--base-subtle-bg, var(--pa-main-bg)); border-radius: var(--pa-border-radius); margin: 0;">(none yet — drop or pick a file)</pre>
        </div>
      </div>
    </div>
    <div class="pa-card__body" style="padding-inline: 0;">
      <pre class="text-xs" style="padding: 0.75rem; background: var(--base-subtle-bg, var(--pa-main-bg)); border-radius: var(--pa-border-radius); overflow-x: auto;"><code>const el = document.getElementById('api-demo')

el.addEventListener('file-added',     e =&gt; console.log('added',    e.detail))
el.addEventListener('file-removed',   e =&gt; console.log('removed',  e.detail))
el.addEventListener('files-rejected', e =&gt; console.log('rejected', e.detail))
el.addEventListener('change',         e =&gt; console.log('change',   e.detail))

el.addFiles(fileList)   // programmatic add (FileList or File[])
el.removeFile(id)       // remove by FileState.id
el.clear()              // remove all
const files = el.files  // current FileState[]

// simulated upload driver (this page): (file, onProgress, signal) =&gt; Promise
el.uploadFileCallback = simulateUpload({ durationMs: 2500, failRate: 0.15 })</code></pre>
    </div>
  </div>
</div>

<!-- RESOURCES -->
<div class="pa-card">
  <div class="pa-card__header">
    <div class="pa-card__title">
        <h3 class="pa-card__title-text">Resources</h3>
    </div>
  </div>
  <div class="pa-card__body">
    <ul>
      <li><strong>npm Package:</strong> <code>@keenmate/web-dropzone</code> (headless store: <code>@keenmate/web-dropzone-core</code>)</li>
      <li><strong>Repository:</strong> <a href="https://github.com/keenmate/web-dropzone" target="_blank" class="pa-link">github.com/keenmate/web-dropzone</a></li>
      <li><strong>Elements:</strong> <code>&lt;web-dropzone&gt;</code> + satellites <code>&lt;web-dropzone-picker&gt;</code>, <code>&lt;web-dropzone-list&gt;</code>, <code>&lt;web-dropzone-indicator&gt;</code>, <code>&lt;web-dropzone-progress&gt;</code></li>
      <li><strong>CSS Variables:</strong> component-local <code>--dz-*</code> + shared <code>--base-*</code> (theme integration, same bridge as web-multiselect / web-grid)</li>
      <li><strong>Theming:</strong> Pure Admin provides <code>--base-*</code> via <code>src/scss/_base-css-variables.scss</code> — the component follows the active theme automatically</li>
    </ul>
  </div>
</div>

<script>
(function () {
  // Simulated upload driver — matches FileUploadHandler:
  //   (file, onProgress, signal, context) => Promise<void>
  // Reports progress 0→100 over durationMs, respects abort, optionally fails.
  window.simulateUpload = function simulateUpload(opts) {
    opts = opts || {};
    var duration = opts.durationMs || 2500;
    var failRate = opts.failRate || 0;
    return function (file, onProgress, signal) {
      return new Promise(function (resolve, reject) {
        var pct = 0;
        var stepEvery = 100;
        var inc = 100 / (duration / stepEvery);
        var timer = setInterval(function () {
          if (signal && signal.aborted) {
            clearInterval(timer);
            reject(new DOMException('Aborted', 'AbortError'));
            return;
          }
          pct = Math.min(100, pct + inc);
          onProgress(pct);
          if (pct >= 100) {
            clearInterval(timer);
            if (Math.random() < failRate) reject(new Error('Simulated upload failure'));
            else resolve();
          }
        }, stepEvery);
      });
    };
  };

  var REJECTION_LABEL = {
    count: 'Too many files',
    size: 'Size limit',
    type: 'Type not accepted',
    duplicate: 'Duplicate filename',
    custom: 'Rejected'
  };

  function notifyRejections(e) {
    var groups = {};
    var list = (e.detail && e.detail.rejectedFiles) || [];
    for (var i = 0; i < list.length; i++) {
      var r = list[i];
      var code = (r.validation && r.validation.code) || 'custom';
      (groups[code] = groups[code] || []).push(r);
    }
    Object.keys(groups).forEach(function (code) {
      var items = groups[code];
      var title = REJECTION_LABEL[code] || 'Rejected';
      var sample = (items[0].validation && items[0].validation.error) || items[0].file.name;
      var more = items.length > 1 ? ' (+' + (items.length - 1) + ' more)' : '';
      if (window.pureAdmin && pureAdmin.toast) pureAdmin.toast.warning(sample + more, { title: title });
      else console.warn('[dropzone] ' + title + ': ' + sample + more);
    });
  }

  customElements.whenDefined('web-dropzone').then(function () {
    // Give every dropzone a working (simulated) upload driver + rejection toasts.
    var zones = document.querySelectorAll('web-dropzone');
    for (var i = 0; i < zones.length; i++) {
      customElements.upgrade(zones[i]);
      zones[i].uploadFileCallback = window.simulateUpload({ durationMs: 2500, failRate: 0.15 });
      zones[i].addEventListener('files-rejected', notifyRejections);
    }

    // list-appearance="none" — caller reads .files itself
    var listNone = document.getElementById('list-none');
    var listNoneOut = document.getElementById('list-none-out');
    if (listNone && listNoneOut) {
      listNone.addEventListener('change', function () {
        var files = listNone.files || [];
        listNoneOut.textContent = files.length
          ? files.length + ' file(s): ' + files.map(function (f) { return f.name; }).join(', ')
          : '(none)';
      });
    }

    // Toggle-disabled button
    var toggle = document.getElementById('toggle-disabled');
    var toggleBtn = document.getElementById('toggle-disabled-btn');
    if (toggle && toggleBtn) {
      toggleBtn.addEventListener('click', function () { toggle.disabled = !toggle.disabled; });
    }

    // Composable controls — drive controls / item-controls from the checkboxes.
    var cd = document.getElementById('controls-demo');
    var cdAttrs = document.getElementById('controls-demo-attrs');
    if (cd) {
      var panel = cd.closest('.pa-card');
      var ALL_CTRL = ['picker', 'list', 'overall-progress'];
      var ALL_ITEM = ['icon', 'name', 'size', 'type', 'progress', 'status', 'action', 'remove'];
      var checkedVals = function (attr) {
        return Array.prototype.slice.call(panel.querySelectorAll('[data-' + attr + ']'))
          .filter(function (c) { return c.checked; })
          .map(function (c) { return c.dataset[attr]; });
      };
      var apply = function (name, chosen, all) {
        if (chosen.length === all.length) cd.removeAttribute(name);
        else cd.setAttribute(name, chosen.join(','));
      };
      var sync = function () {
        apply('controls', checkedVals('ctrl'), ALL_CTRL);
        apply('item-controls', checkedVals('item'), ALL_ITEM);
        if (cdAttrs) {
          cdAttrs.textContent = 'controls="' + (cd.getAttribute('controls') || '(all)') +
            '"  item-controls="' + (cd.getAttribute('item-controls') || '(all)') + '"';
        }
      };
      var boxes = panel.querySelectorAll('[data-ctrl], [data-item]');
      for (var b = 0; b < boxes.length; b++) boxes[b].addEventListener('change', sync);
      sync();
    }

    // Recipe: count-based per-row progress
    var recipeCount = document.getElementById('recipe-count');
    if (recipeCount) {
      var LEAN = 'icon,name,size,type,status,action,remove'; // everything but progress
      recipeCount.addEventListener('change', function () {
        var want = recipeCount.files.length >= 4 ? null : LEAN;
        if (recipeCount.getAttribute('item-controls') === want) return;
        if (want === null) recipeCount.removeAttribute('item-controls');
        else recipeCount.setAttribute('item-controls', want);
      });
    }

    // Recipe: global strip only after upload starts
    var recipeOnStart = document.getElementById('recipe-onstart');
    var recipeOnStartGo = document.getElementById('recipe-onstart-go');
    if (recipeOnStart && recipeOnStartGo) {
      recipeOnStartGo.addEventListener('click', function () {
        if (recipeOnStart.uploadAll) recipeOnStart.uploadAll();
      });
    }

    // Programmatic API demo — event log
    var apiEl = document.getElementById('api-demo');
    var apiLog = document.getElementById('api-log');
    if (apiEl && apiLog) {
      var lines = [];
      var append = function (line) {
        lines.push(line);
        if (lines.length > 12) lines.shift();
        apiLog.textContent = lines.join('\n');
      };
      apiEl.addEventListener('file-added', function (e) { append('+ added    ' + e.detail.file.name); });
      apiEl.addEventListener('file-removed', function (e) { append('- removed  ' + e.detail.file.name); });
      apiEl.addEventListener('files-rejected', function (e) { append('! rejected ' + e.detail.rejectedFiles.length + ' file(s)'); });
      apiEl.addEventListener('change', function (e) { append('~ change   now ' + (e.target.files || []).length + ' file(s)'); });

      var clearBtn = document.getElementById('api-clear');
      var getBtn = document.getElementById('api-getfiles');
      if (clearBtn) clearBtn.addEventListener('click', function () { apiEl.clear && apiEl.clear(); });
      if (getBtn) getBtn.addEventListener('click', function () {
        var files = apiEl.files || [];
        append('getFiles() -> ' + files.length + ' file(s): ' + (files.map(function (f) { return f.name; }).join(', ') || '(none)'));
      });
    }
  });
})();
</script>
