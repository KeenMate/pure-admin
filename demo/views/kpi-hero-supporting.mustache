<div class="pa-card">
    <div class="pa-card__header">
        <h3>CSS Classes Reference</h3>
    </div>
    <div class="pa-card__body">
        <h4>Card structure</h4>
        <ul class="pa-list-basic pa-list-basic--compact">
            <li><code>kpi-hero-list</code> — page-namespace class on <code>.pa-card</code>. Declares <code>container-type: inline-size</code> for the layout collapse.</li>
            <li><code>kpi-hero-list__header</code> — flex header with title + LIVE indicator.</li>
            <li><code>kpi-hero-list__live</code> / <code>kpi-hero-list__livedot</code> — LIVE pill + animated dot.</li>
            <li><code>kpi-hero-list__body</code> — card body with internal padding.</li>
            <li><code>kpi-hero-list__layout</code> — 2-col grid (hero left, rail right). Collapses to 1-col under 700px via container query.</li>
            <li><code>kpi-hero-list__rail</code> — vertical stack of side-tiles (right column).</li>
            <li><code>kpi-hero-list__footer</code> — flex footer caption.</li>
        </ul>

        <h4 class="mt-4">Hero (left column)</h4>
        <ul class="pa-list-basic pa-list-basic--compact">
            <li><code>kpi-hero-main</code> — hero container. Carries <code>--kpi-hero-color</code>.</li>
            <li><code>kpi-hero-main--positive</code> / <code>--negative</code> / <code>--neutral</code> / <code>--up-strong</code> — sentiment modifiers setting <code>--kpi-hero-color</code>.</li>
            <li><code>kpi-hero-main__label</code> — uppercase mono caption.</li>
            <li><code>kpi-hero-main__value</code> — focal number (<code>clamp(4rem, 17cqi, 7rem)</code>).</li>
            <li><code>kpi-hero-main__num</code> / <code>kpi-hero-main__unit</code> — numeric + unit spans.</li>
            <li><code>kpi-hero-main__meta</code> — flex row carrying delta · period · target.</li>
            <li><code>kpi-hero-main__delta</code> — coloured Δ% (reads <code>--kpi-hero-color</code>).</li>
            <li><code>kpi-hero-main__period</code> — period descriptor (e.g. "vs last month").</li>
            <li><code>kpi-hero-main__target</code> — target value pair.</li>
            <li><code>kpi-hero-main__chart</code> — chart wrapper (flex-grow to absorb extra height).</li>
            <li><code>kpi-hero-main__chart-svg</code> — fixed-height pinned-to-bottom SVG host (line never distorts).</li>
        </ul>

        <h4 class="mt-4">Side rail tile (right column)</h4>
        <ul class="pa-list-basic pa-list-basic--compact">
            <li><code>kpi-hero-side</code> — single supporting tile. Carries <code>--kpi-side-color</code>.</li>
            <li><code>kpi-hero-side--positive</code> / <code>--negative</code> / <code>--neutral</code> / <code>--up-strong</code> — sentiment modifiers.</li>
            <li><code>kpi-hero-side__label</code> — caption (top-left of internal 2×2 grid).</li>
            <li><code>kpi-hero-side__value</code> — value spanning both rows on the right column.</li>
            <li><code>kpi-hero-side__num</code> / <code>kpi-hero-side__unit</code> — numeric + unit spans.</li>
            <li><code>kpi-hero-side__delta</code> — coloured Δ% (bottom-left).</li>
        </ul>

        <h4 class="mt-4">Hover detail popover</h4>
        <ul class="pa-list-basic pa-list-basic--compact">
            <li><code>kpi-hero-detail</code> — popover root (moved to <code>&lt;body&gt;</code> on init).</li>
            <li><code>kpi-hero-detail-title</code> — uppercase mono header.</li>
            <li><code>kpi-hero-detail .pos / .neg / .warn</code> — sentiment-coloured <code>&lt;dd&gt;</code> text.</li>
        </ul>

        <h4 class="mt-4">Framework tokens used by this showcase</h4>
        <ul class="pa-list-basic pa-list-basic--compact">
            <li><code>--pa-very-positive</code> / <code>--pa-positive</code> / <code>--pa-neutral</code> / <code>--pa-negative</code> / <code>--pa-very-negative</code> — 5-step semantic sentiment scale.</li>
            <li><code>--pa-warning</code> — orange "off-target / approaching limit" signal.</li>
            <li><code>--pa-detail-bg</code> / <code>--pa-detail-text</code> / <code>--pa-detail-row-label</code> / <code>--pa-detail-title</code> / <code>--pa-detail-shadow</code> — popover chrome.</li>
        </ul>
    </div>
</div>

<script>
// Cursor-anchored hover detail popovers + SVG circle → CSS span conversion
// for the hero sparklines. Same recipes as the other KPI showcases.
document.addEventListener('DOMContentLoaded', function() {

    // ---- Hover detail popover ----
    if (window.FloatingUIDOM) {
        const { computePosition, flip, shift, offset } = window.FloatingUIDOM;

        document.querySelectorAll('.kpi-hero-main, .kpi-hero-side').forEach(host => {
            const detail = host.querySelector('.kpi-hero-detail');
            if (!detail) return;
            document.body.appendChild(detail);

            let cursorX = 0, cursorY = 0;
            const virtualEl = {
                getBoundingClientRect() {
                    return {
                        width: 0, height: 0,
                        x: cursorX, y: cursorY,
                        top: cursorY, left: cursorX,
                        right: cursorX, bottom: cursorY
                    };
                }
            };

            const reposition = () => {
                computePosition(virtualEl, detail, {
                    strategy: 'fixed',
                    placement: 'top-start',
                    middleware: [offset(14), flip(), shift({ padding: 8 })]
                }).then(({ x, y }) => {
                    Object.assign(detail.style, { left: `${x}px`, top: `${y}px` });
                });
            };

            host.addEventListener('mouseenter', (e) => {
                cursorX = e.clientX;
                cursorY = e.clientY;
                detail.setAttribute('data-show', '');
                reposition();
            });
            host.addEventListener('mousemove', (e) => {
                cursorX = e.clientX;
                cursorY = e.clientY;
                reposition();
            });
            host.addEventListener('mouseleave', () => {
                detail.removeAttribute('data-show');
            });
        });
    }

    // ---- Convert SVG <circle> end-of-line markers to CSS-positioned <span> ----
    // (Same recipe as Sparkline list — preserveAspectRatio="none" stretches
    // the SVG so a <circle> renders as an oval; render the dot as an HTML
    // span sized in CSS pixels so it stays a true circle.)
    document.querySelectorAll('.kpi-hero-main__chart svg').forEach(svg => {
        const circle = svg.querySelector('circle');
        if (!circle) return;

        const cx = parseFloat(circle.getAttribute('cx'));
        const cy = parseFloat(circle.getAttribute('cy'));
        const vb = svg.viewBox.baseVal;
        const xPct = (cx - vb.x) / vb.width * 100;
        const yPct = (cy - vb.y) / vb.height * 100;

        const dot = document.createElement('span');
        dot.className = 'kpi-spark-dot';
        dot.style.cssText = `
            position: absolute;
            width: 6px; height: 6px;
            margin: -3px 0 0 -3px;
            border-radius: 50%;
            background: currentColor;
            pointer-events: none;
            left: ${xPct}%; top: ${yPct}%;
        `;
        svg.parentElement.appendChild(dot);
        circle.remove();
    });
});
</script>
