  margin-bottom: 0.6rem;
}
.kpi-hero-detail dl {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 0.35rem 1.6rem;
  margin: 0;
}
.kpi-hero-detail dt { margin: 0; color: var(--pa-detail-row-label); font-weight: 400; }
.kpi-hero-detail dd { margin: 0; text-align: end; font-weight: 600; font-variant-numeric: tabular-nums; }
.kpi-hero-detail .pos { color: var(--pa-positive); }
.kpi-hero-detail .neg { color: var(--pa-negative); }
.kpi-hero-detail .warn { color: var(--pa-warning); }
