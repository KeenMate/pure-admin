            <!-- Popconfirm logic (RTL positioning test for the toolbar buttons).
                 Mirrors demo/views/popconfirm.mustache — positionPopconfirm maps the
                 logical start/end placement to a physical Floating UI side based on
                 document.documentElement.dir, and maps the flipped result back. -->
            <script>
                let currentPopconfirm = null;
                let currentPopTrigger = null;

                function togglePopconfirm(event, popconfirmId) {
                    event.stopPropagation();
                    const trigger = event.currentTarget;
                    const popconfirm = document.getElementById(popconfirmId);
                    if (!popconfirm) return;

                    if (currentPopconfirm && currentPopconfirm !== popconfirm) {
                        currentPopconfirm.classList.remove('is-open');
                    }
                    if (popconfirm.classList.contains('is-open')) {
                        popconfirm.classList.remove('is-open');
                        currentPopconfirm = null;
                        currentPopTrigger = null;
                    } else {
                        positionPopconfirm(trigger, popconfirm);
                        popconfirm.classList.add('is-open');
                        currentPopconfirm = popconfirm;
                        currentPopTrigger = trigger;
                    }
                }

                function closePopconfirm(popconfirmId) {
                    const popconfirm = document.getElementById(popconfirmId);
                    if (!popconfirm) return;
                    popconfirm.classList.remove('is-open');
                    if (currentPopconfirm === popconfirm) {
                        currentPopconfirm = null;
                        currentPopTrigger = null;
                    }
                }

                function confirmPopconfirm(popconfirmId, message) {
                    closePopconfirm(popconfirmId);
                    // Reuse the page's toast helper (logical bottom-end position).
                    if (typeof showTestToast === 'function') {
                        showTestToast('bottom-end');
                    }
                    console.log('[popconfirm] confirmed:', popconfirmId, '-', message);
                }

                async function positionPopconfirm(trigger, popconfirm) {
                    const isRtl = document.documentElement.getAttribute('dir') === 'rtl';
                    const toPhysical = { top: 'top', bottom: 'bottom', start: isRtl ? 'right' : 'left', end: isRtl ? 'left' : 'right' };
                    const toLogical  = { top: 'top', bottom: 'bottom', left: isRtl ? 'end' : 'start', right: isRtl ? 'start' : 'end' };

                    const classMatch = popconfirm.className.match(/pa-popconfirm--(top|bottom|start|end)/);
                    const logical = classMatch ? classMatch[1] : 'bottom';
                    const placement = toPhysical[logical];

                    const { computePosition, flip, shift, offset } = window.FloatingUIDOM;
                    const { x, y, placement: finalPlacement } = await computePosition(trigger, popconfirm, {
                        placement: placement,
                        middleware: [ offset(8), flip(), shift({ padding: 10 }) ]
                    });

                    const finalLogical = toLogical[finalPlacement.split('-')[0]] || 'bottom';
                    popconfirm.className = popconfirm.className
                        .replace(/pa-popconfirm--(top|bottom|start|end)/g, '')
                        .trim() + ' pa-popconfirm--' + finalLogical;

                    Object.assign(popconfirm.style, { left: `${x}px`, top: `${y}px` });
                }

                document.addEventListener('click', (e) => {
                    if (currentPopconfirm &&
                        !currentPopconfirm.contains(e.target) &&
                        currentPopTrigger !== e.target &&
                        (!currentPopTrigger || !currentPopTrigger.contains(e.target))) {
                        currentPopconfirm.classList.remove('is-open');
                        currentPopconfirm = null;
                        currentPopTrigger = null;
                    }
                });

                ['scroll', 'resize'].forEach((evt) => window.addEventListener(evt, () => {
                    if (currentPopconfirm && currentPopTrigger) {
                        positionPopconfirm(currentPopTrigger, currentPopconfirm);
                    }
                }, true));
            </script>

            <script>
                // --- RTL default for THIS page --------------------------------
                // This is the RTL demo page, so it should ARRIVE in RTL. RTL is
                // otherwise a global demo setting (localStorage 'rtl-mode',
                // applied by settings-panel.js on every page). Here we override
                // it PAGE-SCOPED — the rest of the demo isn't forced into RTL,
                // and the visitor's explicit toggle choice is remembered for the
                // session (sessionStorage), defaulting to RTL when unset.
                const RTL_TEST_KEY = 'rtl-test-dir';

                function updateRtlUI(isRtl) {
                    document.getElementById('rtlStatus').innerHTML = 'Current mode: <strong>' + (isRtl ? 'RTL' : 'LTR') + '</strong>';
                    document.getElementById('rtlBtnLabel').textContent = isRtl ? 'Switch to LTR' : 'Switch to RTL';
                }

                function applyRtl(isRtl) {
                    document.documentElement.setAttribute('dir', isRtl ? 'rtl' : 'ltr');
                    updateRtlUI(isRtl);
                    // Keep the settings-panel checkbox visually in sync while on
                    // this page (does NOT write the global 'rtl-mode' flag).
                    const rtlCheckbox = document.getElementById('rtlMode');
                    if (rtlCheckbox) rtlCheckbox.checked = isRtl;
                }

                document.getElementById('rtlToggleBtn').addEventListener('click', function() {
                    const isRtl = document.documentElement.getAttribute('dir') === 'rtl';
                    const next = !isRtl;
                    sessionStorage.setItem(RTL_TEST_KEY, next ? 'rtl' : 'ltr');
                    applyRtl(next);
                });

                // Just REFLECT the dir into the UI text — settings-panel.js is
                // the single load-time dir authority and already defaulted this
                // page (body[data-rtl-default]) to RTL, honoring any
                // sessionStorage[RTL_TEST_KEY] override, so we don't set dir here.
                // Reflect on `load` (not DOMContentLoaded): handler ordering vs
                // settings-panel isn't guaranteed, and by `load` dir is final.
                window.addEventListener('load', function() {
                    updateRtlUI(document.documentElement.getAttribute('dir') === 'rtl');
                });

                // Simple tab switching for demo
                document.querySelectorAll('.pa-tabs__item').forEach(tab => {
                    tab.addEventListener('click', function() {
                        const tabGroup = this.closest('.pa-card__body');
                        const tabId = this.getAttribute('data-tab');

                        // Deactivate all tabs and panels in this group
                        tabGroup.querySelectorAll('.pa-tabs__item').forEach(t => t.classList.remove('pa-tabs__item--active'));
                        tabGroup.querySelectorAll('.pa-tabs__panel').forEach(p => p.classList.remove('pa-tabs__panel--active'));

                        // Activate clicked tab and corresponding panel
                        this.classList.add('pa-tabs__item--active');
                        const panel = document.getElementById(tabId);
                        if (panel) panel.classList.add('pa-tabs__panel--active');
                    });
                });

                // Toast demo function
                function showTestToast(position) {
                    // Create container if not exists
                    let container = document.querySelector('.pa-toast-container--' + position);
                    if (!container) {
                        container = document.createElement('div');
                        container.className = 'pa-toast-container pa-toast-container--' + position;
                        document.body.appendChild(container);
                    }

                    // Create toast
                    const toast = document.createElement('div');
                    toast.className = 'pa-toast pa-toast--info';
                    toast.innerHTML = `
                        <div class="pa-toast__icon"><i class="ti ti-info-circle"></i></div>
                        <div class="pa-toast__content">
                            <div class="pa-toast__title">מיקום הודעה: ${position}</div>
                            <p class="pa-toast__message">הודעה זו מופיעה במיקום ${position}.</p>
                        </div>
                        <button class="pa-toast__close"><span class="pa-icon pa-icon--x" aria-hidden="true"></span></button>
                    `;

                    container.appendChild(toast);

                    // Trigger animation
                    setTimeout(() => toast.classList.add('pa-toast--show'), 10);

                    // Auto dismiss
                    setTimeout(() => {
                        toast.classList.remove('pa-toast--show');
                        toast.classList.add('pa-toast--hide');
                        setTimeout(() => toast.remove(), 300);
                    }, 3000);

                    // Close button
                    toast.querySelector('.pa-toast__close').addEventListener('click', () => {
                        toast.classList.remove('pa-toast--show');
                        toast.classList.add('pa-toast--hide');
                        setTimeout(() => toast.remove(), 300);
                    });
                }
            </script>
