<div class="pa-card">
    <div class="pa-card__header">
        <div class="pa-card__title">
            <h2 class="pa-card__title-text">Changelog</h2>
        </div>
    </div>
    <div class="pa-card__body changelog-content">
        {{{changelogContent}}}
    </div>
</div>

<style>
.changelog-content {
    line-height: 1.6;
}

/* 10px rem base - use larger values */
.changelog-content h1 {
    font-size: 2.4rem; /* 24px */
    margin-bottom: 1.5rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--pc-border-color);
}

.changelog-content h2 {
    font-size: 2rem; /* 20px */
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--pc-border-color);
    color: var(--pc-accent);
}

.changelog-content h3 {
    font-size: 1.6rem; /* 16px */
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    color: var(--pc-text-color-1);
    font-weight: 600;
}

.changelog-content h4 {
    font-size: 1.4rem; /* 14px */
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
    color: var(--pc-text-color-1);
    font-weight: 600;
}

.changelog-content ul {
    margin: 0.5rem 0 1rem 0;
    padding-left: 2rem;
}

.changelog-content li {
    margin-bottom: 0.4rem;
}

.changelog-content code {
    background: var(--pc-subtle-bg);
    padding: 0.2rem 0.5rem;
    border-radius: 3px;
    font-size: 0.9em;
}

.changelog-content pre {
    background: var(--pc-subtle-bg);
    padding: 1.5rem;
    border-radius: 4px;
    overflow-x: auto;
    margin: 1rem 0;
}

.changelog-content pre code {
    background: none;
    padding: 0;
}

.changelog-content p {
    margin-bottom: 1rem;
}

.changelog-content strong {
    color: var(--pc-text-color-1);
    font-size: 1.3rem; /* 13px - smaller than h4 */
}

.changelog-content a {
    color: var(--pc-accent);
    text-decoration: none;
}

.changelog-content a:hover {
    text-decoration: underline;
}

/* Version badges */
.changelog-content h2 code {
    background: var(--pc-accent);
    color: var(--pc-btn-primary-text);
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
    font-size: 0.85em;
}
</style>
