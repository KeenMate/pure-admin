<!-- Notifications Page Header -->
<div class="pc-row mb-1">
    <div class="pc-col">
        <p class="text-muted">View and manage all your notifications</p>
    </div>
    <div class="pc-col-auto">
        <button class="pa-btn pa-btn--secondary pa-btn--sm" onclick="markAllRead()">
            Mark all as read
        </button>
    </div>
</div>

<!-- Notification Filters -->
<div class="pc-row mb-1">
    <div class="pc-col-100">
        <div class="pa-card">
            <div class="pa-card__body">
                <div class="d-flex gap-sm flex-wrap align-items-center">
                    <span class="text-muted text-sm">Filter:</span>
                    <button class="pa-btn pa-btn--primary pa-btn--sm" onclick="filterNotifications('all')">All</button>
                    <button class="pa-btn pa-btn--secondary pa-btn--sm" onclick="filterNotifications('unread')">Unread</button>
                    <button class="pa-btn pa-btn--secondary pa-btn--sm" onclick="filterNotifications('read')">Read</button>
                    <span class="text-muted text-sm ml-2">Type:</span>
                    <button class="pa-btn pa-btn--secondary pa-btn--sm" onclick="filterNotifications('info')">Info</button>
                    <button class="pa-btn pa-btn--secondary pa-btn--sm" onclick="filterNotifications('warning')">Warning</button>
                    <button class="pa-btn pa-btn--secondary pa-btn--sm" onclick="filterNotifications('success')">Success</button>
                    <button class="pa-btn pa-btn--secondary pa-btn--sm" onclick="filterNotifications('error')">Error</button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Notifications List -->
<div class="pc-row">
    <div class="pc-col-100">
        <div class="pa-card">
            <div class="pa-card__header">
                <div class="pa-card__title">
                    <label class="pa-checkbox">
                        <input type="checkbox" id="selectAll" onchange="toggleSelectAll(this)">
                        <span class="pa-checkbox__mark"></span>
                    </label>
                    <h3 class="pa-card__title-text">All Notifications</h3>
                    <span class="pa-badge pa-badge--primary">4 unread</span>
                </div>
                <!-- Bulk Actions (hidden by default) -->
                <div id="bulkActions" class="pa-card__actions" style="display: none !important;">
                    <span class="text-muted text-sm self-center"><span id="selectedCount">0</span> selected</span>
                    <button class="pa-btn pa-btn--secondary pa-btn--sm" onclick="markSelectedRead()">Mark as read</button>
                    <button class="pa-btn pa-btn--danger pa-btn--sm" onclick="deleteSelected()">Delete</button>
                </div>
            </div>
            <div class="pa-card__body p-0">
                <ul class="pa-notifications__list pa-notifications__list--page">
                    <!-- Notification Item - Unread Primary -->
                    <li class="pa-notifications__item pa-notifications__item--unread">
                        <label class="pa-checkbox">
                            <input type="checkbox" class="notification-checkbox" onchange="updateSelection()">
                            <span class="pa-checkbox__mark"></span>
                        </label>
                        <div class="pa-notifications__icon-wrapper pa-notifications__icon-wrapper--primary">
                            i
                        </div>
                        <div class="pa-notifications__content">
                            <h4>New user registration</h4>
                            <p>John Doe has registered a new account and is awaiting approval.</p>
                            <span class="pa-notifications__time">2 minutes ago</span>
                        </div>
                        <div class="pa-notifications__actions">
                            <button class="pa-btn pa-btn--ghost pa-btn--sm" title="Mark as read">&#x2713;</button>
                            <button class="pa-btn pa-btn--ghost pa-btn--sm" title="Delete">&#x2715;</button>
                        </div>
                    </li>

                    <!-- Notification Item - Unread Warning -->
                    <li class="pa-notifications__item pa-notifications__item--unread">
                        <label class="pa-checkbox">
                            <input type="checkbox" class="notification-checkbox" onchange="updateSelection()">
                            <span class="pa-checkbox__mark"></span>
                        </label>
                        <div class="pa-notifications__icon-wrapper pa-notifications__icon-wrapper--warning">
                            !
                        </div>
                        <div class="pa-notifications__content">
                            <h4>Server load high</h4>
                            <p>Server CPU usage has exceeded 85%. Consider scaling resources.</p>
                            <span class="pa-notifications__time">15 minutes ago</span>
                        </div>
                        <div class="pa-notifications__actions">
                            <button class="pa-btn pa-btn--ghost pa-btn--sm" title="Mark as read">&#x2713;</button>
                            <button class="pa-btn pa-btn--ghost pa-btn--sm" title="Delete">&#x2715;</button>
                        </div>
                    </li>

                    <!-- Notification Item - Unread Success -->
                    <li class="pa-notifications__item pa-notifications__item--unread">
                        <label class="pa-checkbox">
                            <input type="checkbox" class="notification-checkbox" onchange="updateSelection()">
                            <span class="pa-checkbox__mark"></span>
                        </label>
                        <div class="pa-notifications__icon-wrapper pa-notifications__icon-wrapper--success">
                            &#x2713;
                        </div>
                        <div class="pa-notifications__content">
                            <h4>Deployment successful</h4>
                            <p>Version 2.1.0 has been successfully deployed to production.</p>
                            <span class="pa-notifications__time">1 hour ago</span>
                        </div>
                        <div class="pa-notifications__actions">
                            <button class="pa-btn pa-btn--ghost pa-btn--sm" title="Mark as read">&#x2713;</button>
                            <button class="pa-btn pa-btn--ghost pa-btn--sm" title="Delete">&#x2715;</button>
                        </div>
                    </li>

                    <!-- Notification Item - Unread Danger -->
                    <li class="pa-notifications__item pa-notifications__item--unread">
                        <label class="pa-checkbox">
                            <input type="checkbox" class="notification-checkbox" onchange="updateSelection()">
                            <span class="pa-checkbox__mark"></span>
                        </label>
                        <div class="pa-notifications__icon-wrapper pa-notifications__icon-wrapper--danger">
                            &#x2715;
                        </div>
                        <div class="pa-notifications__content">
                            <h4>Payment failed</h4>
                            <p>Payment processing failed for order #12847. Customer has been notified.</p>
                            <span class="pa-notifications__time">2 hours ago</span>
                        </div>
                        <div class="pa-notifications__actions">
                            <button class="pa-btn pa-btn--ghost pa-btn--sm" title="Mark as read">&#x2713;</button>
                            <button class="pa-btn pa-btn--ghost pa-btn--sm" title="Delete">&#x2715;</button>
                        </div>
                    </li>

                    <!-- Notification Item - Read -->
                    <li class="pa-notifications__item">
                        <label class="pa-checkbox">
                            <input type="checkbox" class="notification-checkbox" onchange="updateSelection()">
                            <span class="pa-checkbox__mark"></span>
                        </label>
                        <div class="pa-notifications__icon-wrapper pa-notifications__icon-wrapper--primary">
                            i
                        </div>
                        <div class="pa-notifications__content">
                            <h4>System maintenance scheduled</h4>
                            <p>Scheduled maintenance will occur on Sunday at 2:00 AM UTC.</p>
                            <span class="pa-notifications__time">Yesterday</span>
                        </div>
                        <div class="pa-notifications__actions">
                            <button class="pa-btn pa-btn--ghost pa-btn--sm" title="Mark as unread">&#x25CB;</button>
                            <button class="pa-btn pa-btn--ghost pa-btn--sm" title="Delete">&#x2715;</button>
                        </div>
                    </li>

                    <!-- Notification Item - Read -->
                    <li class="pa-notifications__item">
                        <label class="pa-checkbox">
                            <input type="checkbox" class="notification-checkbox" onchange="updateSelection()">
                            <span class="pa-checkbox__mark"></span>
                        </label>
                        <div class="pa-notifications__icon-wrapper pa-notifications__icon-wrapper--success">
                            &#x2713;
                        </div>
                        <div class="pa-notifications__content">
                            <h4>Backup completed</h4>
                            <p>Weekly database backup completed successfully. Size: 2.4 GB.</p>
                            <span class="pa-notifications__time">2 days ago</span>
                        </div>
                        <div class="pa-notifications__actions">
                            <button class="pa-btn pa-btn--ghost pa-btn--sm" title="Mark as unread">&#x25CB;</button>
                            <button class="pa-btn pa-btn--ghost pa-btn--sm" title="Delete">&#x2715;</button>
                        </div>
                    </li>

                    <!-- Notification Item - Read -->
                    <li class="pa-notifications__item">
                        <label class="pa-checkbox">
                            <input type="checkbox" class="notification-checkbox" onchange="updateSelection()">
                            <span class="pa-checkbox__mark"></span>
                        </label>
                        <div class="pa-notifications__icon-wrapper pa-notifications__icon-wrapper--warning">
                            !
                        </div>
                        <div class="pa-notifications__content">
                            <h4>License expiring soon</h4>
                            <p>Your enterprise license expires in 30 days. Please renew to avoid service interruption.</p>
                            <span class="pa-notifications__time">3 days ago</span>
                        </div>
                        <div class="pa-notifications__actions">
                            <button class="pa-btn pa-btn--ghost pa-btn--sm" title="Mark as unread">&#x25CB;</button>
                            <button class="pa-btn pa-btn--ghost pa-btn--sm" title="Delete">&#x2715;</button>
                        </div>
                    </li>

                    <!-- Notification Item - Read -->
                    <li class="pa-notifications__item">
                        <label class="pa-checkbox">
                            <input type="checkbox" class="notification-checkbox" onchange="updateSelection()">
                            <span class="pa-checkbox__mark"></span>
                        </label>
                        <div class="pa-notifications__icon-wrapper pa-notifications__icon-wrapper--secondary">
                            &#x2139;
                        </div>
                        <div class="pa-notifications__content">
                            <h4>New feature available</h4>
                            <p>Dark mode is now available. Enable it in Settings > Appearance.</p>
                            <span class="pa-notifications__time">1 week ago</span>
                        </div>
                        <div class="pa-notifications__actions">
                            <button class="pa-btn pa-btn--ghost pa-btn--sm" title="Mark as unread">&#x25CB;</button>
                            <button class="pa-btn pa-btn--ghost pa-btn--sm" title="Delete">&#x2715;</button>
                        </div>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

<!-- Pagination -->
<div class="pc-row mt-1">
    <div class="pc-col-100">
        <div class="d-flex justify-content-between align-items-center">
            <span class="text-muted text-sm">Showing 1-8 of 24 notifications</span>
            <div class="pa-pager">
                <div class="pa-pager__container">
                    <div class="pa-pager__controls">
                        <button class="pa-btn pa-btn--sm pa-btn--secondary" disabled title="First Page">&laquo;</button>
                        <button class="pa-btn pa-btn--sm pa-btn--secondary" disabled title="Previous Page">&lsaquo;</button>
                    </div>
                    <div class="pa-pager__info">
                        <input type="number" class="pa-input pa-input--sm pa-pager__input" value="1" min="1" max="3">
                        <span class="pa-pager__text">/ 3 pages</span>
                    </div>
                    <div class="pa-pager__controls">
                        <button class="pa-btn pa-btn--sm pa-btn--secondary" title="Next Page">&rsaquo;</button>
                        <button class="pa-btn pa-btn--sm pa-btn--secondary" title="Last Page">&raquo;</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
const STATUS_FILTERS = ['all', 'unread', 'read'];
const TYPE_FILTERS = ['info', 'warning', 'success', 'error'];

let currentStatus = 'all';
let currentType = 'all';

// Map icon-wrapper variant → semantic type used by Type filters.
function getItemType(item) {
    const wrapper = item.querySelector('[class*="pa-notifications__icon-wrapper--"]');
    if (!wrapper) return 'info';
    const variantClass = [...wrapper.classList].find(c => c.startsWith('pa-notifications__icon-wrapper--'));
    const variant = variantClass.replace('pa-notifications__icon-wrapper--', '');
    if (variant === 'danger') return 'error';
    if (variant === 'primary' || variant === 'secondary') return 'info';
    return variant; // 'warning' or 'success'
}

function isItemVisible(item) {
    return item.style.display !== 'none';
}

function applyFilter() {
    document.querySelectorAll('.pa-notifications__list .pa-notifications__item').forEach(item => {
        const isUnread = item.classList.contains('pa-notifications__item--unread');
        const itemType = getItemType(item);
        const statusOk = currentStatus === 'all'
            || (currentStatus === 'unread' && isUnread)
            || (currentStatus === 'read' && !isUnread);
        const typeOk = currentType === 'all' || itemType === currentType;
        item.style.display = (statusOk && typeOk) ? '' : 'none';
    });

    // Drop selection on items the filter just hid.
    document.querySelectorAll('.notification-checkbox:checked').forEach(cb => {
        if (!isItemVisible(cb.closest('.pa-notifications__item'))) cb.checked = false;
    });

    updateActiveFilterButtons();
    updateSelection();
}

function updateActiveFilterButtons() {
    document.querySelectorAll('button[onclick^="filterNotifications"]').forEach(btn => {
        const m = btn.getAttribute('onclick').match(/filterNotifications\('([^']+)'\)/);
        if (!m) return;
        const value = m[1];
        let isActive = false;
        if (STATUS_FILTERS.includes(value)) isActive = value === currentStatus;
        else if (TYPE_FILTERS.includes(value)) isActive = value === currentType;
        btn.classList.toggle('pa-btn--primary', isActive);
        btn.classList.toggle('pa-btn--secondary', !isActive);
    });
}

function filterNotifications(value) {
    if (STATUS_FILTERS.includes(value)) {
        currentStatus = value;
    } else if (TYPE_FILTERS.includes(value)) {
        // Click active type → deselect (back to all types). No explicit "All" button for type.
        currentType = currentType === value ? 'all' : value;
    }
    applyFilter();
}

function updateBadgeCount() {
    const unreadCount = document.querySelectorAll('.pa-notifications__item--unread').length;
    const badge = document.querySelector('.pa-card__header .pa-badge');
    if (badge) badge.textContent = unreadCount + ' unread';
}

// Swap an item between read/unread, including the per-item button icon + title.
function setItemReadState(item, makeRead) {
    item.classList.toggle('pa-notifications__item--unread', !makeRead);
    const firstBtn = item.querySelector('.pa-notifications__actions button:first-child');
    if (firstBtn) {
        if (makeRead) {
            firstBtn.innerHTML = '○'; // ○
            firstBtn.title = 'Mark as unread';
        } else {
            firstBtn.innerHTML = '✓'; // ✓
            firstBtn.title = 'Mark as read';
        }
    }
}

// Per-item action buttons (delegated so the markup doesn't need onclicks on every <li>).
document.addEventListener('click', (e) => {
    const btn = e.target.closest('.pa-notifications__actions button');
    if (!btn) return;
    const item = btn.closest('.pa-notifications__item');
    if (!item) return;
    const action = btn.getAttribute('title');
    if (action === 'Mark as read') setItemReadState(item, true);
    else if (action === 'Mark as unread') setItemReadState(item, false);
    else if (action === 'Delete') item.remove();
    updateBadgeCount();
    applyFilter();
});

function toggleSelectAll(checkbox) {
    document.querySelectorAll('.notification-checkbox').forEach(cb => {
        if (isItemVisible(cb.closest('.pa-notifications__item'))) cb.checked = checkbox.checked;
    });
    updateSelection();
}

function updateSelection() {
    const visibleCheckboxes = [...document.querySelectorAll('.notification-checkbox')]
        .filter(cb => isItemVisible(cb.closest('.pa-notifications__item')));
    const checked = visibleCheckboxes.filter(cb => cb.checked);
    const selectAll = document.getElementById('selectAll');
    const bulkActions = document.getElementById('bulkActions');
    const selectedCount = document.getElementById('selectedCount');

    if (selectAll) {
        selectAll.checked = visibleCheckboxes.length > 0 && checked.length === visibleCheckboxes.length;
        selectAll.indeterminate = checked.length > 0 && checked.length < visibleCheckboxes.length;
    }
    if (bulkActions) {
        if (checked.length > 0) {
            bulkActions.style.display = 'flex';
            if (selectedCount) selectedCount.textContent = checked.length;
        } else {
            bulkActions.style.display = 'none';
        }
    }
}

function markSelectedRead() {
    document.querySelectorAll('.notification-checkbox:checked').forEach(cb => {
        setItemReadState(cb.closest('.pa-notifications__item'), true);
        cb.checked = false;
    });
    updateBadgeCount();
    applyFilter();
}

function deleteSelected() {
    document.querySelectorAll('.notification-checkbox:checked').forEach(cb => {
        cb.closest('.pa-notifications__item').remove();
    });
    updateBadgeCount();
    applyFilter();
}

function markAllRead() {
    document.querySelectorAll('.pa-notifications__item--unread').forEach(item => {
        setItemReadState(item, true);
    });
    updateBadgeCount();
    applyFilter();
}

// Init
updateBadgeCount();
applyFilter();
</script>
