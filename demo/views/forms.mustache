                                            <input type="radio" name="radio-sizes">
                                            Small (14px)
                                        </label>
                                        <label class="pa-radio">
                                            <input type="radio" name="radio-sizes">
                                            Default (16px)
                                        </label>
                                        <label class="pa-radio pa-radio--lg">
                                            <input type="radio" name="radio-sizes">
                                            Large (20px)
                                        </label>
                                        <label class="pa-radio pa-radio--xl">
                                            <input type="radio" name="radio-sizes">
                                            Extra Large (24px)
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Horizontal Form Layout -->
            <div class="pa-card">
                <div class="pa-card__header">
                    <h3>Horizontal Form Layout</h3>
                    <p class="pa-text pa-text--sm pa-text--secondary m-0">Labels on the left, inputs on the right with varying field widths</p>
                </div>
                <div class="pa-card__body">
                    <form class="pa-form">
                        <!-- Line 1: First Name, Last Name, Email (equal widths) -->
                        <div class="pa-row">
                            <!-- First Name -->
                            <div class="pa-col-100 pa-col-md-1-3">
                                <div class="pa-form-group pa-form-group--horizontal">
                                    <label for="h-fname">First Name</label>
                                    <input type="text" id="h-fname" class="pa-input" placeholder="John">
                                </div>
                            </div>

                            <!-- Last Name -->
                            <div class="pa-col-100 pa-col-md-1-3">
                                <div class="pa-form-group pa-form-group--horizontal">
                                    <label for="h-lname">Last Name</label>
                                    <input type="text" id="h-lname" class="pa-input" placeholder="Doe">
                                </div>
                            </div>

                            <!-- Email -->
                            <div class="pa-col-100 pa-col-md-1-3">
                                <div class="pa-form-group pa-form-group--horizontal">
                                    <label for="h-email">Email</label>
                                    <input type="email" id="h-email" class="pa-input" placeholder="john.doe@company.com">
                                </div>
                            </div>
                        </div>

                        <!-- Line 2: Phone (smaller), Department (larger), Job Title (medium) -->
                        <div class="pa-row">
                            <!-- Phone -->
                            <div class="pa-col-100 pa-col-md-25">
                                <div class="pa-form-group pa-form-group--horizontal">
                                    <label for="h-phone">Phone</label>
                                    <input type="tel" id="h-phone" class="pa-input" placeholder="+1 555-0123">
                                </div>
                            </div>

                            <!-- Department -->
                            <div class="pa-col-100 pa-col-md-42">
                                <div class="pa-form-group pa-form-group--horizontal">
                                    <label for="h-dept">Department</label>
                                    <select id="h-dept" class="pa-select">
                                        <option value="">Select department...</option>
                                        <option value="engineering">Engineering</option>
                                        <option value="marketing">Marketing</option>
                                        <option value="sales">Sales</option>
                                        <option value="hr">Human Resources</option>
                                    </select>
                                </div>
                            </div>

                            <!-- Job Title -->
                            <div class="pa-col-100 pa-col-md-1-3">
                                <div class="pa-form-group pa-form-group--horizontal">
                                    <label for="h-title">Job Title</label>
                                    <input type="text" id="h-title" class="pa-input" placeholder="Senior Developer">
                                </div>
                            </div>
                        </div>

                        <!-- Line 3: Address (larger), City (medium), Zip (small) -->
                        <div class="pa-row">
                            <!-- Address -->
                            <div class="pa-col-100 pa-col-md-50">
                                <div class="pa-form-group pa-form-group--horizontal">
                                    <label for="h-address">Address</label>
                                    <input type="text" id="h-address" class="pa-input" placeholder="123 Main Street">
                                </div>
                            </div>

                            <!-- City -->
                            <div class="pa-col-100 pa-col-md-1-3">
                                <div class="pa-form-group pa-form-group--horizontal">
                                    <label for="h-city">City</label>
                                    <input type="text" id="h-city" class="pa-input" placeholder="San Francisco">
                                </div>
                            </div>

                            <!-- Zip Code -->
                            <div class="pa-col-100 pa-col-md-15">
                                <div class="pa-form-group pa-form-group--horizontal">
                                    <label for="h-zip">Zip</label>
                                    <input type="text" id="h-zip" class="pa-input" placeholder="94102">
                                </div>
                            </div>
                        </div>

                        <!-- Submit Buttons -->
                        <div class="pa-row">
                            <div class="pa-col-100" style="text-align: right; margin-top: 1rem;">
                                <button type="button" class="pa-btn pa-btn--secondary">Cancel</button>
                                <button type="submit" class="pa-btn pa-btn--primary">Submit</button>
                            </div>
                        </div>
                    </form>
                </div>
                <div class="pa-card__footer">
                    <p class="pa-text pa-text--sm pa-text--secondary m-0">
                        <strong>Layout pattern:</strong> Each field uses <code>.pa-form-group--horizontal</code> (label left, input right) inside <code>pa-col-*</code> columns.
                        Line 1: equal widths (1/3 each).
                        Line 2: varying sizes (1/4 + 5/12 + 1/3).
                        Line 3: very different sizes (1/2 + 1/3 + 1/6).
                    </p>
                </div>
            </div>