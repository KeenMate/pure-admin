                    <script>
                        // Measure and display actual heights
                        document.addEventListener('DOMContentLoaded', function() {
                            const table = document.getElementById('sizesTable');
                            const rows = table.querySelectorAll('tbody tr');
                            rows.forEach(row => {
                                const input = row.querySelector('[data-measure="input"]');
                                const button = row.querySelector('[data-measure="button"]');
                                const inputHeightCell = row.querySelector('.height-input');
                                const buttonHeightCell = row.querySelector('.height-button');
                                if (input && inputHeightCell) {
                                    inputHeightCell.textContent = input.offsetHeight + 'px';
                                }
                                if (button && buttonHeightCell) {
                                    buttonHeightCell.textContent = button.offsetHeight + 'px';
                                }
                            });
                        });
