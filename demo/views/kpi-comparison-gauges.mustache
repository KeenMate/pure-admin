<p>"Comparison gauges" KPI indicator. Each KPI is a goal-oriented progress bar — <strong>label · value</strong> on top, <strong>bar with a target tick</strong> in the middle, <strong>0 · tgt</strong> scale below. Bar fill is value/target, capped at 100% (overshoots are signalled by colour, not by overflowing the bar). Colours: <code>--pa-positive</code> for "on track", new <code>--pa-warning</code> for "off-target / approaching limit", <code>--pa-neutral</code> for "no strong sentiment".</p>

<style>
/* === Card header: title + LIVE pulse === */
.kpi-gauge-list {
  container-type: inline-size;
}
.kpi-gauge-list__header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 1.6rem;
  flex-wrap: wrap;
}
.kpi-gauge-list__live {
  display: inline-flex;
  align-items: center;
  gap: 0.6rem;
  font-family: var(--base-font-family-mono);
  font-size: 1.2rem;
  font-weight: 600;
  letter-spacing: 0.06em;
  color: var(--pa-text-secondary);
}
.kpi-gauge-list__livedot {
  width: 0.8rem;
  height: 0.8rem;
  border-radius: 50%;
  background: var(--pa-positive);
  box-shadow: 0 0 6px var(--pa-positive);
  animation: kpiPulse 1.6s ease-in-out infinite;
}
@keyframes kpiPulse { 50% { opacity: 0.35; } }

/* === Body: 2-column internal grid by default; collapses to 1-col when card narrows === */
.kpi-gauge-list__body { padding: 0; }

.kpi-gauge-list__grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
}
@container (max-width: 600px) {
  .kpi-gauge-list__grid {
    grid-template-columns: 1fr;
  }
}

/* === Gauge tile: label+value head · bar · 0/tgt scale === */
.kpi-gauge {
  position: relative;
  padding: 1.6rem 2rem;
  border-bottom: 1px solid var(--pa-border-color);
  border-right: 1px solid var(--pa-border-color);
  /* Per-tile bar colour is set via this custom property; defaults to positive
     and is overridden by .kpi-gauge--warning / --negative / --neutral below.
     Cleaner than a dozen .kpi-gauge--X .kpi-gauge__fill { background: ... }
     selectors and lets host apps override at the tile level too. */
  --kpi-accent: var(--pa-positive);
}
.kpi-gauge:nth-child(2n) { border-right: 0; }
.kpi-gauge:nth-last-child(-n+2) { border-bottom: 0; }
@container (max-width: 600px) {
  .kpi-gauge { border-right: 0; }
  .kpi-gauge:nth-last-child(-n+2) { border-bottom: 1px solid var(--pa-border-color); }
  .kpi-gauge:last-child { border-bottom: 0; }
}

.kpi-gauge--positive { --kpi-accent: var(--pa-positive); }
.kpi-gauge--warning  { --kpi-accent: var(--pa-warning); }
.kpi-gauge--negative { --kpi-accent: var(--pa-negative); }
.kpi-gauge--neutral  { --kpi-accent: color-mix(in srgb, var(--pa-text-color-1) 70%, transparent); }

/* Head: label left, value right (baseline-aligned) */
.kpi-gauge__head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 1.2rem;
  margin-bottom: 0.8rem;
}
.kpi-gauge__label {
  font-family: var(--base-font-family-mono);
  font-size: 1.4rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: color-mix(in srgb, var(--pa-text-color-1) 60%, transparent);
}
.kpi-gauge__value {
  font-family: var(--base-font-family-mono);
  line-height: 1;
}
.kpi-gauge__num {
  font-size: 2.6rem;
  font-weight: 700;
  letter-spacing: -0.02em;
  color: var(--pa-text-color-1);
}
.kpi-gauge__unit {
  font-size: 1.3rem;
  font-weight: 500;
  color: var(--pa-text-secondary);
  margin-left: 0.2rem;
}

/* Bar: subtle track + coloured fill + tick marking target position.
   Tick position is author-controlled via `--kpi-gauge-tick-pos`
   (default 100% = at the right edge, matching the bar's "0 → target"
   scale). Override per-tile via `style="--kpi-gauge-tick-pos: 80%"`
   if the bar represents a wider scale (e.g. 0→max where target sits
   inside the bar) — the tick will slide to that position. */
.kpi-gauge__bar {
  --kpi-gauge-tick-pos: 100%;
  --kpi-gauge-tick-color: var(--pa-text-color-1);
  position: relative;
  height: 0.7rem;
  background: var(--pa-surface-track);
  margin-bottom: 0.5rem;
  overflow: visible;          /* tick can sit just outside the bar edges */
}
.kpi-gauge__fill {
  height: 100%;
  background: var(--kpi-accent);
  /* width set inline per tile via style="--fill: 95%" or width: X% directly */
  transition: width 0.3s ease;
}
/* Target tick — small bar slightly taller than the track, reading as a
   "you should be here" mark. Centered on `--kpi-gauge-tick-pos` via the
   negative margin-left (matches half the tick's width, so the position
   value names where the *centre* of the tick sits, not its left edge).
   Colour comes from `--kpi-gauge-tick-color` (default --pa-text-color-1
   at full opacity, so the tick stays readable against any sentiment fill —
   alpha-blended defaults wash out on dark themes against bright orange/green
   fills). Override per-tile or globally for a quieter mark. */
.kpi-gauge__bar::after {
  content: '';
  position: absolute;
  left: var(--kpi-gauge-tick-pos);
  margin-left: -0.15rem;
  top: -0.2rem;
  bottom: -0.2rem;
  width: 0.3rem;
  background: var(--kpi-gauge-tick-color);
}

/* Scale row: 0 left, tgt XYZ right — both dim, mono */
.kpi-gauge__scale {
  display: flex;
  justify-content: space-between;
  font-family: var(--base-font-family-mono);
  font-size: 1.2rem;
  color: var(--pa-text-tertiary);
}

/* === Footer caption === */
.kpi-gauge-list__footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 1rem;
  font-family: var(--base-font-family-mono);
  font-size: 1.2rem;
  color: var(--pa-text-secondary);
}
.kpi-gauge-list__footer strong {
  color: var(--pa-text-color-1);
  font-weight: 700;
}

/* === Hover detail popover — same Floating UI / cursor-anchored recipe as
   the other KPI showcases. === */
.kpi-gauge__detail {
  position: fixed;
  top: 0;
  left: 0;
  visibility: hidden;
  pointer-events: none;
  z-index: 9000;
  min-width: 26rem;
  max-width: 32rem;
  background: var(--pa-detail-bg);
