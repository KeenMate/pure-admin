<p>"Comparison gauges" KPI indicator. Each KPI is a goal-oriented progress bar — <strong>label · value</strong> on top, <strong>bar with a target tick</strong> in the middle, <strong>0 · tgt</strong> scale below. Bar fill is value/target, capped at 100% (overshoots are signalled by colour, not by overflowing the bar). Colours: <code>--kpi-positive</code> for "on track", new <code>--kpi-warning</code> for "off-target / approaching limit", <code>--kpi-neutral</code> for "no strong sentiment".</p>

<style>
/* === KPI design tokens (shared across all KPI indicators) ===
   Adds --kpi-warning to the existing 5-step semantic scale: an amber/orange
   for "approaching limit / off target" states that aren't quite negative
   yet. Sits alongside the scale, not on it — different axis. */
:root {
  --kpi-very-positive: #16a34a;
  --kpi-positive:      #22c55e;
  --kpi-neutral:       #9ca3af;
  --kpi-negative:      #ef4444;
  --kpi-very-negative: #dc2626;
  --kpi-warning:       #f97316;   /* Tailwind orange-500 — off-target / approach-limit signal */

  --kpi-detail-bg: rgba(15, 17, 21, 0.97);
  --kpi-detail-text: #ffffff;
  --kpi-detail-row-label: rgba(255, 255, 255, 0.75);
  --kpi-detail-title: rgba(255, 255, 255, 0.55);
  --kpi-detail-shadow: 0 1.4rem 3.6rem rgba(0, 0, 0, 0.55);
}

/* === Card header: title + LIVE pulse === */
.kpi-gauge-list {
  container-type: inline-size;
}
.kpi-gauge-list__header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 1.6rem;
  flex-wrap: wrap;
}
.kpi-gauge-list__live {
  display: inline-flex;
  align-items: center;
  gap: 0.6rem;
  font-family: var(--base-font-family-mono);
  font-size: 1.2rem;
  font-weight: 600;
  letter-spacing: 0.06em;
  color: color-mix(in srgb, var(--pa-text-color-1) 55%, transparent);
}
.kpi-gauge-list__livedot {
  width: 0.8rem;
  height: 0.8rem;
  border-radius: 50%;
  background: var(--kpi-positive);
  box-shadow: 0 0 6px var(--kpi-positive);
  animation: kpiPulse 1.6s ease-in-out infinite;
}
@keyframes kpiPulse { 50% { opacity: 0.35; } }

/* === Body: 2-column internal grid by default; collapses to 1-col when card narrows === */
.kpi-gauge-list__body { padding: 0; }

.kpi-gauge-list__grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
}
@container (max-width: 600px) {
  .kpi-gauge-list__grid {
    grid-template-columns: 1fr;
  }
}

/* === Gauge tile: label+value head · bar · 0/tgt scale === */
.kpi-gauge {
  position: relative;
  padding: 1.6rem 2rem;
  border-bottom: 1px solid var(--pa-border-color);
  border-right: 1px solid var(--pa-border-color);
  /* Per-tile bar colour is set via this custom property; defaults to positive
     and is overridden by .kpi-gauge--warning / --negative / --neutral below.
     Cleaner than a dozen .kpi-gauge--X .kpi-gauge__fill { background: ... }
     selectors and lets host apps override at the tile level too. */
  --kpi-bar-color: var(--kpi-positive);
}
.kpi-gauge:nth-child(2n) { border-right: 0; }
.kpi-gauge:nth-last-child(-n+2) { border-bottom: 0; }
@container (max-width: 600px) {
  .kpi-gauge { border-right: 0; }
  .kpi-gauge:nth-last-child(-n+2) { border-bottom: 1px solid var(--pa-border-color); }
  .kpi-gauge:last-child { border-bottom: 0; }
}

.kpi-gauge--positive { --kpi-bar-color: var(--kpi-positive); }
.kpi-gauge--warning  { --kpi-bar-color: var(--kpi-warning); }
.kpi-gauge--negative { --kpi-bar-color: var(--kpi-negative); }
.kpi-gauge--neutral  { --kpi-bar-color: color-mix(in srgb, var(--pa-text-color-1) 70%, transparent); }

/* Head: label left, value right (baseline-aligned) */
.kpi-gauge__head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 1.2rem;
  margin-bottom: 0.8rem;
}
.kpi-gauge__label {
  font-family: var(--base-font-family-mono);
  font-size: 1.4rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: color-mix(in srgb, var(--pa-text-color-1) 60%, transparent);
}
.kpi-gauge__value {
  font-family: var(--base-font-family-mono);
  line-height: 1;
}
.kpi-gauge__num {
  font-size: 2.6rem;
  font-weight: 700;
  letter-spacing: -0.02em;
  color: var(--pa-text-color-1);
}
.kpi-gauge__unit {
  font-size: 1.3rem;
  font-weight: 500;
  color: color-mix(in srgb, var(--pa-text-color-1) 55%, transparent);
  margin-left: 0.2rem;
}

/* Bar: subtle track + coloured fill + tick at right edge marking target position */
.kpi-gauge__bar {
  position: relative;
  height: 0.7rem;
  background: color-mix(in srgb, var(--pa-text-color-1) 12%, transparent);
  margin-bottom: 0.5rem;
  overflow: visible;          /* tick can sit just outside the right edge */
}
.kpi-gauge__fill {
  height: 100%;
  background: var(--kpi-bar-color);
  /* width set inline per tile via style="--fill: 95%" or width: X% directly */
  transition: width 0.3s ease;
}
/* Target tick — small lighter-coloured bar at the right edge of the track,
   slightly taller than the bar so it reads as a "you should be here" mark.
   This is the visual anchor for the "tgt XYZ" label below. */
.kpi-gauge__bar::after {
  content: '';
  position: absolute;
  right: 0;
  top: -0.2rem;
  bottom: -0.2rem;
  width: 0.3rem;
  background: color-mix(in srgb, var(--pa-text-color-1) 45%, transparent);
}

/* Scale row: 0 left, tgt XYZ right — both dim, mono */
.kpi-gauge__scale {
  display: flex;
  justify-content: space-between;
  font-family: var(--base-font-family-mono);
  font-size: 1.2rem;
  color: color-mix(in srgb, var(--pa-text-color-1) 42%, transparent);
}

/* === Footer caption === */
.kpi-gauge-list__footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 1rem;
  font-family: var(--base-font-family-mono);
  font-size: 1.2rem;
  color: color-mix(in srgb, var(--pa-text-color-1) 55%, transparent);
}
.kpi-gauge-list__footer strong {
  color: var(--pa-text-color-1);
  font-weight: 700;
}

/* === Hover detail popover — same Floating UI / cursor-anchored recipe as
   the other KPI showcases. === */
.kpi-gauge__detail {
  position: fixed;
  top: 0;
  left: 0;
  visibility: hidden;
  pointer-events: none;
  z-index: 9000;
  min-width: 26rem;
  max-width: 32rem;
  background: var(--kpi-detail-bg);
  color: var(--kpi-detail-text);
  padding: 1.2rem 1.5rem;
  font-family: var(--base-font-family-mono);
  font-size: 1.25rem;
  line-height: 1.5;
  border-radius: 0.4rem;
  box-shadow: var(--kpi-detail-shadow);
}
.kpi-gauge__detail[data-show] { visibility: visible; }
.kpi-gauge__detail-title {
  text-transform: uppercase;
  letter-spacing: 0.08em;
  font-size: 1.05rem;
  font-weight: 700;
  color: var(--kpi-detail-title);
  margin-bottom: 0.6rem;
}
.kpi-gauge__detail dl {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 0.35rem 1.6rem;
  margin: 0;
}
.kpi-gauge__detail dt { margin: 0; color: var(--kpi-detail-row-label); font-weight: 400; }
.kpi-gauge__detail dd { margin: 0; text-align: end; font-weight: 600; font-variant-numeric: tabular-nums; }
.kpi-gauge__detail .pos { color: var(--kpi-positive); }
.kpi-gauge__detail .neg { color: var(--kpi-negative); }
.kpi-gauge__detail .warn { color: var(--kpi-warning); }
</style>

