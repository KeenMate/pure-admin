  border-radius: 0.4rem;
  box-shadow: var(--pa-detail-shadow);
}
.kpi-gauge__detail[data-show] { visibility: visible; }
.kpi-gauge__detail-title {
  text-transform: uppercase;
  letter-spacing: 0.08em;
  font-size: 1.05rem;
  font-weight: 700;
  color: var(--pa-detail-title);
  margin-bottom: 0.6rem;
}
.kpi-gauge__detail dl {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 0.35rem 1.6rem;
  margin: 0;
}
.kpi-gauge__detail dt { margin: 0; color: var(--pa-detail-row-label); font-weight: 400; }
.kpi-gauge__detail dd { margin: 0; text-align: end; font-weight: 600; font-variant-numeric: tabular-nums; }
.kpi-gauge__detail .pos { color: var(--pa-positive); }
.kpi-gauge__detail .neg { color: var(--pa-negative); }
.kpi-gauge__detail .warn { color: var(--pa-warning); }
