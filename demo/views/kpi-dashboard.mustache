<!-- Live-data simulation -->
<script>
(function () {
  var rows = document.querySelectorAll('.pc-row');
  var tileRows = [rows[0], rows[1]];
  var cards = [];
  tileRows.forEach(function (row) {
    if (!row) return;
    row.querySelectorAll('.pa-card').forEach(function (c) { cards.push(c); });
  });

  var LIVE_CLASSES = ['pa-card--live-up', 'pa-card--live-down', 'pa-card--live-neutral'];

  function randomDelta(base) {
    var pct = (Math.random() * 7.5 + 0.5) / 100;
    var sign = Math.random() > 0.5 ? 1 : -1;
    return base * pct * sign;
  }

  function formatValue(raw, template) {
    if (template.startsWith('$')) {
      if (Math.abs(raw) >= 1000) return '$' + Number((raw / 1000).toFixed(1)).toLocaleString('en-US') + 'K';
      return '$' + raw.toLocaleString('en-US', { maximumFractionDigits: 0 });
    }
    if (template.endsWith('%')) return raw.toFixed(2) + '%';
    if (template.endsWith('K')) return (raw / 1000).toFixed(0) + 'K';
    return Number(raw.toFixed(0)).toLocaleString('en-US');
  }

  function parseValue(text) {
    var s = text.trim().replace(/,/g, '');
    if (s.endsWith('K')) return parseFloat(s.replace(/[^0-9.\-]/g, '')) * 1000;
    return parseFloat(s.replace(/[^0-9.\-]/g, ''));
  }

  function setLiveState(card, delta) {
    var cls = delta > 0 ? 'pa-card--live-up' : 'pa-card--live-down';
    LIVE_CLASSES.forEach(function (c) { card.classList.remove(c); });
    card.classList.add(cls);
  }

  function tick() {
    var count = Math.floor(Math.random() * 3) + 1;
    for (var i = 0; i < count; i++) {
      var card = cards[Math.floor(Math.random() * cards.length)];
      var valEl = card.querySelector('.pa-stat__value');
      var changeEl = card.querySelector('.pa-stat__change');
      if (!valEl) continue;

      var template = valEl.textContent.trim();
      var current = parseValue(template);
      if (isNaN(current)) continue;

      var delta = randomDelta(current);
      var next = current + delta;
      valEl.textContent = formatValue(next, template);

      if (changeEl) {
        var pct = Math.abs(delta / current * 100).toFixed(1);
        var isUp = delta > 0;
        changeEl.textContent = (isUp ? '\u25B2 ' : '\u25BC ') + pct + '% vs prev.';
        changeEl.className = 'pa-stat__change pa-stat__change--' + (isUp ? 'positive' : 'negative');
      }

      setLiveState(card, delta);
    }
  }

  function schedule() {
    var delay = 1500 + Math.random() * 1500;
    setTimeout(function () { tick(); schedule(); }, delay);
  }
  schedule();
})();
</script>
