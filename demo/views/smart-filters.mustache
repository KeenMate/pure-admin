    </div>
</div>

<script src="/src/js/search-autocomplete-v2.js"></script>
<script>
// Initialize inline query editor
document.addEventListener('DOMContentLoaded', function() {
    // Field definitions
    const fields = [
        { name: 'name', type: 'text' },
        { name: 'email', type: 'text' },
        { name: 'code', type: 'text' },
        { name: 'price', type: 'number' },
        { name: 'status', type: 'text' },
        { name: 'category', type: 'text' },
        { name: 'created_at', type: 'date' },
        { name: 'updated_at', type: 'date' },
        { name: 'quantity', type: 'number' }
    ];

    // Initialize Inline Query Editor
    const inlineQueryEditor = document.getElementById('inline-query-editor');
    const serverQueryDisplay = document.getElementById('server-query-display');

    if (inlineQueryEditor && serverQueryDisplay) {
        const editor = new InlineQueryEditor(inlineQueryEditor, fields);

        // Update server query display on input
        const editorInput = inlineQueryEditor.querySelector('.pa-inline-query-editor__input');
        if (editorInput) {
            editorInput.addEventListener('input', function() {
                const serverQuery = editor.toServerQuery();

                // Check if filter is empty (no conditions)
                const hasFilter = serverQuery.filter && Object.keys(serverQuery.filter).length > 0;

                if (!hasFilter) {
                    serverQueryDisplay.textContent = 'Start typing to see the server query format';
                } else {
                    serverQueryDisplay.textContent = JSON.stringify(serverQuery, null, 2);
                }

                // Also log for debugging
                console.log('Query:', editor.getValue());
                console.log('Server Query:', serverQuery);
            });
        }
    }
});
</script>
