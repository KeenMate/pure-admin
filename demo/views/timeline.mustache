<script>
// Load More Timeline Feed
let loadMoreFeedPage = 1;
const loadMoreFeedData = [
    [
        { type: 'date', date: 'January 19, 2021' },
        { type: 'item', time: '09:15', avatar: 'Sarah Chen', text: '<a href="#">Sarah Chen</a> attached <a href="#">3 files</a> to the project' }
    ],
    [
        { type: 'date', date: 'January 18, 2021' },
        { type: 'item', time: '17:30', avatar: 'Mike Johnson', text: '<a href="#">Mike Johnson</a> completed <a href="#">Design Review</a> task' },
        { type: 'item', time: '10:15', avatar: 'Emma Davis', text: '<a href="#">Emma Davis</a> created new <a href="#">milestone</a>' }
    ],
    [
        { type: 'date', date: 'January 17, 2021' },
        { type: 'item', time: '15:45', avatar: 'John Smith', text: '<a href="#">John Smith</a> updated project status' }
    ]
];

function loadMoreFeedItems() {
    if (loadMoreFeedPage >= loadMoreFeedData.length) {
        alert('No more entries to load!');
        return;
    }

    const timeline = document.getElementById('timeline-feed-load-more');
    const items = loadMoreFeedData[loadMoreFeedPage];

    items.forEach(item => {
        const li = document.createElement('li');
        if (item.type === 'date') {
            li.className = 'pa-timeline__item pa-timeline__item--date-header';
            li.innerHTML = `
                <div class="pa-timeline__date-icon">📅</div>
                <div class="pa-timeline__date-label">${item.date}</div>
            `;
        } else {
            li.className = 'pa-timeline__item';
            li.innerHTML = `
                <div class="pa-timeline__time">${item.time}</div>
                <div class="pa-timeline__content">
                    <div class="pa-timeline__avatar">
                        <img src="https://ui-avatars.com/api/?name=${item.avatar.replace(' ', '+')}&background=0D8ABC&color=fff" alt="${item.avatar}">
                    </div>
                    <span>${item.text}</span>
                </div>
            `;
        }
        timeline.appendChild(li);
    });

    loadMoreFeedPage++;
}

// Virtual Scroll Timeline Feed
let virtualScrollFeedPage = 1;
let isLoadingVirtualScrollFeed = false;

const virtualScrollFeedData = [
    [
        { type: 'date', date: 'January 19, 2021' },
        { type: 'item', time: '15:30', avatar: 'Sarah Chen', text: '<a href="#">Sarah Chen</a> updated documentation' },
        { type: 'item', time: '09:15', avatar: 'Sarah Chen', text: '<a href="#">Sarah Chen</a> attached <a href="#">3 files</a> to the project' }
    ],
    [
        { type: 'date', date: 'January 18, 2021' },
        { type: 'item', time: '17:30', avatar: 'Mike Johnson', text: '<a href="#">Mike Johnson</a> completed <a href="#">Design Review</a> task' },
        { type: 'item', time: '14:20', avatar: 'Emma Davis', text: '<a href="#">Emma Davis</a> created new <a href="#">milestone</a>' },
        { type: 'item', time: '10:15', avatar: 'John Smith', text: '<a href="#">John Smith</a> assigned task to team' }
    ],
    [
        { type: 'date', date: 'January 17, 2021' },
        { type: 'item', time: '16:45', avatar: 'Luna Bonifacio', text: '<a href="#">Luna Bonifacio</a> reviewed pull request' },
        { type: 'item', time: '15:45', avatar: 'John Smith', text: '<a href="#">John Smith</a> updated project status' },
        { type: 'item', time: '11:30', avatar: 'Yoan Almedia', text: '<a href="#">Yoan Almedia</a> merged feature branch' }
    ],
    [
        { type: 'date', date: 'January 16, 2021' },
        { type: 'item', time: '18:00', avatar: 'Emma Davis', text: '<a href="#">Emma Davis</a> closed <a href="#">5 issues</a>' },
        { type: 'item', time: '13:20', avatar: 'Sarah Chen', text: '<a href="#">Sarah Chen</a> started code review' },
        { type: 'item', time: '09:00', avatar: 'Mike Johnson', text: '<a href="#">Mike Johnson</a> opened new sprint' }
    ],
    [
        { type: 'date', date: 'January 15, 2021' },
        { type: 'item', time: '17:15', avatar: 'Luna Bonifacio', text: '<a href="#">Luna Bonifacio</a> deployed to staging' },
        { type: 'item', time: '14:30', avatar: 'John Smith', text: '<a href="#">John Smith</a> created release notes' },
        { type: 'item', time: '10:45', avatar: 'Yoan Almedia', text: '<a href="#">Yoan Almedia</a> fixed critical bug', comment: 'Fixed the authentication issue that was blocking deployment.' }
    ]
];

const scrollFeedContainer = document.getElementById('timeline-feed-scroll-container');
const virtualScrollFeedTimeline = document.getElementById('timeline-feed-virtual-scroll');
const scrollFeedLoader = document.getElementById('timeline-feed-scroll-loader');
const scrollFeedLoaderSpinner = document.getElementById('timeline-feed-scroll-spinner');
const scrollFeedLoaderText = document.getElementById('timeline-feed-scroll-text');

// Use scroll event instead since loader is outside container
scrollFeedContainer.addEventListener('scroll', () => {
    const scrollTop = scrollFeedContainer.scrollTop;
    const scrollHeight = scrollFeedContainer.scrollHeight;
    const clientHeight = scrollFeedContainer.clientHeight;

    // Check if scrolled to bottom (with 50px threshold)
    if (scrollTop + clientHeight >= scrollHeight - 50 && !isLoadingVirtualScrollFeed && virtualScrollFeedPage < virtualScrollFeedData.length) {
        loadVirtualScrollFeedItems();
    }
});

function loadVirtualScrollFeedItems() {
    if (virtualScrollFeedPage >= virtualScrollFeedData.length || isLoadingVirtualScrollFeed) {
        return;
    }

    isLoadingVirtualScrollFeed = true;
    scrollFeedLoaderSpinner.style.display = 'block';
    scrollFeedLoaderText.style.display = 'block';

    setTimeout(() => {
        const items = virtualScrollFeedData[virtualScrollFeedPage];

        items.forEach(item => {
            const li = document.createElement('li');
            if (item.type === 'date') {
                li.className = 'pa-timeline__item pa-timeline__item--date-header';
                li.innerHTML = `
                    <div class="pa-timeline__date-icon">📅</div>
                    <div class="pa-timeline__date-label">${item.date}</div>
                `;
            } else {
                li.className = 'pa-timeline__item';
                let commentHtml = '';
                if (item.comment) {
                    commentHtml = `<div class="pa-timeline__comment"><p>${item.comment}</p></div>`;
                }
                li.innerHTML = `
                    <div class="pa-timeline__time">${item.time}</div>
                    <div class="pa-timeline__content">
                        <div class="pa-timeline__avatar">
                            <img src="https://ui-avatars.com/api/?name=${item.avatar.replace(' ', '+')}&background=0D8ABC&color=fff" alt="${item.avatar}">
                        </div>
                        <span>${item.text}</span>
                        ${commentHtml}
                    </div>
                `;
            }
            virtualScrollFeedTimeline.appendChild(li);
        });

        virtualScrollFeedPage++;
        scrollFeedLoaderSpinner.style.display = 'none';
        scrollFeedLoaderText.style.display = 'none';
        isLoadingVirtualScrollFeed = false;

        if (virtualScrollFeedPage >= virtualScrollFeedData.length) {
            loadMoreFeedObserver.disconnect();
            scrollFeedLoader.style.display = 'none';
        }
    }, 800);
}
</script>
