            <li><code>pa-code--css</code> - Blue accent</li>
            <li><code>pa-code--bash</code> - Gray accent</li>
            <li><code>pa-code--sql</code> - Purple accent</li>
            <li><code>pa-code--python</code> - Blue accent</li>
        </ul>

        <h4 class="mt-4">Code Block with Header</h4>
        <ul class="pa-list-basic pa-list-basic--compact">
