<!-- CSS Classes Reference -->
<div class="pa-card">
    <div class="pa-card__header">
        <div class="pa-card__title">
            <h3 class="pa-card__title-text">CSS Classes Reference</h3>
        </div>
    </div>
    <div class="pa-card__body">
        <h4>Tabs Base</h4>
        <ul class="pa-list-basic pa-list-basic--compact">
            <li><code>pa-tabs</code> - Base tabs container</li>
            <li><code>pa-tabs__item</code> - Individual tab button</li>
            <li><code>pa-tabs__item--active</code> - Active tab state</li>
            <li><code>pa-tabs__content</code> - Content wrapper</li>
            <li><code>pa-tabs__panel</code> - Tab panel (hidden by default)</li>
            <li><code>pa-tabs__panel--active</code> - Active/visible panel</li>
        </ul>

        <h4 class="mt-4">Tab Styles</h4>
        <ul class="pa-list-basic pa-list-basic--compact">
            <li><code>pa-tabs--pills</code> - Rounded pill-style tabs</li>
            <li><code>pa-tabs--boxed</code> - Boxed tabs with background</li>
            <li><code>pa-tabs--vertical</code> - Vertical tab layout</li>
            <li><code>pa-tabs--border-top</code> - Active indicator on top</li>
        </ul>

        <h4 class="mt-4">Tab Modifiers</h4>
        <ul class="pa-list-basic pa-list-basic--compact">
            <li><code>pa-tabs--sm</code> - Small size</li>
            <li><code>pa-tabs--lg</code> - Large size</li>
            <li><code>pa-tabs--centered</code> - Center-aligned tabs</li>
            <li><code>pa-tabs--full</code> - Full width (equal-width tabs)</li>
            <li><code>pa-tabs--nowrap</code> - Prevent wrapping</li>
            <li><code>pa-tabs--collapse</code> - Icon-only until active</li>
            <li><code>pa-tabs--scrollable</code> - Horizontal scroll with arrows</li>
        </ul>

        <h4 class="mt-4">Scrollable Tabs Elements</h4>
        <ul class="pa-list-basic pa-list-basic--compact">
            <li><code>pa-tabs__scroll-container</code> - Scrollable inner container</li>
            <li><code>pa-tabs__scroll-btn</code> - Scroll arrow button</li>
            <li><code>pa-tabs__scroll-btn--start/--end</code> - Arrow direction</li>
            <li><code>pa-tabs__scroll-btn--visible</code> - Show arrow</li>
        </ul>

        <h4 class="mt-4">Container Wrappers</h4>
        <ul class="pa-list-basic pa-list-basic--compact">
            <li><code>pa-tabs__container--bordered</code> - Card-like border wrapper</li>
            <li><code>pa-tabs__container--card</code> - Tabs as card header</li>
            <li><code>pa-tabs__vertical-layout</code> - Vertical tabs + content wrapper</li>
            <li><code>pa-tabs__vertical-layout--bordered</code> - Bordered vertical layout</li>
        </ul>

        <h4 class="mt-4">Overflow Menu (Card Header)</h4>
        <ul class="pa-list-basic pa-list-basic--compact">
            <li><code>pa-tabs__overflow</code> - Overflow container</li>
            <li><code>pa-tabs__overflow-toggle</code> - Overflow button</li>
            <li><code>pa-tabs__overflow-toggle--has-active</code> - Active tab in overflow</li>
            <li><code>pa-tabs__overflow-menu</code> - Dropdown menu</li>
            <li><code>pa-tabs__overflow-menu--open</code> - Open state</li>
        </ul>
    </div>
</div>

            <script>
            // Scrollable tabs functionality
            function scrollTabs(button, direction) {
                const tabsContainer = button.closest('.pa-tabs--scrollable');
                const scrollContainer = tabsContainer.querySelector('.pa-tabs__scroll-container');
                const scrollAmount = 200; // pixels to scroll

                if (direction === 'left') {
                    scrollContainer.scrollLeft -= scrollAmount;
                } else {
                    scrollContainer.scrollLeft += scrollAmount;
                }

                // Update arrow visibility after scroll
                setTimeout(() => updateScrollArrows(tabsContainer), 100);
            }

            function updateScrollArrows(tabsContainer) {
                const scrollContainer = tabsContainer.querySelector('.pa-tabs__scroll-container');
                const leftBtn = tabsContainer.querySelector('.pa-tabs__scroll-btn--start');
                const rightBtn = tabsContainer.querySelector('.pa-tabs__scroll-btn--end');

                if (!scrollContainer || !leftBtn || !rightBtn) return;

                const isAtStart = scrollContainer.scrollLeft <= 0;
                const isAtEnd = scrollContainer.scrollLeft + scrollContainer.clientWidth >= scrollContainer.scrollWidth - 1;

                // Show/hide arrows based on scroll position
                if (isAtStart) {
                    leftBtn.classList.remove('pa-tabs__scroll-btn--visible');
                } else {
                    leftBtn.classList.add('pa-tabs__scroll-btn--visible');
                }

                if (isAtEnd) {
                    rightBtn.classList.remove('pa-tabs__scroll-btn--visible');
                } else {
                    rightBtn.classList.add('pa-tabs__scroll-btn--visible');
                }
            }

            // Initialize scrollable tabs on page load
            document.addEventListener('DOMContentLoaded', function() {
                const scrollableTabs = document.querySelectorAll('[data-tabs-scroll]');
                scrollableTabs.forEach(tabsContainer => {
                    const scrollContainer = tabsContainer.querySelector('.pa-tabs__scroll-container');

                    // Initial arrow visibility check
                    updateScrollArrows(tabsContainer);

                    // Update on scroll
                    scrollContainer.addEventListener('scroll', () => {
                        updateScrollArrows(tabsContainer);
                    });

                    // Update on resize
                    window.addEventListener('resize', () => {
                        updateScrollArrows(tabsContainer);
                    });
                });
            });

            // Toggle overflow menu for tabs
            function toggleTabsOverflow(button) {
                const menu = button.nextElementSibling;
                menu.classList.toggle('pa-tabs__overflow-menu--open');

                // Close on click outside
                if (menu.classList.contains('pa-tabs__overflow-menu--open')) {
                    setTimeout(() => {
                        document.addEventListener('click', function closeMenu(e) {
                            if (!menu.contains(e.target) && !button.contains(e.target)) {
                                menu.classList.remove('pa-tabs__overflow-menu--open');
                                document.removeEventListener('click', closeMenu);
                            }
                        });
                    }, 0);
                }
            }

            // Tab switching for standalone tabs
            function switchTab(button, panelId) {
                // Handle tabs in overflow menu, scrollable tabs, or regular tabs
                let tabsContainer = button.closest('.pa-tabs__scroll-container');
                if (tabsContainer) {
                    tabsContainer = tabsContainer.parentElement; // Get parent .pa-tabs
                } else {
                    tabsContainer = button.closest('.pa-tabs');
                }

                // Find content container - handle both sibling and wrapper layouts
                let contentContainer = tabsContainer.nextElementSibling;

                // If nextElementSibling is not the content container (wrapped layouts)
                if (!contentContainer || !contentContainer.classList.contains('pa-tabs__content')) {
                    // Search in parent scope (card body, vertical layout wrapper, or container)
                    const parent = tabsContainer.closest('.pa-card__body, .pa-tabs__vertical-layout, .pa-tabs__container');
                    if (parent) {
                        contentContainer = parent.querySelector('.pa-tabs__content');
                    }
                }

                if (!contentContainer) return;

                // Remove active class from all tabs (including those in overflow menu)
                const tabs = tabsContainer.querySelectorAll('.pa-tabs__item');
                tabs.forEach(tab => tab.classList.remove('pa-tabs__item--active'));

                // Add active class to clicked tab
                button.classList.add('pa-tabs__item--active');

                // Hide all panels in this content container
                const panels = contentContainer.querySelectorAll('.pa-tabs__panel');
                panels.forEach(panel => panel.classList.remove('pa-tabs__panel--active'));

                // Show selected panel
                const selectedPanel = contentContainer.querySelector(`#${panelId}`);
                if (selectedPanel) {
                    selectedPanel.classList.add('pa-tabs__panel--active');
                }

                // Close overflow menu if tab was in it
                const overflowMenu = button.closest('.pa-tabs__overflow-menu');
                if (overflowMenu) {
                    overflowMenu.classList.remove('pa-tabs__overflow-menu--open');
                }

                // Update overflow toggle indicator if active tab is in overflow
                const overflow = tabsContainer.querySelector('.pa-tabs__overflow');
                if (overflow) {
                    const toggle = overflow.querySelector('.pa-tabs__overflow-toggle');
                    const menu = overflow.querySelector('.pa-tabs__overflow-menu');
                    const hasActiveInOverflow = menu && menu.querySelector('.pa-tabs__item--active');
                    toggle.classList.toggle('pa-tabs__overflow-toggle--has-active', !!hasActiveInOverflow);
                }
            }

            // Tab switching for card tabs
            function switchCardTab(button, panelId) {
                const card = button.closest('.pa-card');

                // Remove active class from all tabs
                const tabs = card.querySelectorAll('.pa-card__tab');
                tabs.forEach(tab => tab.classList.remove('pa-card__tab--active'));

                // Add active class to clicked tab
                button.classList.add('pa-card__tab--active');

                // Hide all tab content
                const contents = card.querySelectorAll('.pa-card__tab-content');
                contents.forEach(content => content.classList.remove('pa-card__tab-content--active'));

                // Show selected tab content
                const selectedContent = card.querySelector(`#${panelId}`);
                if (selectedContent) {
                    selectedContent.classList.add('pa-card__tab-content--active');
                }
            }
            </script>
