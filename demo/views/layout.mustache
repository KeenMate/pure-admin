<body{{#isRtlTest}} data-rtl-default="true"{{/isRtlTest}}>
    <!-- Page Loader: Shows while fonts/CSS load -->
    <div class="page-loader" id="pageLoader">
        <div class="page-loader__spinner"></div>
    </div>

    <!-- Hide loader when fonts are ready -->
    <script>
        (function() {
            const loader = document.getElementById('pageLoader');

            // Hide loader AFTER fonts are fully loaded
            if (document.fonts && document.fonts.ready) {
                Promise.race([
                    document.fonts.ready,
                    new Promise(resolve => setTimeout(resolve, 1000)) // 1s timeout fallback
                ]).then(() => {
                    requestAnimationFrame(() => {
                        loader.classList.add('loaded');
                        // Remove from DOM after transition
                        setTimeout(() => loader.remove(), 80);
                    });
                });
            } else {
                // Fallback for browsers without Font Loading API
                window.addEventListener('load', () => {
                    loader.classList.add('loaded');
                    setTimeout(() => loader.remove(), 80);
                });
            }
        })();
    </script>

    <!-- Prevent FOUC: Apply saved settings immediately before rendering -->
    <script>
        (function() {
            // Apply sidebar behavior immediately
            const sidebarBehavior = localStorage.getItem('sidebar-behavior') || 'hide';
            const sidebarHidden = localStorage.getItem('sidebar-hidden') === 'true';
            const isMobile = window.innerWidth <= ((window.pureAdmin && window.pureAdmin.config && window.pureAdmin.config.mobileBreakpoint) || 768);

            // Apply sidebar-hidden state (works for both 'hide' and 'icon-collapse' behaviors)
            if (!isMobile && sidebarHidden) {
                document.body.classList.add('sidebar-hidden');
            }

            // Apply compact mode immediately
            const isCompactMode = localStorage.getItem('compact-mode') === 'true';
            if (isCompactMode) {
                document.body.classList.add('compact-mode');
            }

            // Apply theme mode immediately to prevent FOUC
            // URL query param (?mode=dark) takes priority over localStorage
            const modeOverride = '{{modeOverride}}';
            const savedThemeMode = modeOverride || localStorage.getItem('theme-mode');
            if (modeOverride) {
                localStorage.setItem('theme-mode', modeOverride);
            }
            // 'auto' follows the OS colour scheme — resolve it here too so the
            // early paint matches what settings-panel.js will settle on.
            const resolvedThemeMode = savedThemeMode === 'auto'
                ? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
                : savedThemeMode;
            if (resolvedThemeMode === 'dark') {
                document.body.classList.add('pa-mode-dark');
                document.body.dataset.theme = 'dark'; // For web components (web-grid, etc.)
            } else if (resolvedThemeMode === 'light') {
                document.body.classList.add('pa-mode-light');
                document.body.dataset.theme = 'light';
            }

            // Apply color variant immediately to prevent FOUC
            // URL query param (?colorVariant=red) takes priority over localStorage
            const colorVariantOverride = '{{colorVariantOverride}}';
            if (colorVariantOverride) {
                localStorage.setItem('color-variant', colorVariantOverride);
            }
            const savedColorVariant = colorVariantOverride || localStorage.getItem('color-variant');
            if (savedColorVariant) {
                document.body.classList.add(`pa-color-${savedColorVariant}`);
            }

            // Apply font size immediately to prevent size jump
            const savedFontSize = localStorage.getItem('font-size') || 'default';
            if (savedFontSize !== 'default') {
                document.documentElement.classList.add(`font-size-${savedFontSize}`);
            }

            // Apply sidebar mode to body immediately
            const sidebarMode = '{{sidebarMode}}';
            if (sidebarMode === 'sticky') {
                document.body.classList.add('pa-layout--sticky');
            }

            // Apply container width to body immediately
            const containerWidth = '{{containerWidth}}';
            if (containerWidth && containerWidth !== 'fluid') {
                document.body.classList.add(`pa-container-${containerWidth}`);
            }
        })();
    </script>

    <!-- Set burger menu state immediately to prevent FOUC -->
    <script>
        (function() {
            const sidebarHidden = localStorage.getItem('sidebar-hidden') === 'true';
            const isMobile = window.innerWidth <= ((window.pureAdmin && window.pureAdmin.config && window.pureAdmin.config.mobileBreakpoint) || 768);

            // Desktop only: set burger state based on sidebar visibility
            // sidebarHidden = true → show hamburger (no active)
            // sidebarHidden = false → show X (active) because sidebar is visible
            if (!isMobile && !sidebarHidden) {
                const burgerMenu = document.querySelector('.burger-menu');
                if (burgerMenu) {
                    burgerMenu.classList.add('active');
                }
            }
        })();
    </script>

    <!-- Navbar (outside layout container) -->
    {{{partials.navbar}}}

    <!-- Layout Container (below navbar) -->
    <div class="pa-layout" id="layoutContainer">
        <!-- Layout Inner: Sidebar + Content -->
        <div class="pa-layout__inner">
            {{{partials.sidebar}}}

            <!-- Restore submenu states immediately to prevent FOUC -->
            <script>
                (function() {
                    document.querySelectorAll('.pa-sidebar__toggle').forEach(button => {
                        const label = button.querySelector('.pa-sidebar__label');
                        if (!label) return;

                        const submenuId = label.textContent.toLowerCase().replace(/\s+/g, '-');
                        const savedState = localStorage.getItem(`submenu-${submenuId}`);

                        if (savedState === 'open') {
                            const parentItem = button.closest('.pa-sidebar__item');
                            const submenu = parentItem.querySelector('.pa-sidebar__submenu');
                            if (submenu) {
                                parentItem.classList.add('pa-sidebar__item--open');
                                submenu.classList.add('pa-sidebar__submenu--open');
                            }
                        }
                    });
                })();
            </script>

            <!-- Layout Content: Main only -->
            <div class="pa-layout__content">
                <!-- Main Content -->
                <main class="pa-layout__main">
                    <div class="pa-layout__main__inner">
                        {{{body}}}
