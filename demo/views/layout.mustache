    <script>
        function switchTheme(theme) {
            // Redirect to current page with theme parameter
            const url = new URL(window.location);
            url.searchParams.set('theme', theme);
            window.location.href = url.toString();
        }

        function switchSidebarMode(mode) {
            // Redirect to current page with sidebar mode parameter
            const url = new URL(window.location);
            url.searchParams.set('sidebarMode', mode);
            window.location.href = url.toString();
        }

        // --- Mobile drawer background scroll-lock ----------------------------
        // Standard modal-drawer behavior: the page behind the open mobile
        // sidebar + scrim must not scroll. Core CSS locks it via
        // `body.sidebar-visible { overflow: hidden }`, which covers desktop +
        // Android, but iOS Safari ignores overflow:hidden for touch scrolling.
        // The robust cross-device fix is to pin <body> with position:fixed while
        // open and restore the scroll position on close. Kept here because the
        // mobile toggle itself lives only in the demo (core ships no mobile
        // sidebar JS). See docs/mobile-sidebar-overlay.md.
        let savedScrollY = 0;
        function lockBodyScroll() {
            const body = document.body;
            if (body.dataset.scrollLocked) return;
            savedScrollY = window.scrollY || window.pageYOffset || 0;
            // Compensate for the vanishing scrollbar so pinning the body
            // position:fixed doesn't reflow the page ~15px sideways on desktop
            // (mobile overlay scrollbars are 0-width, so this is a no-op there).
            const scrollbarW = window.innerWidth - document.documentElement.clientWidth;
            body.dataset.scrollLocked = '1';
            body.style.position = 'fixed';
            body.style.top = `-${savedScrollY}px`;
            body.style.insetInlineStart = '0';
            body.style.width = '100%';
            if (scrollbarW > 0) body.style.paddingInlineEnd = `${scrollbarW}px`;
        }
        function unlockBodyScroll() {
            const body = document.body;
            if (!body.dataset.scrollLocked) return;
            delete body.dataset.scrollLocked;
            body.style.position = '';
            body.style.top = '';
            body.style.insetInlineStart = '';
            body.style.width = '';
            body.style.paddingInlineEnd = '';
            window.scrollTo(0, savedScrollY);
        }

        function toggleSidebar() {
            const body = document.body;
            const burgerMenu = document.querySelector('.burger-menu');
            const sidebar = document.querySelector('.pa-layout__sidebar');
            const isMobile = window.innerWidth <= ((window.pureAdmin && window.pureAdmin.config && window.pureAdmin.config.mobileBreakpoint) || 768);
            const sidebarBehavior = localStorage.getItem('sidebar-behavior') || 'hide';

            if (isMobile) {
                // Mobile: Toggle sidebar visibility but don't persist state
                body.classList.toggle('sidebar-visible');
                burgerMenu.classList.toggle('active');
                // Lock/unlock background scroll to match the open state
                if (body.classList.contains('sidebar-visible')) {
                    lockBodyScroll();
                } else {
                    unlockBodyScroll();
                }
            } else {
                // Desktop: Check sidebar behavior mode
                if (sidebarBehavior === 'icon-collapse') {
                    // Icon-collapse mode: toggle between icon bar and full width
                    const isExpanded = !body.classList.contains('sidebar-hidden');

                    if (isExpanded) {
                        // Currently expanded, collapse to icons
                        body.classList.add('sidebar-hidden');
                        burgerMenu.classList.remove('active');
                    } else {
                        // Currently showing icons, expand to full width
                        body.classList.remove('sidebar-hidden');
                        burgerMenu.classList.add('active');
                    }
                    localStorage.setItem('sidebar-hidden', body.classList.contains('sidebar-hidden'));
                } else {
                    // Normal hide mode: toggle visibility completely
                    const isHidden = body.classList.contains('sidebar-hidden');

                    if (isHidden) {
                        // Currently hidden, show it
                        body.classList.remove('sidebar-hidden');
                        burgerMenu.classList.add('active');
                    } else {
                        // Currently visible, hide it
                        body.classList.add('sidebar-hidden');
                        burgerMenu.classList.remove('active');
                    }
                    localStorage.setItem('sidebar-hidden', body.classList.contains('sidebar-hidden'));
                }
            }
        }

        function checkMobileLayout() {
            const body = document.body;
            const isMobile = window.innerWidth <= ((window.pureAdmin && window.pureAdmin.config && window.pureAdmin.config.mobileBreakpoint) || 768);

            if (isMobile) {
                // Mobile: Always start with sidebar hidden (not visible)
                body.classList.remove('sidebar-hidden');
                body.classList.remove('sidebar-visible');
                document.querySelector('.burger-menu').classList.remove('active');
                unlockBodyScroll(); // drawer forced closed → release the scroll lock
            } else {
                // Desktop: Use saved state (works for both 'hide' and 'icon-collapse' behaviors)
                body.classList.remove('sidebar-visible');
                unlockBodyScroll(); // crossing to desktop closes the mobile drawer
                const sidebarHidden = localStorage.getItem('sidebar-hidden') === 'true';
                const burgerMenu = document.querySelector('.burger-menu');

                if (sidebarHidden) {
                    // Collapsed/Hidden state
                    body.classList.add('sidebar-hidden');
                    if (burgerMenu) burgerMenu.classList.remove('active'); // Show hamburger
                } else {
                    // Expanded/Visible state
                    body.classList.remove('sidebar-hidden');
                    if (burgerMenu) burgerMenu.classList.add('active'); // Show X
                }
            }
        }

        function closeMobileSidebar(event) {
            const body = document.body;
            if (!body.classList.contains('sidebar-visible')) return;

            const sidebar = document.querySelector('.pa-layout__sidebar');
            const burger = document.querySelector('.burger-menu');

            // Close on any tap OUTSIDE the drawer itself. The backdrop is a CSS
            // ::before on body.sidebar-visible, so a tap on the scrim strip can
            // report body OR the underlying .pa-layout element as the target —
            // the old `event.target === body` check missed the latter and left
            // the drawer stuck open. Exclude the burger (it has its own toggle
            // handler; otherwise the opening tap would immediately re-close).
            if (sidebar && sidebar.contains(event.target)) return;
            if (burger && burger.contains(event.target)) return;

            body.classList.remove('sidebar-visible');
            if (burger) burger.classList.remove('active');
            unlockBodyScroll(); // tap-outside closed the drawer → release the lock
            // No need to save mobile sidebar state - always starts hidden on page load
        }

        document.addEventListener('DOMContentLoaded', function() {
            // Add loaded class after a short delay to prevent FOUC transitions
            setTimeout(() => {
                document.body.classList.add('loaded');
            }, 50);

            checkMobileLayout();
            window.addEventListener('resize', checkMobileLayout);
            document.body.addEventListener('click', closeMobileSidebar);
        });

        // Notification Panel Functions
        function toggleNotifications() {
            const notificationsPanel = document.getElementById('notificationsPanel');
            notificationsPanel.classList.toggle('is-open');

            // Close profile panel if open (via closeProfilePanel so its
            // background scroll-lock is released too — a bare class removal here
            // would leave <body> pinned position:fixed).
            const profilePanel = document.getElementById('profilePanel');
            if (profilePanel.classList.contains('pa-profile-panel--open')) {
                closeProfilePanel();
            }
        }

        function closeNotifications() {
            const notificationsPanel = document.getElementById('notificationsPanel');
            notificationsPanel.classList.remove('is-open');
        }

        function markAllRead() {
            const unreadItems = document.querySelectorAll('.pa-notifications__item--unread');
            unreadItems.forEach(item => {
                item.classList.remove('pa-notifications__item--unread');
            });

            // Update badge count
            const badge = document.querySelector('.pa-notifications__badge');
            if (badge) {
                badge.textContent = '0';
                badge.style.display = 'none';
            }
        }

        // Profile Panel Functions
        function toggleProfilePanel() {
            const profilePanel = document.getElementById('profilePanel');
            profilePanel.classList.toggle('pa-profile-panel--open');

            // Background scroll-lock — MOBILE ONLY. On mobile the profile panel
            // is a full drawer with a scrim (like the sidebar), so the page
            // behind it must not scroll; the robust position:fixed body lock
            // (same helper the sidebar drawer uses) is iOS-Safari-safe. On
            // tablet/desktop the panel is a light side sheet with no scrim, so
            // the page stays scrollable — matching the sidebar, which is only an
            // overlay on mobile too. (The old `pa-scroll-lock` utility only set
            // `overflow-y: scroll`, which never actually stopped the scroll.)
            const isMobile = window.innerWidth <= ((window.pureAdmin && window.pureAdmin.config && window.pureAdmin.config.mobileBreakpoint) || 768);
            if (profilePanel.classList.contains('pa-profile-panel--open') && isMobile) {
                lockBodyScroll();
            } else {
                unlockBodyScroll();
            }

            // Close notifications if open
            const notificationsPanel = document.getElementById('notificationsPanel');
            if (notificationsPanel.classList.contains('is-open')) {
                notificationsPanel.classList.remove('is-open');
            }
        }

        function closeProfilePanel() {
            const profilePanel = document.getElementById('profilePanel');
            profilePanel.classList.remove('pa-profile-panel--open');
            unlockBodyScroll();
        }

        // Profile panel tab switching
        document.querySelectorAll('[data-profile-tab]').forEach(tab => {
            tab.addEventListener('click', () => {
                const tabId = tab.dataset.profileTab;
                // Update active tab
                document.querySelectorAll('[data-profile-tab]').forEach(t =>
                    t.classList.toggle('pa-tabs__item--active', t.dataset.profileTab === tabId));
                // Update active panel
                document.querySelectorAll('[data-profile-panel]').forEach(p =>
                    p.classList.toggle('pa-tabs__panel--active', p.dataset.profilePanel === tabId));
            });
        });

        // Favorite item click - navigate using data-href
        document.querySelectorAll('.pa-profile-panel__favorite-item').forEach(item => {
            item.addEventListener('click', (e) => {
                // Skip if clicking the remove button
                if (e.target.closest('.pa-profile-panel__favorite-remove')) return;
                const href = item.dataset.href;
                if (href) window.location.href = href;
            });
        });

        // Favorite remove button - hide item (demo only)
        document.querySelectorAll('.pa-profile-panel__favorite-remove').forEach(btn => {
            btn.addEventListener('click', (e) => {
                e.stopPropagation();
                // Demo: hide the list item
                btn.closest('li').style.display = 'none';
            });
        });

        // Close panels when clicking outside
        document.addEventListener('click', (e) => {
            const profilePanel = document.getElementById('profilePanel');
            const profileBtn = document.querySelector('.pa-header__profile-btn');
            const notificationsPanel = document.getElementById('notificationsPanel');
            const notificationsBtn = document.querySelector('.pa-notifications__btn');

            // Close profile panel
            if (!profilePanel.contains(e.target) && !profileBtn.contains(e.target) &&
                profilePanel.classList.contains('pa-profile-panel--open')) {
                closeProfilePanel();
            }

            // Close notifications panel
            if (!notificationsPanel.contains(e.target) && !notificationsBtn.contains(e.target) &&
                notificationsPanel.classList.contains('is-open')) {
                closeNotifications();
            }
        });

        // Sidebar Submenu Functions - No accordion behavior for multilevel support
        function toggleSubmenu(button) {
            const parentItem = button.closest('.pa-sidebar__item');
            const submenu = parentItem.querySelector('.pa-sidebar__submenu');

            if (!submenu) return;

            const isOpen = parentItem.classList.contains('pa-sidebar__item--open');

            // Simply toggle current submenu without closing others
            if (isOpen) {
                parentItem.classList.remove('pa-sidebar__item--open');
                submenu.classList.remove('pa-sidebar__submenu--open');
            } else {
                parentItem.classList.add('pa-sidebar__item--open');
                submenu.classList.add('pa-sidebar__submenu--open');
            }

            // Save state to localStorage
            const submenuId = button.querySelector('.pa-sidebar__label').textContent.toLowerCase().replace(/\s+/g, '-');
            localStorage.setItem(`submenu-${submenuId}`, !isOpen ? 'open' : 'closed');
        }

        // Clear all submenu states (for debugging)
        function clearAllSubmenuStates() {
            // Clear localStorage
            Object.keys(localStorage).forEach(key => {
                if (key.startsWith('submenu-')) {
                    localStorage.removeItem(key);
                }
            });

            // Close all open submenus
            document.querySelectorAll('.pa-sidebar__item--open').forEach(item => {
                item.classList.remove('pa-sidebar__item--open');
            });
            document.querySelectorAll('.pa-sidebar__submenu--open').forEach(submenu => {
                submenu.classList.remove('pa-sidebar__submenu--open');
            });

            console.log('All submenu states cleared');
        }

        // Note: Submenu state restoration is now handled by inline script right after sidebar HTML
        // to prevent FOUC. No need to restore states again on DOMContentLoaded.

        // Tooltip & Popover initialization is handled by src/js/tooltips-popovers.js
    </script>
</body>
</html>