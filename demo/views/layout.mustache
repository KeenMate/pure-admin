<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{#pageTitle}}{{pageTitle}}{{/pageTitle}}{{^pageTitle}}Dashboard{{/pageTitle}} - Pure Admin Visual</title>
    <!-- Critical CSS: Loader (inline to prevent FOUC) -->
    <style>
        .page-loader {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: var(--page-loader-bg, rgba(26, 26, 26, 0.95));
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 99999;
            transition: opacity 0.15s ease, visibility 0.15s ease;
        }
        .page-loader.loaded {
            opacity: 0;
            visibility: hidden;
        }
        .page-loader__spinner {
            width: 50px;
            height: 50px;
            border: 4px solid var(--page-loader-spinner-border, #333);
            border-top-color: var(--page-loader-spinner-accent, #0066cc);
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
        }
        @keyframes spin {
            to { transform: rotate(360deg); }
        }
    </style>
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <!-- Preload critical fonts for Audi theme (latin subset) -->
    {{#isAudiTheme}}
    <link rel="preload" href="/fonts/google/wEOhEADFm8hSaQTFG18FErVhsC9x-tarUfbtrQ.woff2" as="font" type="font/woff2" crossorigin>
    {{/isAudiTheme}}
    <!-- SCSS VARIABLE THEME: Dynamic theme loading -->
    <link rel="stylesheet" href="/dist/css/themes/{{currentTheme}}.css">
    <!-- Early settings load (before body renders to prevent flash) -->
    <script>
        (function() {
            // Apply sidebar width from localStorage immediately
            var savedWidth = localStorage.getItem('sidebar-width');
            if (savedWidth) {
                var width = parseInt(savedWidth, 10);
                if (width >= 180 && width <= 500) {
                    document.documentElement.style.setProperty('--pa-local-sidebar-width', (width / 10) + 'rem');
                }
            }
        })();
    </script>
    <!-- Floating UI for tooltips and popovers -->
    <script src="https://cdn.jsdelivr.net/npm/@floating-ui/core@1.7.3"></script>
    <script src="https://cdn.jsdelivr.net/npm/@floating-ui/dom@1.7.4"></script>
    <!-- D3.js for charts -->
    <script src="https://d3js.org/d3.v7.min.js"></script>
    <!-- Chart.js — used by the KPI showcase "custom chart library" examples -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
    <!-- Pure Admin runtime namespace (window.pureAdmin: events, viewport, debug) — load first -->
    <script src="/src/js/pure-admin.js"></script>
    <!-- Command Palette -->
    <script src="/src/js/command-palette.js"></script>
    <!-- Toast Service -->
    <script src="/src/js/toast-service.js"></script>
    <!-- Tooltips & Popovers -->
    <script src="/src/js/tooltips-popovers.js"></script>
    <!-- KPI showcases (popovers, sparkline dots, terminal view toggle) -->
    <script src="/src/js/kpi-showcases.js"></script>
    <!-- KPI showcases — Chart.js drop-in examples for the chart slots -->
    <script src="/src/js/kpi-chartjs-examples.js"></script>
    <!-- Web Components: Multiselect, Date Range Picker, and Data Grid -->
    <link rel="stylesheet" href="/node_modules/@keenmate/web-multiselect/dist/style.css">
    <link rel="stylesheet" href="/node_modules/@keenmate/web-daterangepicker/dist/style.css">
    <link rel="stylesheet" href="/node_modules/@keenmate/web-grid/src/css/main.css">
    <link rel="stylesheet" href="/node_modules/@keenmate/web-dropzone/dist/style.css">
    <script type="module" src="/node_modules/@keenmate/web-multiselect/dist/multiselect.js"></script>
