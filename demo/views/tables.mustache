<script type="module">
customElements.whenDefined('web-grid').then(() => {
    const grid = document.getElementById('table-card-grid')

    const departments = ['Engineering', 'Marketing', 'Sales', 'HR', 'Finance']
    const statuses = ['Active', 'Active', 'Active', 'On Leave', 'Inactive'] // Weighted towards Active

    // Generate 25 employees for paging demo
    const employees = []
    const names = ['Alice Johnson', 'Bob Smith', 'Carol Williams', 'David Brown', 'Eva Martinez',
                   'Frank Lee', 'Grace Kim', 'Henry Chen', 'Ivy Wang', 'Jack Davis',
                   'Karen Wilson', 'Leo Garcia', 'Maria Lopez', 'Nathan Park', 'Olivia Scott',
                   'Peter Adams', 'Quinn Murphy', 'Rachel Green', 'Steve Rogers', 'Tina Turner',
                   'Uma Patel', 'Victor Hugo', 'Wendy Wu', 'Xavier Bell', 'Yuki Tanaka']
    for (let i = 0; i < 25; i++) {
        employees.push({
            id: 1001 + i,
            name: names[i],
            department: departments[i % departments.length],
            salary: 55000 + Math.floor(Math.random() * 50000),
            status: statuses[i % statuses.length]
        })
    }

    grid.columns = [
        { field: 'id', title: 'ID', width: '70px', horizontalAlign: 'center' },
        { field: 'name', title: 'Name', width: '150px' },
        { field: 'department', title: 'Department', width: '120px' },
        { field: 'salary', title: 'Salary', width: '100px', horizontalAlign: 'right', formatCallback: v => `$${v.toLocaleString()}` },
        { field: 'status', title: 'Status', width: '100px' }
    ]
    grid.items = employees
    grid.isStriped = true
    grid.isHoverable = true
    grid.sortMode = 'single'
    grid.isRowNumbersVisible = true

    // Paging
    grid.isPageable = true
    grid.pageSize = 5
    grid.pageSizes = [5, 10, 25]
    grid.paginationPosition = 'top-right|bottom-right'
    grid.paginationLayout = 'first|previous|pageInfo|next|last|pageSize'

    // Summary on bottom-left
    grid.summaryPosition = 'bottom-left'
    grid.summaryContentCallback = ({ allItems }) => {
        const totalSalary = allItems.reduce((sum, e) => sum + e.salary, 0)
        return `<strong>${allItems.length}</strong> employees | Total: <strong>$${totalSalary.toLocaleString()}</strong>`
    }
})
</script>

