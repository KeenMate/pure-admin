        { field: 'stock', title: 'In Stock', width: '90px', horizontalAlign: 'right' }
    ]
    grid.items = products
    grid.isStriped = true
    grid.isHoverable = true
    grid.sortMode = 'single'

    // Paging
    grid.isPageable = true
    grid.pageSize = 5
    grid.pageSizes = [5, 10]
    grid.paginationPosition = 'bottom-right'
    grid.paginationLayout = 'first|previous|pageInfo|next|last'
})
</script>

