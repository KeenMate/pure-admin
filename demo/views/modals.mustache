<!-- CSS Classes Reference -->
<div class="pa-card">
    <div class="pa-card__header">
        <div class="pa-card__title">
            <h3 class="pa-card__title-text">CSS Classes Reference</h3>
        </div>
    </div>
    <div class="pa-card__body">
        <h4>Modal Base</h4>
        <ul class="pa-list-basic pa-list-basic--compact">
            <li><code>pa-modal</code> - Modal wrapper (hidden by default)</li>
            <li><code>pa-modal--show</code> - Display the modal</li>
            <li><code>pa-modal--top</code> - Position near top of viewport</li>
            <li><code>pa-modal--static</code> - Prevent close on backdrop/ESC</li>
        </ul>

        <h4 class="mt-4">Modal Sections</h4>
        <ul class="pa-list-basic pa-list-basic--compact">
            <li><code>pa-modal__backdrop</code> - Dark overlay behind modal</li>
            <li><code>pa-modal__container</code> - Dialog box (default: medium)</li>
            <li><code>pa-modal__header</code> - Header with title and close button</li>
            <li><code>pa-modal__title</code> - Modal title text</li>
            <li><code>pa-modal__body</code> - Content area (scrollable)</li>
            <li><code>pa-modal__body--scrollable</code> - Limit height with scroll</li>
            <li><code>pa-modal__footer</code> - Action buttons area</li>
        </ul>

        <h4 class="mt-4">Container Sizes</h4>
        <ul class="pa-list-basic pa-list-basic--compact">
            <li><code>pa-modal__container--sm</code> - Small (30rem / 480px)</li>
            <li><code>pa-modal__container</code> - Medium (default, 50rem / 800px)</li>
            <li><code>pa-modal__container--lg</code> - Large (60rem / 960px)</li>
            <li><code>pa-modal__container--xl</code> - Extra large (70rem / 1120px)</li>
            <li><code>pa-modal__container--xxl</code> - XXL (90rem / 1440px)</li>
            <li><code>pa-modal__container--fw</code> - Full width (viewport - margin)</li>
        </ul>

        <h4 class="mt-4">Themed Headers</h4>
        <ul class="pa-list-basic pa-list-basic--compact">
            <li><code>pa-modal--primary</code> - Primary color header</li>
            <li><code>pa-modal--success</code> - Success (green) header</li>
            <li><code>pa-modal--warning</code> - Warning (yellow) header</li>
            <li><code>pa-modal--danger</code> - Danger (red) header</li>
        </ul>
    </div>
</div>

<script>
// Modal functionality
function openModal(modalId) {
    const modal = document.getElementById(modalId);
    if (modal) {
        // Calculate scrollbar width to prevent layout shift
        const scrollbarWidth = window.innerWidth - document.documentElement.clientWidth;

        modal.classList.add('pa-modal--show');
        document.body.style.overflow = 'hidden'; // Prevent background scrolling
        document.body.style.paddingRight = scrollbarWidth + 'px'; // Compensate for scrollbar
    }
}

function closeModal(modalId) {
    const modal = document.getElementById(modalId);
    if (modal) {
        modal.classList.remove('pa-modal--show');
        document.body.style.overflow = ''; // Restore scrolling
        document.body.style.paddingRight = ''; // Remove compensation
    }
}

// Close modal with Escape key (skip static modals)
document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
        const openModal = document.querySelector('.pa-modal--show');
        if (openModal && !openModal.classList.contains('pa-modal--static')) {
            closeModal(openModal.id);
        }
    }
});

// Prevent modal close when clicking inside modal content
document.addEventListener('click', function(e) {
    if (e.target.classList.contains('pa-modal__container')) {
        e.stopPropagation();
    }
});
</script>
