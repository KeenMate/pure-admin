<!-- Contact Form Modal -->
<div id="modal-form" class="pa-modal">
    <div class="pa-modal__backdrop" onclick="closeModal('modal-form')"></div>
    <div class="pa-modal__container">
        <div class="pa-modal__header">
            <h3 class="pa-modal__title">Contact Us</h3>
            <button class="pa-btn pa-btn--primary pa-btn--icon-only pa-btn--sm" onclick="closeModal('modal-form')"><span class="pa-icon pa-icon--x" aria-hidden="true"></span></button>
        </div>
