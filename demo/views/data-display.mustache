                            <li><code>pa-field</code> - Label-value pair</li>
                            <li><code>pa-field__label</code> - Label element</li>
                            <li><code>pa-field__value</code> - Value element</li>
                            <li><code>pa-field--full</code> - Span all grid columns</li>
                        </ul>

