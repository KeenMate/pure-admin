            <div class="pa-fields pa-fields--row">
                <div class="pa-field">
                    <span class="pa-field__label">Price</span>
                    <span class="pa-field__value"><strong>${product.price}</strong></span>
                </div>
                <div class="pa-field">
                    <span class="pa-field__label">Stock</span>
                    <span class="pa-field__value">${product.stock} units</span>
                </div>
                <div class="pa-field">
                    <span class="pa-field__label">Status</span>
                    <span class="pa-field__value">${product.status}</span>
                </div>
            </div>
        </div>

        <div class="pa-field-group">
            <div class="pa-field-group__title">Specifications</div>
            <div class="pa-fields pa-fields--cols-2">
                <div class="pa-field">
                    <span class="pa-field__label">Weight</span>
                    <span class="pa-field__value">${product.weight}</span>
                </div>
                <div class="pa-field">
                    <span class="pa-field__label">Dimensions</span>
                    <span class="pa-field__value">${product.dimensions}</span>
                </div>
                <div class="pa-field">
                    <span class="pa-field__label">Warranty</span>
                    <span class="pa-field__value">${product.warranty}</span>
                </div>
            </div>
        </div>

        <div class="pa-field-group">
            <div class="pa-field-group__title">Supplier</div>
            <div class="pa-fields">
                <div class="pa-field">
                    <span class="pa-field__label">Name</span>
                    <span class="pa-field__value">${product.supplier}</span>
                </div>
                <div class="pa-field">
                    <span class="pa-field__label">Contact</span>
                    <span class="pa-field__value">${product.supplierContact}</span>
                </div>
            </div>
        </div>
    `;

    // Show overlay panel
    document.getElementById('productOverlayPanel').classList.add('pa-detail-panel--open');

    // Highlight row
    document.querySelectorAll('#productTable tbody tr').forEach(tr => tr.classList.remove('is-selected'));
    document.querySelector(`#productTable tr[data-product="${productId}"]`).classList.add('is-selected');
}

function closeProductOverlay() {
    document.getElementById('productOverlayPanel').classList.remove('pa-detail-panel--open');
    document.querySelectorAll('#productTable tbody tr').forEach(tr => tr.classList.remove('is-selected'));
}
</script>
