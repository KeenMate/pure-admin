<script>
// Virtual scrolling demo - add 1,000 options
(function() {
  const virtualDemo = document.getElementById('virtual-scroll-demo');
  if (virtualDemo) {
    for (let i = 1; i <= 1000; i++) {
      const option = document.createElement('option');
      option.value = `item${i}`;
      option.textContent = `Item ${i} - Option ${i}`;
      virtualDemo.appendChild(option);
    }
  }
})();

// Tree demo data — each option carries a materialized dot-path; parent/level are
// derived from it. Lifted from the web-multiselect examples-tree.html demo.
const treeCategories = [
  { value: 'fruit',     label: 'Fruit',       path: '1' },
  { value: 'pome',      label: 'Pome fruit',  path: '1.1' },
  { value: 'apple',     label: 'Apple',       path: '1.1.1' },
  { value: 'pear',      label: 'Pear',        path: '1.1.2' },
  { value: 'quince',    label: 'Quince',      path: '1.1.3' },
  { value: 'stone',     label: 'Stone fruit', path: '1.2' },
  { value: 'peach',     label: 'Peach',       path: '1.2.1' },
  { value: 'plum',      label: 'Plum',        path: '1.2.2' },
  { value: 'cherry',    label: 'Cherry',      path: '1.2.3' },
  { value: 'apricot',   label: 'Apricot',     path: '1.2.4' },
  { value: 'berries',   label: 'Berries',     path: '1.3' },
  { value: 'straw',     label: 'Strawberry',  path: '1.3.1' },
  { value: 'blue',      label: 'Blueberry',   path: '1.3.2' },
  { value: 'rasp',      label: 'Raspberry',   path: '1.3.3' },
  { value: 'citrus',    label: 'Citrus',      path: '1.4' },
  { value: 'orange',    label: 'Orange',      path: '1.4.1' },
  { value: 'lemon',     label: 'Lemon',       path: '1.4.2' },
  { value: 'lime',      label: 'Lime',        path: '1.4.3' },
  { value: 'veg',       label: 'Vegetables',  path: '2' },
  { value: 'root',      label: 'Root',        path: '2.1' },
  { value: 'carrot',    label: 'Carrot',      path: '2.1.1' },
  { value: 'beet',      label: 'Beetroot',    path: '2.1.2' },
  { value: 'radish',    label: 'Radish',      path: '2.1.3' },
  { value: 'leafy',     label: 'Leafy',       path: '2.2' },
  { value: 'kale',      label: 'Kale',        path: '2.2.1' },
  { value: 'spinach',   label: 'Spinach',     path: '2.2.2' },
  { value: 'lettuce',   label: 'Lettuce',     path: '2.2.3' },
  { value: 'chard',     label: 'Chard',       path: '2.2.4' },
  { value: 'brassica',  label: 'Brassica',    path: '2.3' },
  { value: 'broccoli',  label: 'Broccoli',    path: '2.3.1' },
  { value: 'caulif',    label: 'Cauliflower', path: '2.3.2' },
  { value: 'cabbage',   label: 'Cabbage',     path: '2.3.3' },
  { value: 'dairy',     label: 'Dairy',       path: '3' },
  { value: 'cheese',    label: 'Cheese',      path: '3.1' },
  { value: 'cheddar',   label: 'Cheddar',     path: '3.1.1' },
  { value: 'brie',      label: 'Brie',        path: '3.1.2' },
  { value: 'gouda',     label: 'Gouda',       path: '3.1.3' },
  { value: 'milk',      label: 'Milk',        path: '3.2' },
  { value: 'milk-w',    label: 'Whole milk',  path: '3.2.1' },
  { value: 'milk-s',    label: 'Skim milk',   path: '3.2.2' }
];

// A "full title" ships WITH the data — build a breadcrumb by joining ancestor labels.
const labelByPath = new Map(treeCategories.map(c => [c.path, c.label]));
const treeWithFullTitles = treeCategories.map(c => {
  const segs = c.path.split('.');
  const crumb = segs
    .map((_, i) => labelByPath.get(segs.slice(0, i + 1).join('.')))
    .filter(Boolean)
    .join(' / ');
  return { ...c, fullTitle: crumb };
});

// Grouped data for the mobile demos (~50 options, 8 groups).
const mobileToOptions = (catalog) =>
  Object.entries(catalog).flatMap(([group, labels], gi) =>
    labels.map((label, i) => ({ value: `${gi}-${i}`, label, group })));
const mobileOptions = mobileToOptions({
  'Compute': ['Virtual Machines', 'Kubernetes', 'Serverless Functions', 'Container Registry', 'Batch', 'Auto Scaling', 'Load Balancer'],
  'Storage': ['Object Storage', 'Block Storage', 'File Storage', 'Cold Archive', 'Backup Vault', 'CDN'],
  'Networking': ['Virtual Network', 'DNS', 'VPN Gateway', 'Firewall', 'NAT Gateway', 'Private Link', 'Traffic Manager'],
  'Databases': ['SQL Database', 'NoSQL Store', 'In-Memory Cache', 'Data Warehouse', 'Graph Database', 'Time Series DB', 'Search Engine'],
  'Security': ['Identity & Access', 'Secrets Manager', 'Key Vault', 'Certificate Manager', 'Web App Firewall', 'DDoS Protection', 'Audit Logs'],
  'Analytics': ['Data Lake', 'Stream Processing', 'BI Dashboards', 'ETL Pipelines', 'Event Bus', 'Metrics'],
  'Developer Tools': ['CI/CD Pipelines', 'Source Repos', 'Artifact Registry', 'API Gateway', 'Feature Flags', 'Monitoring'],
  'Messaging': ['Message Queue', 'Pub/Sub', 'Transactional Email', 'SMS', 'Push Notifications']
});

customElements.whenDefined('web-multiselect').then(() => {
  // ---- None Mode demo ----
  const noneMode = document.getElementById('none-mode');
  if (noneMode) {
    customElements.upgrade(noneMode);
    noneMode.options = [
      { value: 'js', label: 'JavaScript', icon: '🟨' },
      { value: 'ts', label: 'TypeScript', icon: '🔷' },
      { value: 'py', label: 'Python', icon: '🐍' },
      { value: 'rust', label: 'Rust', icon: '🦀' },
      { value: 'go', label: 'Go', icon: '🐹' },
      { value: 'java', label: 'Java', icon: '☕' },
      { value: 'csharp', label: 'C#', icon: '🟣' },
      { value: 'cpp', label: 'C++', icon: '🔵' }
    ];
    noneMode.value = ['js', 'ts'];
  }

  // ---- Grouped options demo ----
  const groupedDemo = document.getElementById('grouped-demo');
  if (groupedDemo) {
    customElements.upgrade(groupedDemo);
    groupedDemo.options = [
      { value: 'react', label: 'React', group: 'Frontend' },
      { value: 'vue', label: 'Vue', group: 'Frontend' },
      { value: 'angular', label: 'Angular', group: 'Frontend' },
      { value: 'svelte', label: 'Svelte', group: 'Frontend' },
      { value: 'nodejs', label: 'Node.js', group: 'Backend' },
      { value: 'django', label: 'Django', group: 'Backend' },
      { value: 'rails', label: 'Ruby on Rails', group: 'Backend' },
      { value: 'laravel', label: 'Laravel', group: 'Backend' },
      { value: 'postgresql', label: 'PostgreSQL', group: 'Database' },
      { value: 'mysql', label: 'MySQL', group: 'Database' },
      { value: 'mongodb', label: 'MongoDB', group: 'Database' },
      { value: 'redis', label: 'Redis', group: 'Database' }
    ];
  }

  // ---- Disabled options demo ----
  const disabledDemo = document.getElementById('disabled-demo');
  if (disabledDemo) {
    customElements.upgrade(disabledDemo);
    disabledDemo.options = [
      { value: 'enabled1', label: 'Available Option 1' },
      { value: 'disabled1', label: 'Unavailable Option 1', disabled: true },
      { value: 'enabled2', label: 'Available Option 2' },
      { value: 'disabled2', label: 'Unavailable Option 2', disabled: true },
      { value: 'enabled3', label: 'Available Option 3' },
      { value: 'disabled3', label: 'Unavailable Option 3', disabled: true }
    ];
  }

  // ---- Tree demos (dot-path) ----
  for (const id of ['tree-basic', 'tree-search']) {
    const el = document.getElementById(id);
    if (!el) continue;
    el.valueMember = 'value';
    el.displayValueMember = 'label';
    el.pathMember = 'path';
    el.options = treeCategories;
  }

  // Leaves-only selectability: branches are pure structure.
  const treeLeaves = document.getElementById('tree-leaves');
  if (treeLeaves) {
    treeLeaves.valueMember = 'value';
    treeLeaves.displayValueMember = 'label';
    treeLeaves.pathMember = 'path';
    treeLeaves.getIsSelectableCallback = (node) => !node.hasChildren;
    treeLeaves.options = treeCategories;
  }

  // Full breadcrumb on badges (two items pre-selected).
  const treeFullTitle = document.getElementById('tree-fulltitle');
  if (treeFullTitle) {
    treeFullTitle.valueMember = 'value';
    treeFullTitle.displayValueMember = 'label';
    treeFullTitle.pathMember = 'path';
    treeFullTitle.fullTitleMember = 'fullTitle';
    treeFullTitle.options = treeWithFullTitles;
    treeFullTitle.setSelected(['apple', 'kale']);
  }

  // Cascade checkboxes with select-all/clear-all + custom action.
  const treeCascade = document.getElementById('tree-cascade');
  if (treeCascade) {
    treeCascade.valueMember = 'value';
    treeCascade.displayValueMember = 'label';
    treeCascade.pathMember = 'path';
    treeCascade.options = treeCategories;
    treeCascade.actionButtons = [
      { action: 'select-all', text: 'Select All' },
      { action: 'clear-all', text: 'Clear All' },
      { action: 'custom', text: 'All fruit', onClick: (ms) => ms.setSelected(['fruit'], { notify: true }) }
    ];
    const emitted = document.getElementById('cascade-emitted');
    const showEmitted = () => { if (emitted) emitted.textContent = JSON.stringify(treeCascade.getValue()); };
    treeCascade.addEventListener('change', showEmitted);
  }

  // Real data — the full ISCO-08 occupation classification (619 groups).
  fetch('/assets/data/isco08.json')
    .then(r => r.json())
    .then(isco => {
      const el = document.getElementById('tree-isco');
      if (!el) return;
      el.valueMember = 'value';
      el.displayValueMember = 'label';
      el.pathMember = 'path';
      el.isSelectableMember = 'selectable';
      // Widen the built-in filter to also match ISCO code + full breadcrumb.
      el.getSearchValueCallback = (item) => `${item.label} ${item.value} ${item.fullTitle}`;
      // Badge = last segment only, with a ".. /" hint when ancestors exist.
      el.getBadgeDisplayCallback = (item) => {
        const segs = String(item.fullTitle || item.label).split(' / ');
        const last = segs[segs.length - 1];
        return segs.length > 1 ? `.. / ${last}` : last;
      };
      el.getBadgeTooltipCallback = (item) => item.fullTitle || item.label;
      el.options = isco;
    })
    .catch(err => console.error('ISCO-08 tree demo failed to load:', err));

  // ---- Mobile demos ----
  const mobileIntro = document.getElementById('mobile-intro');
  const mobileAutofocus = document.getElementById('mobile-autofocus');
  const mobileNavigate = document.getElementById('mobile-navigate');
  [mobileIntro, mobileAutofocus, mobileNavigate].forEach((el) => { if (el) el.options = mobileOptions; });

  // "Preview as fullscreen" checkbox flips mobile-presentation between
  // 'fullscreen' (forced overlay on desktop) and 'auto' (floating here).
  const wirePreview = (checkboxId, ...els) => {
    const cb = document.getElementById(checkboxId);
    if (!cb) return;
    cb.addEventListener('change', (e) => {
      const mode = e.target.checked ? 'fullscreen' : 'auto';
      els.forEach((el) => { if (el) el.setAttribute('mobile-presentation', mode); });
    });
  };
  wirePreview('intro-fs-preview', mobileIntro);
  wirePreview('kb-fs-preview', mobileAutofocus);
  wirePreview('nav-fs-preview', mobileNavigate);
});

// Programmatic control functions
function selectColors(values) {
  const select = document.getElementById('programmatic-demo');
  if (select && select.setSelected) {
    select.setSelected(values);
  }
}

function getSelectedColors() {
  const select = document.getElementById('programmatic-demo');
  const output = document.getElementById('selected-output');
  if (select && output) {
    const selected = select.getSelected ? select.getSelected() : [];
    const values = select.getValue ? select.getValue() : [];
    output.innerHTML = `
      <strong>Selected Options:</strong><br>
      Values: ${JSON.stringify(values)}<br>
      Objects: ${JSON.stringify(selected, null, 2)}
    `;
  }
}

function clearColors() {
  const select = document.getElementById('programmatic-demo');
  if (select && select.setSelected) {
    select.setSelected([]);
  }
}

// Events demo
(function() {
  const eventsDemo = document.getElementById('events-demo');
  const eventLog = document.getElementById('event-log');

  if (eventsDemo && eventLog) {
    eventsDemo.addEventListener('change', (e) => {
      const timestamp = new Date().toLocaleTimeString();
      const values = e.detail.selectedValues || [];
      const logEntry = document.createElement('div');
      logEntry.style.marginBottom = '0.25rem';
      logEntry.textContent = `[${timestamp}] Changed: ${JSON.stringify(values)}`;
      eventLog.insertBefore(logEntry, eventLog.firstChild);

      // Keep only last 10 entries
      while (eventLog.children.length > 10) {
        eventLog.removeChild(eventLog.lastChild);
      }
    });
  }
})();
