<script>
// Virtual scrolling demo - add 1,000 options
(function() {
  const virtualDemo = document.getElementById('virtual-scroll-demo');
  if (virtualDemo) {
    for (let i = 1; i <= 1000; i++) {
      const option = document.createElement('option');
      option.value = `item${i}`;
      option.textContent = `Item ${i} - Option ${i}`;
      virtualDemo.appendChild(option);
    }
  }
})();

// None Mode demo - initialize with technology options
customElements.whenDefined('web-multiselect').then(() => {
  const noneMode = document.getElementById('none-mode');
  if (noneMode) {
    customElements.upgrade(noneMode);
    noneMode.options = [
      { value: 'js', label: 'JavaScript', icon: '🟨' },
      { value: 'ts', label: 'TypeScript', icon: '🔷' },
      { value: 'py', label: 'Python', icon: '🐍' },
      { value: 'rust', label: 'Rust', icon: '🦀' },
      { value: 'go', label: 'Go', icon: '🐹' },
      { value: 'java', label: 'Java', icon: '☕' },
      { value: 'csharp', label: 'C#', icon: '🟣' },
      { value: 'cpp', label: 'C++', icon: '🔵' }
    ];
    noneMode.value = ['js', 'ts'];
  }

  // Grouped options demo - initialize with group property
  const groupedDemo = document.getElementById('grouped-demo');
  if (groupedDemo) {
    customElements.upgrade(groupedDemo);
    groupedDemo.options = [
      { value: 'react', label: 'React', group: 'Frontend' },
      { value: 'vue', label: 'Vue', group: 'Frontend' },
      { value: 'angular', label: 'Angular', group: 'Frontend' },
      { value: 'svelte', label: 'Svelte', group: 'Frontend' },
      { value: 'nodejs', label: 'Node.js', group: 'Backend' },
      { value: 'django', label: 'Django', group: 'Backend' },
      { value: 'rails', label: 'Ruby on Rails', group: 'Backend' },
      { value: 'laravel', label: 'Laravel', group: 'Backend' },
      { value: 'postgresql', label: 'PostgreSQL', group: 'Database' },
      { value: 'mysql', label: 'MySQL', group: 'Database' },
      { value: 'mongodb', label: 'MongoDB', group: 'Database' },
      { value: 'redis', label: 'Redis', group: 'Database' }
    ];
  }

  // Disabled options demo - initialize with disabled property
  const disabledDemo = document.getElementById('disabled-demo');
  if (disabledDemo) {
    customElements.upgrade(disabledDemo);
    disabledDemo.options = [
      { value: 'enabled1', label: 'Available Option 1' },
      { value: 'disabled1', label: 'Unavailable Option 1', disabled: true },
      { value: 'enabled2', label: 'Available Option 2' },
      { value: 'disabled2', label: 'Unavailable Option 2', disabled: true },
      { value: 'enabled3', label: 'Available Option 3' },
      { value: 'disabled3', label: 'Unavailable Option 3', disabled: true }
    ];
  }
});

// Programmatic control functions
function selectColors(values) {
  const select = document.getElementById('programmatic-demo');
  if (select && select.setSelected) {
    select.setSelected(values);
  }
}

function getSelectedColors() {
  const select = document.getElementById('programmatic-demo');
  const output = document.getElementById('selected-output');
  if (select && output) {
    const selected = select.getSelected ? select.getSelected() : [];
    const values = select.getValue ? select.getValue() : [];
    output.innerHTML = `
      <strong>Selected Options:</strong><br>
      Values: ${JSON.stringify(values)}<br>
      Objects: ${JSON.stringify(selected, null, 2)}
    `;
  }
}

function clearColors() {
  const select = document.getElementById('programmatic-demo');
  if (select && select.setSelected) {
    select.setSelected([]);
  }
}

// Events demo
(function() {
  const eventsDemo = document.getElementById('events-demo');
  const eventLog = document.getElementById('event-log');

  if (eventsDemo && eventLog) {
    eventsDemo.addEventListener('change', (e) => {
      const timestamp = new Date().toLocaleTimeString();
      const values = e.detail.selectedValues || [];
      const logEntry = document.createElement('div');
      logEntry.style.marginBottom = '0.25rem';
      logEntry.textContent = `[${timestamp}] Changed: ${JSON.stringify(values)}`;
      eventLog.insertBefore(logEntry, eventLog.firstChild);

      // Keep only last 10 entries
      while (eventLog.children.length > 10) {
        eventLog.removeChild(eventLog.lastChild);
      }
    });
  }
})();
</script>
