<p>Bloomberg-y "sparkline list" KPI indicator. Each KPI becomes one row: <strong>name · sparkline · value · Δ%</strong>. No view-mode toggle, no status pills, no prev row — built for fast vertical scanning and side-by-side comparison rather than per-tile depth. Sparkline gets a filled area under the line for stronger visual weight than the terminal-grid version. Hover any row for the structured detail breakdown.</p>

<style>
/* === Card header: title + LIVE pulse (no view toggle in this design) === */
.kpi-spark-list__header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 1.6rem;
  flex-wrap: wrap;
}
.kpi-spark-list__live {
  display: inline-flex;
  align-items: center;
  gap: 0.6rem;
  font-family: var(--base-font-family-mono);
  font-size: 1.2rem;
  font-weight: 600;
  letter-spacing: 0.06em;
  color: var(--pa-text-secondary);
}
.kpi-spark-list__livedot {
  width: 0.8rem;
  height: 0.8rem;
  border-radius: 50%;
  background: var(--pa-positive);
  box-shadow: 0 0 6px var(--pa-positive);
  animation: kpiPulse 1.6s ease-in-out infinite;
}
@keyframes kpiPulse { 50% { opacity: 0.35; } }

/* === Body: stacked rows, no padding so border-bottoms span full card width === */
.kpi-spark-list__body { padding: 0; }

/* === The card is a query container so rows can react to *card width*, not
       viewport width. This is the right axis: the same row can sit in a
       wide section-1 card or a 25% page-grid card, and we want it to choose
       a layout based on the card it's actually in. === */
.kpi-spark-list {
  container-type: inline-size;
}

/* === Row: default (wide) 4-column grid — label · chart · value · delta === */
.kpi-spark-row {
  display: grid;
  grid-template-columns: minmax(14rem, 28%) minmax(10rem, 1fr) minmax(8rem, 18%) minmax(7rem, 12%);
  align-items: center;
  gap: 1.6rem;
  padding: 1.4rem 2rem;
  border-bottom: 1px solid var(--pa-border-color);
}
.kpi-spark-row:last-child { border-bottom: 0; }

/* === Mid-narrow card (1×3 page-grid columns and 45% column). Stack to two
       rows: label/value/delta on top, full-width chart below. The 4-col
       layout's combined min-content is ~500px (label 140 + chart 100 +
       value 80 + delta 70 + gaps 48 + row padding 64), so trigger stacking
       generously at 640px — keeps things visually spacious even for cards
       that *could* technically squeeze 4 cols.
       Default order: value-above-chart. Use .kpi-spark-list--chart-first to
       flip (see below). === */
@container (max-width: 640px) {
  .kpi-spark-row {
    grid-template-columns: minmax(0, 1fr) auto auto;
    grid-template-rows: auto auto;
    grid-template-areas:
      "label value delta"
      "chart chart chart";
    column-gap: 1.2rem;
    row-gap: 0.4rem;
    align-items: baseline;
    padding: 1.2rem 1.6rem;
  }
  .kpi-spark-row__label  { grid-area: label; align-self: center; font-size: 1.25rem; }
  .kpi-spark-row__value  { grid-area: value; }
  .kpi-spark-row__delta  { grid-area: delta; font-size: 1.25rem; }
  .kpi-spark-row__chart  { grid-area: chart; }
  /* svg height is the framework `--pa-chart-trendline-height`, set on the
     base rule above; no narrow-width override needed now that it's centralised. */
  .kpi-spark-row__num { font-size: 2rem; }
}

/* === Modifier: --chart-first — flips the stacked order. Label on top,
       chart full-width in the middle, value/delta side-by-side at the
       bottom. Reads like the canonical 4-col layout rotated 90° (the
       canonical L-to-R order is label → chart → value → delta, so
       top-to-bottom keeps that flow). Applies starting at the same
       640px container breakpoint, and is also what the very-narrow
       fallback (≤360px) collapses to for both default and modifier. === */
@container (max-width: 640px) {
  .kpi-spark-list--chart-first .kpi-spark-row {
    grid-template-columns: 1fr auto;
    grid-template-rows: auto auto auto;
    grid-template-areas:
      "label  label"
      "chart  chart"
      "value  delta";
    row-gap: 0.5rem;
    column-gap: 1rem;
    padding: 1.2rem 1.6rem;
  }
  .kpi-spark-list--chart-first .kpi-spark-row__label  { align-self: start; }
  .kpi-spark-list--chart-first .kpi-spark-row__value  { text-align: start; align-self: baseline; }
  .kpi-spark-list--chart-first .kpi-spark-row__delta  { align-self: baseline; }
}

/* === Very narrow card (the 25% page-grid stress test, ~280–360px). At this
       width even label + value + delta on one row doesn't fit, so we force
       the chart-first 3-row layout regardless of modifier. === */
@container (max-width: 360px) {
  .kpi-spark-row {
    grid-template-columns: 1fr auto;
    grid-template-rows: auto auto auto;
    grid-template-areas:
      "label  label"
      "chart  chart"
      "value  delta";
    row-gap: 0.5rem;
    column-gap: 1rem;
    padding: 1.2rem 1.4rem;
  }
  .kpi-spark-row__label  { grid-area: label; align-self: start; }
  .kpi-spark-row__chart  { grid-area: chart; }
  .kpi-spark-row__value  { grid-area: value; text-align: start; align-self: baseline; }
  .kpi-spark-row__delta  { grid-area: delta; align-self: baseline; }
}

/* Label (left column) — uppercase, mono, muted vs the value */
.kpi-spark-row__label {
  font-family: var(--base-font-family-mono);
  font-size: 1.4rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: color-mix(in srgb, var(--pa-text-color-1) 60%, transparent);
}

/* Sparkline (col 2) — line + filled area underneath + trailing dot.
   The trailing dot is a CSS-positioned <span>, not a <circle>, because the
   SVG uses preserveAspectRatio="none" — that stretches the line/area to
   fill the cell width but turns an SVG circle into an oval as a side-effect
   (different X/Y scale factors). JS converts each circle to a positioned
   span at init; see the inline <script> at the bottom of this file. */
.kpi-spark-row__chart {
  position: relative;          /* anchor for the dot */
}
.kpi-spark-row__chart svg {
  display: block;
  width: 100%;
  height: var(--pa-chart-trendline-height);
  overflow: visible;
}
.kpi-spark-row__chart polyline {
  fill: none;
  stroke: currentColor;
  stroke-width: var(--pa-chart-trendline-stroke);
  stroke-linecap: round;
  stroke-linejoin: round;
}
.kpi-spark-row__chart polygon {
  fill: currentColor;
  fill-opacity: 0.18;          /* subtle area shading — same hue as the line */
  stroke: none;
}
.kpi-spark-dot {
  position: absolute;
  width: 6px;
  height: 6px;
  margin: -3px 0 0 -3px;       /* centre on (left, top) anchor */
  border-radius: 50%;
  background: currentColor;
  pointer-events: none;
}

/* Sparkline color reflects sentiment, not direction (see kpi-terminal-grid
   for the rationale). Color is set on .kpi-spark-row__chart so currentColor
   resolves for both the SVG content (line/area) and the dot inside the
   wrapper. Picks one of the 5 scale colors via currentColor. */
.kpi-spark-row--up-strong   .kpi-spark-row__chart { color: var(--pa-very-positive); }
.kpi-spark-row--up          .kpi-spark-row__chart { color: var(--pa-positive); }
.kpi-spark-row--flat        .kpi-spark-row__chart { color: var(--pa-neutral); }
.kpi-spark-row--down        .kpi-spark-row__chart { color: var(--pa-negative); }
.kpi-spark-row--down-strong .kpi-spark-row__chart { color: var(--pa-very-negative); }

/* Value (col 3) — focal white number + muted unit, mono, right-aligned */
.kpi-spark-row__value {
  font-family: var(--base-font-family-mono);
  text-align: end;
  line-height: 1;
}
.kpi-spark-row__num {
  font-size: 2.6rem;
  font-weight: 700;
  letter-spacing: -0.02em;
  color: var(--pa-text-color-1);
}
.kpi-spark-row__unit {
  font-size: 1.3rem;
  font-weight: 500;
  color: var(--pa-text-secondary);
  margin-left: 0.2rem;
}

/* Delta (col 4) — coloured by the same 5-step scale as terminal-grid */
.kpi-spark-row__delta {
  font-family: var(--base-font-family-mono);
  font-size: 1.4rem;
  font-weight: 600;
  text-align: end;
  font-variant-numeric: tabular-nums;
}
.kpi-spark-row__delta--very-positive { color: var(--pa-very-positive); }
.kpi-spark-row__delta--positive      { color: var(--pa-positive); }
.kpi-spark-row__delta--neutral       { color: var(--pa-neutral); }
.kpi-spark-row__delta--negative      { color: var(--pa-negative); }
.kpi-spark-row__delta--very-negative { color: var(--pa-very-negative); }

/* === Footer caption === */
.kpi-spark-list__footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 1rem;
  font-family: var(--base-font-family-mono);
  font-size: 1.2rem;
  color: var(--pa-text-secondary);
}
.kpi-spark-list__footer strong {
  color: var(--pa-text-color-1);
  font-weight: 700;
}

/* === Hover detail popover — same Floating UI / cursor-anchored recipe as
   kpi-terminal-grid. Moved to <body> on init to escape ancestor overflow. === */
.kpi-spark-row__detail {
  position: fixed;
  top: 0;
  left: 0;
  visibility: hidden;
  pointer-events: none;
  z-index: 9000;
  min-width: 26rem;
  max-width: 32rem;
  background: var(--pa-detail-bg);
  color: var(--pa-detail-text);
  padding: 1.2rem 1.5rem;
  font-family: var(--base-font-family-mono);
  font-size: 1.25rem;
  line-height: 1.5;
  border-radius: 0.4rem;
  box-shadow: var(--pa-detail-shadow);
}
.kpi-spark-row__detail[data-show] { visibility: visible; }
.kpi-spark-row__detail-title {
  text-transform: uppercase;
  letter-spacing: 0.08em;
  font-size: 1.05rem;
  font-weight: 700;
  color: var(--pa-detail-title);
  margin-bottom: 0.6rem;
}
.kpi-spark-row__detail dl {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 0.35rem 1.6rem;
  margin: 0;
}
.kpi-spark-row__detail dt { margin: 0; color: var(--pa-detail-row-label); font-weight: 400; }
.kpi-spark-row__detail dd { margin: 0; text-align: end; font-weight: 600; font-variant-numeric: tabular-nums; }
.kpi-spark-row__detail .pos { color: var(--pa-positive); }
.kpi-spark-row__detail .neg { color: var(--pa-negative); }
</style>

