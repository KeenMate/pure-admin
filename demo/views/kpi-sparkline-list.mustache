<script>
// Hover detail popover — same Floating UI cursor-anchored recipe as
// kpi-terminal-grid.mustache. Each row's detail is appended to <body> so
// ancestor overflow:hidden doesn't clip; cursor coords (clientX/clientY)
// drive a virtual reference element that computePosition anchors against.
document.addEventListener('DOMContentLoaded', function() {
    if (!window.FloatingUIDOM) return;
    const { computePosition, flip, shift, offset } = window.FloatingUIDOM;

    document.querySelectorAll('.kpi-spark-row').forEach(row => {
        const detail = row.querySelector('.kpi-spark-row__detail');
        if (!detail) return;
        document.body.appendChild(detail);

        let cursorX = 0, cursorY = 0;
        const virtualEl = {
            getBoundingClientRect() {
                return {
                    width: 0, height: 0,
                    x: cursorX, y: cursorY,
                    top: cursorY, left: cursorX,
                    right: cursorX, bottom: cursorY
                };
            }
        };

        const reposition = () => {
            computePosition(virtualEl, detail, {
                strategy: 'fixed',
                placement: 'top-start',
                middleware: [offset(14), flip(), shift({ padding: 8 })]
            }).then(({ x, y }) => {
                Object.assign(detail.style, { left: `${x}px`, top: `${y}px` });
            });
        };

        row.addEventListener('mouseenter', (e) => {
            cursorX = e.clientX;
            cursorY = e.clientY;
            detail.setAttribute('data-show', '');
            reposition();
        });
        row.addEventListener('mousemove', (e) => {
            cursorX = e.clientX;
            cursorY = e.clientY;
            reposition();
        });
        row.addEventListener('mouseleave', () => {
            detail.removeAttribute('data-show');
        });
    });
});
</script>
