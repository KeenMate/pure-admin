      <div class="pa-card">
        <div class="pa-card__header">
          <div class="pa-card__title">
              <h2 class="pa-card__title-text">Position Options</h2>
          </div>
        </div>
        <div class="pa-card__body">
          <p>Dialogs can be positioned in the <strong>center</strong> (default) or at the <strong>top</strong> of the viewport.</p>

          <div class="pa-row gap-10">
            <div class="pa-col-100 pa-col-md-25">
              <button class="pa-btn pa-btn--primary" style="width: 100%;" onclick="positionCenter()">
                Center (Default)
              </button>
            </div>
            <div class="pa-col-100 pa-col-md-25">
              <button class="pa-btn pa-btn--primary" style="width: 100%;" onclick="positionTop()">
                Top Position
              </button>
            </div>
            <div class="pa-col-100 pa-col-md-25">
              <button class="pa-btn pa-btn--success" style="width: 100%;" onclick="promptTop()">
                Prompt (Top)
              </button>
            </div>
            <div class="pa-col-100 pa-col-md-25">
              <button class="pa-btn pa-btn--danger" style="width: 100%;" onclick="confirmTop()">
                Confirm (Top)
              </button>
            </div>
          </div>

          <pre class="pa-code pa-code--compact mt-4"><code>// Center position (default)
