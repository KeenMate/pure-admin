            <div class="pa-stacked-bar__legend-item">
                <span class="pa-stacked-bar__legend-swatch pa-stacked-bar__legend-swatch--secondary"></span>
                Other (7%)
            </div>
        </div>
    </div>
</div>


<!-- ============================================================
     3. PROGRESS RINGS
