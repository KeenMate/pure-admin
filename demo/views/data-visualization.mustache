                <div class="pa-progress-ring__inner">
                    <span class="pa-progress-ring__value">65%</span>
                </div>
            </div>
            <div class="pa-progress-ring" style="--value: 65">
                <div class="pa-progress-ring__inner">
                    <span class="pa-progress-ring__value">65%</span>
                    <span class="pa-progress-ring__label">Default</span>
