<script>
(function() {
    // ── State ──
    // Each loaded font: { id, name, sourceFaces[], styleEl, overrides: {ascent,descent,size} }
    const fonts = [];
    let activeFontId = '__theme__'; // '__theme__' or a font id

    // ── DOM refs ──
    const fontNameInput  = document.getElementById('fontNameInput');
    const fontWeightsInput = document.getElementById('fontWeightsInput');
    const loadFontBtn    = document.getElementById('loadFontBtn');
    const statusEl       = document.getElementById('fontTestStatus');
    const fontSwitcher   = document.getElementById('fontSwitcher');
    const tuningPanel    = document.getElementById('tuningPanel');
    const tuningFontName = document.getElementById('tuningFontName');
    const ascentButtons  = document.getElementById('ascentButtons');
    const descentButtons = document.getElementById('descentButtons');
    const sizeButtons    = document.getElementById('sizeButtons');
    const customAscent   = document.getElementById('customAscent');
    const customDescent  = document.getElementById('customDescent');
    const customSize     = document.getElementById('customSize');
    const applyCustomBtn = document.getElementById('applyCustomBtn');
    const snippetPanel   = document.getElementById('snippetPanel');
    const snippetOutput  = document.getElementById('snippetOutput');
    const copySnippetBtn = document.getElementById('copySnippetBtn');

    // ── Sanitization ──
    function sanitizeFontName(name) {
        return name.replace(/[^a-zA-Z0-9\s\-]/g, '').trim().slice(0, 100);
    }
    function sanitizeWeights(weights) {
        return weights.replace(/[^0-9;]/g, '').slice(0, 30);
    }
    function sanitizeOverride(value, min, max) {
        const num = parseInt(value, 10);
        if (isNaN(num)) return null;
        return Math.max(min, Math.min(max, num));
    }

    // ── Preset ranges ──
    const ascentValues  = [80, 85, 90, 95, 100, 105, 110, 115, 120];
    const descentValues = [5, 10, 15, 20, 25, 30, 35, 40];
    const sizeValues    = [90, 95, 100, 105, 110, 115];

    const STORAGE_KEY = 'pa-font-tuning';

    // ── Persistence ──
    function saveState() {
        const data = {
            activeFontId,
            fonts: fonts.map(f => ({
                id: f.id,
                name: f.name,
                weights: [...new Set(f.sourceFaces.map(s => s.weight))].join(';'),
                overrides: f.overrides
            }))
        };
        try { localStorage.setItem(STORAGE_KEY, JSON.stringify(data)); } catch(e) {}
    }

    async function restoreState() {
        let data;
        try { data = JSON.parse(localStorage.getItem(STORAGE_KEY)); } catch(e) {}
        if (!data || !Array.isArray(data.fonts) || data.fonts.length === 0) return false;

        for (const saved of data.fonts) {
            const name = sanitizeFontName(saved.name);
            if (!name) continue;
            const weights = sanitizeWeights(saved.weights || '400;700') || '400;700';

            try {
                const fetchUrl = `https://fonts.googleapis.com/css2?family=${encodeURIComponent(name.replace(/\s+/g, '+') + ':wght@' + weights)}&display=swap`;
                const resp = await fetch(fetchUrl);
                if (!resp.ok) continue;
                const css = await resp.text();

                const sourceFaces = parseFontFaces(css);
                if (sourceFaces.length === 0) continue;

                const font = {
                    id: saved.id || fontIdFromName(name),
                    name,
                    sourceFaces,
                    styleEl: null,
                    overrides: {
                        ascent: saved.overrides?.ascent || null,
                        descent: saved.overrides?.descent || null,
                        size: saved.overrides?.size || null
                    }
                };
                updateFontStyle(font);
                fonts.push(font);
            } catch(e) { /* skip failed fonts */ }
        }

        if (data.activeFontId && (data.activeFontId === '__theme__' || fonts.find(f => f.id === data.activeFontId))) {
            activeFontId = data.activeFontId;
        }

        applyActiveFont();
        return fonts.length > 0;
    }

    // ── Presets ──
    // Each preset: { name, overrides: {ascent, descent, size} }
    const PRESETS_KEY = 'pa-font-tuning-presets';
    let presets = [];

    const savePresetBtn = document.getElementById('savePresetBtn');
    const presetMenu    = document.getElementById('presetMenu');

    function loadPresets() {
        try { presets = JSON.parse(localStorage.getItem(PRESETS_KEY)) || []; } catch(e) { presets = []; }
    }

    function savePresets() {
        try { localStorage.setItem(PRESETS_KEY, JSON.stringify(presets)); } catch(e) {}
    }

    function presetName(ov) {
        const parts = [];
        if (ov.ascent)  parts.push(`asc:${ov.ascent}`);
        if (ov.descent) parts.push(`desc:${ov.descent}`);
        if (ov.size)    parts.push(`sz:${ov.size}`);
        return parts.length ? parts.join(' ') : 'no overrides';
    }

    function renderPresetMenu() {
        presetMenu.innerHTML = '';
        if (presets.length === 0) {
            const empty = document.createElement('div');
            empty.className = 'pa-btn-split__item';
            empty.style.cssText = 'color: var(--pa-text-color-2); cursor: default; font-style: italic;';
            empty.textContent = 'No saved presets';
            presetMenu.appendChild(empty);
            return;
        }
        for (let i = 0; i < presets.length; i++) {
            const preset = presets[i];
            const item = document.createElement('div');
            item.style.cssText = 'display: flex; align-items: center; gap: 0.4rem;';

            const applyBtn = document.createElement('button');
            applyBtn.className = 'pa-btn-split__item';
            applyBtn.style.cssText = 'flex: 1;';
            applyBtn.textContent = (preset.fontName ? preset.fontName + ' — ' : '') + preset.name;
            applyBtn.addEventListener('click', () => applyPreset(preset));

            const deleteBtn = document.createElement('button');
            deleteBtn.className = 'pa-btn pa-btn--danger pa-btn--xs pa-btn--icon-only';
            deleteBtn.style.cssText = 'flex-shrink: 0; margin-inline-end: 0.5rem;';
            deleteBtn.innerHTML = '<i class="fas fa-trash-can"></i>';
            deleteBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                presets.splice(i, 1);
                savePresets();
                renderPresetMenu();
            });

            item.appendChild(applyBtn);
            item.appendChild(deleteBtn);
            presetMenu.appendChild(item);
        }
    }

    function applyPreset(preset) {
        const font = getActiveFont();
        if (!font) return;
        font.overrides = { ...preset.overrides };
        updateFontStyle(font);
        applyActiveFont();
        saveState();
    }

    savePresetBtn.addEventListener('click', () => {
        const font = getActiveFont();
        if (!font) return;
        const ov = font.overrides;
        if (!ov.ascent && !ov.descent && !ov.size) return;

        const name = presetName(ov);
        const key = `${font.name} — ${name}`;
        // Don't save duplicates
        if (presets.find(p => p.fontName === font.name && p.name === name)) return;

        presets.push({ name, fontName: font.name, overrides: { ascent: ov.ascent, descent: ov.descent, size: ov.size } });
        savePresets();
        renderPresetMenu();
    });

    loadPresets();
    renderPresetMenu();

    // ── Font helpers ──
    function getActiveFont() {
        return fonts.find(f => f.id === activeFontId);
    }

    function fontIdFromName(name) {
        return name.toLowerCase().replace(/\s+/g, '-');
    }

    // ── Build @font-face CSS for a font with its current overrides ──
    function buildFontFaceCSS(font) {
        const ov = font.overrides;
        let overrideStr = '';
        if (ov.ascent)  overrideStr += `    ascent-override: ${ov.ascent}%;\n`;
        if (ov.descent) overrideStr += `    descent-override: ${ov.descent}%;\n`;
        if (ov.size)    overrideStr += `    size-adjust: ${ov.size}%;\n`;

        let css = '';
        for (const face of font.sourceFaces) {
            css += `@font-face {\n`;
            css += `    font-family: '${font.name}-tuned';\n`;
            css += `    font-weight: ${face.weight};\n`;
            css += `    font-display: swap;\n`;
            css += `    src: ${face.src};\n`;
            if (face.unicodeRange) css += `    unicode-range: ${face.unicodeRange};\n`;
            css += overrideStr;
            css += `}\n`;
        }
        return css;
    }

    // Inject/update a font's <style> element
    function updateFontStyle(font) {
        if (!font.styleEl) {
            font.styleEl = document.createElement('style');
            font.styleEl.id = `font-test-${font.id}`;
            document.head.appendChild(font.styleEl);
        }

        // Base (no overrides) + tuned variant
        let css = '';
        for (const face of font.sourceFaces) {
            css += `@font-face {\n`;
            css += `    font-family: '${font.name}';\n`;
            css += `    font-weight: ${face.weight};\n`;
            css += `    font-display: swap;\n`;
            css += `    src: ${face.src};\n`;
            if (face.unicodeRange) css += `    unicode-range: ${face.unicodeRange};\n`;
            css += `}\n`;
        }
        css += buildFontFaceCSS(font);
        font.styleEl.textContent = css;
    }

    // ── Apply active font to page ──
    function applyActiveFont() {
        if (activeFontId === '__theme__') {
            document.body.style.removeProperty('--base-font-family');
            snippetPanel.style.display = 'none';
        } else {
            const font = getActiveFont();
            if (!font) return;
            const hasOverrides = font.overrides.ascent || font.overrides.descent || font.overrides.size;
            const family = hasOverrides ? `'${font.name}-tuned'` : `'${font.name}'`;
            document.body.style.setProperty('--base-font-family', `${family}, sans-serif`);
            tuningPanel.style.display = '';
            tuningFontName.textContent = font.name;
            syncTuningUI(font);
            updateSnippet(font);
        }
        renderSwitcher();
    }

    // ── Switcher bar ──
    function renderSwitcher() {
        fontSwitcher.innerHTML = '';

        // Theme Default button
        const themeBtn = document.createElement('button');
        themeBtn.className = `pa-btn pa-btn--secondary font-switch-btn${activeFontId === '__theme__' ? ' pa-btn--primary' : ''}`;
        themeBtn.textContent = 'Theme Default';
        themeBtn.addEventListener('click', () => {
            activeFontId = '__theme__';
            applyActiveFont();
        });
        fontSwitcher.appendChild(themeBtn);

        // Loaded fonts as split buttons
        for (const font of fonts) {
            const isActive = activeFontId === font.id;
            const wrapper = document.createElement('div');
            wrapper.className = 'pa-btn-split';

            // Main button — select this font
            const mainBtn = document.createElement('button');
            mainBtn.className = `pa-btn ${isActive ? 'pa-btn--primary' : 'pa-btn--secondary'}`;
            const ov = font.overrides;
            let label = font.name;
            const parts = [];
            if (ov.ascent)  parts.push(`asc:${ov.ascent}`);
            if (ov.descent) parts.push(`desc:${ov.descent}`);
            if (ov.size)    parts.push(`sz:${ov.size}`);
            if (parts.length) label += ` (${parts.join(', ')})`;
            mainBtn.textContent = label;
            mainBtn.addEventListener('click', () => {
                activeFontId = font.id;
                applyActiveFont();
            });

            // Toggle button
            const toggleBtn = document.createElement('button');
            toggleBtn.className = `pa-btn ${isActive ? 'pa-btn--primary' : 'pa-btn--secondary'} pa-btn-split__toggle`;
            toggleBtn.innerHTML = '<i class="fas fa-chevron-down text-2xs pa-btn-split__chevron"></i>';
            toggleBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                toggleSplitMenu(e);
            });

            // Dropdown menu
            const menu = document.createElement('div');
            menu.className = 'pa-btn-split__menu';

            const removeItem = document.createElement('button');
            removeItem.className = 'pa-btn-split__item pa-btn-split__item--danger';
            removeItem.innerHTML = '<span class="pa-btn-split__item-icon"><i class="fas fa-trash"></i></span> Remove font';
            removeItem.addEventListener('click', () => {
                removeFont(font.id);
            });
            menu.appendChild(removeItem);

            wrapper.appendChild(mainBtn);
            wrapper.appendChild(toggleBtn);
            wrapper.appendChild(menu);
            fontSwitcher.appendChild(wrapper);
        }
    }

    // ── Tuning UI ──
    function syncTuningUI(font) {
        buildTuneButtons(ascentButtons, ascentValues, 'ascent-override', 'asc', 'pa-btn--primary', font);
        buildTuneButtons(descentButtons, descentValues, 'descent-override', 'desc', 'pa-btn--success', font);
        buildTuneButtons(sizeButtons, sizeValues, 'size-adjust', 'sz', 'pa-btn--warning', font);
        customAscent.value = font.overrides.ascent || '';
        customDescent.value = font.overrides.descent || '';
        customSize.value = font.overrides.size || '';
    }

    function buildTuneButtons(container, values, cssProp, key, btnClass, font) {
        container.innerHTML = '';
        const overrideKey = key === 'asc' ? 'ascent' : key === 'desc' ? 'descent' : 'size';
        const currentVal = font.overrides[overrideKey];

        for (const val of values) {
            const btn = document.createElement('button');
            const isActive = currentVal == val;
            btn.className = `pa-btn ${isActive ? btnClass : 'pa-btn--secondary'} font-test-btn`;
            btn.textContent = `${key}: ${val}%`;
            btn.addEventListener('click', () => {
                // Toggle: if already active, clear; otherwise set
                if (currentVal == val) {
                    font.overrides[overrideKey] = null;
                } else {
                    font.overrides[overrideKey] = val;
                }
                updateFontStyle(font);
                applyActiveFont();
                saveState();
            });
            container.appendChild(btn);
        }
    }

    // ── Parse @font-face blocks from Google Fonts CSS ──
    function parseFontFaces(css) {
        const faces = [];
        const faceRegex = /@font-face\s*\{([^}]+)\}/g;
        let match;
        while ((match = faceRegex.exec(css)) !== null) {
            const block = match[1];
            const weightMatch = block.match(/font-weight:\s*(\d+)/);
            const srcMatch = block.match(/src:\s*([^;]+);/);
            const rangeMatch = block.match(/unicode-range:\s*([^;]+);/);
            if (!srcMatch) continue;

            const srcVal = srcMatch[1].trim();
            const urlInSrc = srcVal.match(/url\(([^)]+)\)/);
            if (!urlInSrc || !urlInSrc[1].startsWith('https://fonts.gstatic.com/')) continue;

            const weight = weightMatch ? weightMatch[1] : '400';
            if (!/^\d{3}$/.test(weight)) continue;

            const unicodeRange = rangeMatch ? rangeMatch[1].trim() : '';
            if (unicodeRange && !/^[U+0-9a-fA-F,\s\-?]+$/.test(unicodeRange)) continue;

            faces.push({ weight, src: srcVal, unicodeRange });
        }
        return faces;
    }

    // ── Load font from Google ──
    async function loadFont() {
        const name = sanitizeFontName(fontNameInput.value);
        if (!name) {
            statusEl.textContent = 'Please enter a font name.';
            return;
        }
        fontNameInput.value = name;

        const id = fontIdFromName(name);
        if (fonts.find(f => f.id === id)) {
            statusEl.textContent = `${name} is already loaded. Select it from the switcher.`;
            activeFontId = id;
            applyActiveFont();
            saveState();
            return;
        }

        const weights = sanitizeWeights(fontWeightsInput.value) || '400;700';
        fontWeightsInput.value = weights;
        statusEl.textContent = `Fetching ${name}...`;

        try {
            const fetchUrl = `https://fonts.googleapis.com/css2?family=${encodeURIComponent(name.replace(/\s+/g, '+') + ':wght@' + weights)}&display=swap`;
            const resp = await fetch(fetchUrl);
            if (!resp.ok) {
                statusEl.textContent = `Google Fonts returned ${resp.status}. Check the font name.`;
                return;
            }

            const sourceFaces = parseFontFaces(await resp.text());
            if (sourceFaces.length === 0) {
                statusEl.textContent = 'Could not parse any @font-face blocks. Check the font name.';
                return;
            }

            const font = {
                id,
                name,
                sourceFaces,
                styleEl: null,
                overrides: { ascent: null, descent: null, size: null }
            };

            updateFontStyle(font);
            fonts.push(font);
            activeFontId = id;
            applyActiveFont();
            saveState();

            statusEl.textContent = `Loaded ${name} — ${sourceFaces.length} subsets.`;
            fontNameInput.value = '';
        } catch(e) {
            statusEl.textContent = 'Fetch failed: ' + e.message;
        }
    }

    // ── Remove font ──
    function removeFont(id) {
        const idx = fonts.findIndex(f => f.id === id);
        if (idx === -1) return;

        const font = fonts[idx];
        if (font.styleEl) font.styleEl.remove();
        fonts.splice(idx, 1);

        if (activeFontId === id) {
            activeFontId = '__theme__';
        }
        applyActiveFont();
        saveState();
    }

    // ── Apply custom combination ──
    applyCustomBtn.addEventListener('click', () => {
        const font = getActiveFont();
        if (!font) return;

        const ascent = sanitizeOverride(customAscent.value, 50, 200);
        const descent = sanitizeOverride(customDescent.value, 0, 100);
        const size = sanitizeOverride(customSize.value, 50, 200);

        if (ascent !== null) customAscent.value = ascent;
        if (descent !== null) customDescent.value = descent;
        if (size !== null) customSize.value = size;

        font.overrides.ascent = ascent;
        font.overrides.descent = descent;
        font.overrides.size = size;

        updateFontStyle(font);
        applyActiveFont();
        saveState();
    });

    // ── Snippet ──
    function updateSnippet(font) {
        const ov = font.overrides;
        if (!ov.ascent && !ov.descent && !ov.size) {
            snippetPanel.style.display = 'none';
            return;
        }

        let overrideLines = '';
        if (ov.ascent)  overrideLines += `    ascent-override: ${ov.ascent}%;\n`;
        if (ov.descent) overrideLines += `    descent-override: ${ov.descent}%;\n`;
        if (ov.size)    overrideLines += `    size-adjust: ${ov.size}%;\n`;

        const weights = [...new Set(font.sourceFaces.map(f => f.weight))];

        let snippet = `/* ${font.name} — baseline-adjusted @font-face */\n`;
        for (const weight of weights) {
            snippet += `@font-face {\n`;
            snippet += `    font-family: '${font.name}';\n`;
            snippet += `    font-weight: ${weight};\n`;
            snippet += `    font-display: swap;\n`;
            snippet += `    src: url('path/to/${font.name.toLowerCase().replace(/\s+/g, '-')}-${weight}.woff2') format('woff2');\n`;
            snippet += overrideLines;
            snippet += `}\n\n`;
        }
        snippet += `/* Usage in theme SCSS */\n`;
        snippet += `$base-font-family: '${font.name}', sans-serif;\n`;

        snippetOutput.textContent = snippet;
        snippetPanel.style.display = '';
    }

    // ── Copy snippet ──
    copySnippetBtn.addEventListener('click', () => {
        navigator.clipboard.writeText(snippetOutput.textContent).then(() => {
            const orig = copySnippetBtn.textContent;
            copySnippetBtn.textContent = 'Copied!';
            setTimeout(() => { copySnippetBtn.textContent = orig; }, 1500);
        });
    });

    // ── Init ──
    loadFontBtn.addEventListener('click', loadFont);
    fontNameInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') loadFont();
    });

    // Restore saved fonts from localStorage, fall back to auto-load
    restoreState().then(restored => {
        if (!restored && fontNameInput.value.trim()) {
            loadFont();
        } else if (!restored) {
            renderSwitcher();
        }
    });
})();
</script>
