<!-- Font Tuning Tool -->
<!-- Helps theme authors find the right @font-face descriptor values for custom fonts -->

<style>
    .font-test-btn { min-width: 12rem; }
    .font-test-btn.active { outline: 2px solid var(--pa-accent); outline-offset: 2px; }
    .font-test-active { padding: 0.5rem 1rem; border-radius: 4px; background: var(--pa-accent); color: #fff; display: inline-block; }
    #fontTestStatus { font-style: italic; color: var(--pa-text-color-2); }
    .font-test-snippet {
        background: var(--pa-card-bg);
        border: 1px solid var(--pa-border-color);
        padding: 1.2rem;
        border-radius: 4px;
        font-family: monospace;
        font-size: 1.2rem;
        white-space: pre-wrap;
        word-break: break-all;
        position: relative;
        max-height: 30rem;
        overflow-y: auto;
    }
    .font-test-copy {
        position: absolute;
        top: 0.6rem;
        right: 0.6rem;
    }
    .font-input-row {
        display: flex;
        gap: 0.8rem;
        align-items: flex-end;
        flex-wrap: wrap;
    }
    .font-input-row .pa-form-group { flex: 1; min-width: 20rem; margin-bottom: 0; }
    .font-tune-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr));
        gap: 0.8rem;
    }
</style>

<div class="pa-section">
    <h3>Font Tuning Tool</h3>
    <p>Find the right <code>@font-face</code> descriptor values (<code>ascent-override</code>, <code>descent-override</code>, <code>size-adjust</code>) for any Google Font. Compare against your theme's default font to match vertical positioning.</p>
</div>

<!-- Font Input -->
<div class="pa-card">
    <div class="pa-card__header">
        <h4>Load Font</h4>
    </div>
    <div class="pa-card__body">
        <div class="font-input-row">
            <div class="pa-form-group">
                <label class="pa-form-label">Google Font Name</label>
                <input type="text" class="pa-input" id="fontNameInput" placeholder="e.g. Monda, Roboto, Inter..." value="Monda">
            </div>
            <div class="pa-form-group" style="flex: 0 0 auto;">
                <label class="pa-form-label">Weights</label>
                <input type="text" class="pa-input" id="fontWeightsInput" placeholder="400;700" value="400;700" style="width: 12rem;">
            </div>
            <button class="pa-btn pa-btn--primary" id="loadFontBtn">Load &amp; Generate Variants</button>
        </div>
        <p class="mt-4" id="fontTestStatus"></p>
    </div>
</div>

<!-- Font Switcher Buttons -->
<div class="pa-card" id="variantPanel" style="display: none;">
    <div class="pa-card__header">
        <h4>Font Variants</h4>
        <div class="pa-card__actions">
            <span class="font-test-active" id="activeFont">Theme Default</span>
        </div>
    </div>
    <div class="pa-card__body">

        <h5 class="mb-4">Reference</h5>
        <div class="font-tune-grid mb-8">
            <button class="pa-btn pa-btn--secondary font-test-btn active" data-font="" data-label="Theme Default">Theme Default</button>
            <button class="pa-btn pa-btn--secondary font-test-btn" data-font="normal" data-label="Normal (no overrides)">Normal (no overrides)</button>
        </div>

        <h5 class="mb-4">ascent-override</h5>
        <p class="mb-4 text-secondary text-sm">Controls where glyphs sit vertically in the line box. Higher = glyphs move up.</p>
        <div class="font-tune-grid mb-8" id="ascentButtons"></div>

        <h5 class="mb-4">descent-override</h5>
        <p class="mb-4 text-secondary text-sm">Controls space below the baseline. Lower = less descender space, text appears higher.</p>
        <div class="font-tune-grid mb-8" id="descentButtons"></div>

        <h5 class="mb-4">size-adjust</h5>
        <p class="mb-4 text-secondary text-sm">Scales the font without changing font-size. Affects both horizontal and vertical.</p>
        <div class="font-tune-grid mb-8" id="sizeButtons"></div>

        <h5 class="mb-4">Combinations</h5>
        <p class="mb-4 text-secondary text-sm">Fine-tune with multiple descriptors. Click any variant above first, then adjust here.</p>
        <div class="pa-row" style="gap: 0.8rem; align-items: flex-end; flex-wrap: wrap;">
            <div class="pa-form-group" style="margin-bottom: 0; min-width: 12rem;">
                <label class="pa-form-label">ascent-override %</label>
                <input type="number" class="pa-input" id="customAscent" value="" placeholder="e.g. 110" step="1">
            </div>
            <div class="pa-form-group" style="margin-bottom: 0; min-width: 12rem;">
                <label class="pa-form-label">descent-override %</label>
                <input type="number" class="pa-input" id="customDescent" value="" placeholder="e.g. 20" step="1">
            </div>
            <div class="pa-form-group" style="margin-bottom: 0; min-width: 12rem;">
                <label class="pa-form-label">size-adjust %</label>
                <input type="number" class="pa-input" id="customSize" value="" placeholder="e.g. 102" step="1">
            </div>
            <button class="pa-btn pa-btn--primary" id="applyCustomBtn">Apply Custom</button>
        </div>
    </div>
</div>

<!-- CSS Snippet Output -->
