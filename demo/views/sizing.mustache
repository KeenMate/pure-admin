<!-- Practical Example: Table Card with Detail Panel -->
<div class="pa-section">
    <h3>Practical Example: Expandable Table Card</h3>
    <p>Use <code>.flex-1</code> or <code>.min-h-{size}x</code> to ensure table cards have enough height for detail panels, even with few rows.</p>

    <div class="pa-row">
        <div class="pa-col-100 pa-col-lg-50">
            <div class="pa-card">
                <div class="pa-card__header">
                    <div class="pa-card__title">
                        <h4 class="pa-card__title-text">Without min-height</h4>
                    </div>
                    <p>Table card shrinks to content - detail panel would be tiny</p>
                </div>
                <div class="pa-card__body p-0">
                    <div class="pa-table-card" style="margin: 0; box-shadow: none;">
                        <div class="pa-table-card__body">
                            <table class="pa-table pa-table--hover">
                                <thead>
                                    <tr>
                                        <th>Name</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr><td>Item 1</td><td><span class="pa-badge pa-badge--success">Active</span></td></tr>
                                    <tr><td>Item 2</td><td><span class="pa-badge pa-badge--warning">Pending</span></td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="pa-col-100 pa-col-lg-50">
            <div class="pa-card">
                <div class="pa-card__header">
                    <div class="pa-card__title">
                        <h4 class="pa-card__title-text">With .min-h-30x</h4>
                    </div>
                    <p>Table card maintains minimum height for detail panel</p>
                </div>
                <div class="pa-card__body p-0">
                    <div class="pa-table-card min-h-30x" style="margin: 0; box-shadow: none;">
                        <div class="pa-table-card__body">
                            <table class="pa-table pa-table--hover">
                                <thead>
                                    <tr>
                                        <th>Name</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr><td>Item 1</td><td><span class="pa-badge pa-badge--success">Active</span></td></tr>
                                    <tr><td>Item 2</td><td><span class="pa-badge pa-badge--warning">Pending</span></td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="pa-card mt-base">
        <div class="pa-card__header">
            <div class="pa-card__title">
                <h4 class="pa-card__title-text">Full-Height Layout Pattern</h4>
            </div>
            <p>Filters + table card that fills remaining viewport height using flex</p>
        </div>
        <div class="pa-card__body">
            <pre class="pa-code"><code>&lt;!-- Container with flex column, full viewport height --&gt;
&lt;div class="d-flex flex-column h-screen"&gt;
    &lt;!-- Header (fixed height) --&gt;
    &lt;header class="pa-header"&gt;...&lt;/header&gt;

    &lt;!-- Main content area --&gt;
    &lt;main class="flex-1 d-flex flex-column p-base"&gt;
        &lt;!-- Filters (shrink to content) --&gt;
        &lt;div class="pa-card mb-base flex-shrink-0"&gt;
            &lt;!-- filter inputs --&gt;
        &lt;/div&gt;

        &lt;!-- Table card fills remaining space --&gt;
        &lt;div class="pa-table-card flex-1 min-h-30x"&gt;
            &lt;div class="pa-table-card__body h-full"&gt;
                &lt;div class="pa-detail-view h-full"&gt;
                    &lt;!-- table + detail panel --&gt;
                &lt;/div&gt;
            &lt;/div&gt;
        &lt;/div&gt;
    &lt;/main&gt;
&lt;/div&gt;</code></pre>
        </div>
    </div>

    <!-- Live Demo -->
    <div class="pa-card mt-base">
        <div class="pa-card__header">
            <div class="pa-card__title">
                <h4 class="pa-card__title-text">Live Demo</h4>
            </div>
            <p>Filters + table card with detail panel in a fixed-height container (simulating viewport)</p>
        </div>
        <div class="pa-card__body p-0">
            <!-- Simulated viewport container -->
            <div class="h-50x d-flex flex-column" style="border: 2px dashed var(--pa-border-color);">
                <!-- Filters (fixed height, doesn't grow) -->
                <div class="flex-shrink-0 p-sm" style="background: var(--pa-card-header-bg); border-bottom: 1px solid var(--pa-border-color);">
                    <div class="d-flex gap-sm align-items-center">
                        <input type="text" class="pa-input pa-input--sm" placeholder="Search..." style="width: 20rem;">
                        <select class="pa-input pa-input--sm" style="width: 12rem;">
                            <option>All Status</option>
                            <option>Active</option>
                            <option>Pending</option>
                        </select>
                        <button class="pa-btn pa-btn--primary pa-btn--sm">Filter</button>
                        <span class="text-secondary text-sm ms-auto">3 results (filtered)</span>
                    </div>
                </div>

                <!-- Table card fills remaining space -->
                <div class="flex-1 d-flex flex-column min-h-0">
                    <div class="pa-detail-view pa-detail-view--overlay h-full">
                        <!-- Table area -->
                        <div class="pa-detail-view__main overflow-y-auto">
                            <table class="pa-table pa-table--hover pa-table--striped" id="sizingDemoTable">
                                <thead>
                                    <tr>
                                        <th>Name</th>
                                        <th>Email</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr onclick="openSizingPanel(1)" style="cursor: pointer;">
                                        <td>Alice Johnson</td>
                                        <td>alice@example.com</td>
                                        <td><span class="pa-badge pa-badge--success">Active</span></td>
                                    </tr>
                                    <tr onclick="openSizingPanel(2)" style="cursor: pointer;">
                                        <td>Bob Smith</td>
                                        <td>bob@example.com</td>
                                        <td><span class="pa-badge pa-badge--warning">Pending</span></td>
                                    </tr>
                                    <tr onclick="openSizingPanel(3)" style="cursor: pointer;">
                                        <td>Carol Williams</td>
                                        <td>carol@example.com</td>
                                        <td><span class="pa-badge pa-badge--success">Active</span></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <!-- Detail panel -->
                        <div class="pa-detail-view__panel" id="sizingDetailPanel">
                            <div class="pa-detail-panel__content">
                                <div class="pa-detail-panel__header">
                                    <h4 class="pa-detail-panel__title" id="sizingDetailTitle">Select a row</h4>
                                    <button class="pa-detail-panel__close" onclick="closeSizingPanel()"><span class="pa-icon pa-icon--x" aria-hidden="true"></span></button>
                                </div>
                                <div class="pa-detail-panel__body" id="sizingDetailBody">
                                    <p class="text-secondary">Click a table row to view details.</p>
                                    <p class="text-secondary mt-base">Notice how the detail panel has plenty of vertical space because the table card fills the container using <code>.flex-1</code>.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
const sizingUsers = [
    { id: 1, name: 'Alice Johnson', email: 'alice@example.com', status: 'Active', role: 'Administrator', department: 'Engineering' },
    { id: 2, name: 'Bob Smith', email: 'bob@example.com', status: 'Pending', role: 'Editor', department: 'Marketing' },
    { id: 3, name: 'Carol Williams', email: 'carol@example.com', status: 'Active', role: 'Viewer', department: 'Sales' }
];

function openSizingPanel(id) {
    const user = sizingUsers.find(u => u.id === id);
    if (!user) return;

    document.getElementById('sizingDetailTitle').textContent = user.name;
    document.getElementById('sizingDetailBody').innerHTML = `
        <div class="pa-fields">
            <div class="pa-field">
                <span class="pa-field__label">Email</span>
                <span class="pa-field__value">${user.email}</span>
            </div>
            <div class="pa-field">
                <span class="pa-field__label">Role</span>
                <span class="pa-field__value">${user.role}</span>
            </div>
            <div class="pa-field">
                <span class="pa-field__label">Department</span>
                <span class="pa-field__value">${user.department}</span>
            </div>
            <div class="pa-field">
                <span class="pa-field__label">Status</span>
                <span class="pa-field__value"><span class="pa-badge pa-badge--${user.status === 'Active' ? 'success' : 'warning'}">${user.status}</span></span>
            </div>
        </div>
        <p class="text-secondary mt-base text-sm">The detail panel fills the available height thanks to <code>.flex-1</code> and <code>.h-full</code> on the container.</p>
    `;
    document.getElementById('sizingDetailPanel').classList.add('pa-detail-view__panel--open');

    // Highlight selected row
    document.querySelectorAll('#sizingDemoTable tbody tr').forEach(tr => tr.classList.remove('is-selected'));
    document.querySelector(`#sizingDemoTable tbody tr:nth-child(${id})`).classList.add('is-selected');
}

function closeSizingPanel() {
    document.getElementById('sizingDetailPanel').classList.remove('pa-detail-view__panel--open');
    document.querySelectorAll('#sizingDemoTable tbody tr').forEach(tr => tr.classList.remove('is-selected'));
}
</script>

<!-- CSS Reference -->
<div class="pa-card">
    <div class="pa-card__header">
        <div class="pa-card__title">
            <h3 class="pa-card__title-text">CSS Classes Reference</h3>
        </div>
    </div>
    <div class="pa-card__body">
        <h4>Fixed Height (rem-based)</h4>
        <ul class="pa-list-basic pa-list-basic--compact">
            <li><code>.h-2x</code> through <code>.h-50x</code> - Fixed heights (2rem to 50rem)</li>
            <li><code>.min-h-2x</code> through <code>.min-h-30x</code> - Minimum heights</li>
            <li><code>.max-h-5x</code> through <code>.max-h-50x</code> - Maximum heights</li>
        </ul>

        <h4 class="mt-4">Percentage / Viewport Height</h4>
        <ul class="pa-list-basic pa-list-basic--compact">
            <li><code>.h-full</code> - <code>height: 100%</code></li>
            <li><code>.h-screen</code> - <code>height: 100vh</code></li>
            <li><code>.min-h-full</code> - <code>min-height: 100%</code></li>
            <li><code>.min-h-screen</code> - <code>min-height: 100vh</code></li>
            <li><code>.max-h-full</code> - <code>max-height: 100%</code></li>
            <li><code>.max-h-screen</code> - <code>max-height: 100vh</code></li>
        </ul>

        <h4 class="mt-4">Flex Utilities</h4>
        <ul class="pa-list-basic pa-list-basic--compact">
            <li><code>.flex-1</code> - <code>flex: 1 1 0%</code> (grow/shrink equally, ignore content)</li>
            <li><code>.flex-auto</code> - <code>flex: 1 1 auto</code> (grow/shrink based on content)</li>
            <li><code>.flex-initial</code> - <code>flex: 0 1 auto</code> (shrink only, default)</li>
            <li><code>.flex-none</code> - <code>flex: none</code> (don't grow or shrink)</li>
            <li><code>.flex-grow</code> - <code>flex-grow: 1</code></li>
            <li><code>.flex-grow-0</code> - <code>flex-grow: 0</code></li>
            <li><code>.flex-shrink</code> - <code>flex-shrink: 1</code></li>
            <li><code>.flex-shrink-0</code> - <code>flex-shrink: 0</code></li>
        </ul>

        <h4 class="mt-4">Overflow (pair with height)</h4>
        <ul class="pa-list-basic pa-list-basic--compact">
            <li><code>.overflow-auto</code> - Scroll when needed</li>
            <li><code>.overflow-y-auto</code> - Vertical scroll when needed</li>
            <li><code>.overflow-hidden</code> - Hide overflow</li>
            <li><code>.overflow-y-overlay</code> - Overlay scrollbar (Chromium)</li>
        </ul>
    </div>
</div>
