<p>Comprehensive showcase of all input types, states, sizes, and variations available in the framework.</p>

<!-- Text Inputs -->
<div class="pa-card">
    <div class="pa-card__header">
        <h3>Text Inputs</h3>
    </div>
    <div class="pa-card__body">
        <div class="pa-row">
            <!-- States -->
            <div class="pa-col-100 pa-col-md-1-3">
                <div class="pa-form-group">
                    <label>Normal</label>
                    <input type="text" class="pa-input" placeholder="Enter text">
                </div>
            </div>
            <div class="pa-col-100 pa-col-md-1-3">
                <div class="pa-form-group">
                    <label>Disabled</label>
                    <input type="text" class="pa-input" placeholder="Disabled" disabled>
                </div>
            </div>
            <div class="pa-col-100 pa-col-md-1-3">
                <div class="pa-form-group">
                    <label>Readonly</label>
                    <input type="text" class="pa-input" value="Read only value" readonly>
                </div>
            </div>

            <!-- Sizes -->
            <div class="pa-col-100 pa-col-md-20">
                <div class="pa-form-group">
                    <label>Extra Small</label>
                    <input type="text" class="pa-input pa-input--xs" placeholder="XS">
                </div>
            </div>
            <div class="pa-col-100 pa-col-md-20">
                <div class="pa-form-group">
                    <label>Small</label>
                    <input type="text" class="pa-input pa-input--sm" placeholder="Small">
                </div>
            </div>
            <div class="pa-col-100 pa-col-md-20">
                <div class="pa-form-group">
                    <label>Default</label>
                    <input type="text" class="pa-input" placeholder="Default">
                </div>
            </div>
            <div class="pa-col-100 pa-col-md-20">
                <div class="pa-form-group">
                    <label>Large</label>
                    <input type="text" class="pa-input pa-input--lg" placeholder="Large">
                </div>
            </div>
            <div class="pa-col-100 pa-col-md-20">
                <div class="pa-form-group">
                    <label>Extra Large</label>
                    <input type="text" class="pa-input pa-input--xl" placeholder="XL">
                </div>
            </div>

            <!-- Validation States -->
            <div class="pa-col-100 pa-col-md-1-3">
                <div class="pa-form-group pa-form-group--success">
                    <label>Success</label>
                    <input type="text" class="pa-input" value="Valid input">
                    <small class="pa-form-help">Looks good!</small>
                </div>
            </div>
            <div class="pa-col-100 pa-col-md-1-3">
                <div class="pa-form-group pa-form-group--warning">
                    <label>Warning</label>
                    <input type="text" class="pa-input" value="Warning input">
                    <small class="pa-form-help">Please check this field</small>
                </div>
            </div>
            <div class="pa-col-100 pa-col-md-1-3">
                <div class="pa-form-group pa-form-group--error">
                    <label>Error</label>
                    <input type="text" class="pa-input" value="Invalid input">
                    <small class="pa-form-help">This field is required</small>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Input Groups -->
<div class="pa-card">
    <div class="pa-card__header">
        <h3>Input Groups (Prepend/Append)</h3>
    </div>
    <div class="pa-card__body">
        <div class="pa-row">
            <!-- Prepend -->
            <div class="pa-col-100 pa-col-md-50">
                <div class="pa-form-group">
                    <label>With Prepend</label>
                    <div class="pa-input-group">
                        <span class="pa-input-group__prepend">@</span>
                        <input type="text" class="pa-input" placeholder="username">
                    </div>
                </div>
            </div>

            <!-- Append -->
            <div class="pa-col-100 pa-col-md-50">
                <div class="pa-form-group">
                    <label>With Append</label>
                    <div class="pa-input-group">
                        <input type="text" class="pa-input" placeholder="0.00">
                        <span class="pa-input-group__append">.00</span>
                    </div>
                </div>
            </div>

            <!-- Both -->
            <div class="pa-col-100 pa-col-md-50">
                <div class="pa-form-group">
                    <label>With Both</label>
                    <div class="pa-input-group">
                        <span class="pa-input-group__prepend">$</span>
                        <input type="text" class="pa-input" placeholder="0.00">
                        <span class="pa-input-group__append">.00</span>
                    </div>
                </div>
            </div>

            <!-- Button Append -->
            <div class="pa-col-100 pa-col-md-50">
                <div class="pa-form-group">
                    <label>With Button</label>
                    <div class="pa-input-group">
                        <input type="text" class="pa-input" placeholder="Search...">
                        <button class="pa-input-group__button pa-btn pa-btn--primary">Go</button>
                    </div>
                </div>
            </div>

            <!-- Multiple Prepends/Appends -->
            <div class="pa-col-100">
                <div class="pa-form-group">
                    <label>Multiple Prepends & Appends</label>
                    <div class="pa-input-group">
                        <span class="pa-input-group__prepend">https://</span>
                        <span class="pa-input-group__prepend">www.</span>
                        <input type="text" class="pa-input" placeholder="example">
                        <span class="pa-input-group__append">.com</span>
                        <span class="pa-input-group__append">🔗</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Input Types -->
<div class="pa-card">
    <div class="pa-card__header">
        <h3>Input Types</h3>
    </div>
    <div class="pa-card__body">
        <div class="pa-row">
            <div class="pa-col-100 pa-col-md-1-3">
                <div class="pa-form-group">
                    <label>Email</label>
                    <input type="email" class="pa-input" placeholder="user@example.com">
                </div>
            </div>
            <div class="pa-col-100 pa-col-md-1-3">
                <div class="pa-form-group">
                    <label>Password</label>
                    <input type="password" class="pa-input" placeholder="••••••••">
                </div>
            </div>
            <div class="pa-col-100 pa-col-md-1-3">
                <div class="pa-form-group">
                    <label>Number</label>
                    <input type="number" class="pa-input" placeholder="0">
                </div>
            </div>
            <div class="pa-col-100 pa-col-md-1-3">
                <div class="pa-form-group">
                    <label>Tel</label>
                    <input type="tel" class="pa-input" placeholder="+1 (555) 123-4567">
                </div>
            </div>
            <div class="pa-col-100 pa-col-md-1-3">
                <div class="pa-form-group">
                    <label>URL</label>
                    <input type="url" class="pa-input" placeholder="https://example.com">
                </div>
            </div>
            <div class="pa-col-100 pa-col-md-1-3">
                <div class="pa-form-group">
                    <label>Search</label>
                    <input type="search" class="pa-input" placeholder="Search...">
                </div>
            </div>
            <div class="pa-col-100 pa-col-md-1-3">
                <div class="pa-form-group">
                    <label>Date</label>
                    <input type="date" class="pa-input">
                </div>
            </div>
            <div class="pa-col-100 pa-col-md-1-3">
                <div class="pa-form-group">
                    <label>Time</label>
                    <input type="time" class="pa-input">
                </div>
            </div>
            <div class="pa-col-100 pa-col-md-1-3">
                <div class="pa-form-group">
                    <label>DateTime</label>
                    <input type="datetime-local" class="pa-input">
                </div>
            </div>
            <div class="pa-col-100 pa-col-md-1-3">
                <div class="pa-form-group">
                    <label>Month</label>
                    <input type="month" class="pa-input">
                </div>
            </div>
            <div class="pa-col-100 pa-col-md-1-3">
                <div class="pa-form-group">
                    <label>Week</label>
                    <input type="week" class="pa-input">
                </div>
            </div>
            <div class="pa-col-100 pa-col-md-1-3">
                <div class="pa-form-group">
                    <label>Color</label>
                    <input type="color" class="pa-input" value="#ff0000">
                </div>
            </div>
            <div class="pa-col-100 pa-col-md-1-3">
                <div class="pa-form-group">
                    <label>File</label>
                    <input type="file" class="pa-input">
                </div>
            </div>
            <div class="pa-col-100 pa-col-md-1-3">
                <div class="pa-form-group">
                    <label>Range</label>
                    <input type="range" class="pa-input" min="0" max="100" value="50">
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Selects -->
