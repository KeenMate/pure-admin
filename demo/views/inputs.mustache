<!-- Input Groups -->
<div class="pa-card">
    <div class="pa-card__header">
        <h3>Input Groups (Prepend/Append)</h3>
    </div>
    <div class="pa-card__body">
        <div class="pa-row">
            <!-- Prepend -->
            <div class="pa-col-100 pa-col-md-50">
                <div class="pa-form-group">
                    <label>With Prepend</label>
                    <div class="pa-input-group">
                        <span class="pa-input-group__prepend">@</span>
                        <input type="text" class="pa-input" placeholder="username">
                    </div>
                </div>
            </div>

            <!-- Append -->
            <div class="pa-col-100 pa-col-md-50">
                <div class="pa-form-group">
                    <label>With Append</label>
                    <div class="pa-input-group">
                        <input type="text" class="pa-input" placeholder="0.00">
                        <span class="pa-input-group__append">.00</span>
                    </div>
                </div>
            </div>

            <!-- Both -->
            <div class="pa-col-100 pa-col-md-50">
                <div class="pa-form-group">
                    <label>With Both (prepend uses <code>wr-3</code> for fixed width)</label>
                    <div class="pa-input-group">
                        <span class="pa-input-group__prepend wr-3">$</span>
                        <input type="text" class="pa-input" placeholder="0.00">
                        <span class="pa-input-group__append">.00</span>
                    </div>
                </div>
            </div>

            <!-- Button Append -->
            <div class="pa-col-100 pa-col-md-50">
                <div class="pa-form-group">
                    <label>With Button</label>
                    <div class="pa-input-group">
                        <input type="text" class="pa-input" placeholder="Search...">
                        <button class="pa-input-group__button pa-btn pa-btn--primary">Go</button>
                    </div>
                </div>
            </div>

            <!-- Toggle Mode Button Prepend + Append -->
            <div class="pa-col-100 pa-col-md-50">
                <div class="pa-form-group">
                    <label>Toggle Mode Button (Filter / Search) + Go</label>
                    <div class="pa-input-group">
                        <button class="pa-input-group__button pa-btn pa-btn--primary" id="mode-toggle-btn" title="Filter mode — click to switch to Search" onclick="toggleInputMode()">
                            <i class="fa-solid fa-filter" id="mode-toggle-icon"></i>
                        </button>
                        <input type="text" class="pa-input" placeholder="Filter..." id="mode-toggle-input">
                        <button class="pa-input-group__button pa-btn pa-btn--primary">Go</button>
                    </div>
                    <small class="pa-form-help">Click the icon button to switch between Filter and Search modes</small>
                </div>
            </div>

            <script>
                function toggleInputMode() {
                    var btn = document.getElementById('mode-toggle-btn');
                    var icon = document.getElementById('mode-toggle-icon');
                    var input = document.getElementById('mode-toggle-input');
                    var isFilter = icon.classList.contains('fa-filter');

                    if (isFilter) {
                        icon.classList.remove('fa-filter');
                        icon.classList.add('fa-magnifying-glass');
                        input.placeholder = 'Search...';
                        btn.title = 'Search mode — click to switch to Filter';
                    } else {
                        icon.classList.remove('fa-magnifying-glass');
                        icon.classList.add('fa-filter');
                        input.placeholder = 'Filter...';
                        btn.title = 'Filter mode — click to switch to Search';
                    }
                }
            </script>

            <!-- Multiple Prepends/Appends -->
            <div class="pa-col-100">
                <div class="pa-form-group">
                    <label>Multiple Prepends & Appends</label>
                    <div class="pa-input-group">
                        <span class="pa-input-group__prepend">https://</span>
                        <span class="pa-input-group__prepend">www.</span>
                        <input type="text" class="pa-input" placeholder="example">
                        <span class="pa-input-group__append">.com</span>
                        <span class="pa-input-group__append">🔗</span>
                    </div>
                </div>
            </div>

            <!-- Tip -->
            <div class="pa-col-100 mt-3">
                <small class="text-muted"><strong>Tip:</strong> Use width utilities (<code>wr-*</code> for rem-based, <code>wp-*</code> for percentage-based) on prepend/append elements to control their width. See <a href="/css-helpers">CSS Helpers</a> for all available width classes.</small>
            </div>
        </div>
    </div>
</div>

