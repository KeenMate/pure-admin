            <label>50% Width</label>
            <input type="text" class="pa-input" placeholder="50%" style="width: 50%;">
        </div>
        <div class="pa-form-group">
            <label>75% Width</label>
            <input type="text" class="pa-input" placeholder="75%" style="width: 75%;">
        </div>
        <div class="pa-form-group">
            <label>100% Width (full width)</label>
            <input type="text" class="pa-input" placeholder="100%">
        </div>
    </div>
</div>
