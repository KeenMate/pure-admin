<!-- Checkboxes & Radios -->
<div class="pa-card">
    <div class="pa-card__header">
        <h3>Checkboxes & Radios</h3>
    </div>
    <div class="pa-card__body">
        <div class="pa-row">
            <!-- Checkboxes -->
            <div class="pa-col-100 pa-col-md-50">
                <div class="pa-form-group">
                    <label>Checkboxes</label>
                    <div class="pa-checkbox-group">
                        <label class="pa-checkbox">
                            <input type="checkbox" checked>
                            <span class="pa-checkbox__box"></span>
                            <span class="pa-checkbox__label">Option 1 (checked)</span>
                        </label>
                        <label class="pa-checkbox">
                            <input type="checkbox">
                            <span class="pa-checkbox__box"></span>
                            <span class="pa-checkbox__label">Option 2</span>
                        </label>
                        <label class="pa-checkbox">
                            <input type="checkbox" disabled>
                            <span class="pa-checkbox__box"></span>
                            <span class="pa-checkbox__label">Option 3 (disabled)</span>
                        </label>
                    </div>
                </div>
            </div>

            <!-- Radios -->
            <div class="pa-col-100 pa-col-md-50">
                <div class="pa-form-group">
                    <label>Radio Buttons</label>
                    <div class="pa-radio-group">
                        <label class="pa-radio">
                            <input type="radio" name="radio-demo" checked>
                            <span class="pa-radio__label">Option A (selected)</span>
                        </label>
                        <label class="pa-radio">
                            <input type="radio" name="radio-demo">
                            <span class="pa-radio__label">Option B</span>
                        </label>
                        <label class="pa-radio">
                            <input type="radio" name="radio-demo" disabled>
                            <span class="pa-radio__label">Option C (disabled)</span>
                        </label>
                    </div>
                </div>
            </div>

            <!-- Checkbox Sizes -->
            <div class="pa-col-100">
                <div class="pa-form-group">
                    <label>Checkbox Sizes</label>
                    <div class="pa-checkbox-group">
                        <label class="pa-checkbox pa-checkbox--xs">
                            <input type="checkbox" checked>
                            <span class="pa-checkbox__box"></span>
                            <span class="pa-checkbox__label">Extra Small</span>
                        </label>
                        <label class="pa-checkbox pa-checkbox--sm">
                            <input type="checkbox" checked>
                            <span class="pa-checkbox__box"></span>
                            <span class="pa-checkbox__label">Small</span>
                        </label>
                        <label class="pa-checkbox">
                            <input type="checkbox" checked>
                            <span class="pa-checkbox__box"></span>
                            <span class="pa-checkbox__label">Default</span>
                        </label>
                        <label class="pa-checkbox pa-checkbox--lg">
                            <input type="checkbox" checked>
                            <span class="pa-checkbox__box"></span>
                            <span class="pa-checkbox__label">Large</span>
                        </label>
                        <label class="pa-checkbox pa-checkbox--xl">
                            <input type="checkbox" checked>
                            <span class="pa-checkbox__box"></span>
                            <span class="pa-checkbox__label">Extra Large</span>
                        </label>
                    </div>
                </div>
            </div>

            <!-- Radio Sizes -->
            <div class="pa-col-100">
                <div class="pa-form-group">
                    <label>Radio Sizes</label>
                    <div class="pa-radio-group">
                        <label class="pa-radio pa-radio--xs">
                            <input type="radio" name="size-demo" checked>
                            <span class="pa-radio__label">Extra Small</span>
                        </label>
                        <label class="pa-radio pa-radio--sm">
                            <input type="radio" name="size-demo">
                            <span class="pa-radio__label">Small</span>
                        </label>
                        <label class="pa-radio">
                            <input type="radio" name="size-demo">
                            <span class="pa-radio__label">Default</span>
                        </label>
                        <label class="pa-radio pa-radio--lg">
                            <input type="radio" name="size-demo">
                            <span class="pa-radio__label">Large</span>
                        </label>
                        <label class="pa-radio pa-radio--xl">
                            <input type="radio" name="size-demo">
                            <span class="pa-radio__label">Extra Large</span>
                        </label>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Width Classes -->
