<script>
document.addEventListener('DOMContentLoaded', function() {
    // ---- View-mode toggle (per-terminal) ----
    // Each .kpi-terminal is independent — clicking VALUE / Δ% / TREND in one
    // section swaps only that section's tiles.
    document.querySelectorAll('.kpi-terminal').forEach(function(terminal) {
        const buttons = terminal.querySelectorAll('.kpi-terminal__viewbtn');
        buttons.forEach(btn => {
            btn.addEventListener('click', () => {
                const view = btn.dataset.view;
                terminal.setAttribute('data-view', view);
                buttons.forEach(b => {
                    const active = b === btn;
                    b.classList.toggle('is-active', active);
                    b.setAttribute('aria-selected', active ? 'true' : 'false');
                });
            });
        });
    });

    // ---- Hover detail popover (Floating UI anchored to cursor) ----
    // Each tile's .kpi-tile__detail is moved to <body> (escapes ancestor
    // overflow:hidden / transforms). On mouseenter we capture the cursor
    // position; on mousemove we update it and recompute the popover position
    // via a virtual reference element. Floating UI's flip + shift middleware
    // keep it on-screen (e.g. flips below if there's no headroom above).
    if (window.FloatingUIDOM) {
        const { computePosition, flip, shift, offset } = window.FloatingUIDOM;

        document.querySelectorAll('.kpi-tile').forEach(tile => {
            const detail = tile.querySelector('.kpi-tile__detail');
            if (!detail) return;
            document.body.appendChild(detail);

            let cursorX = 0, cursorY = 0;
            const virtualEl = {
                getBoundingClientRect() {
                    return {
                        width: 0, height: 0,
                        x: cursorX, y: cursorY,
                        top: cursorY, left: cursorX,
                        right: cursorX, bottom: cursorY
                    };
                }
            };

            const reposition = () => {
                computePosition(virtualEl, detail, {
                    strategy: 'fixed',
                    placement: 'top-start',
                    middleware: [offset(14), flip(), shift({ padding: 8 })]
                }).then(({ x, y }) => {
                    Object.assign(detail.style, { left: `${x}px`, top: `${y}px` });
                });
            };

            tile.addEventListener('mouseenter', (e) => {
                cursorX = e.clientX;
                cursorY = e.clientY;
                detail.setAttribute('data-show', '');
                reposition();
            });
            tile.addEventListener('mousemove', (e) => {
                cursorX = e.clientX;
                cursorY = e.clientY;
                reposition();
            });
            tile.addEventListener('mouseleave', () => {
                detail.removeAttribute('data-show');
            });
        });
    }
});
</script>
