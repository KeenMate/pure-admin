<p>Bloomberg-y "terminal grid" KPI panel — mono numbers, status tags, sparklines, ▲▼ deltas. Three view modes (Value / Δ% / Trend) swap the focal number per tile. Hover any tile for the detail breakdown.</p>

<!-- ============================================================
     1. Terminal grid · dense KPI panel
     ============================================================ -->

<style>
/* === KPI design tokens (shared across all KPI indicators) ===
   Defined on :root so the .kpi-tile__detail popovers — which JS moves to <body>
   to escape ancestor overflow:hidden — can still resolve them via inheritance.
   A host app can override any of these on :root, body, or per-component to
   retune semantics (e.g. --kpi-positive: orange for an air-quality surface,
   --kpi-detail-bg: light for a non-Bloomberg integration). */
:root {
  /* Semantic 5-step scale: very-positive → positive → neutral → negative → very-negative.
     Use --positive/--negative for ordinary deltas, --very-X for outliers (big jumps,
     spikes, breakouts) where you want extra emphasis, --neutral for "no meaningful
     change". Default greens/reds are Tailwind 500/600 + gray-400. */
  --kpi-very-positive: #16a34a;   /* deep saturated green — strong gain */
  --kpi-positive:      #22c55e;   /* gain */
  --kpi-neutral:       #9ca3af;   /* flat / no change */
  --kpi-negative:      #ef4444;   /* loss */
  --kpi-very-negative: #dc2626;   /* deep saturated red — strong loss */

  /* Hover detail popover chrome — intentionally dark by default for the
     Bloomberg/terminal aesthetic, regardless of host theme. Override these to
     adopt theme-aware popovers. */
  --kpi-detail-bg: rgba(15, 17, 21, 0.97);
  --kpi-detail-text: #ffffff;
  --kpi-detail-row-label: rgba(255, 255, 255, 0.75);
  --kpi-detail-title: rgba(255, 255, 255, 0.55);
  --kpi-detail-shadow: 0 1.4rem 3.6rem rgba(0, 0, 0, 0.55);
}

.kpi-terminal {
  /* dark, dense look — relies on theme vars so it tracks light/dark + variant */
}

/* === Header: title + segmented view toggle + LIVE pulse === */
.kpi-terminal__header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 1.6rem;
  flex-wrap: wrap;
}
.kpi-terminal__controls {
  display: inline-flex;
  align-items: center;
  gap: 1.6rem;
}
.kpi-terminal__viewtoggle {
  display: inline-flex;
  border: 1px solid var(--pa-border-color);
  border-radius: 0.4rem;
  overflow: hidden;
}
.kpi-terminal__viewbtn {
  background: transparent;
  border: 0;
  color: var(--pa-text-color-2);
  padding: 0.4rem 1.1rem;
  font-family: var(--base-font-family-mono);
  font-size: 1.1rem;
  font-weight: 600;
  letter-spacing: 0.06em;
  cursor: pointer;
  transition: background-color 0.1s ease-out, color 0.1s ease-out;
}
.kpi-terminal__viewbtn:hover {
  color: var(--pa-text-color-1);
}
.kpi-terminal__viewbtn.is-active {
  background: var(--pa-text-color-1);
  color: var(--pa-card-bg);
}
.kpi-terminal__live {
  display: inline-flex;
  align-items: center;
  gap: 0.6rem;
  font-family: var(--base-font-family-mono);
  font-size: 1.1rem;
  font-weight: 600;
  letter-spacing: 0.06em;
  color: var(--pa-text-color-2);
}
.kpi-terminal__livedot {
  width: 0.8rem;
  height: 0.8rem;
  border-radius: 50%;
  background: var(--kpi-positive);
  box-shadow: 0 0 6px var(--kpi-positive);
  animation: kpiPulse 1.6s ease-in-out infinite;
}
@keyframes kpiPulse { 50% { opacity: 0.35; } }

/* === Grid + tile borders === */
.kpi-terminal__body {
  padding: 0;
}
.kpi-terminal__grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
}
.kpi-tile {
  position: relative;
  padding: 1.4rem 1.8rem 1.6rem;
  min-height: 16rem;
  display: flex;
  flex-direction: column;
}
/* Inside a dense terminal grid: cells are separated by 1px hairlines (no gap). */
.kpi-terminal__grid .kpi-tile {
  border-bottom: 1px solid var(--pa-border-color);
  border-right: 1px solid var(--pa-border-color);
}
.kpi-terminal__grid--2col .kpi-tile:nth-child(2n)         { border-right: 0; }
.kpi-terminal__grid--2col .kpi-tile:nth-last-child(-n+2)  { border-bottom: 0; }

/* Standalone modifier: tile lives directly inside a .pa-col-* (no neighbour cells)
   — so it gets a full border and the card background so it doesn't look orphaned. */
.kpi-tile--standalone {
  background: var(--pa-card-bg);
  border: 1px solid var(--pa-border-color);
  margin-bottom: 1.2rem;
}
.kpi-tile--standalone:last-child { margin-bottom: 0; }

/* Header strip used outside a card chrome (page-grid layout tests). */
.kpi-terminal__sectionhead {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 1.6rem;
  margin-bottom: 1.2rem;
}

/* === Tile head: ID · period + status pill ===
   Color hierarchy: only the number value is full --pa-text-color-1 (white).
   Everything else steps down via color-mix(white, alpha) so the focal value
   reads as "the data" and the surrounding text is supporting metadata. Same
   pattern works in light themes (light text on dark background inverts at the
   theme level via --pa-text-color-1). */
.kpi-tile__head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-family: var(--base-font-family-mono);
  font-size: 1.3rem;
  letter-spacing: 0.04em;
  margin-bottom: 0.3rem;
}
.kpi-tile__id {
  color: color-mix(in srgb, var(--pa-text-color-1) 42%, transparent);
  font-weight: 600;
}
.kpi-tile__status {
  font-family: var(--base-font-family-mono);
  font-size: 1.2rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  padding: 0.3rem 0.9rem;
  line-height: 1.3;
}
.kpi-tile__status--warn {
  background: var(--pa-warning-bg);
  color: var(--pa-btn-warning-text);
}
.kpi-tile__status--good {
  /* text-only — design intent: GOOD is "default", no chrome */
  background: transparent;
  color: var(--pa-text-color-1);
  padding: 0.2rem 0;
}
.kpi-tile__status--neutral {
  background: color-mix(in srgb, var(--pa-text-color-2) 25%, transparent);
  color: var(--pa-text-color-1);
}

/* === Label === */
.kpi-tile__label {
  font-family: var(--base-font-family-mono);
  font-size: 1.4rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: color-mix(in srgb, var(--pa-text-color-1) 72%, transparent);
  margin-bottom: 0.8rem;
}

/* === Big value + 3-mode swap === */
.kpi-tile__values {
  margin-bottom: 0.4rem;
}
.kpi-tile__value {
  display: none;
  align-items: baseline;
  gap: 0.3rem;
  font-family: var(--base-font-family-mono);
  line-height: 1;
}
.kpi-terminal[data-view="value"] .kpi-tile__value[data-mode="value"],
.kpi-terminal[data-view="delta"] .kpi-tile__value[data-mode="delta"],
.kpi-terminal[data-view="trend"] .kpi-tile__value[data-mode="trend"] {
  display: inline-flex;
}
.kpi-tile__num {
  font-size: 3.8rem;
  font-weight: 700;
  letter-spacing: -0.02em;
  color: var(--pa-text-color-1);
}
.kpi-tile__unit {
  font-size: 1.6rem;
  font-weight: 500;
  color: color-mix(in srgb, var(--pa-text-color-1) 55%, transparent);
}
.kpi-tile__value--very-positive .kpi-tile__num { color: var(--kpi-very-positive); }
.kpi-tile__value--positive      .kpi-tile__num { color: var(--kpi-positive); }
.kpi-tile__value--neutral       .kpi-tile__num { color: var(--kpi-neutral); }
.kpi-tile__value--negative      .kpi-tile__num { color: var(--kpi-negative); }
.kpi-tile__value--very-negative .kpi-tile__num { color: var(--kpi-very-negative); }

/* === prev / delta row === */
.kpi-tile__prev {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-family: var(--base-font-family-mono);
  font-size: 1.3rem;
  margin-top: auto;          /* push to bottom of flex column */
  margin-bottom: 0.4rem;
  color: color-mix(in srgb, var(--pa-text-color-1) 42%, transparent);
}
.kpi-tile__delta--very-positive { color: var(--kpi-very-positive); }
.kpi-tile__delta--positive      { color: var(--kpi-positive); }
.kpi-tile__delta--neutral       { color: var(--kpi-neutral); }
.kpi-tile__delta--negative      { color: var(--kpi-negative); }
.kpi-tile__delta--very-negative { color: var(--kpi-very-negative); }

/* === Sparkline === */
.kpi-tile__spark {
  display: block;
  width: 100%;
  height: 2.6rem;
  overflow: visible;
}
.kpi-tile__spark polyline {
  fill: none;
  stroke: currentColor;
  stroke-width: 1.4;
  stroke-linecap: round;
  stroke-linejoin: round;
}
.kpi-tile__spark circle { fill: currentColor; }
/* Sparkline class names use up/down wording but resolve to sentiment colors —
   green for "the change is good", red for "the change is bad", regardless of
   whether the line shape itself rises or falls. For inverse-good metrics
   (error rate, server temp, churn) the line direction and sentiment diverge:
   error rate dropping shows a downward line but is good → use --up. Server
   temp climbing shows an upward line but is bad → use --down. Pick the
   class that matches the *sentiment of the change*, not the line shape. */
.kpi-tile--up-strong   .kpi-tile__spark { color: var(--kpi-very-positive); }
.kpi-tile--up          .kpi-tile__spark { color: var(--kpi-positive); }
.kpi-tile--flat        .kpi-tile__spark { color: var(--kpi-neutral); }
.kpi-tile--down        .kpi-tile__spark { color: var(--kpi-negative); }
.kpi-tile--down-strong .kpi-tile__spark { color: var(--kpi-very-negative); }

/* === Hover detail popover ===
   Positioned with Floating UI anchored to a *virtual element* at the cursor
   position (updated on mousemove), so it follows where you point instead of
   sitting in a fixed spot relative to the tile. position: fixed because the
   virtual element's coordinates are viewport-relative (clientX/clientY).
   Appended to <body> on init so ancestor overflow:hidden doesn't clip it.
   pointer-events:none so the cursor passes through and tile mouseleave fires
   reliably. */
.kpi-tile__detail {
  position: fixed;
  top: 0;
  left: 0;
  visibility: hidden;
  pointer-events: none;
  z-index: 9000;
  min-width: 26rem;
  max-width: 32rem;
  background: var(--kpi-detail-bg);
  color: var(--kpi-detail-text);
  padding: 1.2rem 1.5rem;
  font-family: var(--base-font-family-mono);
  font-size: 1.25rem;
  line-height: 1.5;
  border-radius: 0.4rem;
  box-shadow: var(--kpi-detail-shadow);
}
.kpi-tile__detail[data-show] {
  visibility: visible;
}
.kpi-tile__detail-title {
  text-transform: uppercase;
  letter-spacing: 0.08em;
  font-size: 1.05rem;
  font-weight: 700;
  color: var(--kpi-detail-title);
  margin-bottom: 0.6rem;
}
.kpi-tile__detail dl {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 0.35rem 1.6rem;
  margin: 0;
}
.kpi-tile__detail dt {
  margin: 0;
  color: var(--kpi-detail-row-label);
  font-weight: 400;
}
.kpi-tile__detail dd {
  margin: 0;
  text-align: end;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}
.kpi-tile__detail .pos { color: var(--kpi-positive); }
.kpi-tile__detail .neg { color: var(--kpi-negative); }

/* === Footer caption === */
.kpi-terminal__footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 1rem;
  font-family: var(--base-font-family-mono);
  font-size: 1.1rem;
  color: var(--pa-text-color-3);
}
.kpi-terminal__footer strong {
  color: var(--pa-text-color-1);
  font-weight: 700;
}
</style>

