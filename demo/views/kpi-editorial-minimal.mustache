<!-- CSS Classes Reference -->
<div class="pa-card">
    <div class="pa-card__header">
        <h3>CSS Classes Reference</h3>
    </div>
    <div class="pa-card__body">
        <h4>Card structure</h4>
        <ul class="pa-list-basic pa-list-basic--compact">
            <li><code>kpi-edit</code> — page-namespace class on <code>.pa-card</code>. Optional anchor for theme-scoped overrides.</li>
            <li><code>kpi-edit__header</code> — flex header with title + LIVE indicator.</li>
            <li><code>kpi-edit__live</code> — LIVE pill (mono caps + animated dot).</li>
            <li><code>kpi-edit__livedot</code> — pulsing dot inside the LIVE pill.</li>
            <li><code>kpi-edit__body</code> — applies <code>padding: 0</code> to <code>.pa-card__body</code> so dividers go edge-to-edge.</li>
            <li><code>kpi-edit__footer</code> — flex footer caption + "Hover any KPI for detail" hint.</li>
        </ul>

        <h4 class="mt-4">Grid + tiles</h4>
        <ul class="pa-list-basic pa-list-basic--compact">
            <li><code>kpi-edit__grid</code> — grid container (<code>display: grid</code>, default <code>repeat(3, 1fr)</code>, <code>gap: 1px</code> over <code>--pa-border-color</code> background).</li>
            <li><code>kpi-edit__grid--2col</code> — modifier forcing <code>grid-template-columns: repeat(2, 1fr)</code> regardless of card width.</li>
            <li><code>kpi-edit__tile</code> — single KPI cell (<code>2.4rem 2rem</code> padding, <code>--pa-card-bg</code> over the grid background).</li>
        </ul>

        <h4 class="mt-4">Tile content</h4>
        <ul class="pa-list-basic pa-list-basic--compact">
            <li><code>kpi-edit__label</code> — uppercase mono caption (50% contrast, allowed to wrap).</li>
            <li><code>kpi-edit__value</code> — headline number row (body sans, <code>font-weight: 200</code>, <code>clamp(3.2rem, 18cqi, 5.6rem)</code>).</li>
            <li><code>kpi-edit__num</code> — numeric span inside <code>__value</code> (tabular nums).</li>
            <li><code>kpi-edit__unit</code> — currency / percent / unit span (40% size, dim).</li>
            <li><code>kpi-edit__meta</code> — flex row carrying delta + target.</li>
            <li><code>kpi-edit__delta</code> — coloured delta number.</li>
            <li><code>kpi-edit__target</code> — dim "tgt {value}" pair; <code>em</code> inside is the literal "tgt" prefix.</li>
        </ul>

        <h4 class="mt-4">Delta sentiment modifiers</h4>
        <ul class="pa-list-basic pa-list-basic--compact">
            <li><code>kpi-edit__delta--positive</code> — ordinary positive movement.</li>
            <li><code>kpi-edit__delta--negative</code> — ordinary negative movement.</li>
            <li><code>kpi-edit__delta--neutral</code> — no meaningful change (<code>±0.0</code>).</li>
            <li><code>kpi-edit__delta--up-strong</code> — outlier positive (deeper green).</li>
            <li><code>kpi-edit__delta--down-strong</code> — outlier negative (deeper red).</li>
        </ul>

        <h4 class="mt-4">Hover detail popover</h4>
        <ul class="pa-list-basic pa-list-basic--compact">
            <li><code>kpi-edit-detail</code> — popover root (moved to <code>&lt;body&gt;</code> on init; <code>position: fixed</code>, hidden until <code>data-show</code>).</li>
            <li><code>kpi-edit-detail-title</code> — uppercase mono header inside the popover.</li>
            <li><code>kpi-edit-detail .pos / .neg / .warn</code> — sentiment-coloured <code>&lt;dd&gt;</code> text inside the detail's <code>&lt;dl&gt;</code>.</li>
        </ul>

        <h4 class="mt-4">Framework tokens used by this showcase</h4>
        <ul class="pa-list-basic pa-list-basic--compact">
            <li><code>--pa-very-positive</code> / <code>--pa-positive</code> — green sentiment scale.</li>
            <li><code>--pa-neutral</code> — grey for "no meaningful change".</li>
            <li><code>--pa-negative</code> / <code>--pa-very-negative</code> — red sentiment scale.</li>
            <li><code>--pa-warning</code> — orange "off-target / approaching limit" signal.</li>
            <li><code>--pa-detail-bg</code> / <code>--pa-detail-text</code> / <code>--pa-detail-row-label</code> / <code>--pa-detail-title</code> / <code>--pa-detail-shadow</code> — popover chrome (Bloomberg-dark by default; override for theme-aware popovers).</li>
        </ul>
    </div>
</div>

<script>
// Cursor-anchored hover detail popovers — same recipe as the other KPI showcases.
document.addEventListener('DOMContentLoaded', function() {
    if (!window.FloatingUIDOM) return;
    const { computePosition, flip, shift, offset } = window.FloatingUIDOM;

    document.querySelectorAll('.kpi-edit__tile').forEach(host => {
        const detail = host.querySelector('.kpi-edit-detail');
        if (!detail) return;
        document.body.appendChild(detail);

        let cursorX = 0, cursorY = 0;
        const virtualEl = {
            getBoundingClientRect() {
                return {
                    width: 0, height: 0,
                    x: cursorX, y: cursorY,
                    top: cursorY, left: cursorX,
                    right: cursorX, bottom: cursorY
                };
            }
        };

        const reposition = () => {
            computePosition(virtualEl, detail, {
                strategy: 'fixed',
                placement: 'top-start',
                middleware: [offset(14), flip(), shift({ padding: 8 })]
            }).then(({ x, y }) => {
                Object.assign(detail.style, { left: `${x}px`, top: `${y}px` });
            });
        };

        host.addEventListener('mouseenter', (e) => {
            cursorX = e.clientX;
            cursorY = e.clientY;
            detail.setAttribute('data-show', '');
            reposition();
        });
        host.addEventListener('mousemove', (e) => {
            cursorX = e.clientX;
            cursorY = e.clientY;
            reposition();
        });
        host.addEventListener('mouseleave', () => {
            detail.removeAttribute('data-show');
        });
    });
});
</script>
