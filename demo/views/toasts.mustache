        <ul class="pa-list-basic pa-list-basic--compact">
            <li><code>pa-toast--primary</code> - Primary/accent color</li>
            <li><code>pa-toast--success</code> - Success (green)</li>
            <li><code>pa-toast--danger</code> - Danger/error (red)</li>
            <li><code>pa-toast--warning</code> - Warning (yellow/orange)</li>
            <li><code>pa-toast--info</code> - Information (blue)</li>
        </ul>
    </div>
</div>

<script>
// Toast message defaults
const toastMessages = {
    primary: 'This is a primary toast notification.',
    success: 'Your action was completed successfully.',
    danger: 'An error occurred. Please try again.',
    warning: 'Please review this warning message.',
    info: 'Here is some useful information for you.'
};

// Demo functions using PureAdmin.toast API
function showToast(position, variant) {
    PureAdmin.toast.show({
        variant: variant,
        message: toastMessages[variant],
        position: position
    });
}

function showToastVariant(variant) {
    PureAdmin.toast[variant](toastMessages[variant]);
}

function showProgressToast() {
    PureAdmin.toast.primary('Your request is being processed...', {
        title: 'Processing',
        showProgress: true
    });
}

function showActionToast(message, variant) {
    PureAdmin.toast[variant === 'danger' ? 'error' : variant](message);
}

function showMultipleToasts() {
    PureAdmin.toast.success('This is the first notification', { title: 'First Toast' });
    setTimeout(() => {
        PureAdmin.toast.warning('This is the second notification', { title: 'Second Toast' });
    }, 300);
    setTimeout(() => {
        PureAdmin.toast.info('This is the third notification', { title: 'Third Toast' });
    }, 600);
}

function showPersistentToast(variant) {
    const persistentMessages = {
        warning: 'This is an important warning that requires your attention. Click the close button to dismiss.',
        danger: 'Critical error detected! This message will remain until you acknowledge it.',
        info: 'Important information that you should read carefully before dismissing.'
    };

    PureAdmin.toast.show({
        variant: variant,
        message: persistentMessages[variant],
        persistent: true
    });
}
</script>
