<!-- CSS Classes Reference -->
<div class="pa-card">
    <div class="pa-card__header">
        <div class="pa-card__title">
            <h3 class="pa-card__title-text">CSS Classes Reference</h3>
        </div>
    </div>
    <div class="pa-card__body">
        <h4>Toast Container</h4>
        <ul class="pa-list-basic pa-list-basic--compact">
            <li><code>pa-toast-container</code> - Fixed container for toasts</li>
            <li><code>pa-toast-container--top-end</code> - Top end position (right in LTR, left in RTL)</li>
            <li><code>pa-toast-container--top-start</code> - Top start position (left in LTR, right in RTL)</li>
            <li><code>pa-toast-container--top-center</code> - Top center position</li>
            <li><code>pa-toast-container--bottom-end</code> - Bottom end position (right in LTR, left in RTL)</li>
            <li><code>pa-toast-container--bottom-start</code> - Bottom start position (left in LTR, right in RTL)</li>
            <li><code>pa-toast-container--bottom-center</code> - Bottom center position</li>
        </ul>

        <h4 class="mt-4">Toast Item</h4>
        <ul class="pa-list-basic pa-list-basic--compact">
            <li><code>pa-toast</code> - Base toast element</li>
            <li><code>pa-toast--show</code> - Visible/animating in</li>
            <li><code>pa-toast--hide</code> - Animating out</li>
            <li><code>pa-toast__icon</code> - Icon container</li>
            <li><code>pa-toast__content</code> - Content wrapper</li>
            <li><code>pa-toast__title</code> - Toast title</li>
            <li><code>pa-toast__message</code> - Toast message text</li>
            <li><code>pa-toast__close</code> - Close/dismiss button</li>
            <li><code>pa-toast__progress</code> - Auto-dismiss progress bar</li>
        </ul>

        <h4 class="mt-4">Toast Variants</h4>
        <ul class="pa-list-basic pa-list-basic--compact">
            <li><code>pa-toast--primary</code> - Primary/accent color</li>
            <li><code>pa-toast--success</code> - Success (green)</li>
            <li><code>pa-toast--danger</code> - Danger/error (red)</li>
            <li><code>pa-toast--warning</code> - Warning (yellow/orange)</li>
            <li><code>pa-toast--info</code> - Information (blue)</li>
            <li><code>pa-toast--color-{1-9}</code> - Theme color slots</li>
            <li><code>pa-toast--filled-primary</code> - Filled primary</li>
            <li><code>pa-toast--filled-success</code> - Filled success</li>
            <li><code>pa-toast--filled-danger</code> - Filled danger</li>
            <li><code>pa-toast--filled-warning</code> - Filled warning</li>
            <li><code>pa-toast--filled-info</code> - Filled info</li>
            <li><code>pa-toast--filled-color-{1-9}</code> - Filled theme color slots</li>
        </ul>
    </div>
</div>

<script>
// Toast message defaults
const toastMessages = {
    primary: 'This is a primary toast notification.',
    success: 'Your action was completed successfully.',
    danger: 'An error occurred. Please try again.',
    warning: 'Please review this warning message.',
    info: 'Here is some useful information for you.'
};

// Demo functions using pureAdmin.toast API
function showToast(position, variant) {
    pureAdmin.toast.show({
        variant: variant,
        message: toastMessages[variant],
        position: position
    });
}

function showToastVariant(variant) {
    pureAdmin.toast[variant](toastMessages[variant]);
}

function showProgressToast(variant, opts = {}) {
    pureAdmin.toast.show({
        variant,
        title: 'Processing',
        message: 'Your request is being processed...',
        showProgress: true,
        ...opts
    });
}

function showUndoToast() {
    pureAdmin.toast.show({
        variant: 'warning',
        title: 'Item Deleted',
        message: '3 items have been moved to trash.',
        persistent: true,
        actions: [
            { label: 'Undo', variant: 'warning', onClick: () => console.log('Undo clicked') },
            { label: 'Dismiss', variant: 'secondary' }
        ]
    });
}

function showRetryToast() {
    pureAdmin.toast.show({
        variant: 'danger',
        title: 'Upload Failed',
        message: 'Could not upload report.pdf — connection timed out.',
        persistent: true,
        actions: [
            { label: 'Retry', variant: 'danger', onClick: () => console.log('Retry clicked') },
            { label: 'Cancel', variant: 'secondary' }
        ]
    });
}

function showUpdateToast() {
    pureAdmin.toast.show({
        variant: 'info',
        title: 'Update Available',
        message: 'Version 2.3.0 is ready to install.',
        persistent: true,
        actions: [
            { label: 'Update Now', variant: 'primary', onClick: () => console.log('Update clicked') },
            { label: 'Later', variant: 'secondary' }
        ]
    });
}

function showFeedbackToast() {
    pureAdmin.toast.show({
        variant: 'success',
        filled: true,
        title: 'Changes Saved',
        message: 'Your settings have been updated successfully.',
        actions: [
            { label: 'View Changes', variant: 'primary', onClick: () => console.log('View clicked') }
        ]
    });
}

function showMultipleToasts() {
    pureAdmin.toast.success('This is the first notification', { title: 'First Toast' });
    setTimeout(() => {
        pureAdmin.toast.warning('This is the second notification', { title: 'Second Toast' });
    }, 300);
    setTimeout(() => {
        pureAdmin.toast.info('This is the third notification', { title: 'Third Toast' });
    }, 600);
}

function showFilledToast(variant) {
    pureAdmin.toast.show({
        variant,
        filled: true,
        title: 'Filled ' + variant.charAt(0).toUpperCase() + variant.slice(1),
        message: toastMessages[variant]
    });
}

function showThemeColorToast(n) {
    pureAdmin.toast.show({
        variant: 'color-' + n,
        title: 'Color ' + n,
        message: 'This is a theme color slot ' + n + ' toast notification.'
    });
}

function showFilledThemeColorToast(n) {
    pureAdmin.toast.show({
        variant: 'color-' + n,
        filled: true,
        title: 'Filled Color ' + n,
        message: 'This is a filled theme color slot ' + n + ' toast notification.'
    });
}

function showPersistentToast(variant) {
    const persistentMessages = {
        warning: 'This is an important warning that requires your attention. Click the close button to dismiss.',
        danger: 'Critical error detected! This message will remain until you acknowledge it.',
        info: 'Important information that you should read carefully before dismissing.'
    };

    pureAdmin.toast.show({
        variant: variant,
        message: persistentMessages[variant],
        persistent: true
    });
}
</script>
