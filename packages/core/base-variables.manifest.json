{
  "$schema": "./schemas/component-variables.schema.json",
  "component": "@keenmate/pure-admin-core",
  "version": "1.0.0",
  "description": "Pure Admin CSS framework - lightweight admin template",
  "categories": [
    "accent",
    "text",
    "surface",
    "border",
    "input",
    "dropdown",
    "tooltip",
    "typography",
    "contextual",
    "interactive"
  ],
  "variables": [
    { "name": "base-accent-color", "required": true, "usage": "Primary buttons, links, focus states" },
    { "name": "base-accent-color-hover", "required": true, "usage": "Hover states for accent elements" },
    { "name": "base-accent-color-active", "required": false, "usage": "Active/pressed states" },
    { "name": "base-accent-color-light", "required": true, "usage": "Light accent backgrounds" },
    { "name": "base-accent-color-light-hover", "required": false, "usage": "Hover on light accent backgrounds" },

    { "name": "base-text-color-1", "required": true, "usage": "Primary text, headings" },
    { "name": "base-text-color-2", "required": true, "usage": "Secondary text, labels" },
    { "name": "base-text-color-3", "required": false, "usage": "Tertiary text, hints" },
    { "name": "base-text-color-4", "required": false, "usage": "Disabled text, placeholders" },
    { "name": "base-text-color-on-accent", "required": true, "usage": "Text on accent backgrounds" },

    { "name": "base-surface-1", "required": true, "usage": "Cards, modals, main content" },
    { "name": "base-surface-2", "required": true, "usage": "Page background, subtle sections" },
    { "name": "base-surface-3", "required": false, "usage": "Dividers, borders" },
    { "name": "base-surface-inverse", "required": true, "usage": "Tooltips, dark elements" },
    { "name": "base-overlay-bg", "required": true, "usage": "Modal overlays" },
    { "name": "base-shadow-color", "required": false, "usage": "Box shadows" },

    { "name": "base-border-color", "required": true, "usage": "Default borders" },

    { "name": "base-input-bg", "required": true, "usage": "Input backgrounds" },
    { "name": "base-input-color", "required": true, "usage": "Input text" },
    { "name": "base-input-border", "required": true, "usage": "Input borders" },
    { "name": "base-input-border-focus", "required": true, "usage": "Focused input borders" },
    { "name": "base-input-placeholder-color", "required": false, "usage": "Placeholder text" },

    { "name": "base-dropdown-bg", "required": true, "usage": "Dropdown menus" },
    { "name": "base-dropdown-border", "required": false, "usage": "Dropdown borders" },
    { "name": "base-dropdown-box-shadow", "required": false, "usage": "Dropdown shadows" },

    { "name": "base-tooltip-bg", "required": true, "usage": "Tooltip backgrounds" },
    { "name": "base-tooltip-text-color", "required": true, "usage": "Tooltip text" },

    { "name": "base-success-color", "required": true, "usage": "Success buttons, badges, alerts" },
    { "name": "base-success-bg-light", "required": false, "usage": "Light success backgrounds" },
    { "name": "base-success-text", "required": false, "usage": "Success text on light backgrounds" },
    { "name": "base-text-on-success", "required": true, "usage": "Text on success backgrounds" },

    { "name": "base-danger-color", "required": true, "usage": "Danger buttons, badges, alerts" },
    { "name": "base-danger-bg-light", "required": false, "usage": "Light danger backgrounds" },
    { "name": "base-danger-text", "required": false, "usage": "Danger text on light backgrounds" },
    { "name": "base-text-on-danger", "required": true, "usage": "Text on danger backgrounds" },

    { "name": "base-warning-color", "required": true, "usage": "Warning buttons, badges, alerts" },
    { "name": "base-warning-bg-light", "required": false, "usage": "Light warning backgrounds" },
    { "name": "base-warning-text", "required": false, "usage": "Warning text on light backgrounds" },
    { "name": "base-text-on-warning", "required": true, "usage": "Text on warning backgrounds" },

    { "name": "base-info-color", "required": true, "usage": "Info buttons, badges, alerts" },
    { "name": "base-info-bg-light", "required": false, "usage": "Light info backgrounds" },
    { "name": "base-info-text", "required": false, "usage": "Info text on light backgrounds" },
    { "name": "base-text-on-info", "required": true, "usage": "Text on info backgrounds" },

    { "name": "base-focus-ring-color", "required": true, "usage": "Focus outlines" },
    { "name": "base-focus-ring-width", "required": false, "usage": "Focus outline width" },

    { "name": "base-font-family", "required": true, "usage": "Body text" },
    { "name": "base-font-size-base", "required": true, "usage": "Default font size" },
    { "name": "base-font-weight-normal", "required": true, "usage": "Normal text weight" },
    { "name": "base-font-weight-semibold", "required": true, "usage": "Emphasized text" },
    { "name": "base-line-height-normal", "required": true, "usage": "Default line height" },

    { "name": "base-border-radius-sm", "required": false, "usage": "Small elements" },
    { "name": "base-border-radius-md", "required": true, "usage": "Buttons, inputs" },
    { "name": "base-border-radius-lg", "required": false, "usage": "Cards, modals" }
  ]
}
