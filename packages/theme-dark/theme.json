{
  "$schema": "../core/schemas/pure-admin-theme.schema.json",
  "name": "Dark",
  "id": "dark",
  "version": "1.0.0-rc01",
  "description": "Neutral dark theme with optional color variants (blue, green, red)",
  "author": "KeenMate",
  "license": "MIT",

  "modes": {
    "supported": ["light", "dark"],
    "default": "dark",
    "cssClass": "pa-mode-{mode}",
    "autoSwitch": {
      "enabled": true,
      "method": "prefers-color-scheme",
      "respectUserPreference": true
    }
  },

  "colorVariants": {
    "supported": [
      {
        "id": "",
        "name": "Default",
        "description": "Neutral gray with blue accent",
        "accentColor": "#4dabf7"
      },
      {
        "id": "blue",
        "name": "Blue",
        "description": "Slate blue tinted backgrounds",
        "accentColor": "#3b82f6"
      },
      {
        "id": "green",
        "name": "Green",
        "description": "Green tinted backgrounds",
        "accentColor": "#22c55e"
      },
      {
        "id": "red",
        "name": "Red",
        "description": "Red tinted backgrounds",
        "accentColor": "#ef4444"
      }
    ],
    "default": "",
    "cssClass": "pa-color-{variant}"
  },

  "features": {
    "cssVariables": true,
    "responsiveLayout": true,
    "compactMode": true,
    "sidebarCollapse": true,
    "sidebarIconMode": true,
    "customFonts": false,
    "rtlSupport": false,
    "printStyles": false
  },

  "colors": {
    "accent": "#4dabf7",
    "accentHover": "#74c0fc",
    "background": "#1a1a1a",
    "surface": "#2a2a2a",
    "text": "#ffffff",
    "textSecondary": "#b8b8b8",
    "border": "#404040",
    "header": "#2d2d2d",
    "sidebar": "#242424",
    "footer": "#2d2d2d"
  },

  "exports": {
    "css": "./dist/dark.css",
    "scss": "./src/scss/dark.scss"
  },

  "dependencies": {
    "core": "^1.0.0-rc01"
  }
}
