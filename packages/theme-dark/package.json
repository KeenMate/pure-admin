{
  "name": "@keenmate/pure-admin-theme-dark",
  "version": "1.5.1",
  "description": "Dark theme for Pure Admin with color variants (blue, green, red) via CSS classes",
  "style": "dist/dark.css",
  "exports": {
    ".": "./dist/dark.css",
    "./scss": "./src/scss/dark.scss"
  },
  "files": [
    "dist/",
    "src/scss/"
  ],
  "scripts": {
    "build": "sass src/scss:dist --no-source-map --silence-deprecation=import --load-path=../../node_modules",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "pure-admin",
    "theme",
    "dark",
    "css"
  ],
  "author": "KeenMate",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KeenMate/pure-admin.git",
    "directory": "packages/theme-dark"
  },
  "bugs": {
    "url": "https://github.com/KeenMate/pure-admin/issues"
  },
  "homepage": "https://github.com/KeenMate/pure-admin#readme",
  "peerDependencies": {
    "@keenmate/pure-admin-core": "^1.0.0"
  },
  "devDependencies": {
    "@keenmate/pure-admin-core": "^1.0.0",
    "sass": "^1.70.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
