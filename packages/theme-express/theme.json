{
  "$schema": "../core/schemas/pure-admin-theme.schema.json",
  "name": "Express",
  "id": "express",
  "version": "1.0.0-rc01",
  "description": "Bold yellow and red theme inspired by logistics brands",
  "author": "KeenMate",
  "license": "MIT",

  "modes": {
    "supported": ["light", "dark"],
    "default": "light",
    "cssClass": "pa-mode-{mode}",
    "autoSwitch": {
      "enabled": true,
      "method": "prefers-color-scheme",
      "respectUserPreference": true
    }
  },

  "colorVariants": null,

  "features": {
    "cssVariables": true,
    "responsiveLayout": true,
    "compactMode": true,
    "sidebarCollapse": true,
    "sidebarIconMode": true,
    "customFonts": true,
    "rtlSupport": false,
    "printStyles": false
  },

  "colors": {
    "accent": "#D40511",
    "accentHover": "#F91320",
    "background": "#F2F2F2",
    "surface": "#ffffff",
    "text": "#333333",
    "textSecondary": "#8C8C8C",
    "border": "#E5E5E5",
    "header": "#FFCC00",
    "sidebar": "#000000",
    "footer": "#FFCC00"
  },

  "fonts": {
    "family": "Fira Sans Condensed, Arial Narrow, Arial, sans-serif",
    "files": []
  },

  "exports": {
    "css": "./dist/express.css",
    "scss": "./src/scss/express.scss"
  },

  "dependencies": {
    "core": "^1.0.0-rc01"
  }
}
