{
  "$schema": "../core/schemas/pure-admin-theme.schema.json",
  "name": "Minimal",
  "id": "minimal",
  "version": "1.0.0-rc01",
  "description": "Ultra clean monochrome theme with grayscale palette",
  "author": "KeenMate",
  "license": "MIT",

  "modes": {
    "supported": ["light", "dark"],
    "default": "light",
    "cssClass": "pa-mode-{mode}",
    "autoSwitch": {
      "enabled": true,
      "method": "prefers-color-scheme",
      "respectUserPreference": true
    }
  },

  "colorVariants": null,

  "features": {
    "cssVariables": true,
    "responsiveLayout": true,
    "compactMode": true,
    "sidebarCollapse": true,
    "sidebarIconMode": true,
    "customFonts": false,
    "rtlSupport": false,
    "printStyles": false
  },

  "colors": {
    "accent": "#555555",
    "accentHover": "#444444",
    "background": "#ffffff",
    "surface": "#ffffff",
    "text": "#333333",
    "textSecondary": "#777777",
    "border": "#e8e8e8",
    "header": "#fafafa",
    "sidebar": "#f8f8f8",
    "footer": "#fafafa"
  },

  "exports": {
    "css": "./dist/minimal.css",
    "scss": "./src/scss/minimal.scss"
  },

  "dependencies": {
    "core": "^1.0.0-rc01"
  }
}
