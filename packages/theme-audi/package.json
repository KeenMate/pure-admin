{
  "name": "@keenmate/pure-admin-theme-audi",
  "version": "2.0.2",
  "description": "Audi theme for Pure Admin - includes dark and light variants",
  "style": "dist/audi.css",
  "exports": {
    ".": "./dist/audi.css",
    "./light": "./dist/audi-light.css",
    "./dark": "./dist/audi.css",
    "./scss": "./src/scss/audi.scss",
    "./scss/light": "./src/scss/audi-light.scss"
  },
  "files": [
    "dist/",
    "src/scss/"
  ],
  "scripts": {
    "build": "sass src/scss:dist --no-source-map --silence-deprecation=import --load-path=../../node_modules",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "pure-admin",
    "theme",
    "audi",
    "css"
  ],
  "author": "KeenMate",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KeenMate/pure-admin.git",
    "directory": "packages/theme-audi"
  },
  "bugs": {
    "url": "https://github.com/KeenMate/pure-admin/issues"
  },
  "homepage": "https://github.com/KeenMate/pure-admin#readme",
  "peerDependencies": {
    "@keenmate/pure-admin-core": "^2.0.0"
  },
  "devDependencies": {
    "@keenmate/pure-admin-core": "^2.0.0",
    "sass": "^1.70.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
