# Build outputs - always rebuild fresh in Docker
**/dist/
**/*.tgz

# Dependencies - installed fresh via npm ci
node_modules/

# Git
.git/
.gitignore

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Documentation (not needed for runtime)
*.md
!README.md
docs/

# Legacy directories
pure-admin-visual/
pure-admin-core/

# Local development files
*.local
*.log
npm-debug.log*

# GitHub workflows (not needed in image)
.github/
