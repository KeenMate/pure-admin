{
  "name": "pure-admin-workspace",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "demo"
  ],
  "scripts": {
    "dev": "npm run dev -w demo",
    "start": "npm run start -w demo",
    "build": "npm run build -w @keenmate/pure-admin-core",
    "build:themes": "npm run build -w @keenmate/pure-admin-theme-audi -w @keenmate/pure-admin-theme-dark -w @keenmate/pure-admin-theme-corporate -w @keenmate/pure-admin-theme-express -w @keenmate/pure-admin-theme-minimal",
    "build:all": "npm run build && npm run build:themes",
    "watch": "npm run watch -w @keenmate/pure-admin-core"
  }
}
